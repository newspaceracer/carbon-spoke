---
// A scannable key/value grid — label above value, wrapping into responsive
// columns. The default read for permit facts inside a section.
// Pass `tiles` to promote each fact onto its own cds-tile surface (a card grid)
// where facts read better as discrete blocks than as a dense dl.
// A row with `href` renders its value as a cds-link to that document (the answer
// lives in an uploaded file) with a launch glyph. The link carries `data-view-doc`,
// so a page with an embedded DocumentViewer can open it there instead of a new tab.
import type { MetaRow } from '../data/permit';
import ContactCard from './ContactCard.astro';
import YesNoStatement from './YesNoStatement.astro';
import EditButton from './EditButton.astro';
interface Props {
  rows: MetaRow[];
  /** Minimum column width; wider for long values (e.g. contact strings). */
  min?: string;
  /** Render each fact as its own cds-tile card instead of a plain dl row. */
  tiles?: boolean;
  /** Application-record editing (tiles only): each tile gets an Edit button keyed
   *  `${editPrefix}-${row index}` plus the bindings the shared edit modal re-renders
   *  (src/lib/record-edit.ts). The host supplies the matching specs. */
  editPrefix?: string;
}
const { rows, min = '15rem', tiles = false, editPrefix } = Astro.props;
const keyFor = (row: MetaRow) => (editPrefix ? `${editPrefix}-${rows.indexOf(row)}` : undefined);

// Yes/no facts with statement phrasing ("Does / Does NOT …") always show, as a
// YesNoStatement. Legacy yes/no rows without it only surface when affirmative —
// a "No" row drops out, and a "Yes" row's tile states the label itself.
const visibleRows = rows.filter((r) => !(r.boolean && !r.statements && r.value !== 'Yes'));

// Carbon `launch` 16 glyph — signals the value opens an uploaded document.
const launchIcon =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">' +
  '<path d="M13,14H3c-0.6,0-1-0.4-1-1V3c0-0.6,0.4-1,1-1h5v1H3v10h10V8h1v5C14,13.6,13.6,14,13,14z"/>' +
  '<path d="M10 1 10 2 13.3 2 9 6.3 9.7 7 14 2.7 14 6 15 6 15 1z"/></svg>';
---

{tiles ? (
  <div class="factgrid factgrid--tiles" style={`--min:${min}`}>
    {visibleRows.map((row) => (
      row.contact ? (
        <ContactCard role={row.key} contact={row.contact} kind={row.contactKind} editKey={keyFor(row)} />
      ) : row.boolean && row.statements ? (
        <cds-tile class="factgrid__item">
          {row.value === 'Yes' && row.detail ? (
            <YesNoStatement value={true} statements={row.statements}>{row.detail}</YesNoStatement>
          ) : (
            <YesNoStatement value={row.value === 'Yes'} statements={row.statements} />
          )}
        </cds-tile>
      ) : row.boolean ? (
        <cds-tile class="factgrid__item factgrid__item--flag">
          <p class="factgrid__flag t-body-01">{row.key}</p>
        </cds-tile>
      ) : row.entries ? (
        <cds-tile class:list={['factgrid__item', keyFor(row) && 'factgrid__item--editable']} data-edit-scope={keyFor(row)}>
          {keyFor(row) && <EditButton item={keyFor(row)!} label={row.key} />}
          <dl class="factgrid__pair">
            <dt class="factgrid__key t-label-01">{row.key}</dt>
            {row.entries.map((e, j) => (
              <dd class="factgrid__entry">
                <span class="factgrid__entry-label t-label-01">{e.label}</span>
                <span class="factgrid__entry-value t-heading-03" data-bind={keyFor(row) ? `entry-${j}` : undefined}>{e.value}</span>
              </dd>
            ))}
          </dl>
        </cds-tile>
      ) : (
        <cds-tile class:list={['factgrid__item', keyFor(row) && 'factgrid__item--editable']} data-edit-scope={keyFor(row)}>
          {keyFor(row) && <EditButton item={keyFor(row)!} label={row.key} />}
          <dl class="factgrid__pair">
            <dt class="factgrid__key t-label-01">{row.key}</dt>
            <dd class="factgrid__val t-heading-03">
              {row.href ? (
                <>
                  {/* "Answered in study proposal" link; an editable tile can switch to a typed answer. */}
                  <cds-link href={row.href} size="lg" target="_blank" rel="noopener" data-view-doc={row.href} data-show-if={keyFor(row) ? 'inProposal' : undefined}>
                    {row.linkLabel ?? row.value}
                    <Fragment set:html={launchIcon} />
                  </cds-link>
                  {keyFor(row) && <span data-bind="value" data-hide-if="inProposal" hidden></span>}
                </>
              ) : keyFor(row) ? <span data-bind="value">{row.value}</span> : row.value}
            </dd>
          </dl>
        </cds-tile>
      )
    ))}
  </div>
) : (
  <dl class="factgrid" style={`--min:${min}`}>
    {visibleRows.map((row) => (
      <div class="factgrid__item">
        <dt class="factgrid__key t-label-01">{row.key}</dt>
        <dd class="factgrid__val t-body-01">
          {row.href ? (
            <cds-link href={row.href} target="_blank" rel="noopener" data-view-doc={row.href}>
              {row.linkLabel ?? row.value}
              <Fragment set:html={launchIcon} />
            </cds-link>
          ) : row.value}
        </dd>
      </div>
    ))}
  </dl>
)}

<style>
  .factgrid {
    display: grid;
    /* min(…, 100%): a tile never demands more than the container, so a 20rem
       minimum collapses to one full-width column on a phone instead of overflowing. */
    grid-template-columns: repeat(auto-fill, minmax(min(var(--min, 15rem), 100%), 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }
  /* Tile variant: even gap between cards; the tile owns each item's surface
     and padding, so the pair's own margin is zeroed. */
  .factgrid--tiles {
    gap: 1rem;
  }
  .factgrid__pair {
    margin: 0;
  }
  /* Record editing: the Edit button pins to the tile's top-right corner; the key
     leaves room for it.
     carbon-checked: layout only — positions a stock cds-icon-button inside a stock
     cds-tile; no Carbon part is restyled. */
  .factgrid__item--editable { position: relative; }
  .factgrid__item--editable > :global(.record-edit-btn),
  .factgrid__item--editable > :global(.item-actions) { position: absolute; inset-block-start: 0.5rem; inset-inline-end: 0.5rem; }
  .factgrid__item--editable .factgrid__key { padding-inline-end: 2.5rem; }
  .factgrid__item {
    min-width: 0;
  }
  /* Affirmative yes/no flag: the label is the whole statement (no eyebrow/value
     split), so the tile centers it as a single line of content. */
  .factgrid__flag {
    margin: 0;
  }
  .factgrid__item--flag {
    display: flex;
    align-items: center;
  }
  .factgrid__key {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
  .factgrid__val {
    margin: 0.25rem 0 0;
    color: var(--cds-text-primary, #161616);
    overflow-wrap: break-word;
  }
  /* Stacked sub-values (e.g. Start over End dates) within one tile: a quiet
     sub-label above each value, entries separated by a small gap. */
  .factgrid__entry {
    margin: 0.5rem 0 0;
  }
  .factgrid__entry-label {
    display: block;
    color: var(--cds-text-secondary, #525252);
  }
  .factgrid__entry-value {
    display: block;
    color: var(--cds-text-primary, #161616);
  }
</style>
