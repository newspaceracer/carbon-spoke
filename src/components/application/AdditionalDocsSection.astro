---
// Application record · Additional documents — the compliance screening answers and
// the uploaded files. Shared by the review wizard (ApplicationReview: screening
// answers as statements + label-over-value rows, each with an Edit button; the
// files as a plain list — the wizard reads them in its Documents tab) and the
// permit detail page (`readonly`: Compliance as the detail's fact tiles, proposal-
// answered facts linking to the document; Uploaded files as a table with Download
// all, where View opens the file in an inline DocumentViewer below the table — the
// host page wires [data-view-doc] / [data-view-cv] clicks to it).
//
// carbon-checked: every control is stock — FactGrid (cds-tile), cds-table,
// cds-button, cds-link, cds-icon-indicator (YesNoStatement), DocumentViewer
// (cds-dropdown + iframe). `ro-table` is only a display:block hook on the stock
// cds-table; `.doc-actions` only groups the stock ghost buttons in a cell.
import ReviewSection from '../ReviewSection.astro';
import FactGrid from '../FactGrid.astro';
import YesNoStatement from '../YesNoStatement.astro';
import EditButton from '../EditButton.astro';
import DocumentViewer from '../DocumentViewer.astro';
import { permit, badgesForSection } from '../../data/permit';
import { reviewDocuments, documentTypeText } from '../../data/review-documents';
import { answerIdFor } from '../../lib/record-summary';
import { truncateMiddle } from '../../lib/truncate';
import { statementFacts, otherFacts, factIndex, fileGlyph, ORDER, type SectionFrame } from '../../lib/application-record';

interface Props extends SectionFrame {
  readonly?: boolean;
  title?: string;
}
const {
  readonly = false, title = 'Additional documents',
  collapsible = false, layered = false, panel = false, orderIndex = ORDER.docs, commentKey,
} = Astro.props;
const ad = permit.additionalDocs;
const documents = reviewDocuments(ad.files);
---

<ReviewSection title={title} collapsible={collapsible} layered={layered} panel={panel} orderIndex={orderIndex} commentKey={commentKey} {...badgesForSection('docs')}>
  {readonly ? (
    <>
      <div class="subblock">
        <h3 class="sub-head t-heading-02">Compliance</h3>
        <FactGrid rows={ad.facts} min="20rem" tiles />
      </div>

      <div class="subblock">
        <div class="roster__head sub-head-row">
          <h3 class="sub-head t-heading-02">Uploaded files</h3>
          <cds-button id="download-all-docs" kind="tertiary" size="md">
            Download all
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M13 7 12.3 6.3 8.5 10.1 8.5 1 7.5 1 7.5 10.1 3.7 6.3 3 7 8 12z"/>
              <path d="M13,12v2H3v-2H2v2l0,0c0,0.6,0.4,1,1,1h10c0.6,0,1-0.4,1-1l0,0v-2H13z"/>
            </svg>
          </cds-button>
        </div>
        <script type="application/json" id="all-docs-data" set:html={JSON.stringify(ad.files.map((f) => ({ href: f.href, name: f.name })))}></script>
        <cds-table class="ro-table">
          <cds-table-head>
            <cds-table-header-row>
              <cds-table-header-cell>File</cds-table-header-cell>
              <cds-table-header-cell>Type</cds-table-header-cell>
              <cds-table-header-cell>Size</cds-table-header-cell>
              <cds-table-header-cell>Uploaded by</cds-table-header-cell>
              <cds-table-header-cell>Date</cds-table-header-cell>
              <cds-table-header-cell>Actions</cds-table-header-cell>
            </cds-table-header-row>
          </cds-table-head>
          <cds-table-body>
            {ad.files.map((f) => (
              <cds-table-row>
                <cds-table-cell>{truncateMiddle(f.name) === f.name ? f.name : (
                  <Fragment>
                    <span title={f.name} aria-hidden="true">{truncateMiddle(f.name)}</span>
                    <span class="cds--visually-hidden">{f.name}</span>
                  </Fragment>
                )}</cds-table-cell>
                <cds-table-cell>{documentTypeText(f.type)}</cds-table-cell>
                <cds-table-cell><span class="doc-nowrap">{f.size}</span></cds-table-cell>
                <cds-table-cell>{f.by}</cds-table-cell>
                <cds-table-cell><span class="doc-nowrap">{f.date}</span></cds-table-cell>
                <cds-table-cell>
                  <div class="doc-actions">
                    {/* View opens the file in the viewer below (the page wires it);
                        the href keeps a plain new-tab fallback. */}
                    <cds-button
                      kind="ghost"
                      size="sm"
                      href={f.href}
                      target="_blank"
                      rel="noopener"
                      data-view-doc={f.href}
                      tooltip-text={`View ${f.name}`}
                      tooltip-position="left"
                    >
                      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <path d="M15.5,7.8C14.3,4.7,11.3,2.6,8,2.5C4.7,2.6,1.7,4.7,0.5,7.8c0,0.1,0,0.2,0,0.3c1.2,3.1,4.1,5.2,7.5,5.3c3.3-0.1,6.3-2.2,7.5-5.3C15.5,8.1,15.5,7.9,15.5,7.8z M8,12.5c-2.7,0-5.4-2-6.5-4.5c1-2.5,3.8-4.5,6.5-4.5s5.4,2,6.5,4.5C13.4,10.5,10.6,12.5,8,12.5z"/>
                        <path d="M8,5C6.3,5,5,6.3,5,8s1.3,3,3,3s3-1.3,3-3S9.7,5,8,5z M8,10c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S9.1,10,8,10z"/>
                      </svg>
                    </cds-button>
                    <cds-button
                      kind="ghost"
                      size="sm"
                      href={f.href}
                      download={f.name}
                      tooltip-text={`Download ${f.name}`}
                      tooltip-position="left"
                    >
                      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <path d="M13 7 12.3 6.3 8.5 10.1 8.5 1 7.5 1 7.5 10.1 3.7 6.3 3 7 8 12z"/>
                        <path d="M13,12v2H3v-2H2v2l0,0c0,0.6,0.4,1,1,1h10c0.6,0,1-0.4,1-1l0,0v-2H13z"/>
                      </svg>
                    </cds-button>
                  </div>
                </cds-table-cell>
              </cds-table-row>
            ))}
          </cds-table-body>
        </cds-table>

        <!-- The inline reader: hidden until a file is viewed, then the picker lets the
             reader switch files without leaving the tab. -->
        <div class="doc-viewer" data-record-docs hidden>
          <div class="doc-viewer__head">
            <cds-button kind="ghost" size="sm" data-docs-hide>
              Hide document
              <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.4141 16 24 9.4141 22.5859 8 16 14.5859 9.4143 8 8 9.4141 14.5859 16 8 22.5859 9.4143 24 16 17.4141 22.5859 24 24 22.5859 17.4141 16z"/></svg>
            </cds-button>
          </div>
          <DocumentViewer documents={documents} docTitle={permit.name} slim />
        </div>
      </div>
    </>
  ) : (
    <>
      <!-- Screening answers as statements ("Does / Does NOT …"), then the remaining
           label-over-value facts. -->
      <div class="subblock">
        <ul class="statements">
          {statementFacts.map((r) => (
            <li class="statement" id={answerIdFor(r.key)} data-edit-scope={`doc-fact-${factIndex(r)}`}>
              <YesNoStatement value={r.value === 'Yes'} statements={r.statements!} bind="value" bindDetail="detail">{r.detail}</YesNoStatement>
              <EditButton item={`doc-fact-${factIndex(r)}`} label={r.key.toLowerCase()} />
            </li>
          ))}
        </ul>
        <dl class="review">
          {otherFacts.map((r) => (
            <div class="review__row" data-edit-scope={`doc-fact-${factIndex(r)}`}>
              <dt class="review__label t-label-01">{r.key}</dt>
              <dd class="review__value review__value--editable t-body-01">
                <span class="review__answer">
                  {r.href ? (
                    <>
                      {/* size="lg" = Carbon's 16px link, matching the body-02 values. */}
                      <cds-link href={r.href} size="lg" target="_blank" rel="noopener" data-view-doc={r.href} data-show-if="inProposal">{r.linkLabel ?? r.value}</cds-link>
                      <span data-bind="value" data-hide-if="inProposal" hidden></span>
                    </>
                  ) : <span data-bind="value">{r.value}</span>}
                  {r.detail && <span class="review__detail t-label-01">{r.detail}</span>}
                </span>
                <EditButton item={`doc-fact-${factIndex(r)}`} label={r.key.toLowerCase()} />
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="subblock">
        <h3 class="sub-head t-heading-02">Submitted files</h3>
        <ul class="docs">
          {ad.files.map((f) => (
            <li class="doc">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={fileGlyph}></path></svg>
              <span class="t-body-01">{f.name}</span>
              <span class="doc__type t-label-01">{documentTypeText(f.type)}</span>
            </li>
          ))}
        </ul>
      </div>
    </>
  )}
</ReviewSection>

<style>
  /* Row action buttons sit flush-right and tight; the buttons themselves are
     stock cds-button (ghost, icon-only) — this only handles their grouping. */
  .doc-actions { display: flex; gap: 0.25rem; justify-content: flex-end; }
  /* Sizes and dates are compared down the column — never break them across lines.
     Long file names are shortened from the middle instead (truncateMiddle). */
  .doc-nowrap { white-space: nowrap; }
  /* The inline reader under the files table. Author element reset beats the UA
     [hidden] rule, so restate the collapse. A jump to it lands below the sticky
     header + tab strip. */
  .doc-viewer { margin-top: var(--cds-spacing-06, 1.5rem); scroll-margin-block-start: 10rem; }
  .doc-viewer[hidden] { display: none; }
  .doc-viewer__head { display: flex; justify-content: flex-end; margin-bottom: var(--cds-spacing-03, 0.5rem); }
</style>
