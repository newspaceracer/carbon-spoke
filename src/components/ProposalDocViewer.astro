---
// ProposalDocViewer — the study proposal shown the way a reviewer actually reads
// it: an EMBEDDED PDF. A thin file bar (name · size · pages · Open) sits over the
// browser's native PDF viewer, which loads the real document from `href`. Used by
// the review-layout studies so the "compare against the study proposal" job is
// reading the actual document side-by-side with the record.
//
// carbon-checked: Carbon ships no PDF/document viewer component, so the document
// is a stock <iframe> pointing at the real PDF (public/docs/...); the only chrome
// is a stock cds-link ("Open"). Not a reinvented UI control.
import { withBase } from '../lib/base';

interface Props {
  href: string;
  filename: string;
  size: string;
  pages: number;
  /** Accessible title for the embedded document. */
  docTitle: string;
  /** Narrow-column treatment (shorter frame). */
  compact?: boolean;
  /** Extra fields (authors/sections/…) are accepted but unused by the embed. */
  [key: string]: unknown;
}
const { href, filename, size, pages, docTitle, compact = false } = Astro.props;
// #view=FitH fits the page to the frame width; the native viewer supplies scroll,
// zoom, and page navigation.
const src = `${withBase(href)}#view=FitH`;
---

<div class:list={['pdfv', compact && 'pdfv--compact']}>
  <div class="pdfv__bar">
    <div class="pdfv__id">
      <svg class="pdfv__glyph" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M20 2H8a2 2 0 00-2 2v24a2 2 0 002 2h16a2 2 0 002-2V8zm-1 2.4L23.6 9H19zM8 28V4h9v6h6v18z"/>
        <path d="M10 14h12v2H10zm0 5h12v2H10zm0 5h8v2h-8z"/>
      </svg>
      <div class="pdfv__idtext">
        <p class="pdfv__name t-body-compact-01">{filename}</p>
        <p class="pdfv__meta t-label-01">PDF · {size} · {pages} pages</p>
      </div>
    </div>
    <cds-link class="pdfv__open" href={withBase(href)} target="_blank" rel="noopener">Open ↗</cds-link>
  </div>

  <iframe class="pdfv__frame" src={src} title={`${docTitle} — study proposal (PDF)`} loading="lazy"></iframe>
</div>

<style>
  /* Viewer shell — layout + a token-backed surface. */
  .pdfv {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border: 1px solid var(--cds-border-subtle-01);
    background: var(--cds-layer-01);
  }
  .pdfv__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border-block-end: 1px solid var(--cds-border-subtle-01);
    background: var(--cds-layer-01);
  }
  .pdfv__id { display: flex; align-items: center; gap: 0.625rem; min-inline-size: 0; }
  .pdfv__glyph { color: var(--cds-text-secondary); flex-shrink: 0; }
  .pdfv__idtext { min-inline-size: 0; }
  .pdfv__name { margin: 0; color: var(--cds-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pdfv__meta { margin: 0; color: var(--cds-text-secondary); }
  .pdfv__open { flex-shrink: 0; }

  /* The embedded PDF — the browser's native viewer fills the frame. */
  .pdfv__frame {
    inline-size: 100%;
    block-size: 42rem;
    border: 0;
    display: block;
    background: var(--cds-layer-02);
  }
  .pdfv--compact .pdfv__frame { block-size: 34rem; }
</style>
