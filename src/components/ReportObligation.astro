---
// Staff view of the permit's FINAL REPORT obligation (lib/final-report.ts), shown
// at the top of the Overview for internal identities once the permit is issued:
// due → info; delinquent → error, with "Lift renewal block" for the Responsible
// Agent (or an admin); lifted → info naming who lifted it (the report is still
// owed), with "Restore block"; submitted → success + View report.
//
// Delinquency itself is automatic (the day after the due date) — there is no
// manual "flag" action. Composition: cds-actionable-notification (+ buttons).
import { permit } from '../data/permit';
---

<cds-actionable-notification class="report-obligation" data-report-obligation data-permit-id={permit.id}
  inline low-contrast hide-close-button style="display:none">
  <span slot="title" data-ob-title></span>
  <span slot="subtitle" data-ob-subtitle></span>
  <cds-actionable-notification-button slot="action" data-ob-lift style="display:none">Lift renewal block</cds-actionable-notification-button>
  <cds-actionable-notification-button slot="action" data-ob-restore style="display:none">Restore block</cds-actionable-notification-button>
  <cds-actionable-notification-button slot="action" data-ob-view style="display:none">View report</cds-actionable-notification-button>
</cds-actionable-notification>

<script>
  import { reportState, reportDueISO, formatDate, todayISO, delinquencyClearance, clearanceKey } from '../lib/final-report';
  import { readIdentity } from '../lib/maintenance';
  import { activeUser } from '../data/user';
  import { readPermitRole } from '../lib/permissions';
  import { showToast } from '../lib/toast';

  const note = document.querySelector<HTMLElement & { kind: string }>('[data-report-obligation]');
  if (note) {
    const id = note.dataset.permitId!;
    const $ = (sel: string) => note.querySelector<HTMLElement>(sel)!;
    const shown = (el: HTMLElement, on: boolean) => { el.style.display = on ? '' : 'none'; };
    const who = readIdentity();
    const internal = ['admin', 'hq-technical', 'district-lead', 'district-assistant'].includes(who);
    const canLift = () => who === 'admin' || readPermitRole(id) === 'responsible';
    const status = () => localStorage.getItem(`permit-status-${id}`)
      || document.getElementById('permit-banner')?.dataset.status || '';

    const render = () => {
      const state = internal ? reportState(status(), id) : null;
      shown(note, !!state && state !== 'not-due');
      if (!state || state === 'not-due') return;
      const due = formatDate(reportDueISO());
      const cleared = delinquencyClearance(id);
      const [kind, title, sub] =
        state === 'submitted' ? ['success', 'Final report submitted', 'The researcher filed the final report.']
        : state === 'due' ? ['info', `Final report due ${due}`, 'The permit has ended. The researcher has 30 days from the end date to file it.']
        : cleared ? ['info', 'Final report overdue — renewal block lifted', `${cleared.by} lifted the block on ${cleared.at}. The report is still owed (it was due ${due}).`]
        : ['error', 'Final report overdue — renewals are blocked', `It was due ${due}. The principal investigator can't apply for, renew, or amend a permit until it's in.`];
      note.kind = kind;
      note.setAttribute('kind', kind);
      $('[data-ob-title]').textContent = title;
      $('[data-ob-subtitle]').textContent = sub;
      shown($('[data-ob-lift]'), state === 'delinquent' && !cleared && canLift());
      shown($('[data-ob-restore]'), state === 'delinquent' && !!cleared && canLift());
      shown($('[data-ob-view]'), state === 'submitted');
    };

    $('[data-ob-lift]').addEventListener('click', () => {
      const at = formatDate(todayISO()); // the demo clock, so it reads in sequence with the due date
      localStorage.setItem(clearanceKey(id), JSON.stringify({ by: activeUser(who)?.name ?? 'The responsible analyst', at }));
      render();
      showToast('Renewal block lifted', 'The researcher can apply again. The final report is still owed.');
    });
    $('[data-ob-restore]').addEventListener('click', () => {
      localStorage.removeItem(clearanceKey(id));
      render();
      showToast('Renewal block restored', 'Renewals stay blocked until the final report is in.');
    });
    $('[data-ob-view]').addEventListener('click', () => {
      const tabs = document.getElementById('permit-tabs') as any;
      if (tabs) { tabs.value = 'report'; tabs.dispatchEvent(new CustomEvent('cds-tabs-selected')); }
    });

    render();
    window.addEventListener('permit-status-changed', render);
  }
</script>
