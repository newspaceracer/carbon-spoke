---
// The analysis-team roster — ONE component shared by the permit detail page
// (Overview rail) and the review workflow (final-letter Team tab), so the two
// surfaces are identical. Members are GROUPED by review unit: the Responsible
// analyst on their own, then Headquarters, then each district (in the order it
// first appears). Each member shows their role, a copyable email (mailto link +
// copy button), and their application-review status with the relevant date:
// Completed <when> / Last opened <when> (in progress) / Added <when> (not started).
//
// Editing (add / remove) is Responsible-Agent-or-Admin only during review — the
// component resolves that itself from the shared IR matrix, so both hosts gate
// identically. Add / remove / email-all persist to the shared `permit-team-${id}`
// storage, keeping both surfaces in sync. The host only supplies the data.
import { installEmailCopy } from '../lib/email-copy';

interface TeamMember {
  id: string; role: string; name: string; detail?: string;
  reviewStatus: 'not-started' | 'pending' | 'complete'; when?: string; highlight?: boolean;
}
interface DirUser { id: string; name: string; role: string; detail: string; email: string; }
interface Props { permitId: string; team: TeamMember[]; directory: DirUser[]; }
const { permitId, team, directory } = Astro.props;

// Review status → icon-indicator kind + the dated line. One `when` per member is
// relabelled by status (a prototype has no live per-event log): completed date,
// last-opened date (in progress), or added date (not yet started).
const STATUS: Record<string, { kind: string; verb: string }> = {
  'complete': { kind: 'succeeded', verb: 'Completed' },
  'pending': { kind: 'in-progress', verb: 'Last opened' },
  'not-started': { kind: 'not-started', verb: 'Added' },
};
const statusOf = (m: TeamMember) => STATUS[m.reviewStatus] ?? STATUS['not-started'];
const statusLine = (m: TeamMember) => {
  const s = statusOf(m);
  return m.when ? `${s.verb} ${m.when}` : s.verb;
};
const initials = (name: string) =>
  name.replace(/[^A-Za-z. ]/g, '').split(/[.\s]+/).filter(Boolean).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
const emailOf = (id: string) => directory.find((u) => u.id === id)?.email ?? '';

// Group members by review unit — the same rule as the header's review roster:
// the Responsible analyst on their own, District reviewers under their district
// (their `detail`), everyone else under Headquarters.
const isResponsible = (m: TeamMember) => m.highlight === true || m.role === 'Responsible analyst';
const RESPONSIBLE = '__responsible';
const unitOf = (m: TeamMember): string =>
  isResponsible(m) ? RESPONSIBLE : m.role === 'District reviewer' ? (m.detail || 'Headquarters') : 'Headquarters';

const byUnit = new Map<string, TeamMember[]>();
const seen: string[] = [];
team.forEach((m) => {
  const u = unitOf(m);
  if (!byUnit.has(u)) { byUnit.set(u, []); seen.push(u); }
  byUnit.get(u)!.push(m);
});
const orderedUnits = [
  ...seen.filter((u) => u === RESPONSIBLE),
  ...seen.filter((u) => u === 'Headquarters'),
  ...seen.filter((u) => u !== RESPONSIBLE && u !== 'Headquarters'),
];
const groups = orderedUnits.map((u) => ({
  key: u,
  label: u === RESPONSIBLE ? 'Responsible analyst' : u,
  members: byUnit.get(u)!,
}));

// Directory users not already on the team seed the add-member combo.
const teamIds = new Set(team.map((m) => m.id));
const eligible = directory.filter((u) => !teamIds.has(u.id)).sort((a, b) => a.name.localeCompare(b.name));

const copyIcon =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>';
const trashIcon =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>';
---

<div class="team" id="team-roster" data-storage-key={`permit-team-${permitId}`}>
  <div class="team__tools">
    <cds-button id="team-email-all" kind="ghost" size="md">Email all</cds-button>
    <cds-button id="team-add-open" kind="tertiary" size="md" type="button">Add member</cds-button>
  </div>

  <div class="team__groups" id="team-groups">
    {groups.map((g) => (
      <section class="team-group" data-team-group={g.key}>
        <cds-contained-list label={g.label} kind="on-page">
          {g.members.map((m) => {
            const email = emailOf(m.id);
            const st = statusOf(m);
            return (
              <cds-contained-list-item data-user-id={m.id} data-email={email} data-responsible={m.highlight ? 'true' : 'false'}>
                <div class:list={['member', m.highlight && 'member--responsible']}>
                  <span class="member__avatar" aria-hidden="true">{initials(m.name)}</span>
                  <div class="member__body">
                    <p class="member__name t-body-01">{m.name}</p>
                    <p class="member__role t-label-01">{m.detail ? `${m.role} · ${m.detail}` : m.role}</p>
                    {email && (
                      <span class="member__email">
                        <cds-link href={`mailto:${email}`}>{email}</cds-link>
                        <cds-icon-button class="member__copy" kind="ghost" size="sm" align="bottom" data-copy-email={email} set:html={`${copyIcon}<span slot="tooltip-content">Copy email</span>`}></cds-icon-button>
                      </span>
                    )}
                    <p class="member__status t-label-01">
                      <cds-icon-indicator size="16" kind={st.kind} label={statusLine(m)}></cds-icon-indicator>
                    </p>
                  </div>
                  {!m.highlight && (
                    <div class="member__end">
                      <cds-icon-button class="member__remove" kind="ghost" size="sm" align="left" data-remove-member set:html={`${trashIcon}<span slot="tooltip-content">Remove ${m.name}</span>`}></cds-icon-button>
                    </div>
                  )}
                </div>
              </cds-contained-list-item>
            );
          })}
        </cds-contained-list>
      </section>
    ))}
  </div>

  <!-- Template for a JS-added member's group (created when the first member of a
       not-yet-shown unit is added) and its row. Rendered inert so the markup
       carries the scoped-style attributes, then cloned. -->
  <template id="team-group-template">
    <section class="team-group" data-team-group="">
      <cds-contained-list label="" kind="on-page"></cds-contained-list>
    </section>
  </template>
  <template id="team-row-template">
    <cds-contained-list-item data-user-id="" data-email="" data-responsible="false">
      <div class="member">
        <span class="member__avatar" aria-hidden="true"></span>
        <div class="member__body">
          <p class="member__name t-body-01"></p>
          <p class="member__role t-label-01"></p>
          <span class="member__email" hidden>
            <cds-link class="member__emaillink" href="">
              <span class="member__emailtext"></span>
            </cds-link>
            <cds-icon-button class="member__copy" kind="ghost" size="sm" align="bottom" data-copy-email="">
              <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>
              <span slot="tooltip-content">Copy email</span>
            </cds-icon-button>
          </span>
          <p class="member__status t-label-01">
            <cds-icon-indicator size="16" kind="not-started" label="Not started"></cds-icon-indicator>
          </p>
        </div>
        <div class="member__end">
          <cds-icon-button class="member__remove" kind="ghost" size="sm" align="left" data-remove-member>
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>
            <span slot="tooltip-content"></span>
          </cds-icon-button>
        </div>
      </div>
    </cds-contained-list-item>
  </template>

  <script type="application/json" class="team-directory" set:html={JSON.stringify(directory)}></script>

  <!-- Add a member — button-first: "Add member" opens this, you pick a directory
       user (only those not already on the team), and the modal's own "Add to team"
       commits. Shared permit-team storage keeps both surfaces in sync. -->
  <cds-modal id="team-add-modal" size="sm">
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label>Analysis team</cds-modal-label>
      <cds-modal-heading>Add to team</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <cds-combo-box
        id="team-add-select"
        title-text="Reviewer"
        label="Search the user directory…"
        helper-text="Only users not already on the analysis team appear here."
      >
        {eligible.map((u) => (
          <cds-combo-box-item value={u.id}>{u.name} — {u.role}</cds-combo-box-item>
        ))}
      </cds-combo-box>
    </cds-modal-body>
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="team-add-confirm">Add to team</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>
</div>

<style>
  .team {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .team__tools {
    display: flex;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .team__groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* One member row: initials chip · body (name / role / email / status) · remove. */
  .member {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.75rem;
    width: 100%;
  }
  .member--responsible {
    /* The Responsible analyst — a quiet layered surface, not colour-as-status. */
    margin: calc(-1 * var(--cds-spacing-05, 1rem));
    padding: var(--cds-spacing-05, 1rem);
    background: var(--cds-layer-selected, #e0e0e0);
  }
  .member__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--cds-layer-accent, #e0e0e0);
    color: var(--cds-text-primary, #161616);
    font-size: 0.75rem;
    font-weight: 600;
    flex: 0 0 auto;
  }
  .member__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .member__name { margin: 0; }
  .member__role {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
  .member__email {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    max-width: 100%;
  }
  .member__email[hidden] { display: none; }
  .member__status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0.125rem 0 0;
    color: var(--cds-text-secondary, #525252);
  }
  .member__end { flex: 0 0 auto; }
</style>

<script>
  import { readIdentity } from '../lib/maintenance';
  import { sectionAccessor } from '../lib/permissions';
  import { installEmailCopy } from '../lib/email-copy';

  installEmailCopy();

  interface DirUser { id: string; name: string; role: string; detail: string; email: string; }
  interface TeamEdits { removed: string[]; added: DirUser[]; }

  const root = document.getElementById('team-roster') as HTMLElement | null;
  const groupsWrap = document.getElementById('team-groups');
  const rowTpl = document.getElementById('team-row-template') as HTMLTemplateElement | null;
  const groupTpl = document.getElementById('team-group-template') as HTMLTemplateElement | null;
  const dirEl = root?.querySelector('.team-directory') ?? null;
  const addOpen = document.getElementById('team-add-open');
  const addModal = document.getElementById('team-add-modal') as any;
  const addSelect = document.getElementById('team-add-select') as any;
  const addConfirm = document.getElementById('team-add-confirm');
  const emailAll = document.getElementById('team-email-all');

  if (root && groupsWrap && rowTpl && groupTpl && dirEl) {
    // Editability = the analysis-team roster's IR access (Responsible Agent / Admin
    // during review), resolved the SAME way on both hosts from the shared banner.
    const banner = document.getElementById('permit-banner');
    const permitId = banner?.dataset.permitId || '';
    const status = localStorage.getItem(`permit-status-${permitId}`) || banner?.dataset.status || 'Under review';
    const acc = sectionAccessor(readIdentity(), permitId, banner?.dataset.permitType, status);
    const canEdit = acc('supporting-agents') === 'update';

    const storageKey = root.dataset.storageKey || `permit-team-${permitId}`;
    let directory: DirUser[] = [];
    try { directory = JSON.parse(dirEl.textContent || '[]'); } catch { directory = []; }
    const byId = new Map(directory.map((u) => [u.id, u]));

    const initials = (name: string) =>
      name.replace(/[^A-Za-z. ]/g, '').split(/[.\s]+/).filter(Boolean).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
    const todayLabel = () => new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    // The unit an ADDED user belongs to (added members are never the Responsible
    // analyst): District reviewers under their district, everyone else Headquarters.
    const unitOfUser = (u: DirUser) => u.role === 'District reviewer' ? (u.detail || 'Headquarters') : 'Headquarters';

    const allRows = () => Array.from(groupsWrap.querySelectorAll<HTMLElement>('[data-user-id]'));
    const onTeamIds = () => new Set(allRows().map((r) => r.dataset.userId!));

    // Seed ids = the server-rendered rows, captured before replaying stored edits —
    // so a removed *seed* (tracked in `removed`) is told from a removed *added* user.
    const seedIds = new Set(allRows().map((r) => r.dataset.userId!));

    const load = (): TeamEdits => {
      try {
        const p = JSON.parse(localStorage.getItem(storageKey) || '{}');
        return { removed: Array.isArray(p.removed) ? p.removed : [], added: Array.isArray(p.added) ? p.added : [] };
      } catch { return { removed: [], added: [] }; }
    };
    const save = (e: TeamEdits) => localStorage.setItem(storageKey, JSON.stringify(e));
    let edits = load();

    // Keep any tab badge (final-letter's Team tab count) in step with the roster.
    const syncBadge = () => {
      const badge = document.querySelector('[data-tab-badge="team"]');
      if (badge) badge.textContent = String(onTeamIds().size);
    };

    const refreshCombo = () => {
      syncBadge();
      if (!addSelect) return;
      const on = onTeamIds();
      addSelect.value = '';
      addSelect.innerHTML = '';
      directory.filter((u) => !on.has(u.id)).sort((a, b) => a.name.localeCompare(b.name)).forEach((u) => {
        const it = document.createElement('cds-combo-box-item');
        it.setAttribute('value', u.id);
        it.textContent = `${u.name} — ${u.role}`;
        addSelect.appendChild(it);
      });
    };

    const findGroup = (unit: string) =>
      Array.from(groupsWrap.querySelectorAll<HTMLElement>('[data-team-group]')).find((s) => s.dataset.teamGroup === unit) ?? null;

    // Find (or create, appended after existing groups) the contained-list for a unit.
    const listForUnit = (unit: string, label: string) => {
      let sec = findGroup(unit);
      if (!sec) {
        sec = groupTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        sec.dataset.teamGroup = unit;
        sec.querySelector('cds-contained-list')?.setAttribute('label', label);
        groupsWrap.appendChild(sec);
      }
      return sec.querySelector('cds-contained-list') as HTMLElement;
    };

    const removeMember = (id: string, row: HTMLElement) => {
      const sec = row.closest<HTMLElement>('[data-team-group]');
      row.remove();
      // Drop a group section once its last member is gone (re-adding recreates it).
      if (sec && !sec.querySelector('[data-user-id]')) sec.remove();
      if (seedIds.has(id)) { if (!edits.removed.includes(id)) edits.removed.push(id); }
      else { edits.added = edits.added.filter((u) => u.id !== id); }
      save(edits);
      refreshCombo();
    };
    const wireRemove = (row: HTMLElement) => {
      const btn = row.querySelector('[data-remove-member]') as HTMLElement | null;
      if (!btn) return;
      if (!canEdit) { btn.style.display = 'none'; return; }
      btn.addEventListener('click', () => removeMember(row.dataset.userId!, row));
    };

    // JS-added members are new to the review: Not started, added today.
    const buildRow = (u: DirUser): HTMLElement => {
      const li = rowTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.dataset.userId = u.id;
      li.dataset.email = u.email || '';
      const set = (sel: string, text: string) => { const el = li.querySelector(sel); if (el) el.textContent = text; };
      set('.member__avatar', initials(u.name));
      set('.member__name', u.name);
      set('.member__role', u.detail ? `${u.role} · ${u.detail}` : u.role);
      // Added members are Not started, added today (the icon-indicator's label IS
      // the visible status line — don't add a second copy).
      li.querySelector('.member__status cds-icon-indicator')?.setAttribute('label', `Added ${todayLabel()}`);
      const emailWrap = li.querySelector('.member__email') as HTMLElement | null;
      if (u.email && emailWrap) {
        emailWrap.hidden = false;
        li.querySelector('.member__emaillink')?.setAttribute('href', `mailto:${u.email}`);
        set('.member__emailtext', u.email);
        li.querySelector('.member__copy')?.setAttribute('data-copy-email', u.email);
      }
      const tip = li.querySelector('.member__remove [slot="tooltip-content"]');
      if (tip) tip.textContent = `Remove ${u.name}`;
      wireRemove(li);
      return li;
    };
    const placeRow = (u: DirUser) => {
      const unit = unitOfUser(u);
      listForUnit(unit, unit).appendChild(buildRow(u));
    };

    // Read-only roster (not RA/Admin, or review not active): no Add trigger.
    if (!canEdit && addOpen) (addOpen as HTMLElement).style.display = 'none';

    // Wire seed rows, then replay stored edits (drop removed, append added).
    allRows().forEach(wireRemove);
    edits.removed.forEach((id) => {
      const row = groupsWrap.querySelector<HTMLElement>(`[data-user-id="${id}"]`);
      const sec = row?.closest<HTMLElement>('[data-team-group]');
      row?.remove();
      if (sec && !sec.querySelector('[data-user-id]')) sec.remove();
    });
    edits.added.forEach((u) => placeRow(u));

    const addMember = () => {
      const id = addSelect?.value;
      const user = id && byId.get(id);
      if (!user || onTeamIds().has(id)) return;
      placeRow(user);
      if (edits.removed.includes(id)) edits.removed = edits.removed.filter((r) => r !== id);
      else if (!edits.added.some((u) => u.id === id)) edits.added.push(user);
      save(edits);
      refreshCombo();
    };

    addOpen?.addEventListener('click', () => { refreshCombo(); if (addModal) addModal.open = true; });
    addConfirm?.addEventListener('click', () => { addMember(); if (addModal) addModal.open = false; });
    emailAll?.addEventListener('click', () => {
      const emails = allRows().map((r) => r.dataset.email).filter(Boolean);
      if (emails.length) window.location.href = `mailto:${emails.join(',')}`;
    });

    refreshCombo();
  }
</script>
