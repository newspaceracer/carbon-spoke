---
// The special-conditions editor's markup — Collapse/Expand all, the per-scope
// accordion host, and the add/edit dialog (catalog picks OR a written condition,
// one path at a time via a content switcher). Behavior: src/lib/conditions-editor.ts
// (mountConditionsEditor), wired by the host page with its data. Shared by the
// review wizard (final-letter.astro) and the application-review prototype.
//
// carbon-checked: every control is stock cds-* (accordion, icon-button, button,
// tag, modal, content-switcher, multi-select, checkbox) plus the spoke's own
// sc-rich-text editor for the condition body.
---

<div class="ce" data-conditions-editor>
  <div class="ce__tools" data-ce-tools>
    <cds-button kind="ghost" size="sm" data-ce-expand>Expand all</cds-button>
    <cds-button kind="ghost" size="sm" data-ce-collapse>Collapse all</cds-button>
  </div>
  <div class="ce__groups" data-ce-groups></div>

  <!-- Add / edit a special condition. The rich-text body IS the condition that
       prints. Moved to <body> at mount so no sticky host traps it. -->
  <cds-modal class="ce-modal" size="md" data-ce-modal>
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label data-ce-owner>Headquarters</cds-modal-label>
      <cds-modal-heading data-ce-heading>Add condition</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <cds-stack gap="6">
        <div class="ce-modal__mode" data-ce-mode-wrap>
          <p class="ce-modal__label t-label-01">Pull a saved condition, or write a new one.</p>
          <cds-content-switcher data-ce-mode value="catalog">
            <cds-content-switcher-item value="catalog" selected>From catalog</cds-content-switcher-item>
            <cds-content-switcher-item value="manual">Write manually</cds-content-switcher-item>
          </cds-content-switcher>
        </div>
        <div data-ce-catalog>
          <cds-multi-select data-ce-pick title-text="Saved conditions" label="Select saved conditions" filterable></cds-multi-select>
        </div>
        <div class="ce-modal__manual" data-ce-manual hidden>
          <div>
            <p class="ce-modal__label ce-modal__label--field t-label-01">Condition text</p>
            <sc-rich-text data-ce-body placeholder="The exact wording that will print on the permit. Use the toolbar for bold, italics, lists, or a link…"></sc-rich-text>
          </div>
          <cds-checkbox data-ce-save-catalog label-text="Also save to the catalog for reuse"></cds-checkbox>
        </div>
      </cds-stack>
    </cds-modal-body>
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" data-ce-save>Save condition</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>
</div>

<script>
  // The rich-text condition editor (<sc-rich-text>) used by the dialog.
  import './sc-rich-text.ts';
</script>

<style>
  /* Layout only — controls are cds-*, color from --cds-* tokens. The scope
     sections and condition cards are built at runtime, hence :global under .ce. */
  .ce__tools { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--cds-spacing-03, 0.5rem); margin: 0 0 var(--cds-spacing-05, 1rem); }
  .ce :global(.cond-list) { list-style: none; margin: 0 0 var(--cds-spacing-04, 0.75rem); padding: 0; display: grid; gap: var(--cds-spacing-03, 0.5rem); }
  /* A condition card takes the CURRENT layer (Carbon's layering model): white in
     the wizard's panel on the g10 field, gray inside the review page's white
     section (cds-layer level 1) — so no border is needed to separate it. */
  .ce :global(.cond) { display: block; padding: var(--cds-spacing-03, 0.5rem) var(--cds-spacing-04, 0.75rem); background: var(--cds-layer, #fff); }
  .ce :global(.cond--empty) { color: var(--cds-text-secondary, #525252); background: none; border: 0; padding: var(--cds-spacing-02, 0.25rem) 0; }
  .ce :global(.cond__bar) { display: flex; align-items: center; gap: var(--cds-spacing-03, 0.5rem); margin: 0 0 var(--cds-spacing-02, 0.25rem); }
  .ce :global(.cond__num) { display: inline-grid; place-items: center; min-inline-size: 1.25rem; block-size: 1.25rem; padding: 0 0.25rem; border-radius: 0.25rem; background: var(--cds-layer-accent-01, #e0e0e0); color: var(--cds-text-primary, #161616); font-weight: 600; }
  .ce :global(.cond__text) { margin: 0; color: var(--cds-text-primary, #161616); }
  .ce :global(.cond__actions) { display: flex; margin-inline-start: auto; }
  /* Scope header: name + count tag inline, filling the toggle's width. */
  .ce :global(.cond-acc__title) { display: flex; align-items: center; gap: var(--cds-spacing-03, 0.5rem); inline-size: 100%; }
  .ce :global(.cond-acc__name) { margin: 0 auto 0 0; }
  /* Carbon's wide prose right-padding insets the cards — match the left gutter
     (::part(content) is Carbon's sanctioned hook). */
  .ce :global(cds-accordion-item::part(content)) { padding-inline-end: var(--cds-spacing-05, 1rem); }

  /* Dialog — catalog / manual, one path at a time. cds-* set :host display, so a
     [hidden] must force display:none. */
  .ce-modal__label { margin: 0; color: var(--cds-text-secondary, #525252); }
  .ce-modal__label--field { margin-bottom: var(--cds-spacing-03, 0.5rem); }
  .ce-modal__mode { display: flex; flex-direction: column; gap: var(--cds-spacing-03, 0.5rem); }
  .ce-modal__manual { display: flex; flex-direction: column; gap: var(--cds-spacing-06, 1.25rem); }
  [data-ce-mode-wrap][hidden], [data-ce-catalog][hidden], [data-ce-manual][hidden], [data-ce-save-catalog][hidden] { display: none; }
</style>
