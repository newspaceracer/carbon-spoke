---
// Permit detail header — editorial layout on the page background (no tiles):
// number eyebrow, name, status indicator, action buttons, badge rows, then an
// at-a-glance strip of labeled facts (plain data, not boxed content pieces).
import type { Badge } from '../data/permit';
import FlagTag from './FlagTag.astro';
import type { DirectoryUser } from '../data/user';
import { withBase } from '../lib/base';
import Avatar from './Avatar.astro';
import PermitHeaderActions from './PermitHeaderActions.astro';
import { roleLine, teamUnitOf } from '../lib/analysis-team';
import { MAX_FILE_SIZE } from '../lib/file-upload';

interface Stat {
  label: string;
  value: string;
}

/** One reviewer on the analysis team. `reviewStatus` tracks them through their
 *  own review workflow — 'not-started' (assigned, not opened), 'pending' (started,
 *  in progress), 'complete' (finished). The Lead analyst is the exception: their
 *  status is DERIVED from the permit (Complete only once it's Out for signature),
 *  not this field. `when` is the date that state was reached. */
type ReviewStatus = 'not-started' | 'pending' | 'complete';
interface TeamMember {
  id: string;
  role: string;
  name: string;
  detail: string;
  reviewStatus: ReviewStatus;
  when?: string;
  highlight?: boolean;
}

interface Props {
  id: string;
  name: string;
  organization: string;
  status: { label: string; kind: string };
  infoTags: Badge[];
  flagTags: Badge[];
  stats: Stat[];
  /** Dates the applicant requested — shown as a reminder in the approve modal
   *  and used to prefill its confirmation date-range picker (ISO pair). */
  requestedWindow: { start: string; end: string; startISO: string; endISO: string };
  /** OPTIONAL. When present, the header gains a clickable "Analysis review"
   *  key-metric (how many reviewers are done) that opens a modal listing the
   *  team, their completion, and a control to add reviewers. Passed by the
   *  finalize (under-review) view; omitted on the read-only detail page, which
   *  carries its own roster in the Overview tab. */
  analysisTeam?: TeamMember[];
  /** The user directory the add-reviewer control draws from (required when
   *  analysisTeam is passed). */
  directory?: DirectoryUser[];
  /** Where this header is mounted. On the detail page ("detail") the started-phase
   *  action is "Open review" — it enters the finalize wizard. On the wizard itself
   *  ("finalize") the reviewer is already inside, so the primary reads "Approve
   *  permit" and jumps to the wizard's Review & send step; the menu keeps only the
   *  decision actions (Request changes / Reject permit). Defaults to the detail
   *  behavior. */
  context?: 'detail' | 'finalize';
  /** The permit's district span, 'single' | 'multi'. Surfaced on the banner as
   *  `data-permit-type` so the dev permit-role control can constrain its options
   *  to what the active identity is eligible for on this type (Story 2). Derived
   *  from the parks' district span today; a stored field in Story 8. */
  permitType?: 'single' | 'multi';
}

const {
  id, name, organization, status, infoTags, flagTags, stats, requestedWindow,
  analysisTeam, directory = [], context = 'detail', permitType,
} = Astro.props;

// The started-phase primary differs by mount: enter the wizard vs. approve from
// inside it. Kept here so the full header and the compact bar stay in lockstep.
const finalize = context === 'finalize';
const reviewLabel = finalize ? 'Approve permit' : 'Open review';

// An amendment reuses the whole application flow, prefilled from this permit and
// numbered with an "-A" suffix — offered only once the permit is Active.
const amendHref = withBase(`/apply?amend=${id}`);
const reviseHref = withBase(`/apply?revise=${id}`);

// ── Analysis-review metric (only when analysisTeam is supplied) ──
// The three reviewer states, each with its icon-indicator kind + label + the verb
// that prefixes the date line ("Completed Jul 5", "Started …", "Added …"). Status
// is meaning, not colour alone — the indicator renders its own text label.
const STATE_META: Record<ReviewStatus, { kind: string; label: string; verb: string }> = {
  'not-started': { kind: 'not-started', label: 'Not started', verb: 'Added' },
  'pending':     { kind: 'in-progress', label: 'In progress', verb: 'Last opened' },
  'complete':    { kind: 'succeeded',   label: 'Complete',    verb: 'Completed' },
};
const isLead = (m: TeamMember) => m.highlight === true || m.role === 'Responsible analyst';
// The Lead analyst reads Complete only once the permit has left review (Out for
// signature and beyond) — their sign-off IS the end of the analysis. Before that
// they're actively reviewing (Pending). Everyone else carries their own status.
const leadComplete = ['Out for signature', 'Waiting for annual report', 'Active'].includes(status.label);
const memberStatus = (m: TeamMember): ReviewStatus =>
  isLead(m) ? (leadComplete ? 'complete' : 'pending') : m.reviewStatus;
// The date/time line under the status. The lead's is phrased as a sign-off, not a
// generic verb; everyone else gets "<verb> <date>".
const reviewWhen = (m: TeamMember): string => {
  if (isLead(m)) return leadComplete ? 'Signed off' : '';
  const st = memberStatus(m);
  return m.when ? `${STATE_META[st].verb} ${m.when}` : STATE_META[st].label;
};
// The progress bar measures REVIEW UNITS, not people: each involved district is
// one unit, and every HQ reviewer collapses into a single "Headquarters" unit. A
// unit is complete once AT LEAST ONE of its members is Complete. The lead analyst
// (the responsible analyst) is excluded — their sign-off doesn't move this bar.
const unitOf = (m: TeamMember): string | null => {
  if (isLead(m)) return null;                     // excluded from the bar
  return teamUnitOf(m.detail);                    // its district, else Headquarters
};
const unitDone = new Map<string, boolean>();
(analysisTeam ?? []).forEach((m) => {
  const u = unitOf(m);
  if (!u) return;
  unitDone.set(u, (unitDone.get(u) ?? false) || memberStatus(m) === 'complete');
});
const reviewTotal = unitDone.size;
const reviewDone = [...unitDone.values()].filter(Boolean).length;
const reviewAllDone = reviewTotal > 0 && reviewDone === reviewTotal;
// Shared with the detail page's roster (removed/added edits).
const teamStorageKey = `permit-team-${id}`;

// Collapse toggle for a review unit. The tooltip names the action; JS keeps it in
// step with the unit's state ("Hide analysts" / "Show analysts").
const toggleIcon =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5L13 10 12.3 10.7 8 6.4 3.7 10.7 3 10z"/></svg><span slot="tooltip-content">Hide analysts</span>';
const copyIcon =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>';

// The roster is GROUPED to match the bar: the lead analyst sits on their own, then
// one section per review unit (Headquarters first, then each district in the order
// it first appears). A unit section shows a Reviewed/Pending status = its bar state
// (done once ≥1 member has finished).
const leadMembers = (analysisTeam ?? []).filter(isLead);
const unitMembers = new Map<string, TeamMember[]>();
const unitOrder: string[] = [];
(analysisTeam ?? []).forEach((m) => {
  const u = unitOf(m);
  if (!u) return;
  if (!unitMembers.has(u)) { unitMembers.set(u, []); unitOrder.push(u); }
  unitMembers.get(u)!.push(m);
});
const orderedUnits = [
  ...unitOrder.filter((u) => u === 'Headquarters'),
  ...unitOrder.filter((u) => u !== 'Headquarters'),
];
const rosterSections = [
  ...(leadMembers.length ? [{ key: '__lead', label: 'Responsible analyst', members: leadMembers, counts: false }] : []),
  ...orderedUnits.map((u) => ({ key: u, label: u, members: unitMembers.get(u)!, counts: true })),
];
---

<header class="banner cds--g100" id="permit-banner" data-permit-id={id} data-permit-name={name} data-status={status.label} data-letter-url={withBase('/final-letter')} data-context={context} data-permit-type={permitType}>
  <div class="banner__inner">
  <div class="banner__crumb"><slot name="breadcrumb" /></div>
  <div class="banner__main">
    <div class="banner__lead">
      <p class="banner__eyebrow t-heading-compact-01">{organization}</p>
      <h1 class="banner__title t-heading-05">{name}</h1>
      <div class="banner__id-row">
        <span class="banner__number t-heading-03">{id}</span>
        <cds-icon-indicator class="permit-status-indicator" size="20" kind={status.kind} label={status.label}></cds-icon-indicator>
      </div>
      <div class="banner__tags">
        {infoTags.map((tag) => <cds-tag type={tag.type} size="lg" title={tag.label}>{tag.label}</cds-tag>)}
        {flagTags.map((tag) => <FlagTag tag={tag} size="lg" />)}
      </div>
    </div>

    <!-- One action button per viewer: status × permit-role / owner (Story 2).
         The script shows the matching [data-action]; see PermitHeaderActions. -->
    <div class="banner__actions">
      <PermitHeaderActions reviewLabel={reviewLabel} amendHref={amendHref} reviseHref={reviseHref} />
    </div>
  </div>

  <div class="banner__facts">
    <dl class="banner__stats">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat__label t-label-01">{s.label}</dt>
          <dd class="stat__value t-body-01">{s.value}</dd>
        </div>
      ))}
    </dl>

    {analysisTeam && (
      <!-- Key metric: at-a-glance analysis-review completion. The whole tile is a
           button that opens the roster modal (Carbon ships no clickable-metric →
           dialog control; a clickable-tile is a navigation link, not a dialog
           trigger). carbon-checked: dialog-opening metric tile. -->
      <button type="button" class="analysis-metric" id="analysis-metric" aria-haspopup="dialog">
        <cds-progress-bar
          id="analysis-metric-bar"
          class="analysis-metric__bar"
          label="Analysis team"
          helper-text={`${reviewDone} of ${reviewTotal} reviews complete`}
          value={reviewDone}
          max={reviewTotal}
          size="small"
          status={reviewAllDone ? 'finished' : 'active'}
        ></cds-progress-bar>
        <span class="analysis-metric__cta t-label-01">
          <span id="analysis-metric-cta-text">View team</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M11 8L6 3 5.3 3.7 9.6 8l-4.3 4.3L6 13z"/></svg>
        </span>
      </button>
    )}
  </div>
  </div>
</header>

<!-- Compact bar — a SEPARATE, position:fixed bar (constant height, out of normal
     flow) that fades in once the full header above has scrolled away. Because it
     never enters document flow, showing/hiding it can't change the page height,
     so it can't trigger the scroll-anchoring feedback that makes a *resizing*
     sticky header oscillate. Shows number + requested window + the action. -->
<div class="compactbar cds--g100" id="permit-compactbar" aria-hidden="true">
  <div class="compactbar__inner">
    <span class="compactbar__number t-heading-03">{id}</span>
    <cds-icon-indicator class="permit-status-indicator" size="16" kind={status.kind} label={status.label}></cds-icon-indicator>
    <span class="compactbar__window t-body-01">{requestedWindow.start} – {requestedWindow.end}</span>
    <div class="compactbar__spacer"></div>
    <PermitHeaderActions reviewLabel={reviewLabel} amendHref={amendHref} reviseHref={reviseHref} />
  </div>
</div>

<!-- Confirmation dialogs for the workflow decisions. Overlays live outside normal
     flow; Carbon owns the focus trap + return and the accessible heading. Approval
     is no longer a header modal — it's the review wizard's Send step, reached via
     Open review, where the reviewer confirms the window and conditions first. -->
<!-- Activation (no in-system signing): the Responsible analyst downloads the
     generated letter, has it signed outside the system, and uploads the signed
     copy here. The upload is what activates the permit — the system records only
     the file, who uploaded it, and when. -->
<cds-modal id="sign-permit-modal" size="sm">
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-label>Permit {id}</cds-modal-label>
    <cds-modal-heading id="sign-heading">Upload signed letter</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <!-- A renewal whose previous permit's annual report is missing: say so FIRST,
         before the uploader — it decides which button to press. A Callout, not an
         inline notification: it's standing context in the dialog, not a response to
         something the user did. Callouts are info/warning only, so overdue stays a
         warning and says "overdue" in the title. Filled by the script. -->
    <cds-callout-notification id="sign-prior-report" class="signed-upload__notice" kind="warning" low-contrast style="display:none">
      <!-- The details on their own line under the title (the subtitle runs inline). -->
      <p class="t-body-compact-01" id="sign-prior-details"></p>
    </cds-callout-notification>
    <p class="t-body-01 signed-upload__lead" id="sign-lead">
      Uploading it activates the permit.
    </p>
    <!-- The modal heading names the upload, so the uploader carries no title. The
         button slots into cds-file-uploader (as a direct child of cds-modal-body
         it would never render). -->
    <cds-file-uploader label-description={`Accepted file type: PDF. Maximum file size: ${MAX_FILE_SIZE}.`}>
      <cds-file-uploader-button button-kind="tertiary" size="md" id="signed-letter-drop" accept=".pdf">Add file</cds-file-uploader-button>
      <div id="signed-letter-chosen"></div>
    </cds-file-uploader>
  </cds-modal-body>
  <!-- A renewal whose previous permit's annual report is missing gets a third
       button, "Upload and activate" (the RA's override), before the primary, which
       then reads "Upload and hold". The script adds/removes it rather than hiding
       it: cds-modal-footer counts its slotted buttons for the three-button layout. -->
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="primary" id="sign-confirm" disabled>Upload and activate</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

<cds-modal id="request-changes-modal" size="md">
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-label>Permit {id}</cds-modal-label>
    <cds-modal-heading>Request changes</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <!-- The issues reviewers marked on the record (shared store, lib/review-thread),
         grouped by section, then an optional message. Returning sends them all; the
         researcher sees each one on the page of their application it's about. -->
    <p class="t-body-01 rc-lede">The researcher is emailed these issues and sees each one on the page of their application it's about. They can resubmit once they're addressed.</p>
    <div id="request-issues"></div>
    <cds-inline-notification
      id="request-none"
      kind="info"
      low-contrast
      hide-close-button
      title="No issues marked"
      subtitle="Mark issues on the application record, or add a message so the researcher knows what to change."
    ></cds-inline-notification>
    <cds-textarea id="request-message" label="Message to the researcher (optional)" rows="3" invalid-text="Add a message, or mark at least one issue."></cds-textarea>
  </cds-modal-body>
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="primary" id="request-confirm">Return application</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

<cds-modal id="reject-permit-modal" size="sm" alert>
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-label>Permit {id}</cds-modal-label>
    <cds-modal-heading>Reject this permit?</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <p class="t-body-01">
      Rejecting closes this application. The applicant will be notified and must
      submit a new application to reapply. This can’t be undone.
    </p>
  </cds-modal-body>
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="danger" id="reject-confirm" data-modal-close>Reject permit</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

<!-- "Activate permit" on a renewal held for its previous permit's annual report
     (CSPS-406). The warning shows only while that report is missing — the
     callout sits first, as in the signed-letter dialog. Filled by the script. -->
<cds-modal id="activate-permit-modal" size="sm">
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-heading>Activate permit {id}?</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <cds-callout-notification id="activate-prior-report" class="signed-upload__notice" kind="warning" low-contrast style="display:none">
      <p class="t-body-compact-01">Activate this permit only if you're making an exception.</p>
    </cds-callout-notification>
    <p class="t-body-01">
      The permit becomes active and the researcher, PI, and PICOF get an email.
    </p>
  </cds-modal-body>
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="primary" id="activate-confirm">Activate permit</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

{analysisTeam && (
  <!-- Analysis team — a VIEW of the team and its review progress. The team is
       managed in ONE place (the Internal review rail, AnalysisTeam.astro); this
       modal only reads it, so its actions are Email all and, for whoever may edit
       the team, Manage team (which takes them to that rail). -->
  <cds-modal id="analysis-team-modal" size="md" has-scrolling-content>
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label>Permit {id}</cds-modal-label>
      <cds-modal-heading>Analysis team</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <cds-stack gap="7">
        <cds-progress-bar
          id="analysis-modal-bar"
          label="Reviews complete"
          helper-text={`${reviewDone} of ${reviewTotal} reviews complete`}
          value={reviewDone}
          max={reviewTotal}
          status={reviewAllDone ? 'finished' : 'active'}
        ></cds-progress-bar>

        <!-- Grouped by review unit to match the bar: the Responsible analyst, then
             Headquarters, then each district. A unit counts as complete once ≥1 of
             its members is. Status is icon + text (not colour alone). -->
        <div class="review-roster" id="review-roster" data-team-key={teamStorageKey}>
          {rosterSections.map((sec) => {
            const sts = sec.members.map(memberStatus);
            const secKind = !sec.counts ? '' : sts.includes('complete') ? 'succeeded' : sts.includes('pending') ? 'in-progress' : 'not-started';
            const secLabel = !sec.counts ? '' : sts.includes('complete') ? 'Complete' : sts.includes('pending') ? 'In progress' : 'Not started';
            return (
            <section class="unit-group" data-unit-group={sec.counts ? sec.key : ''}>
              <div class="unit-group__head">
                <h4 class="unit-group__title t-heading-compact-01">{sec.label}</h4>
                {sec.counts && (
                  <cds-icon-indicator class="unit-group__ind" size="16" kind={secKind} label={secLabel}></cds-icon-indicator>
                )}
                {sec.counts && <span class="unit-group__by t-label-01"></span>}
                {sec.counts && <cds-icon-button class="unit-group__toggle" kind="ghost" size="sm" align="left" data-unit-toggle set:html={toggleIcon}></cds-icon-button>}
              </div>
              <ul class="unit-members">
                {sec.members.map((m) => {
                  const st = memberStatus(m);
                  const email = directory.find((u) => u.id === m.id)?.email ?? '';
                  return (
                  <li class="review-row" data-user-id={m.id} data-status={st} data-unit={unitOf(m) ?? ''} data-email={email} data-lead={isLead(m) ? 'true' : 'false'}>
                    <Avatar name={m.name} size="md" />
                    <div class="review-row__id">
                      <p class="review-row__name t-body-01">{m.name}</p>
                      <p class="review-row__role t-label-01">{roleLine(m.role, m.detail, sec.label)}</p>
                      {email && (
                        <p class="review-row__email t-label-01">
                          <span class="review-row__email-addr">{email}</span>
                          <cds-icon-button class="review-row__copy" kind="ghost" size="sm" align="bottom" data-copy-email={email} set:html={`${copyIcon}<span slot="tooltip-content">Copy email</span>`}></cds-icon-button>
                        </p>
                      )}
                    </div>
                    <div class="review-row__status">
                      <cds-icon-indicator class="review-row__ind" size="16" kind={STATE_META[st].kind} label={STATE_META[st].label}></cds-icon-indicator>
                      <span class="review-row__when t-label-01">{reviewWhen(m)}</span>
                      <span class="review-row__note t-label-01">Not required</span>
                    </div>
                  </li>
                  );
                })}
              </ul>
            </section>
            );
          })}
        </div>

      </cds-stack>
    </cds-modal-body>
    <!-- Manage team shows only for whoever may edit the team (JS); otherwise the
         primary is Done. Toggled by inline display (cds-* ignore [hidden]). -->
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" id="email-all-team">Email all</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="team-manage-btn" style="display:none">Manage team</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="team-done-btn" data-modal-close>Done</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>

  <!-- Row + unit templates — for analysts added on the Internal review rail, replayed
       from the shared permit-team storage each time the modal opens. -->
  <template id="review-row-template">
    <li class="review-row" data-status="not-started" data-lead="false">
      <span class="avatar avatar--md" aria-hidden="true"></span>
      <div class="review-row__id">
        <p class="review-row__name t-body-01"></p>
        <p class="review-row__role t-label-01"></p>
        <p class="review-row__email t-label-01">
          <span class="review-row__email-addr"></span>
          <cds-icon-button class="review-row__copy" kind="ghost" size="sm" align="bottom" data-copy-email="" set:html={`${copyIcon}<span slot="tooltip-content">Copy email</span>`}></cds-icon-button>
        </p>
      </div>
      <div class="review-row__status">
        <cds-icon-indicator class="review-row__ind" size="16" kind="not-started" label="Not started"></cds-icon-indicator>
        <span class="review-row__when t-label-01"></span>
        <span class="review-row__note t-label-01">Not required</span>
      </div>
    </li>
  </template>
  <template id="unit-group-template">
    <section class="unit-group" data-unit-group="">
      <div class="unit-group__head">
        <h4 class="unit-group__title t-heading-compact-01"></h4>
        <cds-icon-indicator class="unit-group__ind" size="16" kind="not-started" label="Not started"></cds-icon-indicator>
        <span class="unit-group__by t-label-01"></span>
        <cds-icon-button class="unit-group__toggle" kind="ghost" size="sm" align="left" data-unit-toggle set:html={toggleIcon}></cds-icon-button>
      </div>
      <ul class="unit-members"></ul>
    </section>
  </template>
)}

<script>
  import { readIdentity } from '../lib/maintenance';
  import { readPermitRole } from '../lib/permissions';
  import { reviewStore, returnToResearcher, RECORD_SECTIONS } from '../lib/review-thread';
  import { activeUser } from '../data/user';
  import '../styles/review-notes.css';
  import { sendEmail } from '../lib/notifications';
  import { showToast } from '../lib/toast';
  import { withBase } from '../lib/base';
  import { reportState, priorReport, renewalHoldKey, REPORT_EVENT } from '../lib/final-report';
  import { downloadSignedLetter, downloadUnsignedLetter } from '../lib/letter-download';
  import { wireUpload } from '../lib/file-upload';
  import { actorEmail, isReviewComplete, markReviewComplete, notifyResponsibleAgent, reopenReview, REVIEW_COMPLETE_EVENT } from '../lib/review-complete';
  // ── Workflow state machine (prototype-local) ──
  // The permit moves through a small set of statuses; each has a cds-icon-indicator
  // `kind` (kept in sync with data/permits.ts) and its own action set. The current
  // status persists to `permit-status-${id}` so it survives a reload, and every
  // transition broadcasts `permit-status-changed` so other surfaces on the page —
  // notably the Special conditions tab, which freezes once the permit leaves review
  // — react without a reload.
  //   Under review ─[Start review]▶ (started) ─Open review▶ wizard ─Send▶ Out for signature ─sign▶ Active
  //                └─request changes─▶ Changes requested
  //                └─reject──────────▶ Rejected
  // "Start review" is a phase within Under review, not a status: it sets the
  // permit-review-started-${id} flag (who + when), which gates the detail body
  // and the wizard. The status stays "Under review" throughout.
  const banner = document.getElementById('permit-banner');
  const permitId = banner?.dataset.permitId ?? '';
  const seededStatus = banner?.dataset.status ?? 'Under review';
  const statusKey = `permit-status-${permitId}`;
  const letterUrl = banner?.dataset.letterUrl;
  const inFinalize = banner?.dataset.context === 'finalize';

  // Decision actions are permit-role gated (Story 9.3): Approve / Request changes /
  // Reject and the review-decision entry are RA-or-Admin only; so are Start review
  // (Story 5 refines) and the signed-letter upload that activates the permit.
  const gateIdentity = readIdentity();
  const gatePermitType = banner?.dataset.permitType;
  const startAllowed = gateIdentity === 'admin' || readPermitRole(permitId) === 'responsible';
  const STAFF = ['admin', 'hq-technical', 'district-lead', 'district-assistant'];

  const STATUS_KIND: Record<string, string> = {
    'Waiting for review': 'not-started',
    'Under review': 'in-progress',
    'Out for signature': 'pending',
    'Waiting for annual report': 'caution-minor',
    'Active': 'succeeded',
    'Changes requested': 'caution-minor',
    'Rejected': 'failed',
    'Expired': 'unknown',
  };

  const currentStatus = () =>
    (permitId && localStorage.getItem(statusKey)) || seededStatus;

  // "Under review" has two phases — before and after a reviewer starts. The flag
  // records who's reviewing + when; its presence is the whole gate.
  const reviewStartedKey = `permit-review-started-${permitId}`;

  // Reflect a status across every surface: the two status indicators and the
  // one action button for this viewer (both mounts).
  // ── Who's looking (Story 2) ──
  // RA / System Admin move the permit forward; a Supporting analyst reviews and marks
  // themselves done; other staff only download; the researcher owner revises or
  // uploads. The public view gets no action.
  type Viewer = 'ra' | 'sa' | 'staff' | 'owner' | 'public';
  const viewer = (): Viewer => {
    if (startAllowed) return 'ra';
    if (STAFF.includes(gateIdentity)) return readPermitRole(permitId) === 'supporting' ? 'sa' : 'staff';
    let owners: string[] = [];
    try { owners = JSON.parse(document.getElementById('permit-owners')?.textContent || '[]'); } catch {}
    const me = activeUser(gateIdentity);
    return gateIdentity === 'researcher' && !!me && owners.includes(me.name.toLowerCase()) ? 'owner' : 'public';
  };
  const reportOwed = (status: string) =>
    ['due', 'changes-requested', 'delinquent'].includes(reportState(status, permitId) ?? '');

  /** The one [data-action] to show for this status and viewer, or null. */
  const actionFor = (status: string): string | null => {
    const v = viewer();
    if (v === 'public') return null;
    switch (status) {
      case 'Waiting for review': return v === 'ra' ? 'start' : null;
      case 'Under review':
        if (v === 'ra') return 'review';
        // Inside the wizard the Supporting analyst has its own Complete review CTA.
        return v === 'sa' && !inFinalize ? 'supporting' : null;
      case 'Changes requested':
      case 'Returned to submitter': return v === 'owner' ? 'revise' : v === 'sa' ? 'sa-toggle' : null;
      case 'Out for signature': return v === 'ra' ? 'sign' : null;
      case 'Waiting for annual report': return v === 'ra' ? 'hold' : v === 'owner' ? 'owner-report' : 'download';
      case 'Active': return v === 'ra' || v === 'owner' ? 'active' : 'download';
      case 'Expired': return v === 'owner' && reportOwed(status) ? 'owner-report' : 'download';
      default: return null;
    }
  };

  const paintStatus = (status: string) => {
    const kind = STATUS_KIND[status] ?? 'unknown';
    document.querySelectorAll('.permit-status-indicator').forEach((el) => {
      el.setAttribute('kind', kind);
      el.setAttribute('label', status);
    });
    const action = actionFor(status);
    document.querySelectorAll<HTMLElement>('[data-action]').forEach((el) => {
      el.hidden = el.dataset.action !== action;
    });
    syncSupportingToggle();
  };

  const setStatus = (status: string) => {
    if (permitId) localStorage.setItem(statusKey, status);
    paintStatus(status);
    window.dispatchEvent(
      new CustomEvent('permit-status-changed', { detail: { status } }),
    );
  };

  // ── Simulated emails + signed-letter activation (Stories 6, 13) ─────────────
  const projectTitle = banner?.dataset.permitName ?? '';
  const emailVars = () => ({ 'Permit #': permitId, 'Project title': projectTitle, 'Status': currentStatus() });
  const signedKey = `permit-signed-letter-${permitId}`;
  const holdFlagKey = renewalHoldKey(permitId); // set = renewal w/ missing prior annual report
  const stamp = () => new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

  // The uploaded signed letter activates — unless a renewal's prior annual report
  // is missing, which holds it (Waiting for annual report) and notifies via EM-H
  // (Story 13). The RA can override at upload ("Upload and activate"), the same
  // override the hold's header action offers later. A static prototype stores the
  // file's name, not its bytes.
  const applySignedLetter = (fileName: string, override = false) => {
    const by = activeUser(gateIdentity)?.name ?? 'Responsible analyst';
    localStorage.setItem(signedKey, JSON.stringify({ name: fileName, by, at: stamp() }));
    if (override) localStorage.removeItem(holdFlagKey);
    if (localStorage.getItem(holdFlagKey) === '1') {
      setStatus('Waiting for annual report');
      sendEmail('EM-H', emailVars());
      showToast('Signed letter uploaded', "On hold until the previous permit's annual report is in.");
    } else {
      setStatus('Active');
      sendEmail('EM-C', emailVars());
      showToast('Permit activated', 'Emailed the researcher, PI, and PICOF.');
    }
  };

  // Admin only: replace the signed letter of record (or upload one that's missing)
  // after signature. Same modal, but the status doesn't change. The replaced file is
  // kept on the record (`previous`, oldest first) so the original upload — the
  // activation date — survives.
  const replaceSignedLetter = (fileName: string) => {
    const by = activeUser(gateIdentity)?.name ?? 'System admin';
    let prior: { name: string; by: string; at: string; previous?: { name: string; by: string; at: string }[] } | null = null;
    try { prior = JSON.parse(localStorage.getItem(signedKey) || 'null'); } catch {}
    const previous = prior ? [...(prior.previous ?? []), { name: prior.name, by: prior.by, at: prior.at }] : [];
    localStorage.setItem(signedKey, JSON.stringify({ name: fileName, by, at: stamp(), ...(previous.length ? { previous } : {}) }));
    window.dispatchEvent(new CustomEvent('signed-letter-changed'));
    showToast(prior ? 'Signed letter replaced' : 'Signed letter uploaded', "The permit's status didn't change.");
  };

  // Combo-button fires onClick for its primary button AND for menu-item picks;
  // route each to the matching confirmation modal. Both the full header and the
  // compact bar carry a `.permit-actions` combo-button, so wire them all.
  // (Cancel / X / confirm all close natively via [data-modal-close].)
  const rejectModal = document.getElementById('reject-permit-modal') as any;
  const requestModal = document.getElementById('request-changes-modal') as any;
  const signModal = document.getElementById('sign-permit-modal') as any;

  // Start review (Story 5) — the Waiting for review → Under review transition. Only
  // the Responsible analyst (or Admin) can start; records who + when in the flag, sets
  // the status, then drops the reviewer into the review wizard (final-letter).
  const startReview = () => {
    if (!permitId || !startAllowed) return;
    if (!localStorage.getItem(reviewStartedKey)) {
      const at = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      localStorage.setItem(reviewStartedKey, JSON.stringify({ by: 'You', at }));
    }
    // The transition: Waiting for review → Under review (persisted so the detail
    // body unseals and the started-phase actions show on return).
    if (permitId) localStorage.setItem(statusKey, 'Under review');
    // Starting drops the reviewer straight into the review wizard (final-letter);
    // the flag is now set, so the wizard's guard admits them. Coming back to the
    // permit later shows the unlocked detail with an "Open review" action.
    if (letterUrl) { window.location.href = letterUrl; return; }
    paintStatus(currentStatus()); // fallback only if the wizard URL is unwired
  };
  document.querySelectorAll('.permit-start-review').forEach((btn) => {
    btn.addEventListener('click', startReview);
  });

  // Started-phase primary + decision menu. On the detail page the primary "Open
  // review" enters the wizard (letterUrl); on the wizard itself ("Approve permit")
  // the reviewer is already here, so it fires a `permit:approve` event the wizard
  // catches to jump to its Review & send step. The menu is identical either way.
  // Request changes: list the draft issues (grouped by record section) so the
  // reviewer sees exactly what goes back; a message is optional with issues and
  // required without.
  function openRequestChanges() {
    const drafts = reviewStore(permitId).issues().filter((i) => !i.sentAt && !i.resolvedAt);
    const host = document.getElementById('request-issues');
    if (host) {
      host.replaceChildren();
      RECORD_SECTIONS.forEach((sec) => {
        const mine = drafts.filter((i) => i.section === sec.slug);
        if (!mine.length) return;
        const g = document.createElement('div'); g.className = 'rw-return-group';
        const h = document.createElement('h3'); h.className = 't-heading-compact-01'; h.textContent = sec.title;
        const ol = document.createElement('ol');
        mine.forEach((i) => {
          const li = document.createElement('li');
          if (i.quote) { const q = document.createElement('p'); q.className = 'rw-note__quote t-body-01'; q.textContent = i.quote; li.append(q); }
          const t = document.createElement('p'); t.className = 't-body-01'; t.textContent = i.text; li.append(t);
          ol.append(li);
        });
        g.append(h, ol);
        host.append(g);
      });
    }
    const none = document.getElementById('request-none') as HTMLElement | null;
    if (none) none.style.display = drafts.length ? 'none' : '';
    const msg = document.getElementById('request-message') as any;
    if (msg) {
      msg.value = '';
      msg.invalid = false;
      msg.label = drafts.length ? 'Message to the researcher (optional)' : 'Message to the researcher';
    }
    requestModal.open = true;
  }

  // cds-combo-button fires onClick for its primary button AND for menu-item picks;
  // `menuPick` tells them apart (null = the primary button).
  const menuPick = (e: Event) =>
    (e.target as HTMLElement).closest?.('cds-menu-item')?.getAttribute('label') ?? null;
  const onCombo = (sel: string, fn: (pick: string | null) => void) =>
    document.querySelectorAll(sel).forEach((combo) => { (combo as any).onClick = (e: Event) => fn(menuPick(e)); });

  const signedDownload = () => {
    if (!downloadSignedLetter(permitId)) showToast('No signed letter on file', '', 'warning');
  };
  const unsignedDownload = () => {
    if (!downloadUnsignedLetter(permitId)) showToast('No letter on file', '', 'warning');
  };
  const goTab = (tab: string) => {
    const tabs = document.getElementById('permit-tabs') as any;
    if (!tabs) { window.location.href = `${withBase('/permit')}?tab=${tab}`; return; }
    if (tabs.value !== tab) { tabs.value = tab; tabs.dispatchEvent(new CustomEvent('cds-tabs-selected')); }
    tabs.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  };

  // RA: Open review (or Approve permit inside the wizard) + decision menu.
  onCombo('.permit-open-review', (pick) => {
    if (pick === 'Reject permit') rejectModal.open = true;
    else if (pick === 'Request changes') openRequestChanges();
    else if (pick) return;
    else if (inFinalize) document.dispatchEvent(new CustomEvent('permit:approve'));
    else if (letterUrl) window.location.href = letterUrl;
  });

  // Supporting analyst: Review application enters the wizard; Complete review marks
  // them done on the analysis team (who + when), Reopen review undoes it. Under
  // review (menu item) and Returned to submitter (its own button), per CSPS-406.
  // A menu item's text is its `label`; a button's is its text.
  const me = actorEmail(gateIdentity);
  const supportingKey = `permit-supporting-review-${permitId}-${gateIdentity}`;
  function syncSupportingToggle() {
    const done = isReviewComplete(permitId, me);
    const label = done ? 'Reopen review' : 'Complete review';
    document.querySelectorAll<HTMLElement>('[data-sa-toggle]').forEach((it) => {
      if (it.tagName === 'CDS-MENU-ITEM') it.setAttribute('label', label);
      else it.textContent = label;
    });
  }
  const toggleSupportingReview = (pick: string) => {
    if (!me) return;
    if (pick === 'Complete review') {
      markReviewComplete(permitId, me);
      localStorage.setItem(supportingKey, 'complete');
      notifyResponsibleAgent(permitId, gateIdentity, 'completed');
      showToast('Review complete', 'Emailed the responsible analyst.');
    } else {
      reopenReview(permitId, me);
      localStorage.setItem(supportingKey, 'in-progress');
      notifyResponsibleAgent(permitId, gateIdentity, 'reopened');
      showToast('Review reopened', 'Emailed the responsible analyst.');
    }
    syncSupportingToggle();
  };
  onCombo('.permit-sa-review', (pick) => {
    if (!pick) { if (letterUrl) window.location.href = letterUrl; return; }
    toggleSupportingReview(pick);
  });
  document.querySelectorAll<HTMLElement>('.permit-sa-toggle').forEach((btn) =>
    btn.addEventListener('click', () => toggleSupportingReview(btn.textContent?.trim() ?? '')));

  // RA: Upload signed letter (activates) + the unsigned letter to get signed.
  onCombo('.permit-action-sign', (pick) => { if (pick) unsignedDownload(); else signModal.open = true; });

  // RA: "Activate permit" overrides the annual-report hold (Story 13), after a
  // confirmation (CSPS-406) that warns while the previous report is missing.
  // Confirming clears the hold flag and sends the issued email.
  const activateModal = document.getElementById('activate-permit-modal') as any;
  onCombo('.permit-hold-override', (pick) => {
    if (pick) { signedDownload(); return; }
    const prior = priorReport(permitId);
    const notice = document.getElementById('activate-prior-report') as any;
    notice.style.display = prior ? '' : 'none';
    if (prior) notice.setAttribute('title', `No annual report for permit ${prior.permitId}`);
    activateModal.open = true;
  });
  document.getElementById('activate-confirm')?.addEventListener('click', () => {
    activateModal.open = false;
    localStorage.removeItem(holdFlagKey);
    setStatus('Active');
    sendEmail('EM-C', emailVars());
    showToast('Permit activated', 'Emailed the researcher, PI, and PICOF.');
  });

  // Active (RA / Admin / owner): Download signed letter + Request amendment. The
  // amendment opens the prefilled application; record that it exists first so the
  // permit can link back to it.
  onCombo('.permit-active', (pick) => {
    if (!pick) { signedDownload(); return; }
    if (permitId) localStorage.setItem(`permit-amendment-${permitId}`, `${permitId}-A`);
    const href = document.querySelector<HTMLElement>('.permit-active')?.dataset.amendHref;
    if (href) window.location.href = href;
  });

  // Owner: Upload annual report. Expired → this permit's Annual report tab; on a
  // renewal hold the report is owed on the PREVIOUS permit → My permits.
  onCombo('.permit-owner-report', (pick) => {
    if (pick) { signedDownload(); return; }
    if (currentStatus() === 'Expired') goTab('report');
    else window.location.href = withBase('/my-permits');
  });

  document.querySelectorAll('.permit-download-signed').forEach((btn) => btn.addEventListener('click', signedDownload));
  window.addEventListener(REVIEW_COMPLETE_EVENT, syncSupportingToggle);
  window.addEventListener(REPORT_EVENT, () => paintStatus(currentStatus()));

  // Sign = the SECOND signature → activation (or hold). Decisions notify the
  // researcher (regulated EM-D / EM-E).
  // Signed-letter upload: one PDF; confirm stays disabled until a file is chosen.
  // Two modes: 'activate' (the RA's upload at Out for signature) and 'replace'
  // (admin, after signature — opened via the `signed-letter-open` event).
  let signMode: 'activate' | 'replace' = 'activate';
  const overrideButton = document.createElement('cds-modal-footer-button') as any;
  overrideButton.setAttribute('kind', 'secondary');
  overrideButton.disabled = true;
  overrideButton.textContent = 'Upload and activate';
  const setSignMode = (mode: 'activate' | 'replace', current?: string) => {
    signMode = mode;
    const heading = document.getElementById('sign-heading');
    const lead = document.getElementById('sign-lead');
    const confirm = document.getElementById('sign-confirm');
    if (heading) heading.textContent = mode === 'replace' && current ? 'Replace signed letter' : 'Upload signed letter';
    // A held renewal: hold is the rule (primary); activating is the RA's
    // override (the third button). Three buttons need the md width.
    const prior = mode === 'activate' ? priorReport(permitId) : null;
    const held = !!prior;
    if (held && !overrideButton.isConnected) confirm?.before(overrideButton);
    if (!held) overrideButton.remove();
    signModal?.setAttribute('size', held ? 'md' : 'sm');
    const notice = document.getElementById('sign-prior-report') as any;
    if (notice) {
      notice.style.display = prior ? '' : 'none';
      if (prior) {
        notice.setAttribute('title', prior.overdue ? "Previous permit's annual report is overdue" : "Previous permit's annual report is missing");
        const details = document.getElementById('sign-prior-details');
        if (details) details.textContent = `Permit ${prior.permitId} · ${prior.overdue ? 'was due' : 'due'} ${prior.due}`;
      }
    }
    // Held: the notification + the buttons say it all — no lead.
    if (lead) lead.style.display = held ? 'none' : '';
    if (lead) lead.textContent = mode === 'activate'
      ? 'Uploading it activates the permit.'
      : current ? `Replaces ${current}. The permit's status doesn't change.` : "The permit's status doesn't change.";
    if (confirm) confirm.textContent = mode === 'activate' ? held ? 'Upload and hold' : 'Upload and activate' : current ? 'Replace letter' : 'Upload';
  };
  // The hold flag can change after load (demo state switcher) — settle on open.
  // cds-modal fires no "opening" event, so watch its reflected `open` attribute.
  if (signModal) new MutationObserver(() => {
    if (signModal.hasAttribute('open') && signMode === 'activate') setSignMode('activate');
  }).observe(signModal, { attributes: true, attributeFilter: ['open'] });
  window.addEventListener('signed-letter-open', (e) => {
    setSignMode('replace', (e as CustomEvent).detail?.current);
    signModal.open = true;
  });
  // Every other opener (header, alerts) expects the activating upload.
  signModal?.addEventListener('cds-modal-closed', () => setSignMode('activate'));
  {
    const confirm = document.getElementById('sign-confirm') as any;
    let chosen: string | null = null;
    // A wrong-type or too-large file shows as an error item; it doesn't turn the
    // upload buttons on (lib/file-upload).
    const upload = wireUpload(document.getElementById('signed-letter-drop')!, {
      list: document.getElementById('signed-letter-chosen')!,
      single: true,
      onChange: (names) => {
        chosen = names[0] ?? null;
        if (confirm) confirm.disabled = !chosen;
        overrideButton.disabled = !chosen;
      },
    });
    const submit = (override: boolean) => {
      if (!chosen) return;
      if (signMode === 'replace') replaceSignedLetter(chosen); else applySignedLetter(chosen, override);
      signModal.open = false;
      upload.clear();
      setSignMode('activate'); // closing in code fires no cds-modal-closed
    };
    confirm?.addEventListener('click', () => submit(false));
    overrideButton.addEventListener('click', () => submit(true));
  }
  document.getElementById('request-confirm')?.addEventListener('click', () => {
    const drafts = reviewStore(permitId).issues().filter((i) => !i.sentAt && !i.resolvedAt);
    const msg = document.getElementById('request-message') as any;
    const message = (msg?.value ?? '').trim();
    if (!drafts.length && !message) { if (msg) { msg.invalid = true; msg.focus?.(); } return; }
    returnToResearcher(permitId, activeUser(gateIdentity)?.name || 'Responsible analyst', message);
    requestModal.open = false;
    paintStatus(currentStatus());
    sendEmail('EM-D', emailVars());
  });
  document.getElementById('reject-confirm')?.addEventListener('click', () => {
    setStatus('Rejected');
    sendEmail('EM-E', emailVars());
  });

  // Reflect the persisted (or seeded) status on load.
  paintStatus(currentStatus());

  // ── Compact bar reveal ──
  // Show the compact bar once the full header has scrolled out of view. This is
  // NOT a resize: the full header simply scrolls away (constant height) and the
  // compact bar is position:fixed (out of flow, constant height). Nothing changes
  // the document height on scroll, so there's no scroll-anchoring feedback and no
  // content jump — the two failure modes that made a *resizing* sticky header
  // oscillate. An IntersectionObserver on the header flips a single class.
  const compactbar = document.getElementById('permit-compactbar');
  if (banner && compactbar && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        const gone = !entry.isIntersecting;
        compactbar.classList.toggle('compactbar--shown', gone);
        compactbar.setAttribute('aria-hidden', String(!gone));
      },
      // Reveal once the header's bottom passes the sticky line for the tab bar
      // (fixed UI-Shell 48px + compact bar 48px = 96px), so the compact bar takes
      // over exactly as the tabs pin beneath it.
      { rootMargin: '-96px 0px 0px 0px', threshold: 0 },
    );
    io.observe(banner);
  }
</script>

<!-- ── Analysis-review key-metric + roster modal (only rendered on the finalize
     view, so everything here is guarded on the metric existing) ── -->
<script>
  import { initials } from '../lib/avatar';
  import { readIdentity } from '../lib/maintenance';
  import { sectionAccessor } from '../lib/permissions';
  import { withBase } from '../lib/base';
  import { installEmailCopy } from '../lib/email-copy';
  import { roleLine, teamUnitOf } from '../lib/analysis-team';
  import { paintReviewRows, REVIEW_COMPLETE_EVENT } from '../lib/review-complete';

  interface DirUser { id: string; name: string; role: string; detail: string; email: string; }
  interface TeamEdits { removed: string[]; added: DirUser[]; }

  const metricBtn = document.getElementById('analysis-metric');
  const modal = document.getElementById('analysis-team-modal') as any;
  const roster = document.getElementById('review-roster');

  if (metricBtn && modal && roster) {
    installEmailCopy();

    const banner = document.getElementById('permit-banner');
    const permitId = banner?.dataset.permitId ?? '';
    const permitType = banner?.dataset.permitType as any;
    const statusNow = () => (permitId && localStorage.getItem(`permit-status-${permitId}`)) || banner?.dataset.status || 'Under review';
    // Same gate as the rail: the Responsible analyst (or Admin) during review.
    const canManage = () => sectionAccessor(readIdentity(), permitId, permitType, statusNow())('supporting-agents') === 'update';

    const teamKey = roster.dataset.teamKey || `permit-team-${permitId}`;
    const tpl = document.getElementById('review-row-template') as HTMLTemplateElement;
    const groupTpl = document.getElementById('unit-group-template') as HTMLTemplateElement;
    const bars = [
      document.getElementById('analysis-metric-bar'),
      document.getElementById('analysis-modal-bar'),
    ].filter(Boolean) as any[];
    const rows = () => Array.from(roster.querySelectorAll<HTMLElement>('.review-row'));

    const loadTeam = (): TeamEdits => {
      try {
        const p = JSON.parse(localStorage.getItem(teamKey) || '{}');
        return { removed: Array.isArray(p.removed) ? p.removed : [], added: Array.isArray(p.added) ? p.added : [] };
      } catch { return { removed: [], added: [] }; }
    };

    // Collapse: a COMPLETE unit folds to its heading (status + who completed it), so
    // finished units read as done at a glance; open ones stay expanded. A unit the
    // viewer toggled by hand keeps their choice for the rest of the visit.
    const userCollapsed = new Map<string, boolean>();
    const setCollapsed = (sec: HTMLElement, collapsed: boolean) => {
      sec.toggleAttribute('data-collapsed', collapsed);
      const list = sec.querySelector<HTMLElement>('.unit-members');
      if (list) list.style.display = collapsed ? 'none' : '';
      const btn = sec.querySelector<HTMLElement>('[data-unit-toggle]');
      btn?.setAttribute('aria-expanded', String(!collapsed));
      const tip = btn?.querySelector('[slot="tooltip-content"]');
      if (tip) tip.textContent = collapsed ? 'Show analysts' : 'Hide analysts';
    };
    roster.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest?.('[data-unit-toggle]');
      const sec = btn?.closest<HTMLElement>('.unit-group');
      if (!sec?.dataset.unitGroup) return;
      const collapsed = !sec.hasAttribute('data-collapsed');
      userCollapsed.set(sec.dataset.unitGroup, collapsed);
      setCollapsed(sec, collapsed);
    });

    // Meters + unit headings roll up by REVIEW UNIT, not person: a unit is complete
    // once ≥1 of its members is. The Responsible analyst (no data-unit) is excluded.
    const recompute = () => {
      const unitDone = new Map<string, boolean>();
      rows().forEach((r) => {
        const u = r.dataset.unit;
        if (!u) return;
        unitDone.set(u, (unitDone.get(u) ?? false) || r.dataset.status === 'complete');
      });
      const total = unitDone.size;
      const done = [...unitDone.values()].filter(Boolean).length;
      bars.forEach((bar) => {
        bar.max = total;
        bar.value = done;
        bar.helperText = `${done} of ${total} reviews complete`;
        bar.status = total > 0 && done === total ? 'finished' : 'active';
      });
      roster.querySelectorAll<HTMLElement>('.unit-group').forEach((sec) => {
        const members = Array.from(sec.querySelectorAll<HTMLElement>('.review-row'));
        if (!members.length) { sec.remove(); return; }
        if (!sec.dataset.unitGroup) return; // the Responsible analyst section has no roll-up
        const kind = members.some((r) => r.dataset.status === 'complete') ? 'succeeded'
          : members.some((r) => r.dataset.status === 'pending') ? 'in-progress' : 'not-started';
        const ind = sec.querySelector('.unit-group__ind');
        ind?.setAttribute('kind', kind);
        ind?.setAttribute('label', kind === 'succeeded' ? 'Complete' : kind === 'in-progress' ? 'In progress' : 'Not started');
        // Who closed the unit out (the first analyst to complete), beside the status;
        // everyone else in a complete unit reads "Not required".
        const done = kind === 'succeeded';
        const closer = members.find((r) => r.dataset.status === 'complete');
        const by = sec.querySelector('.unit-group__by');
        if (by) {
          const name = closer?.querySelector('.review-row__name')?.textContent || '';
          const date = (closer?.querySelector('.review-row__when')?.textContent || '').replace(/^Completed\s*/, '');
          by.textContent = done && name ? [name, date].filter(Boolean).join(' · ') : '';
        }
        members.forEach((r) => {
          if (done && r.dataset.status !== 'complete') r.dataset.covered = 'true';
          else delete r.dataset.covered;
        });
        const unit = sec.dataset.unitGroup;
        setCollapsed(sec, userCollapsed.has(unit) ? userCollapsed.get(unit)! : done);
      });
    };

    // An analyst added on the rail: Not started, in their unit's section (created
    // after the existing ones if it's the first from that district).
    const insertRow = (u: DirUser) => {
      const unit = teamUnitOf(u.detail);
      let sec = roster.querySelector<HTMLElement>(`.unit-group[data-unit-group="${CSS.escape(unit)}"]`);
      if (!sec) {
        sec = groupTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        sec.dataset.unitGroup = unit;
        const title = sec.querySelector('.unit-group__title');
        if (title) title.textContent = unit;
        roster.appendChild(sec);
      }
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.dataset.userId = u.id;
      li.dataset.unit = unit;
      li.dataset.email = u.email || '';
      li.dataset.added = 'true';
      const set = (sel: string, text: string) => { const el = li.querySelector(sel); if (el) el.textContent = text; };
      set('.avatar', initials(u.name));
      set('.review-row__name', u.name);
      set('.review-row__role', roleLine(u.role, u.detail, unit));
      set('.review-row__email-addr', u.email || '');
      li.querySelector('.review-row__copy')?.setAttribute('data-copy-email', u.email || '');
      const emailLine = li.querySelector<HTMLElement>('.review-row__email');
      if (emailLine && !u.email) emailLine.style.display = 'none';
      sec.querySelector('.unit-members')?.appendChild(li);
    };

    // The rail is the only editor and lives on the same page, so re-read the shared
    // team edits each time the modal opens: un-hide every seed row, hide removed
    // ones, rebuild the added ones.
    const syncFromStorage = () => {
      const edits = loadTeam();
      roster.querySelectorAll('[data-added]').forEach((r) => r.remove());
      rows().forEach((r) => { r.style.display = edits.removed.includes(r.dataset.userId || '') ? 'none' : ''; });
      roster.querySelectorAll<HTMLElement>('.review-row[style*="none"]').forEach((r) => r.remove());
      edits.added.forEach((u) => { if (!roster.querySelector(`[data-user-id="${CSS.escape(u.id)}"]`)) insertRow(u); });
      recompute();
    };

    // The Responsible analyst reads Complete only once the permit has left review
    // (their sign-off ends the analysis); repaint live on every status change.
    const paintLead = (status: string) => {
      const complete = ['Out for signature', 'Waiting for annual report', 'Active'].includes(status);
      roster.querySelectorAll<HTMLElement>('.review-row[data-lead="true"]').forEach((row) => {
        row.dataset.status = complete ? 'complete' : 'pending';
        const ind = row.querySelector('.review-row__ind');
        ind?.setAttribute('kind', complete ? 'succeeded' : 'in-progress');
        ind?.setAttribute('label', complete ? 'Complete' : 'In progress');
        const when = row.querySelector('.review-row__when');
        if (when) when.textContent = complete ? 'Signed off' : '';
      });
    };

    // Analysts who marked themselves done ("Complete review") read Complete with
    // their date; a reopen restores the seeded state.
    const paintComplete = () => {
      paintReviewRows(rows(), permitId, (row, st) => {
        row.dataset.status = st.status;
        const ind = row.querySelector('.review-row__ind');
        ind?.setAttribute('kind', st.kind);
        ind?.setAttribute('label', st.label);
        const when = row.querySelector('.review-row__when');
        if (when) when.textContent = st.when;
      }, (row) => {
        const ind = row.querySelector('.review-row__ind');
        return {
          status: row.dataset.status || 'not-started',
          kind: ind?.getAttribute('kind') || 'not-started',
          label: ind?.getAttribute('label') || 'Not started',
          when: row.querySelector('.review-row__when')?.textContent || '',
        };
      });
      recompute();
    };

    const manageBtn = document.getElementById('team-manage-btn') as HTMLElement | null;
    const doneBtn = document.getElementById('team-done-btn') as HTMLElement | null;
    const refresh = () => {
      syncFromStorage();
      paintLead(statusNow());
      paintComplete();
      const manage = canManage();
      if (manageBtn) manageBtn.style.display = manage ? '' : 'none';
      if (doneBtn) doneBtn.style.display = manage ? 'none' : '';
    };

    metricBtn.addEventListener('click', () => { refresh(); modal.open = true; });

    // Manage team → the Internal review rail. On the permit page that's a tab switch
    // (via the #internal deep link); elsewhere (the review wizard) it navigates there.
    // Scroll + focus wait out the modal's close (closing in code fires no
    // cds-modal-closed), or its focus-return to the metric would win.
    manageBtn?.addEventListener('click', () => {
      const rail = document.getElementById('team-roster');
      if (!rail) { window.location.href = `${withBase('/permit')}#internal`; return; }
      if (location.hash !== '#internal') location.hash = 'internal';
      modal.open = false;
      setTimeout(() => {
        rail.scrollIntoView({ block: 'center' });
        (document.getElementById('team-add-open') as HTMLElement | null)?.focus({ preventScroll: true });
      }, 300);
    });

    // Email all — one message to every analyst with an address on file.
    document.getElementById('email-all-team')?.addEventListener('click', () => {
      const emails = [...new Set(rows().map((r) => (r.dataset.email || '').trim()).filter(Boolean))];
      if (emails.length) window.location.href = `mailto:${emails.join(',')}`;
    });

    window.addEventListener('permit-status-changed', (e) => {
      paintLead((e as CustomEvent).detail?.status ?? statusNow());
    });
    window.addEventListener(REVIEW_COMPLETE_EVENT, paintComplete);
    refresh(); // the header meter reflects stored edits + marks on load
  }
</script>

<style>
  /* Dark banner panel — the header carries the g100 dark theme zone (see the
     `cds--g100` class on the element), so its background is the near-black base
     (--cds-background) and Carbon flips the text, tags, and button to their
     light dark-zone values automatically. Number sits UNDER the name. */
  .banner {
    background: var(--cds-background, #161616);
    /* Full-bleed: break out of the constrained page column so the gray band
       spans the whole viewport width. .banner__inner re-centers the content so
       it stays aligned with the rest of the page. */
    margin-inline: calc(50% - 50vw);
    padding-block: var(--cds-spacing-07, 2rem); /* 32px, on-scale */
    /* The full header just scrolls away normally — no sticky, no resize. The
       compact bar below takes over the pinned role. */
  }

  /* ── Compact bar ─────────────────────────────────────────────────────────
     A position:fixed bar pinned under the UI-Shell header (48px). Constant
     height, out of normal flow — so revealing/hiding it never changes document
     height (that's what kills the scroll-anchoring oscillation). Fades in once
     the full header has scrolled away. Its 48px height + the 48px UI-Shell header
     define the tab strip's sticky offset (6rem) on the page. */
  .compactbar {
    position: fixed;
    top: var(--cds-spacing-09, 3rem);
    left: 0;
    right: 0;
    height: var(--cds-spacing-09, 3rem);
    background: var(--cds-background, #161616);
    z-index: 95;
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .compactbar--shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .compactbar__inner {
    max-inline-size: 99rem;
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--cds-grid-margin, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--cds-spacing-04, 0.75rem);
  }
  .compactbar__number {
    color: var(--cds-text-primary, #f4f4f4);
    white-space: nowrap;
  }
  .compactbar__window {
    color: var(--cds-text-secondary, #c6c6c6);
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
