---
// Permit detail header — editorial layout on the page background (no tiles):
// number eyebrow, name, status indicator, action buttons, badge rows, then an
// at-a-glance strip of labeled facts (plain data, not boxed content pieces).
import type { Badge } from '../data/permit';
import type { DirectoryUser } from '../data/user';
import { withBase } from '../lib/base';
import Avatar from './Avatar.astro';

interface Stat {
  label: string;
  value: string;
}

/** One reviewer on the analysis team. `reviewStatus` tracks them through their
 *  own review workflow — 'not-started' (assigned, not opened), 'pending' (started,
 *  in progress), 'complete' (finished). The Lead analyst is the exception: their
 *  status is DERIVED from the permit (Complete only once it's Out for signature),
 *  not this field. `when` is the date that state was reached. */
type ReviewStatus = 'not-started' | 'pending' | 'complete';
interface TeamMember {
  id: string;
  role: string;
  name: string;
  detail: string;
  reviewStatus: ReviewStatus;
  when?: string;
  highlight?: boolean;
}

interface Props {
  id: string;
  name: string;
  organization: string;
  status: { label: string; kind: string };
  infoTags: Badge[];
  flagTags: Badge[];
  stats: Stat[];
  /** Dates the applicant requested — shown as a reminder in the approve modal
   *  and used to prefill its confirmation date-range picker (ISO pair). */
  requestedWindow: { start: string; end: string; startISO: string; endISO: string };
  /** OPTIONAL. When present, the header gains a clickable "Analysis review"
   *  key-metric (how many reviewers are done) that opens a modal listing the
   *  team, their completion, and a control to add reviewers. Passed by the
   *  finalize (under-review) view; omitted on the read-only detail page, which
   *  carries its own roster in the Overview tab. */
  analysisTeam?: TeamMember[];
  /** The user directory the add-reviewer control draws from (required when
   *  analysisTeam is passed). */
  directory?: DirectoryUser[];
  /** Where this header is mounted. On the detail page ("detail") the started-phase
   *  action is "Open review" — it enters the finalize wizard. On the wizard itself
   *  ("finalize") the reviewer is already inside, so the primary reads "Approve
   *  permit" and jumps to the wizard's Review & send step; the menu keeps only the
   *  decision actions (Request changes / Reject permit). Defaults to the detail
   *  behavior. */
  context?: 'detail' | 'finalize';
  /** The permit's district span, 'single' | 'multi'. Surfaced on the banner as
   *  `data-permit-type` so the dev permit-role control can constrain its options
   *  to what the active identity is eligible for on this type (Story 2). Derived
   *  from the parks' district span today; a stored field in Story 8. */
  permitType?: 'single' | 'multi';
}

const {
  id, name, organization, status, infoTags, flagTags, stats, requestedWindow,
  analysisTeam, directory = [], context = 'detail', permitType,
} = Astro.props;

// The started-phase primary differs by mount: enter the wizard vs. approve from
// inside it. Kept here so the full header and the compact bar stay in lockstep.
const finalize = context === 'finalize';
const reviewLabel = finalize ? 'Approve permit' : 'Open review';

// An amendment reuses the whole application flow, prefilled from this permit and
// numbered with an "-A" suffix — offered only once the permit is Active.
const amendHref = withBase(`/apply?amend=${id}`);

// ── Analysis-review metric (only when analysisTeam is supplied) ──
// The three reviewer states, each with its icon-indicator kind + label + the verb
// that prefixes the date line ("Completed Jul 5", "Started …", "Added …"). Status
// is meaning, not colour alone — the indicator renders its own text label.
const STATE_META: Record<ReviewStatus, { kind: string; label: string; verb: string }> = {
  'not-started': { kind: 'not-started', label: 'Not started', verb: 'Added' },
  'pending':     { kind: 'in-progress', label: 'Pending',     verb: 'Started' },
  'complete':    { kind: 'succeeded',   label: 'Complete',    verb: 'Completed' },
};
const isLead = (m: TeamMember) => m.highlight === true || m.role === 'Lead analyst';
// The Lead analyst reads Complete only once the permit has left review (Out for
// signature and beyond) — their sign-off IS the end of the analysis. Before that
// they're actively reviewing (Pending). Everyone else carries their own status.
const leadComplete = ['Out for signature', 'Waiting for annual report', 'Active'].includes(status.label);
const memberStatus = (m: TeamMember): ReviewStatus =>
  isLead(m) ? (leadComplete ? 'complete' : 'pending') : m.reviewStatus;
// The date/time line under the status. The lead's is phrased as a sign-off, not a
// generic verb; everyone else gets "<verb> <date>".
const reviewWhen = (m: TeamMember): string => {
  if (isLead(m)) return leadComplete ? 'Signed off' : 'Reviewing';
  const st = memberStatus(m);
  return m.when ? `${STATE_META[st].verb} ${m.when}` : STATE_META[st].label;
};
// The progress bar measures REVIEW UNITS, not people: each involved district is
// one unit, and every HQ reviewer collapses into a single "Headquarters" unit. A
// unit is complete once AT LEAST ONE of its members is Complete. The lead analyst
// (the responsible agent) is excluded — their sign-off doesn't move this bar.
const unitOf = (m: TeamMember): string | null => {
  if (isLead(m)) return null;                     // excluded from the bar
  if (m.role === 'District reviewer') return m.detail; // detail = district name
  return 'Headquarters';                          // all other HQ roles
};
const unitDone = new Map<string, boolean>();
(analysisTeam ?? []).forEach((m) => {
  const u = unitOf(m);
  if (!u) return;
  unitDone.set(u, (unitDone.get(u) ?? false) || memberStatus(m) === 'complete');
});
const reviewTotal = unitDone.size;
const reviewDone = [...unitDone.values()].filter(Boolean).length;
const reviewAllDone = reviewTotal > 0 && reviewDone === reviewTotal;
// Shared with the detail page's roster (removed/added edits).
const teamStorageKey = `permit-team-${id}`;

// Directory users not already on the seeded team — the modal's inline "Add member"
// picker draws from these, adding the pick as a Supporting analyst.
const teamIds = new Set((analysisTeam ?? []).map((m) => m.id));
const eligibleReviewers = directory.filter((u) => !teamIds.has(u.id));

// The roster is GROUPED to match the bar: the lead analyst sits on their own, then
// one section per review unit (Headquarters first, then each district in the order
// it first appears). A unit section shows a Reviewed/Pending status = its bar state
// (done once ≥1 member has finished).
const leadMembers = (analysisTeam ?? []).filter(isLead);
const unitMembers = new Map<string, TeamMember[]>();
const unitOrder: string[] = [];
(analysisTeam ?? []).forEach((m) => {
  const u = unitOf(m);
  if (!u) return;
  if (!unitMembers.has(u)) { unitMembers.set(u, []); unitOrder.push(u); }
  unitMembers.get(u)!.push(m);
});
const orderedUnits = [
  ...unitOrder.filter((u) => u === 'Headquarters'),
  ...unitOrder.filter((u) => u !== 'Headquarters'),
];
const rosterSections = [
  ...(leadMembers.length ? [{ key: '__lead', label: 'Lead analyst', members: leadMembers, counts: false }] : []),
  ...orderedUnits.map((u) => ({ key: u, label: u, members: unitMembers.get(u)!, counts: true })),
];
---

<header class="banner cds--g100" id="permit-banner" data-permit-id={id} data-permit-name={name} data-status={status.label} data-letter-url={withBase('/final-letter')} data-context={context} data-permit-type={permitType}>
  <div class="banner__inner">
  <div class="banner__crumb"><slot name="breadcrumb" /></div>
  <div class="banner__main">
    <div class="banner__lead">
      <p class="banner__eyebrow t-heading-compact-01">{organization}</p>
      <h1 class="banner__title t-heading-05">{name}</h1>
      <div class="banner__id-row">
        <span class="banner__number t-heading-03">{id}</span>
        <cds-icon-indicator class="permit-status-indicator" size="20" kind={status.kind} label={status.label}></cds-icon-indicator>
      </div>
      <div class="banner__tags">
        {infoTags.map((tag) => <cds-tag type={tag.type} size="lg">{tag.label}</cds-tag>)}
        {flagTags.map((tag) => (
          <cds-tag type={tag.type} size="lg">
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M14.5,14h-13c-0.2,0-0.3-0.1-0.4-0.2c-0.1-0.2-0.1-0.3,0-0.5l6.5-12C7.7,1,8,0.9,8.2,1.1c0.1,0,0.2,0.1,0.2,0.2l6.5,12 c0.1,0.2,0.1,0.3,0,0.5C14.9,13.9,14.7,14,14.5,14z M2.3,13h11.3L8,2.5L2.3,13z"/>
              <path d="M7.5 6H8.5V9.5H7.5z"/>
              <path d="M8,10.8c-0.4,0-0.8,0.3-0.8,0.8s0.3,0.8,0.8,0.8c0.4,0,0.8-0.3,0.8-0.8S8.4,10.8,8,10.8z"/>
            </svg>
            {tag.label}
          </cds-tag>
        ))}
      </div>
    </div>

    <!-- Actions depend on where the permit sits in the workflow — only the set for
         the current status is shown (the script toggles by [data-when]):
           • Under review     → Approve (primary) + Request changes / Reject in the menu
           • Out for signature → Sign permit
           • Active            → Request amendment (the applicant's next move)
           • Changes requested / Rejected → no decision remains here
         tooltip-alignment=bottom: the caret's tooltip defaults to opening upward,
         which is clipped once the header is a pinned bar — open it downward. -->
    <div class="banner__actions">
      <!-- Under review has two phases (the script toggles [data-phase] by the
           permit-review-started-${id} flag):
             not-started → Start review — records who's reviewing + when, then
                           opens the review wizard (final-letter).
             started     → Open review — primary enters the wizard; the decision
                           actions stay in the menu, and the approval itself is
                           the wizard's Send step. -->
      <cds-button data-when="Waiting for review" class="permit-start-review" size="md">Start review</cds-button>
      <cds-combo-button data-when="Under review" class="permit-open-review" size="md" label={reviewLabel} menu-alignment="bottom-end" tooltip-alignment="bottom" hidden>
        <cds-menu>
          <cds-menu-item label="Request changes"></cds-menu-item>
          {!finalize && <cds-menu-item label="Download"></cds-menu-item>}
          {!finalize && <cds-menu-item-divider></cds-menu-item-divider>}
          <cds-menu-item label="Reject permit" kind="danger"></cds-menu-item>
        </cds-menu>
      </cds-combo-button>
      <cds-button data-when="Out for signature" class="permit-action-sign" size="md" hidden>Sign permit</cds-button>
      <cds-button data-when="Waiting for annual report" class="permit-hold-override" size="md" hidden>Override hold — issue permit</cds-button>
      <cds-button data-when="Active" class="permit-action-amend" size="md" href={amendHref} hidden>Request amendment</cds-button>
    </div>
  </div>

  <div class="banner__facts">
    <dl class="banner__stats">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat__label t-label-01">{s.label}</dt>
          <dd class="stat__value t-body-01">{s.value}</dd>
        </div>
      ))}
    </dl>

    {analysisTeam && (
      <!-- Key metric: at-a-glance analysis-review completion. The whole tile is a
           button that opens the roster modal (Carbon ships no clickable-metric →
           dialog control; a clickable-tile is a navigation link, not a dialog
           trigger). carbon-checked: dialog-opening metric tile. -->
      <button type="button" class="analysis-metric" id="analysis-metric" aria-haspopup="dialog">
        <cds-progress-bar
          id="analysis-metric-bar"
          class="analysis-metric__bar"
          label="Analysis team"
          helper-text={`${reviewDone} of ${reviewTotal} reviews complete`}
          value={reviewDone}
          max={reviewTotal}
          size="small"
          status={reviewAllDone ? 'finished' : 'active'}
        ></cds-progress-bar>
        <span class="analysis-metric__cta t-label-01">
          <span id="analysis-metric-cta-text">View team</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M11 8L6 3 5.3 3.7 9.6 8l-4.3 4.3L6 13z"/></svg>
        </span>
      </button>
    )}
  </div>
  </div>
</header>

<!-- Compact bar — a SEPARATE, position:fixed bar (constant height, out of normal
     flow) that fades in once the full header above has scrolled away. Because it
     never enters document flow, showing/hiding it can't change the page height,
     so it can't trigger the scroll-anchoring feedback that makes a *resizing*
     sticky header oscillate. Shows number + requested window + the action. -->
<div class="compactbar cds--g100" id="permit-compactbar" aria-hidden="true">
  <div class="compactbar__inner">
    <span class="compactbar__number t-heading-03">{id}</span>
    <cds-icon-indicator class="permit-status-indicator" size="16" kind={status.kind} label={status.label}></cds-icon-indicator>
    <span class="compactbar__window t-body-01">{requestedWindow.start} – {requestedWindow.end}</span>
    <div class="compactbar__spacer"></div>
    <cds-button data-when="Waiting for review" class="permit-start-review" size="md">Start review</cds-button>
    <cds-combo-button data-when="Under review" class="permit-open-review" size="md" label={reviewLabel} menu-alignment="bottom-end" tooltip-alignment="bottom" hidden>
      <cds-menu>
        <cds-menu-item label="Request changes"></cds-menu-item>
        {!finalize && <cds-menu-item label="Download"></cds-menu-item>}
        {!finalize && <cds-menu-item-divider></cds-menu-item-divider>}
        <cds-menu-item label="Reject permit" kind="danger"></cds-menu-item>
      </cds-menu>
    </cds-combo-button>
    <cds-button data-when="Out for signature" class="permit-action-sign" size="md" hidden>Sign permit</cds-button>
      <cds-button data-when="Waiting for annual report" class="permit-hold-override" size="md" hidden>Override hold — issue permit</cds-button>
    <cds-button data-when="Active" class="permit-action-amend" size="md" href={amendHref} hidden>Request amendment</cds-button>
  </div>
</div>

<!-- Confirmation dialogs for the workflow decisions. Overlays live outside normal
     flow; Carbon owns the focus trap + return and the accessible heading. Approval
     is no longer a header modal — it's the review wizard's Send step, reached via
     Open review, where the reviewer confirms the window and conditions first. -->
<cds-modal id="sign-permit-modal" size="sm">
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-label>Permit {id}</cds-modal-label>
    <cds-modal-heading>Record the signed permit?</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <p class="t-body-01">
      Confirm the applicant has signed and returned the permit. This activates it:
      the permit becomes valid and the applicant can begin the authorized work.
    </p>
  </cds-modal-body>
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="primary" id="sign-confirm" data-modal-close>Mark as signed</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

<cds-modal id="request-changes-modal" size="md">
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-label>Permit {id}</cds-modal-label>
    <cds-modal-heading>Request changes</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <cds-stack gap="7">
      <p class="t-body-01">
        Return the application to the applicant with the items to address.
        They’ll be notified and can resubmit once the requested changes are made.
      </p>

      <!-- Reasons are not mutually exclusive, so a checkbox group. -->
      <cds-checkbox-group legend-text="What’s needed">
        <cds-checkbox value="dpr65a" label-text="DPR65A form submission"></cds-checkbox>
        <cds-checkbox value="dpr65b" label-text="DPR65B form submission"></cds-checkbox>
        <cds-checkbox
          value="missing-docs"
          label-text="Additional documentation requested / missing documents"
        ></cds-checkbox>
        <cds-checkbox
          value="other"
          label-text="Other information or changes requested"
        ></cds-checkbox>
      </cds-checkbox-group>

      <cds-textarea
        label="Additional information"
        placeholder="Describe what the applicant needs to change or provide…"
        rows="4"
      ></cds-textarea>
    </cds-stack>
  </cds-modal-body>
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="primary" id="request-confirm" data-modal-close>Send request</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

<cds-modal id="reject-permit-modal" size="sm" alert>
  <cds-modal-header>
    <cds-modal-close-button></cds-modal-close-button>
    <cds-modal-label>Permit {id}</cds-modal-label>
    <cds-modal-heading>Reject this permit?</cds-modal-heading>
  </cds-modal-header>
  <cds-modal-body>
    <p class="t-body-01">
      Rejecting closes this application. The applicant will be notified and must
      submit a new application to reapply. This can’t be undone.
    </p>
  </cds-modal-body>
  <cds-modal-footer>
    <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
    <cds-modal-footer-button kind="danger" id="reject-confirm" data-modal-close>Reject permit</cds-modal-footer-button>
  </cds-modal-footer>
</cds-modal>

{analysisTeam && (
  <cds-modal id="analysis-team-modal" size="lg">
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label>Permit {id}</cds-modal-label>
      <cds-modal-heading id="analysis-modal-title">Analysis team</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <cds-stack gap="7">
        <cds-progress-bar
          id="analysis-modal-bar"
          label="Reviews complete"
          helper-text={`${reviewDone} of ${reviewTotal} reviews complete`}
          value={reviewDone}
          max={reviewTotal}
          status={reviewAllDone ? 'finished' : 'active'}
        ></cds-progress-bar>

        <!-- Add a member INLINE (no second modal — that would stack on this one).
             SELECTING a directory user stages them straight into their unit's section
             as a Supporting analyst and flips the footer to Save changes / Cancel — no
             separate "add" button. A staged row carries a Remove (×) to undo a mis-pick
             before saving. Nothing persists until Save. -->
        <div class="team-add">
          <cds-combo-box
            id="team-add-select"
            title-text="Add a member"
            label="Search the user directory…"
            helper-text="Select a user to add them to the team. Only users not already on the team appear here."
          >
            {eligibleReviewers.map((u) => (
              <cds-combo-box-item value={u.id} data-name={u.name} data-detail={u.detail} data-email={u.email}>{u.name} — {u.detail}</cds-combo-box-item>
            ))}
          </cds-combo-box>
        </div>

        <!-- Reviewer roster — GROUPED by review unit to match the bar: the lead
             analyst first, then one section per unit (Headquarters, then each
             district). A unit heading rolls up its members' state (Reviewed once
             ≥1 is Complete, else In progress / Not started). Each row shows the
             person, their email (with a copy control) under the name, and their
             review state. When the team is editable, members can be added inline
             above (staged until Save) and removed here (a trash toggle, also staged
             until Save). Status shows via an icon-indicator (not colour alone). -->
        <div class="review-roster" id="review-roster" data-team-key={teamStorageKey}>
          {rosterSections.map((sec) => {
            const sts = sec.members.map(memberStatus);
            const secKind = !sec.counts ? '' : sts.includes('complete') ? 'succeeded' : sts.includes('pending') ? 'in-progress' : 'not-started';
            const secLabel = !sec.counts ? '' : sts.includes('complete') ? 'Reviewed' : sts.includes('pending') ? 'In progress' : 'Not started';
            return (
            <section class="unit-group" data-unit-group={sec.counts ? sec.key : ''}>
              <div class="unit-group__head">
                <h4 class="unit-group__title t-heading-compact-01">{sec.label}</h4>
                {sec.counts && (
                  <cds-icon-indicator class="unit-group__ind" size="16" kind={secKind} label={secLabel}></cds-icon-indicator>
                )}
              </div>
              <ul class="unit-members">
                {sec.members.map((m) => {
                  const st = memberStatus(m);
                  const email = directory.find((u) => u.id === m.id)?.email ?? '';
                  return (
                  <li class="review-row" data-user-id={m.id} data-seed data-status={st} data-unit={unitOf(m) ?? ''} data-email={email} data-lead={m.highlight ? 'true' : 'false'}>
                    <Avatar name={m.name} size="md" />
                    <div class="review-row__id">
                      <p class="review-row__name t-body-01">{m.name}{m.highlight ? <span class="review-row__lead t-label-01"> · Lead</span> : null}</p>
                      <p class="review-row__role t-label-01">{m.role}</p>
                      {email && (
                        <p class="review-row__email t-label-01">
                          <span class="review-row__email-addr">{email}</span>
                          <cds-icon-button class="review-row__copy" kind="ghost" size="sm" align="bottom" data-copy-email>
                            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true">
                              <path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/>
                              <path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/>
                            </svg>
                            <span slot="tooltip-content">Copy email</span>
                          </cds-icon-button>
                        </p>
                      )}
                    </div>
                    <div class="review-row__status">
                      <cds-icon-indicator class="review-row__ind" size="16" kind={STATE_META[st].kind} label={STATE_META[st].label}></cds-icon-indicator>
                      <span class="review-row__when t-label-01">{reviewWhen(m)}</span>
                    </div>
                    {!m.highlight && (
                      <cds-icon-button class="review-row__remove" kind="ghost" size="sm" align="left" data-remove>
                        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true">
                          <path d="M12 12H14V24H12zM18 12H20V24H18z"/>
                          <path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/>
                        </svg>
                        <span slot="tooltip-content">Remove</span>
                      </cds-icon-button>
                    )}
                  </li>
                  );
                })}
              </ul>
            </section>
            );
          })}
        </div>
      </cds-stack>
    </cds-modal-body>
    <!-- Footer is stateful: clean → [Email all | Done]; once a member is staged →
         [Cancel | Save changes]. Toggled by inline display (cds-* ignore [hidden]).
         Cancel/Done close natively; the close handler discards any staged rows. -->
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" id="team-cancel-btn" data-modal-close style="display:none">Cancel</cds-modal-footer-button>
      <cds-modal-footer-button kind="secondary" id="email-all-team">Email all</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="team-save-btn" style="display:none">Save changes</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="team-done-btn" data-modal-close>Done</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>

  <!-- Row template — clones a roster row for reviewers added inline (staged) or
       replayed from localStorage. Same shape as a seed row: email + copy under the
       name, status, and the remove toggle (shown only when the team is editable). -->
  <template id="review-row-template">
    <li class="review-row" data-status="not-started">
      <span class="avatar avatar--md" aria-hidden="true"></span>
      <div class="review-row__id">
        <p class="review-row__name t-body-01"></p>
        <p class="review-row__role t-label-01"></p>
        <p class="review-row__email t-label-01">
          <span class="review-row__email-addr"></span>
          <cds-icon-button class="review-row__copy" kind="ghost" size="sm" align="bottom" data-copy-email>
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/>
              <path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/>
            </svg>
            <span slot="tooltip-content">Copy email</span>
          </cds-icon-button>
        </p>
      </div>
      <div class="review-row__status">
        <cds-icon-indicator class="review-row__ind" size="16" kind="not-started" label="Not started"></cds-icon-indicator>
        <span class="review-row__when t-label-01"></span>
      </div>
      <cds-icon-button class="review-row__remove" kind="ghost" size="sm" align="left" data-remove>
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M12 12H14V24H12zM18 12H20V24H18z"/>
          <path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/>
        </svg>
        <span slot="tooltip-content">Remove</span>
      </cds-icon-button>
    </li>
  </template>

  <!-- Unit-group template — clones a whole section when a reviewer is added for a
       district not yet on the roster. -->
  <template id="unit-group-template">
    <section class="unit-group" data-unit-group="">
      <div class="unit-group__head">
        <h4 class="unit-group__title t-heading-compact-01"></h4>
        <cds-icon-indicator class="unit-group__ind" size="16" kind="not-started" label="Not started"></cds-icon-indicator>
      </div>
      <ul class="unit-members"></ul>
    </section>
  </template>

)}

<script>
  import { readIdentity } from '../lib/maintenance';
  import { readPermitRole, sectionAccessor } from '../lib/permissions';
  import { sendEmail } from '../lib/notifications';
  // ── Workflow state machine (prototype-local) ──
  // The permit moves through a small set of statuses; each has a cds-icon-indicator
  // `kind` (kept in sync with data/permits.ts) and its own action set. The current
  // status persists to `permit-status-${id}` so it survives a reload, and every
  // transition broadcasts `permit-status-changed` so other surfaces on the page —
  // notably the Special conditions tab, which freezes once the permit leaves review
  // — react without a reload.
  //   Under review ─[Start review]▶ (started) ─Open review▶ wizard ─Send▶ Out for signature ─sign▶ Active
  //                └─request changes─▶ Changes requested
  //                └─reject──────────▶ Rejected
  // "Start review" is a phase within Under review, not a status: it sets the
  // permit-review-started-${id} flag (who + when), which gates the detail body
  // and the wizard. The status stays "Under review" throughout.
  const banner = document.getElementById('permit-banner');
  const permitId = banner?.dataset.permitId ?? '';
  const seededStatus = banner?.dataset.status ?? 'Under review';
  const statusKey = `permit-status-${permitId}`;

  // Decision/sign actions are permit-role gated (Story 9.3): Approve / Request
  // changes / Reject and the review-decision entry are RA-or-Admin only; Sign is
  // for the applicable signer only; Start review is RA-or-Admin (Story 5 refines).
  const gateIdentity = readIdentity();
  const gatePermitType = banner?.dataset.permitType;
  const startAllowed = gateIdentity === 'admin' || readPermitRole(permitId) === 'responsible';

  const STATUS_KIND: Record<string, string> = {
    'Waiting for review': 'not-started',
    'Under review': 'in-progress',
    'Out for signature': 'pending',
    'Waiting for annual report': 'caution-minor',
    'Active': 'succeeded',
    'Changes requested': 'caution-minor',
    'Rejected': 'failed',
  };

  const currentStatus = () =>
    (permitId && localStorage.getItem(statusKey)) || seededStatus;

  // "Under review" has two phases — before and after a reviewer starts. The flag
  // records who's reviewing + when; its presence is the whole gate.
  const reviewStartedKey = `permit-review-started-${permitId}`;
  const isReviewStarted = () => Boolean(permitId && localStorage.getItem(reviewStartedKey));

  // Reflect a status across every surface: the two status indicators and the
  // action controls. A plain [data-when] action shows for its status; a
  // [data-phase] action (only within "Under review") additionally requires its
  // phase to match the started flag, so Start review and Open review swap.
  const paintStatus = (status: string) => {
    const kind = STATUS_KIND[status] ?? 'unknown';
    document.querySelectorAll('.permit-status-indicator').forEach((el) => {
      el.setAttribute('kind', kind);
      el.setAttribute('label', status);
    });
    const started = isReviewStarted();
    document.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => {
      let show = el.dataset.when === status;
      if (show && el.dataset.phase) show = el.dataset.phase === (started ? 'started' : 'not-started');
      el.hidden = !show;
    });

    // Permit-role gate (Story 9.3), applied over the status/phase visibility: hide
    // any action the active identity's permit-role can't perform in this status.
    const a = sectionAccessor(gateIdentity, permitId, gatePermitType, status);
    const canDecide = a('approve') === 'update'; // RA or Admin
    const canSign = a('sign') === 'update';       // applicable signer only
    document.querySelectorAll<HTMLElement>('.permit-open-review').forEach((el) => {
      if (!canDecide) el.hidden = true;
    });
    document.querySelectorAll<HTMLElement>('.permit-action-sign').forEach((el) => {
      if (!canSign) el.hidden = true;
    });
    document.querySelectorAll<HTMLElement>('.permit-start-review').forEach((el) => {
      if (!startAllowed) el.hidden = true;
    });
    // Hold override (Story 13) is RA/Admin only.
    document.querySelectorAll<HTMLElement>('.permit-hold-override').forEach((el) => {
      if (!startAllowed) el.hidden = true;
    });
  };

  const setStatus = (status: string) => {
    if (permitId) localStorage.setItem(statusKey, status);
    paintStatus(status);
    window.dispatchEvent(
      new CustomEvent('permit-status-changed', { detail: { status } }),
    );
  };

  // ── Simulated emails + two-signature activation (Stories 6, 13) ─────────────
  const projectTitle = banner?.dataset.permitName ?? '';
  const emailVars = () => ({ 'Permit #': permitId, 'Project title': projectTitle, 'Status': currentStatus() });
  const sigKey = `permit-signatures-${permitId}`;
  const holdFlagKey = `permit-renewal-hold-${permitId}`; // set = renewal w/ missing prior annual report
  const readSigs = () => { try { return JSON.parse(localStorage.getItem(sigKey) || '{}'); } catch { return {}; } };
  const writeSigs = (s: any) => localStorage.setItem(sigKey, JSON.stringify(s));
  const stamp = () => new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

  // When the permit reaches Out for signature, the RA's first signature is complete
  // and the second signer is notified via (simulated) DocuSign — EM-A.
  const reconcileSignatures = (status: string) => {
    if (status !== 'Out for signature') return;
    const s = readSigs();
    if (!s.first) {
      s.first = { by: 'Responsible Agent', at: stamp() };
      writeSigs(s);
      sendEmail('EM-A', emailVars());
    }
  };

  // The second signature (Sign permit) activates — unless a renewal's prior annual
  // report is missing, which holds it (Waiting for annual report) and notifies via
  // EM-H (Story 13).
  const applySecondSignature = () => {
    const s = readSigs();
    s.second = { by: 'Second signer', at: stamp() };
    writeSigs(s);
    if (localStorage.getItem(holdFlagKey) === '1') {
      setStatus('Waiting for annual report');
      sendEmail('EM-H', emailVars());
    } else {
      setStatus('Active');
      sendEmail('EM-C', emailVars());
    }
  };

  // Combo-button fires onClick for its primary button AND for menu-item picks;
  // route each to the matching confirmation modal. Both the full header and the
  // compact bar carry a `.permit-actions` combo-button, so wire them all.
  // (Cancel / X / confirm all close natively via [data-modal-close].)
  const rejectModal = document.getElementById('reject-permit-modal') as any;
  const requestModal = document.getElementById('request-changes-modal') as any;
  const signModal = document.getElementById('sign-permit-modal') as any;
  const letterUrl = banner?.dataset.letterUrl;
  const inFinalize = banner?.dataset.context === 'finalize';

  // Start review (Story 5) — the Waiting for review → Under review transition. Only
  // the Responsible Agent (or Admin) can start; records who + when in the flag, sets
  // the status, then drops the reviewer into the review wizard (final-letter).
  const startReview = () => {
    if (!permitId || !startAllowed) return;
    if (!localStorage.getItem(reviewStartedKey)) {
      const at = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      localStorage.setItem(reviewStartedKey, JSON.stringify({ by: 'You', at }));
    }
    // The transition: Waiting for review → Under review (persisted so the detail
    // body unseals and the started-phase actions show on return).
    if (permitId) localStorage.setItem(statusKey, 'Under review');
    // Starting drops the reviewer straight into the review wizard (final-letter);
    // the flag is now set, so the wizard's guard admits them. Coming back to the
    // permit later shows the unlocked detail with an "Open review" action.
    if (letterUrl) { window.location.href = letterUrl; return; }
    paintStatus(currentStatus()); // fallback only if the wizard URL is unwired
  };
  document.querySelectorAll('.permit-start-review').forEach((btn) => {
    btn.addEventListener('click', startReview);
  });

  // Started-phase primary + decision menu. On the detail page the primary "Open
  // review" enters the wizard (letterUrl); on the wizard itself ("Approve permit")
  // the reviewer is already here, so it fires a `permit:approve` event the wizard
  // catches to jump to its Review & send step. The menu is identical either way.
  document.querySelectorAll('.permit-open-review').forEach((combo) => {
    (combo as any).onClick = (e: Event) => {
      const item = (e.target as HTMLElement).closest?.('cds-menu-item');
      const label = item?.getAttribute('label');
      if (label === 'Reject permit') rejectModal.open = true;
      else if (label === 'Request changes') requestModal.open = true;
      else if (item) return; // other menu picks handled elsewhere
      else if (inFinalize) document.dispatchEvent(new CustomEvent('permit:approve'));
      else if (letterUrl) window.location.href = letterUrl; // primary "Open review"
    };
  });
  document.querySelectorAll('.permit-action-sign').forEach((btn) => {
    btn.addEventListener('click', () => (signModal.open = true));
  });
  // Request amendment navigates to the prefilled application (href); before it
  // does, record that an amendment exists for this permit so the detail page can
  // surface a link back to it. Set synchronously so it lands before navigation.
  document.querySelectorAll('.permit-action-amend').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (permitId) localStorage.setItem(`permit-amendment-${permitId}`, `${permitId}-A`);
    });
  });
  // Override the annual-report hold → issue the permit (Story 13). RA/Admin only
  // (gated in paintStatus); clears the hold flag and sends the issued email.
  document.querySelectorAll('.permit-hold-override').forEach((btn) => {
    btn.addEventListener('click', () => {
      localStorage.removeItem(holdFlagKey);
      setStatus('Active');
      sendEmail('EM-C', emailVars());
    });
  });

  // Sign = the SECOND signature → activation (or hold). Decisions notify the
  // researcher (regulated EM-D / EM-E).
  document.getElementById('sign-confirm')?.addEventListener('click', applySecondSignature);
  document.getElementById('request-confirm')?.addEventListener('click', () => {
    setStatus('Changes requested');
    sendEmail('EM-D', emailVars());
  });
  document.getElementById('reject-confirm')?.addEventListener('click', () => {
    setStatus('Rejected');
    sendEmail('EM-E', emailVars());
  });

  // Reflect the persisted (or seeded) status on load, and reconcile the first
  // signature if the permit is already Out for signature.
  paintStatus(currentStatus());
  reconcileSignatures(currentStatus());

  // ── Compact bar reveal ──
  // Show the compact bar once the full header has scrolled out of view. This is
  // NOT a resize: the full header simply scrolls away (constant height) and the
  // compact bar is position:fixed (out of flow, constant height). Nothing changes
  // the document height on scroll, so there's no scroll-anchoring feedback and no
  // content jump — the two failure modes that made a *resizing* sticky header
  // oscillate. An IntersectionObserver on the header flips a single class.
  const compactbar = document.getElementById('permit-compactbar');
  if (banner && compactbar && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        const gone = !entry.isIntersecting;
        compactbar.classList.toggle('compactbar--shown', gone);
        compactbar.setAttribute('aria-hidden', String(!gone));
      },
      // Reveal once the header's bottom passes the sticky line for the tab bar
      // (fixed UI-Shell 48px + compact bar 48px = 96px), so the compact bar takes
      // over exactly as the tabs pin beneath it.
      { rootMargin: '-96px 0px 0px 0px', threshold: 0 },
    );
    io.observe(banner);
  }
</script>

<!-- ── Analysis-review key-metric + roster modal (only rendered on the finalize
     view, so everything here is guarded on the metric existing) ── -->
<script>
  import { initials } from '../lib/avatar';
  import { showToast } from '../lib/toast';
  import { readIdentity } from '../lib/maintenance';
  import { sectionAccessor } from '../lib/permissions';

  interface DirUser { id: string; name: string; role: string; detail: string; email: string; unit?: string; }
  interface TeamEdits { removed: string[]; added: DirUser[]; }

  const metricBtn = document.getElementById('analysis-metric');
  const modal = document.getElementById('analysis-team-modal') as any;
  const roster = document.getElementById('review-roster');

  // The review-unit key for a row, mirroring the server's unitOf: a district
  // reviewer counts toward their district; every other (non-lead) reviewer toward
  // "Headquarters". Added reviewers are never the lead.
  const clientUnit = (role: string, detail: string): string =>
    /district/i.test(role) || /district/i.test(detail) ? detail : 'Headquarters';

  if (metricBtn && modal && roster) {
    metricBtn.addEventListener('click', () => (modal.open = true));

    // Team editing is gated exactly like the Overview roster: the 'supporting-agents'
    // section is Update only for the Responsible Agent (or Admin) during Under review.
    // Editable → the modal manages the team (show the picker + per-row remove, label
    // it "Manage"); not editable → a read-only view (no picker/remove, "View team").
    const banner = document.getElementById('permit-banner');
    const permitId = banner?.dataset.permitId ?? '';
    const permitType = banner?.dataset.permitType as any;
    const statusNow = () => (permitId && localStorage.getItem(`permit-status-${permitId}`)) || banner?.dataset.status || 'Under review';
    const teamEditable = sectionAccessor(readIdentity(), permitId, permitType, statusNow())('supporting-agents') === 'update';

    const addWrap = document.querySelector('.team-add') as HTMLElement | null;
    const ctaText = document.getElementById('analysis-metric-cta-text');
    const titleEl = document.getElementById('analysis-modal-title');
    if (teamEditable) {
      if (ctaText) ctaText.textContent = 'Manage team';
      if (titleEl) titleEl.textContent = 'Manage analysis team';
      (roster as HTMLElement).dataset.editable = 'true'; // CSS reveals the row remove toggles
    } else if (addWrap) {
      addWrap.style.display = 'none'; // view-only — no picker; labels stay "View team"
    }

    // The modal shows the analysis team + review progress, and (when editable) adds
    // members inline and removes them — both STAGED until Save. Saving writes the same
    // `permit-team-${id}` localStorage the Overview uses, and this replays on load.
    const teamKey = (roster as HTMLElement).dataset.teamKey || 'permit-team';
    const tpl = document.getElementById('review-row-template') as HTMLTemplateElement;
    const groupTpl = document.getElementById('unit-group-template') as HTMLTemplateElement;
    const bars = [
      document.getElementById('analysis-metric-bar'),
      document.getElementById('analysis-modal-bar'),
    ].filter(Boolean) as any[];

    const today = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

    const loadTeam = (): TeamEdits => {
      try {
        const p = JSON.parse(localStorage.getItem(teamKey) || '{}');
        return { removed: Array.isArray(p.removed) ? p.removed : [], added: Array.isArray(p.added) ? p.added : [] };
      } catch { return { removed: [], added: [] }; }
    };

    const currentIds = () =>
      Array.from(roster.querySelectorAll<HTMLElement>('[data-user-id]')).map((r) => r.dataset.userId!);
    const rows = () => Array.from(roster.querySelectorAll<HTMLElement>('.review-row'));

    // A row staged for removal is excluded from every rollup — it reflects the state
    // the roster will be in once Save commits.
    const liveRows = () => rows().filter((r) => r.dataset.stagedRemove !== 'true');

    // Recompute the two meters from the roster by REVIEW UNIT, not by person: group
    // rows by their data-unit (rows with no unit — the lead analyst — are excluded),
    // and a unit is complete once at least one of its members' data-status is 'complete'.
    const recompute = () => {
      const unitDone = new Map<string, boolean>();
      liveRows().forEach((r) => {
        const u = r.dataset.unit;
        if (!u) return;
        unitDone.set(u, (unitDone.get(u) ?? false) || r.dataset.status === 'complete');
      });
      const total = unitDone.size;
      const done = [...unitDone.values()].filter(Boolean).length;
      const allDone = total > 0 && done === total;
      bars.forEach((bar) => {
        bar.max = total;
        bar.value = done;
        bar.helperText = `${done} of ${total} reviews complete`;
        bar.status = allDone ? 'finished' : 'active';
      });
      // Roll each unit heading up from its live members: Reviewed once ≥1 is Complete,
      // else In progress if any is Pending, else Not started. Drop a section with no
      // live members left (its last member removed / staged for removal).
      roster.querySelectorAll<HTMLElement>('.unit-group[data-unit-group]').forEach((sec) => {
        if (!sec.dataset.unitGroup) return; // the lead section has no unit key
        const live = Array.from(sec.querySelectorAll<HTMLElement>('.review-row')).filter((r) => r.dataset.stagedRemove !== 'true');
        if (sec.querySelectorAll('.review-row').length === 0) { sec.remove(); return; }
        const kind = live.some((r) => r.dataset.status === 'complete') ? 'succeeded'
          : live.some((r) => r.dataset.status === 'pending') ? 'in-progress' : 'not-started';
        const label = kind === 'succeeded' ? 'Reviewed' : kind === 'in-progress' ? 'In progress' : 'Not started';
        const ind = sec.querySelector('.unit-group__ind');
        ind?.setAttribute('kind', kind);
        ind?.setAttribute('label', label);
      });
    };

    const buildRow = (u: DirUser): HTMLElement => {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.dataset.userId = u.id;
      li.dataset.unit = u.unit || clientUnit(u.role, u.detail);
      li.dataset.email = u.email || '';
      const chip = li.querySelector('.avatar');
      if (chip) chip.textContent = initials(u.name);
      const nameEl = li.querySelector('.review-row__name');
      if (nameEl) nameEl.textContent = u.name;
      const roleEl = li.querySelector('.review-row__role');
      if (roleEl) roleEl.textContent = u.role;
      const addrEl = li.querySelector('.review-row__email-addr');
      if (addrEl) addrEl.textContent = u.email || '';
      const whenEl = li.querySelector('.review-row__when');
      if (whenEl) whenEl.textContent = `Added ${today}`;
      return li;
    };

    // Place a built row into its unit's section, creating the section if this is the
    // first reviewer for that district. New sections append after the existing ones.
    const insertRow = (u: DirUser) => {
      const li = buildRow(u);
      const unit = li.dataset.unit!;
      let sec = roster.querySelector<HTMLElement>(`.unit-group[data-unit-group="${CSS.escape(unit)}"]`);
      if (!sec) {
        sec = groupTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        sec.dataset.unitGroup = unit;
        const title = sec.querySelector('.unit-group__title');
        if (title) title.textContent = unit;
        roster.appendChild(sec);
      }
      sec.querySelector('.unit-members')?.appendChild(li);
      return li;
    };

    // ── Init: replay stored add/remove edits, recompute ──
    const edits = loadTeam();
    edits.removed.forEach((id) => roster.querySelector(`[data-user-id="${id}"]`)?.remove());
    edits.added.forEach((u) => { if (!currentIds().includes(u.id)) insertRow(u); });
    recompute();

    // ── Copy one email · email the whole team ───────────────────────────────
    // Both are read-only utilities, always available (independent of who may edit
    // the roster). Each row carries the address on data-email — seed rows from the
    // directory, added rows from the picker.
    const rowEmail = (row: HTMLElement) => (row.dataset.email || '').trim();
    // The email line (address + copy control) is pointless with no address — hide the
    // whole line for a row that has none (cloned template rows always carry the line).
    const syncCopyButtons = () => {
      rows().forEach((row) => {
        const line = row.querySelector<HTMLElement>('.review-row__email');
        if (line) line.style.display = rowEmail(row) ? '' : 'none';
      });
    };
    syncCopyButtons();

    roster.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest?.('[data-copy-email]');
      if (!btn) return;
      const email = rowEmail(btn.closest<HTMLElement>('.review-row')!);
      if (!email) return;
      navigator.clipboard?.writeText(email).then(
        () => showToast('Email copied', email),
        () => showToast('Couldn’t copy the email', 'Select and copy the address manually.', 'error'),
      );
    });

    // Email all — one message to every team member with an address on file (all in
    // the To line, since it's an internal review team). Dedupes shared addresses.
    document.getElementById('email-all-team')?.addEventListener('click', () => {
      const emails = [...new Set(rows().map(rowEmail).filter(Boolean))];
      if (!emails.length) {
        showToast('No email addresses on file', 'No team member has an email to write to.', 'warning');
        return;
      }
      window.location.href = `mailto:${emails.join(',')}`;
    });

    // ── Add a member inline (staged until Save) ─────────────────────────────
    // Pressing "Add member" inserts the picked user into their unit's section as a
    // Supporting analyst, marked data-staged. Staged rows are visible immediately
    // and count toward the bar, but persist to `permit-team-${id}` only on Save.
    // Cancel / closing the modal discards them. This keeps everything on ONE surface
    // (no second modal) while still being an explicit, reversible edit.
    const addSelect = document.getElementById('team-add-select') as any;
    const cancelBtn = document.getElementById('team-cancel-btn') as HTMLElement | null;
    const emailAllBtn = document.getElementById('email-all-team') as HTMLElement | null;
    const saveBtn = document.getElementById('team-save-btn') as HTMLElement | null;
    const doneBtn = document.getElementById('team-done-btn') as HTMLElement | null;
    let staged: DirUser[] = [];              // not-yet-saved adds
    const stagedRemovals = new Set<string>(); // ids of committed rows staged for removal

    // Footer swap — clean shows [Email all | Done], dirty shows [Cancel | Save
    // changes]. Toggled by inline display because cds-* ignore the `hidden` attribute.
    const setDirty = (dirty: boolean) => {
      if (cancelBtn) cancelBtn.style.display = dirty ? '' : 'none';
      if (saveBtn) saveBtn.style.display = dirty ? '' : 'none';
      if (emailAllBtn) emailAllBtn.style.display = dirty ? 'none' : '';
      if (doneBtn) doneBtn.style.display = dirty ? 'none' : '';
    };
    // Any pending add OR removal makes the session dirty (needs Save/Cancel).
    const refreshFooter = () => setDirty(staged.length > 0 || stagedRemovals.size > 0);

    // Cancel / close → throw away the whole edit session: drop staged adds and un-mark
    // any rows staged for removal, returning the roster to its saved state.
    const discardStaged = () => {
      roster.querySelectorAll('[data-staged]').forEach((r) => r.remove());
      staged = [];
      stagedRemovals.forEach((id) => unmarkRemoval(id));
      stagedRemovals.clear();
      recompute();
      syncCopyButtons();
      setDirty(false);
    };

    // Stage the picked user into their unit's section (Supporting analyst, pending),
    // marked data-staged. Not persisted yet — Save commits, Cancel/close discards.
    const stageMember = (pickedId: string) => {
      if (!pickedId || currentIds().includes(pickedId)) return;
      const opt = addSelect.querySelector(`cds-combo-box-item[value="${CSS.escape(pickedId)}"]`) as HTMLElement | null;
      const name = opt?.dataset.name || pickedId;
      const detail = opt?.dataset.detail || 'Headquarters';
      const email = opt?.dataset.email || '';
      // Unit follows the shared rule — a district office counts toward that district,
      // everything else toward Headquarters.
      const unit = clientUnit('Supporting analyst', detail);
      const u: DirUser = { id: pickedId, name, role: 'Supporting analyst', detail, email, unit };
      const li = insertRow(u);
      li.dataset.staged = 'true';
      const whenEl = li.querySelector('.review-row__when');
      if (whenEl) whenEl.textContent = 'Not saved yet';
      staged.push(u);
      recompute();
      syncCopyButtons();
      refreshFooter();
    };

    // SELECTING a user stages them — no separate Add button. cds-combo-box-selected
    // fires only on a committed pick (not per keystroke). Clear the field afterward
    // so the next pick starts fresh.
    addSelect?.addEventListener('cds-combo-box-selected', () => {
      const pickedId: string = addSelect?.value || '';
      if (pickedId) stageMember(pickedId);
      if (addSelect) addSelect.value = '';
    });

    // ── Remove a member (staged until Save) ─────────────────────────────────
    // Mark/unmark a committed row for removal: strike it, note "Will be removed", and
    // flip the trash tooltip to Undo. Recompute treats staged-remove rows as gone, so
    // the bar + unit rollups preview the saved state; nothing persists until Save.
    const markRemoval = (row: HTMLElement) => {
      row.dataset.stagedRemove = 'true';
      const when = row.querySelector('.review-row__when');
      if (when) { (row as any)._whenBefore = when.textContent; when.textContent = 'Will be removed'; }
      const tip = row.querySelector('.review-row__remove [slot="tooltip-content"]');
      if (tip) tip.textContent = 'Undo remove';
    };
    const unmarkRemoval = (id: string) => {
      const row = roster.querySelector<HTMLElement>(`.review-row[data-user-id="${CSS.escape(id)}"]`);
      if (!row) return;
      delete row.dataset.stagedRemove;
      const when = row.querySelector('.review-row__when');
      if (when && (row as any)._whenBefore != null) when.textContent = (row as any)._whenBefore;
      const tip = row.querySelector('.review-row__remove [slot="tooltip-content"]');
      if (tip) tip.textContent = 'Remove';
    };

    // One remove control per non-lead row. A STAGED add is discarded outright (it was
    // never saved); a COMMITTED member is toggled into/out of the staged-removal set.
    roster.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest?.('[data-remove]');
      if (!btn) return;
      const row = btn.closest<HTMLElement>('.review-row');
      if (!row) return;
      const id = row.dataset.userId || '';
      if (row.dataset.staged === 'true') {
        staged = staged.filter((u) => u.id !== id);
        row.remove();
      } else if (stagedRemovals.has(id)) {
        stagedRemovals.delete(id);
        unmarkRemoval(id);
      } else {
        stagedRemovals.add(id);
        markRemoval(row);
      }
      recompute();          // prunes a unit section left empty; previews the bar
      syncCopyButtons();
      refreshFooter();
    });

    // Save — commit the whole edit session to the shared team edits (survives reload,
    // shows on the Overview too). Adds append to added[]; removals either drop out of
    // added[] (if they were an earlier add) or go onto removed[] (a seed member).
    saveBtn?.addEventListener('click', () => {
      const addCount = staged.length;
      const remCount = stagedRemovals.size;
      if (!addCount && !remCount) { modal.open = false; return; }
      const cur = loadTeam();

      // Commit adds: append (dedup), drop the staged marker, remove from the picker.
      staged.forEach((u) => { if (!cur.added.some((a) => a.id === u.id)) cur.added.push(u); });
      roster.querySelectorAll<HTMLElement>('[data-staged]').forEach((r) => {
        r.removeAttribute('data-staged');
        const whenEl = r.querySelector('.review-row__when');
        if (whenEl) whenEl.textContent = `Added ${today}`;
      });
      staged.forEach((u) => addSelect?.querySelector(`cds-combo-box-item[value="${CSS.escape(u.id)}"]`)?.remove());

      // Commit removals: a previously-added member simply leaves added[]; a seed member
      // is recorded on removed[]. The row leaves the roster either way.
      stagedRemovals.forEach((id) => {
        if (cur.added.some((a) => a.id === id)) cur.added = cur.added.filter((a) => a.id !== id);
        else if (!cur.removed.includes(id)) cur.removed.push(id);
        roster.querySelector<HTMLElement>(`.review-row[data-user-id="${CSS.escape(id)}"]`)?.remove();
      });

      localStorage.setItem(teamKey, JSON.stringify(cur));
      staged = [];
      stagedRemovals.clear();
      recompute();      // prunes any now-empty unit section, refreshes the meters
      syncCopyButtons();
      setDirty(false);
      modal.open = false;

      const parts: string[] = [];
      if (addCount) parts.push(addCount === 1 ? '1 member added' : `${addCount} members added`);
      if (remCount) parts.push(remCount === 1 ? '1 member removed' : `${remCount} members removed`);
      showToast('Analysis team updated', parts.join(' · '));
    });

    // Cancel / X / click-away all close the modal natively; drop the edit session
    // (staged adds AND removals) so the roster returns to its saved state.
    modal.addEventListener('cds-modal-closed', () => {
      if (staged.length || stagedRemovals.size) discardStaged();
    });
    setDirty(false);

    // The Lead analyst reads Complete only once the permit is Out for signature (their
    // sign-off ends the analysis). The workflow script broadcasts permit-status-changed
    // on every transition; repaint the lead row(s) live so the modal stays truthful
    // without a reload. Non-lead rows are driven by their own reviewStatus, untouched.
    const paintLead = (status: string) => {
      const complete = ['Out for signature', 'Waiting for annual report', 'Active'].includes(status);
      roster.querySelectorAll<HTMLElement>('.review-row[data-lead="true"]').forEach((row) => {
        row.dataset.status = complete ? 'complete' : 'pending';
        const ind = row.querySelector('.review-row__ind');
        ind?.setAttribute('kind', complete ? 'succeeded' : 'in-progress');
        ind?.setAttribute('label', complete ? 'Complete' : 'Pending');
        const when = row.querySelector('.review-row__when');
        if (when) when.textContent = complete ? 'Signed off' : 'Reviewing';
      });
    };
    window.addEventListener('permit-status-changed', (e) => {
      paintLead((e as CustomEvent).detail?.status ?? statusNow());
    });
    paintLead(statusNow()); // reflect the persisted status on load (SSR can't see it)
  }
</script>

<style>
  /* Dark banner panel — the header carries the g100 dark theme zone (see the
     `cds--g100` class on the element), so its background is the near-black base
     (--cds-background) and Carbon flips the text, tags, and button to their
     light dark-zone values automatically. Number sits UNDER the name. */
  .banner {
    background: var(--cds-background, #161616);
    /* Full-bleed: break out of the constrained page column so the gray band
       spans the whole viewport width. .banner__inner re-centers the content so
       it stays aligned with the rest of the page. */
    margin-inline: calc(50% - 50vw);
    padding-block: var(--cds-spacing-07, 2rem); /* 32px, on-scale */
    /* The full header just scrolls away normally — no sticky, no resize. The
       compact bar below takes over the pinned role. */
  }

  /* ── Compact bar ─────────────────────────────────────────────────────────
     A position:fixed bar pinned under the UI-Shell header (48px). Constant
     height, out of normal flow — so revealing/hiding it never changes document
     height (that's what kills the scroll-anchoring oscillation). Fades in once
     the full header has scrolled away. Its 48px height + the 48px UI-Shell header
     define the tab strip's sticky offset (6rem) on the page. */
  .compactbar {
    position: fixed;
    top: var(--cds-spacing-09, 3rem);
    left: 0;
    right: 0;
    height: var(--cds-spacing-09, 3rem);
    background: var(--cds-background, #161616);
    z-index: 95;
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .compactbar--shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .compactbar__inner {
    max-inline-size: 99rem;
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--cds-grid-margin, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--cds-spacing-04, 0.75rem);
  }
  .compactbar__number {
    color: var(--cds-text-primary, #f4f4f4);
    white-space: nowrap;
  }
  .compactbar__window {
    color: var(--cds-text-secondary, #c6c6c6);
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .compactbar__spacer {
    flex: 1 1 auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .compactbar {
      transition: none;
    }
  }

  /* Re-center the full-bleed banner's content to match the 2x Grid: same 99rem
     cap and responsive page margin as .cds--css-grid, so the header lines up
     with the panels below. */
  .banner__inner {
    max-inline-size: 99rem;
    margin-inline: auto;
    padding-inline: var(--cds-grid-margin, 1.5rem);
  }
  /* Breadcrumb row sits above the title, inside the dark header. */
  .banner__crumb {
    margin-bottom: var(--cds-spacing-05, 1rem); /* 16px */
  }
  .banner__main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .banner__lead {
    min-width: 0;
    flex: 1 1 22rem;
  }
  /* Organization eyebrow — sits above the title, subordinate to it (secondary
     value, not a hue). Meaningful content, not an ornamental micro-label. */
  .banner__eyebrow {
    margin: 0 0 var(--cds-spacing-03, 0.5rem); /* 8px */
    color: var(--cds-text-secondary, #525252);
  }
  .banner__title {
    margin: 0;
    max-width: 46rem;
  }
  .banner__id-row {
    display: flex;
    align-items: center;
    gap: var(--cds-spacing-04, 0.75rem);
    margin-top: var(--cds-spacing-03, 0.5rem); /* 8px */
  }
  .banner__number {
    color: var(--cds-text-primary, #161616);
  }
  .banner__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cds-spacing-02, 0.25rem);
    margin-top: var(--cds-spacing-05, 1rem); /* 16px, on-scale */
  }
  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    flex: 0 0 auto;
  }
  /* Only the action set for the current status is shown; the script toggles
     [hidden] on the rest. Custom elements don't honor the UA [hidden] rule
     reliably, so force it. */
  [data-when][hidden] {
    display: none;
  }
  /* Facts strip: the labeled facts on the left, the optional analysis-review
     key-metric on the right, sharing the divider above them. */
  .banner__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--cds-spacing-06, 1.5rem);
    margin-top: var(--cds-spacing-07, 2rem);      /* 32px above the divider */
    padding-top: var(--cds-spacing-06, 1.5rem);   /* 24px, on-scale */
    border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  .banner__stats {
    flex: 1 1 22rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--cds-spacing-06, 1.5rem);
