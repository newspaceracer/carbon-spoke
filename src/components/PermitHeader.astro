  .review-row__name {
    margin: 0;
    color: var(--cds-text-primary, #161616);
  }
  .review-row__role {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
  /* Email sits under the name with an inline copy control (this is where the copy
     affordance lives now). The address truncates; the button never shrinks. */
  .review-row__email {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--cds-spacing-02, 0.25rem);
    min-width: 0;
    color: var(--cds-text-secondary, #525252);
  }
  .review-row__email-addr {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .review-row__copy {
    flex: 0 0 auto;
  }
  /* Status column: the state (indicator + label) over the date/time line, both
     hugging the column's left edge so they share a start line. */
  .review-row__status {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    min-width: 0;
  }
  .review-row__ind {
    white-space: nowrap;
  }
  /* The date/time sits UNDER the status text, not under the icon — indent it by the
     icon (16px) + the indicator's icon↔label gap (0.5rem) so it lines up with where
     "Complete" / "Pending" / "Not started" begins. */
  .review-row__when {
    padding-inline-start: calc(16px + var(--cds-spacing-03, 0.5rem));
    text-align: left;
    color: var(--cds-text-secondary, #525252);
  }
  .review-row__when:empty { display: none; }
  /* An analyst whose unit another analyst already completed: their own date line
     gives way to "Not required". */
  .review-row__note {
    display: none;
    padding-inline-start: calc(16px + var(--cds-spacing-03, 0.5rem));
    color: var(--cds-text-secondary, #525252);
  }
  .review-row[data-covered] .review-row__when { display: none; }
  .review-row[data-covered] .review-row__note { display: block; }

  @media (max-width: 42rem) {
    /* Stack the status under the identity on a narrow modal; the avatar spans both rows. */
    .review-roster { --status-track: auto; }
    .unit-group__head { grid-template-columns: minmax(0, 1fr) auto var(--toggle-track); }
    .review-row {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "avatar id"
        "avatar status";
      row-gap: var(--cds-spacing-03, 0.5rem);
    }
  }

  /* Approve modal: quiet reminder of the applicant's requested window, sitting
     directly under the editable confirmation date range. Secondary value only —
     it's context, not the field. */
  .requested-reminder {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }

  /* Signed-letter upload modal — spacing only; the uploader and file item are stock. */
  .signed-upload__lead { margin: 0 0 var(--cds-spacing-05, 1rem); }
  .signed-upload__notice { margin: 0 0 var(--cds-spacing-05, 1rem); }
  /* The callout's content row wraps (flex) — a full-width body line drops the
     details under the title: title = the fact, details = which permit and when. */
  .signed-upload__notice p { flex-basis: 100%; margin-block-start: var(--cds-spacing-02, 0.25rem); }
</style>
