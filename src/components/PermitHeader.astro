  }
  .stat {
    min-width: 0;
  }
  .stat__label {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
  .stat__value {
    margin: 0.25rem 0 0;
    color: var(--cds-text-primary, #161616);
  }

  /* ── Analysis-review key metric ──────────────────────────────────────────
     A clickable tile in the facts strip: the completion meter + a "View team"
     affordance. Opens the roster modal. Reset the native button so only the
     meter's own tokens show; the hover/focus ring signals it's interactive. */
  .analysis-metric {
    flex: 0 1 20rem;
    display: flex;
    flex-direction: column;
    gap: var(--cds-spacing-03, 0.5rem);
    padding: var(--cds-spacing-04, 0.75rem);
    margin: calc(-1 * var(--cds-spacing-04, 0.75rem));
    background: transparent;
    border: 0;
    border-radius: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    transition: background 0.11s ease;
  }
  .analysis-metric:hover {
    background: var(--cds-layer-hover, rgba(141, 141, 141, 0.16));
  }
  .analysis-metric:focus-visible {
    outline: 2px solid var(--cds-focus, #0f62fe);
    outline-offset: -2px;
  }
  .analysis-metric__bar {
    display: block;
    width: 100%;
    pointer-events: none; /* the whole tile is the click target */
  }
  .analysis-metric__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    color: var(--cds-link-primary, #78a9ff);
  }
  .analysis-metric__cta svg {
    fill: currentColor;
  }

  /* ── Roster modal ── */
  /* Inline add-member picker — selecting a user stages them (no add button). */
  .team-add cds-combo-box {
    display: block;
  }
  .review-roster {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--cds-spacing-06, 1.5rem);
    /* Cap the roster and let IT scroll, so a long team never grows the modal past
       the viewport (and so the add-reviewer dropdown above it clears the list). */
    max-block-size: 24rem;
    overflow-y: auto;
  }
  /* One section per review unit (Headquarters, each district) + the lead. */
  .unit-group__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cds-spacing-05, 1rem);
    padding-block-end: var(--cds-spacing-03, 0.5rem);
    border-block-end: 1px solid var(--cds-border-strong-01, #8d8d8d);
  }
  .unit-group__title {
    margin: 0;
    color: var(--cds-text-primary, #161616);
  }
  /* The unit's roll-up state — Reviewed once ≥1 member is Complete, else In progress
     / Not started. The icon-indicator renders its own label, so it's icon + text,
     not colour alone. */
  .unit-group__ind {
    white-space: nowrap;
  }
  .unit-members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  /* Named grid areas keep the four cells (identity / status / remove) in lockstep
     across rows so their edges align, and let the layout re-flow cleanly on a narrow
     modal without per-child reordering. The status track is FIXED so its left edge
     lands on the same vertical line in every row. */
  .review-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 11rem auto;
    grid-template-areas: "avatar id status remove";
    align-items: center;
    gap: var(--cds-spacing-05, 1rem);
    padding: var(--cds-spacing-05, 1rem) 0;
    border-block-end: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  .review-row > .avatar { grid-area: avatar; }
  .review-row__id { grid-area: id; }
  .review-row__status { grid-area: status; }
  .review-row__remove { grid-area: remove; }
  /* The last row in a unit sits flush — the section gap does the separating. */
  .unit-members .review-row:last-child {
    border-block-end: none;
  }
  /* Identity block: name, role, then the email line under it. */
  .review-row__id {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .review-row__name {
    margin: 0;
    color: var(--cds-text-primary, #161616);
  }
  .review-row__lead {
    color: var(--cds-text-secondary, #525252);
  }
  .review-row__role {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
  /* Email sits under the name with an inline copy control (this is where the copy
     affordance lives now). The address truncates; the button never shrinks. */
  .review-row__email {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--cds-spacing-02, 0.25rem);
    min-width: 0;
    color: var(--cds-text-secondary, #525252);
  }
  .review-row__email-addr {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .review-row__copy {
    flex: 0 0 auto;
  }
  /* Status column: the state (indicator + label) over the date/time line, both
     hugging the column's left edge so they share a start line. */
  .review-row__status {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    min-width: 0;
  }
  .review-row__ind {
    white-space: nowrap;
  }
  /* The date/time sits UNDER the status text, not under the icon — indent it by the
     icon (16px) + the indicator's icon↔label gap (0.5rem) so it lines up with where
     "Complete" / "Pending" / "Not started" begins. */
  .review-row__when {
    padding-inline-start: calc(16px + var(--cds-spacing-03, 0.5rem));
    text-align: left;
    color: var(--cds-text-secondary, #525252);
  }
  /* Remove toggle — present only when the team is editable (JS sets data-editable on
     the roster). Hidden entirely on a read-only view. */
  .review-row__remove {
    display: none;
  }
  .review-roster[data-editable="true"] .review-row__remove {
    display: inline-flex;
  }
  /* A staged (unsaved) add reads as provisional until Save. */
  .review-row[data-staged] .review-row__when {
    color: var(--cds-text-error, #da1e28);
  }
  /* A row staged for removal is struck through + dimmed until Save; its date line
     becomes the "Will be removed" note (not struck, so it stays legible). */
  .review-row[data-staged-remove] {
    opacity: 0.6;
  }
  .review-row[data-staged-remove] .review-row__name,
  .review-row[data-staged-remove] .review-row__email-addr {
    text-decoration: line-through;
  }
  .review-row[data-staged-remove] .review-row__when {
    color: var(--cds-text-error, #da1e28);
    text-decoration: none;
  }
  @media (max-width: 42rem) {
    /* Stack the status under the identity on a narrow modal; the remove toggle spans
       both rows on the right, the avatar both rows on the left. */
    .review-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "avatar id     remove"
        "avatar status remove";
      row-gap: var(--cds-spacing-03, 0.5rem);
    }
  }

  /* Approve modal: quiet reminder of the applicant's requested window, sitting
     directly under the editable confirmation date range. Secondary value only —
     it's context, not the field. */
  .requested-reminder {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
</style>
