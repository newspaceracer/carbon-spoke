  }
  .stat {
    min-width: 0;
  }
  .stat__label {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }
  .stat__value {
    margin: 0.25rem 0 0;
    color: var(--cds-text-primary, #161616);
  }

  /* ── Analysis-review key metric ──────────────────────────────────────────
     A clickable tile in the facts strip: the completion meter + a "View team"
     affordance. Opens the roster modal. Reset the native button so only the
     meter's own tokens show; the hover/focus ring signals it's interactive. */
  .analysis-metric {
    flex: 0 1 20rem;
    display: flex;
    flex-direction: column;
    gap: var(--cds-spacing-03, 0.5rem);
    padding: var(--cds-spacing-04, 0.75rem);
    margin: calc(-1 * var(--cds-spacing-04, 0.75rem));
    background: transparent;
    border: 0;
    border-radius: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    transition: background 0.11s ease;
  }
  .analysis-metric:hover {
    background: var(--cds-layer-hover, rgba(141, 141, 141, 0.16));
  }
  .analysis-metric:focus-visible {
    outline: 2px solid var(--cds-focus, #0f62fe);
    outline-offset: -2px;
  }
  .analysis-metric__bar {
    display: block;
    width: 100%;
    pointer-events: none; /* the whole tile is the click target */
  }
  .analysis-metric__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    color: var(--cds-link-primary, #78a9ff);
  }
  .analysis-metric__cta svg {
    fill: currentColor;
  }

  /* ── Roster modal ── */
  .review-roster {
    --status-track: 11rem;
    --toggle-track: 2rem;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--cds-spacing-06, 1.5rem);
  }
  /* One section per review unit (Headquarters, each district) + the lead. The
     heading shares the rows' status track, so a unit's roll-up status starts on the
     same vertical line as its members'; who completed it sits under that status. The
     last track holds the collapse toggle (rows keep it empty so the columns match). */
  .unit-group__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--status-track) var(--toggle-track);
    grid-template-areas:
      "title ind toggle"
      ".     by  toggle";
    align-items: center;
    column-gap: var(--cds-spacing-05, 1rem);
    row-gap: 0.125rem;
    padding-block-end: var(--cds-spacing-03, 0.5rem);
    border-block-end: 1px solid var(--cds-border-strong-01, #8d8d8d);
  }
  .unit-group__title {
    grid-area: title;
    margin: 0;
    color: var(--cds-text-primary, #161616);
  }
  /* The unit's roll-up state — Complete once ≥1 member is, else In progress / Not
     started. The icon-indicator renders its own label (icon + text, not colour alone). */
  .unit-group__ind {
    grid-area: ind;
    white-space: nowrap;
  }
  .unit-group__by {
    grid-area: by;
    /* Indented past the icon so it lines up under the status text. */
    padding-inline-start: calc(16px + var(--cds-spacing-03, 0.5rem));
    color: var(--cds-text-secondary, #525252);
  }
  .unit-group__by:empty { display: none; }
  .unit-group__toggle { grid-area: toggle; justify-self: end; }
  /* Chevron points down when collapsed (expand), up when open. */
  /* (The SVG comes in via set:html, so it carries no scope attribute → :global.) */
  .unit-group__toggle :global(svg) { transition: transform 0.11s ease; }
  .unit-group[data-collapsed] .unit-group__toggle :global(svg) { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .unit-group__toggle :global(svg) { transition: none; } }
  .unit-members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  /* Named grid areas keep the cells in lockstep across rows (and with the unit
     heading above) so their edges align. The status track is FIXED so its left edge
     lands on the same vertical line in every row. */
  .review-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) var(--status-track) var(--toggle-track);
    grid-template-areas: "avatar id status .";
    /* Top-aligned: the status sits level with the name, not floating mid-row. */
    align-items: start;
    gap: var(--cds-spacing-05, 1rem);
    padding: var(--cds-spacing-05, 1rem) 0;
    border-block-end: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  .review-row > .avatar { grid-area: avatar; }
  .review-row__id { grid-area: id; }
  .review-row__status { grid-area: status; }
  /* The last row in a unit sits flush — the section gap does the separating. */
  .unit-members .review-row:last-child {
    border-block-end: none;
  }
  /* Identity block: name, role, then the email line under it. */
  .review-row__id {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
