<script>
  // Application / conditions tabs. cds-tabs only renders the strip; showing the
  // panel is ours (inline display — a plain [hidden] div can lose to author CSS).
  // The contents rail belongs to the application, so it hides with it. The URL
  // hash keeps the tab: #conditions / #letter / #report open that tab; any
  // in-page link to the application (contents, "Go to the answer") switches back.
  const tabs = document.querySelector('[data-record-tabs]') as any;
  const panels = [...document.querySelectorAll<HTMLElement>('[data-record-panel]')];
  const rail = document.querySelector<HTMLElement>('[data-record-rail]');
  const show = (value: string, { scrollTo }: { scrollTo?: string } = {}) => {
    panels.forEach((p) => { p.style.display = p.dataset.recordPanel === value ? '' : 'none'; });
    if (rail) rail.style.display = value === 'application' ? '' : 'none';
    if (tabs && tabs.value !== value) tabs.value = value;
    document.querySelector('[data-record-toc]')?.dispatchEvent(new Event('record-toc-refresh'));
    if (scrollTo) document.getElementById(scrollTo)?.scrollIntoView();
  };
  const panelFor = (id: string) =>
    document.getElementById(id)?.closest<HTMLElement>('[data-record-panel]')?.dataset.recordPanel;
  const fromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (panels.some((p) => p.dataset.recordPanel === id)) { show(id); return; }
    const panel = id ? panelFor(id) : null;
    show(panel ?? 'application', panel ? { scrollTo: id } : {});
  };
  tabs?.addEventListener('cds-tabs-selected', () => {
    show(tabs.value);
    history.replaceState(null, '', tabs.value === 'application' ? location.pathname + location.search : `#${tabs.value}`);
    window.scrollTo({ top: (document.querySelector('[data-record-tabs-wrap]') as HTMLElement)?.offsetTop - 64 || 0 });
  });
  window.addEventListener('hashchange', fromHash);
  // Wait for the strip to upgrade before setting its value.
  customElements.whenDefined('cds-tabs').then(async () => { await tabs?.updateComplete; fromHash(); });
  fromHash();
</script>

