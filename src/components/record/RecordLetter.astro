---
// "Final permit letter" tab: the letter EXACTLY as it was sent for signature. The
// review wizard (final-letter.astro) freezes the rendered letter into
// permit-letter-${id} when it sends; this shows that copy (an approved letter must
// never re-derive from later edits). No copy on file — e.g. a status preview —
// says so rather than inventing a letter.
//
// Activation is a signed-letter UPLOAD (no in-system signing): the Responsible
// Agent downloads this letter, has it signed outside the system, and uploads the
// signed copy (PermitHeader's #sign-permit-modal, which writes
// permit-signed-letter-${id} = { name, by, at }). Once uploaded, the signed letter
// leads the tab and the generated letter stays below it.
//
// After signature the System Admin (only) can replace the signed letter, or upload
// one that's missing — same modal, no status change; the replaced file stays on the
// record as `previous`.
import { permit } from '../../data/permit';
import '../../styles/permit-letter.css';
---

<div class="rl" data-record-letter data-permit-id={permit.id}>
  <cds-inline-notification
    data-rl-empty
    kind="info"
    low-contrast
    hide-close-button
    title="No letter on file yet"
    subtitle="It appears here once it's sent for signature."
    style="display: none"
  ></cds-inline-notification>

  <!-- The signed letter of record — revealed once the Responsible Agent uploads it
       (or, for the admin, once the permit is past signature without one). -->
  <section class="rl__signed" data-rl-signed aria-labelledby="rl-signed-title" style="display: none">
    <h3 id="rl-signed-title" class="t-heading-02">Signed letter</h3>
    <p class="t-body-01 rl__none" data-rl-signed-none style="display: none">No signed letter on file.</p>
    <dl class="rl__meta" data-rl-signed-meta>
      <div><dt class="t-label-01">File</dt><dd class="t-body-01" data-rl-signed-name></dd></div>
      <div><dt class="t-label-01">Uploaded</dt><dd class="t-body-01" data-rl-signed-at></dd></div>
      <div data-rl-signed-prev style="display: none"><dt class="t-label-01">Replaced</dt><dd class="t-body-01" data-rl-signed-prev-text></dd></div>
    </dl>
    <div class="rl__actions">
      <cds-button kind="tertiary" size="md" data-rl-signed-download>Download signed letter</cds-button>
      <cds-button kind="tertiary" size="md" data-rl-replace style="display: none">Replace signed letter</cds-button>
    </div>
  </section>

  <section data-rl-doc aria-labelledby="rl-doc-title" style="display: none">
    <h3 id="rl-doc-title" class="t-heading-02" data-rl-doc-title>Permit letter</h3>
    <dl class="rl__meta">
      <div><dt class="t-label-01">Sent for signature</dt><dd class="t-body-01" data-rl-sent></dd></div>
      <div><dt class="t-label-01">Signed letter</dt><dd class="t-body-01"><cds-icon-indicator data-rl-sig size="16"></cds-icon-indicator></dd></div>
    </dl>
    <div class="rl__actions">
      <cds-button kind="tertiary" size="md" data-rl-download>Download letter</cds-button>
      <cds-button kind="primary" size="md" data-rl-upload style="display: none">Upload signed letter</cds-button>
    </div>
    <article class="rl__sheet ltr-sheet cds--white" aria-label={`Final permit letter for ${permit.id}`} data-rl-sheet></article>
  </section>
</div>

<script>
  import { readIdentity } from '../../lib/maintenance';
  import { readPermitRole } from '../../lib/permissions';
  import { downloadSignedLetter, downloadUnsignedLetter } from '../../lib/letter-download';

  const root = document.querySelector<HTMLElement>('[data-record-letter]');
  if (root) {
    const id = root.dataset.permitId!;
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const shown = (el: HTMLElement, on: boolean) => { el.style.display = on ? '' : 'none'; };
    const read = (k: string) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch { return null; } };
    const status = () => localStorage.getItem(`permit-status-${id}`)
      || document.getElementById('permit-banner')?.dataset.status || '';
    // The upload lives in the permit header's modal; without it (another host
    // page) the tab only reads.
    const uploadModal = document.getElementById('sign-permit-modal') as any;
    const who = readIdentity();
    const canUpload = () => !!uploadModal && status() === 'Out for signature'
      && (who === 'admin' || readPermitRole(id) === 'responsible');

    $('[data-rl-download]').addEventListener('click', () => downloadUnsignedLetter(id));
    $('[data-rl-signed-download]').addEventListener('click', () => downloadSignedLetter(id));
    $('[data-rl-upload]').addEventListener('click', () => { if (uploadModal) uploadModal.open = true; });
    // Admin: replace (or add a missing) signed letter after signature.
    const SIGNED = ['Active', 'Waiting for annual report', 'Expired'];
    const canReplace = () => !!uploadModal && who === 'admin' && SIGNED.includes(status());
    $('[data-rl-replace]').addEventListener('click', () => {
      const current = (read(`permit-signed-letter-${id}`) as { name: string } | null)?.name;
      window.dispatchEvent(new CustomEvent('signed-letter-open', { detail: { current } }));
    });

    const paint = () => {
      const letter = read(`permit-letter-${id}`) as { html: string; sentAt: string; sentBy?: string } | null;
      type Upload = { name: string; by: string; at: string };
      const signed = read(`permit-signed-letter-${id}`) as (Upload & { previous?: Upload[] }) | null;
      const replace = canReplace();
      shown($('[data-rl-empty]'), !letter && !replace);
      shown($('[data-rl-doc]'), !!letter);
      shown($('[data-rl-signed]'), !!signed || replace);
      shown($('[data-rl-signed-none]'), !signed);
      shown($('[data-rl-signed-meta]'), !!signed);
      shown($('[data-rl-signed-download]'), !!signed);
      shown($('[data-rl-replace]'), replace);
      $('[data-rl-replace]').textContent = signed ? 'Replace signed letter' : 'Upload signed letter';
      if (signed) {
        $('[data-rl-signed-name]').textContent = signed.name;
        $('[data-rl-signed-at]').textContent = `${signed.at} by ${signed.by}`;
        const prev = signed.previous?.at(-1);
        shown($('[data-rl-signed-prev]'), !!prev);
        if (prev) $('[data-rl-signed-prev-text]').textContent = `${prev.name} · uploaded ${prev.at} by ${prev.by}`;
      }
      if (!letter) return;
      // Once the signed copy leads, the generated one is named for what it is.
      $('[data-rl-doc-title]').textContent = signed ? 'Unsigned letter' : 'Letter';
      $('[data-rl-sheet]').innerHTML = letter.html; // our own rendered letter
      $('[data-rl-sent]').textContent = letter.sentBy ? `${letter.sentAt} by ${letter.sentBy}` : letter.sentAt;
      const sig = $('[data-rl-sig]');
      sig.setAttribute('kind', signed ? 'succeeded' : 'pending');
      sig.setAttribute('label', signed ? `Uploaded ${signed.at}` : 'Waiting for upload');
      shown($('[data-rl-upload]'), !signed && canUpload());
    };
    paint();
    window.addEventListener('permit-status-changed', paint);
    window.addEventListener('signed-letter-changed', paint);
  }
</script>

<style>
  /* Layout only — the letter's own styles come from permit-letter.css. */
  .rl { display: flex; flex-direction: column; gap: var(--cds-spacing-07, 2rem); }
  .rl section { display: flex; flex-direction: column; gap: var(--cds-spacing-05, 1rem); align-items: flex-start; }
  .rl h3 { margin: 0; }
  .rl__none { margin: 0; color: var(--cds-text-secondary, #525252); }
  .rl__meta { display: flex; flex-wrap: wrap; gap: var(--cds-spacing-05, 1rem) var(--cds-spacing-09, 3rem); margin: 0; }
  .rl__meta dt { color: var(--cds-text-secondary, #525252); margin-bottom: var(--cds-spacing-02, 0.25rem); }
  .rl__meta dd { margin: 0; }
  .rl__actions { display: flex; flex-wrap: wrap; gap: var(--cds-spacing-03, 0.5rem); }
  .rl__sheet {
    align-self: stretch;
    background: var(--cds-background, #ffffff);
    border: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    padding: var(--cds-spacing-09, 3rem);
    color: var(--cds-text-primary, #161616);
  }
  @media (max-width: 42rem) { .rl__sheet { padding: var(--cds-spacing-05, 1rem); } }
</style>
