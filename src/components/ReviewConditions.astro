---
// Special conditions, rendered the way the permit DETAIL page shows them: a
// Headquarters (universal) block plus one block per district on the permit, each a
// cds-contained-list of the conditions APPLIED to the permit. The data comes from
// the real special-conditions catalog (src/data/conditions.ts) — the same source
// the detail page reads — so the review-layout studies present the TRUE structure
// (owner blocks, rich-text bodies, source tags), not a flat mock list.
//
// Read + optional per-row remove; adding is driven by the host page's shared
// Add-condition modal, which appends rows into the matching [data-cond-list].
//
// carbon-checked: stock cds-contained-list / cds-contained-list-item / cds-tag /
// cds-icon-button — the identical primitives the detail page's Special conditions
// tab composes. The rich-text condition body is our own sanitized seed HTML.
export interface CondItem {
  id: string;
  /** Sanitized rich-text HTML — the whole condition. */
  body: string;
  source: 'default' | 'inventory' | 'custom';
}
export interface CondGroup {
  /** 'hq' or a district slug. */
  key: string;
  label: string;
  /** Authorized-park count for a district block; null for HQ. */
  parks: number | null;
  items: CondItem[];
}
interface Props {
  groups: CondGroup[];
  /** Tighten spacing for a narrow column (layouts B / E). */
  compact?: boolean;
  /** Show the per-row remove control (the interactive docks). */
  removable?: boolean;
  /** Make each owner block (Headquarters, and every district) a collapsible
   *  cds-accordion-item — the reviewer folds away the owners they aren't working
   *  through, the way the application record's sections collapse. All open on load. */
  collapsible?: boolean;
}
const { groups, compact = false, removable = true, collapsible = false } = Astro.props;

// Same source→label mapping the detail page uses (permit.astro sourceLabel).
const sourceLabel = (s: CondItem['source']) =>
  s === 'default' ? 'Standard' : s === 'inventory' ? 'From catalog' : 'Custom';
const addedBy = (s: CondItem['source']) =>
  s === 'default' ? 'Standard condition' : s === 'inventory' ? 'From catalog' : 'Custom';

const hq = groups.find((g) => g.key === 'hq');
const districts = groups.filter((g) => g.key !== 'hq');

const trash =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>';
const edit =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M2 26h28v2H2zM25.4 9c.8-.8.8-2 0-2.8l-3.6-3.6c-.8-.8-2-.8-2.8 0l-15 15V26h8.4zM20.4 4L24 7.6l-3 3L17.4 7zM6 24v-3.6l10-10 3.6 3.6-10 10z"/></svg>';
---

<div class:list={['rc', compact && 'rc--compact', collapsible && 'rc--collapsible', removable && 'rc--removable']}>
  {collapsible ? (
    /* Each owner is a collapsible accordion item — the reviewer folds away the
       owners they aren't working through, the way the record's sections collapse.
       Owner lists keep their [data-cond-list]/[data-owner] hooks so the host page's
       Add-condition modal still appends into the right list. */
    <cds-accordion class="rc-acc" size="md">
      {hq && (
        <cds-accordion-item title="Headquarters conditions" open>
          <p class="rc-hint t-body-01">Apply to all locations covered by this permit.</p>
          <cds-contained-list data-cond-list data-owner="hq" kind="on-page" label="Universal conditions">
            {hq.items.map((c) => (
              <cds-contained-list-item>
                <div class="rc-cond">
                  <div class="rc-cond__body" set:html={c.body}></div>
                  <div class="rc-cond__meta">
                    <cds-tag type="cool-gray" size="sm">{sourceLabel(c.source)}</cds-tag>
                    <span class="rc-cond__by t-label-01">{addedBy(c.source)}</span>
                  </div>
                </div>
                {removable && (
                  <div class="rc-cond__actions" {...{ slot: 'action' }}>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-edit-cond set:html={`${edit}<span slot="tooltip-content">Edit condition</span>`}></cds-icon-button>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-remove-cond set:html={`${trash}<span slot="tooltip-content">Remove condition</span>`}></cds-icon-button>
                  </div>
                )}
              </cds-contained-list-item>
            ))}
          </cds-contained-list>
        </cds-accordion-item>
      )}
      {districts.map((d) => (
        <cds-accordion-item title={d.label} open>
          <cds-contained-list data-cond-list data-owner={d.key} kind="on-page" label={d.parks != null ? `${d.parks} authorized parks` : 'District conditions'}>
            {d.items.map((c) => (
              <cds-contained-list-item>
                <div class="rc-cond">
                  <div class="rc-cond__body" set:html={c.body}></div>
                  <div class="rc-cond__meta">
                    <cds-tag type="cool-gray" size="sm">{sourceLabel(c.source)}</cds-tag>
                    <span class="rc-cond__by t-label-01">{addedBy(c.source)}</span>
                  </div>
                </div>
                {removable && (
                  <div class="rc-cond__actions" {...{ slot: 'action' }}>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-edit-cond set:html={`${edit}<span slot="tooltip-content">Edit condition</span>`}></cds-icon-button>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-remove-cond set:html={`${trash}<span slot="tooltip-content">Remove condition</span>`}></cds-icon-button>
                  </div>
                )}
              </cds-contained-list-item>
            ))}
          </cds-contained-list>
        </cds-accordion-item>
      ))}
    </cds-accordion>
  ) : (
    <Fragment>
      {hq && (
        <section class="rc-block">
          <h4 class="rc-block__title t-heading-02">Headquarters conditions</h4>
          <p class="rc-hint t-body-01">Apply to all locations covered by this permit.</p>
          <cds-contained-list data-cond-list data-owner="hq" kind="on-page" label="Universal conditions">
            {hq.items.map((c) => (
              <cds-contained-list-item>
                <div class="rc-cond">
                  <div class="rc-cond__body" set:html={c.body}></div>
                  <div class="rc-cond__meta">
                    <cds-tag type="cool-gray" size="sm">{sourceLabel(c.source)}</cds-tag>
                    <span class="rc-cond__by t-label-01">{addedBy(c.source)}</span>
                  </div>
                </div>
                {removable && (
                  <div class="rc-cond__actions" {...{ slot: 'action' }}>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-edit-cond set:html={`${edit}<span slot="tooltip-content">Edit condition</span>`}></cds-icon-button>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-remove-cond set:html={`${trash}<span slot="tooltip-content">Remove condition</span>`}></cds-icon-button>
                  </div>
                )}
              </cds-contained-list-item>
            ))}
          </cds-contained-list>
        </section>
      )}

      {districts.length > 0 && (
        <section class="rc-block">
          <h4 class="rc-block__title t-heading-02">District special conditions</h4>
          <p class="rc-hint t-body-01">Additional conditions apply within each district on this permit.</p>
          {districts.map((d) => (
            <cds-contained-list data-cond-list data-owner={d.key} kind="on-page">
              <div slot="label" class="rc-dlabel">
                <span class="rc-dlabel__name">{d.label}</span>
                {d.parks != null && <span class="rc-dlabel__count t-label-01">{d.parks} authorized parks</span>}
              </div>
              {d.items.map((c) => (
                <cds-contained-list-item>
                  <div class="rc-cond">
                    <div class="rc-cond__body" set:html={c.body}></div>
                    <div class="rc-cond__meta">
                      <cds-tag type="cool-gray" size="sm">{sourceLabel(c.source)}</cds-tag>
                      <span class="rc-cond__by t-label-01">{addedBy(c.source)}</span>
                    </div>
                  </div>
                  {removable && (
                    <div class="rc-cond__actions" {...{ slot: 'action' }}>
                      <cds-icon-button kind="ghost" size="sm" align="left" data-edit-cond set:html={`${edit}<span slot="tooltip-content">Edit condition</span>`}></cds-icon-button>
                      <cds-icon-button kind="ghost" size="sm" align="left" data-remove-cond set:html={`${trash}<span slot="tooltip-content">Remove condition</span>`}></cds-icon-button>
                    </div>
                  )}
                </cds-contained-list-item>
              ))}
            </cds-contained-list>
          ))}
        </section>
      )}
    </Fragment>
  )}
</div>

<style>
  .rc { display: flex; flex-direction: column; gap: var(--cds-spacing-07, 2rem); }
  .rc--compact { gap: var(--cds-spacing-06, 1.5rem); }
  .rc-block { display: flex; flex-direction: column; gap: var(--cds-spacing-03, 0.5rem); }
  .rc-block__title { margin: 0; }
  .rc-hint { margin: 0 0 var(--cds-spacing-03, 0.5rem); color: var(--cds-text-secondary, #525252); }

  /* Condition item — a column (rich-text body over its source meta), matching the
     detail page's .cond. The rich body is server-injected set:html, so its inner
     tags carry no scoped attribute → those rules must be :global. */
  .rc-cond { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  /* Carbon renders the contained-list-item `action` slot as position:absolute at the
     top-right (it overlays the content, reserving no space — it assumes a short,
     single-line item). Our condition body is multi-line rich text, so its first line
     runs UNDER the edit + trash icons. Reserve room on the right for the two sm icon
     buttons so the text clears them. Only when actions are shown (rc--removable), and
     :global so it also reaches rows cloned from the page's cond-row-template. */
  :global(.rc--removable .rc-cond) { padding-inline-end: 4.5rem; }
  :global(.rc-cond__body) { color: var(--cds-text-primary, #161616); font-size: 0.875rem; line-height: 1.28572; }
  :global(.rc-cond__body p) { margin: 0 0 0.375rem; font-size: 0.875rem; }
  :global(.rc-cond__body p:last-child) { margin-bottom: 0; }
  :global(.rc-cond__body ul), :global(.rc-cond__body ol) { margin: 0 0 0.375rem; padding-left: 1.5rem; }
  :global(.rc-cond__body ul) { list-style: disc; }
  :global(.rc-cond__body ol) { list-style: decimal; }
  :global(.rc-cond__body a) { color: var(--cds-link-primary, #0f62fe); }
  .rc-cond__meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .rc-cond__by { color: var(--cds-text-secondary, #525252); }
  :global(.rc-cond__actions) { display: flex; gap: 0.125rem; align-items: center; }

  .rc-dlabel { display: flex; flex-direction: column; gap: 0.125rem; }
  .rc-dlabel__count { color: var(--cds-text-secondary, #525252); }

  /* Collapsible owners (collapsible mode). Carbon caps accordion content with a wide
     responsive trailing padding for prose line length — right for prose, but it boxes
     these condition bodies. Drop it to a normal gutter (::part(content) is Carbon's
     sanctioned hook), and give the HQ hint a little breathing room above its list. */
  .rc-acc cds-accordion-item::part(content) { padding-inline-end: var(--cds-spacing-05, 1rem); }
  .rc-acc .rc-hint { margin: 0 0 var(--cds-spacing-03, 0.5rem); }
</style>
