---
// A titled section of the application record. Three modes:
//
//   • default — a plain titled block with a hairline rule, IDENTICAL to
//     PermitSection (so the finalize wizard's step ① is unchanged). It simply
//     renders PermitSection.
//   • collapsible — the header becomes a disclosure toggle and the body collapses.
//     Used by the review wizard, where the headers are also made
//     STICKY-STACKABLE: each pins at an offset (orderIndex × header height) so the
//     section headers pile up at the top of the scroll pane as you scroll.
//     `orderIndex` drives both the visual order (CSS `order`) and the sticky offset
//     (so the pinned headers stay in visual order); `open` sets the initial state.
//     Expand/collapse-all + per-section toggling is wired by the page script
//     (final-letter.astro) via the data-section-toggle / data-section-body hooks.
//   • panel — the permit DETAIL page's static read: a raised (layer-01) panel on
//     the page's g10 field with the title + badges in its head, content one layer
//     deeper (cds-layer level 1 — gray tiles on the white panel). No collapsing:
//     the detail's tabs already chunk the record, so a disclosure would be a control
//     without a job.
//
// `commentKey` marks the section as a target in the detail page's anchored-comments
// study (?comments=anchored): the page injects a comment control into the
// [data-section-aside] hook and a thread after [data-section-head]. Inert elsewhere.
//
// carbon-checked: cds-accordion is the spoke's collapsible primitive, but its
// header lives in shadow DOM and cannot be made `position: sticky`. The wizard
// requires sticky, stacking section headers, so the collapsible mode uses a
// light-DOM disclosure — a stock <button> toggling aria-expanded over a [hidden]
// body. Carbon ships no sticky-header accordion; this is a documented exception,
// not a reinvented lego. The panel mode is a plain <section> surface painted from
// layer tokens (the same raised-surface treatment as cds-tile, for a section).
import PermitSection from './PermitSection.astro';
import FlagTag from './FlagTag.astro';
import type { Badge } from '../data/permit';

interface Props {
  title: string;
  /** Render as a sticky, collapsible disclosure (the wizard) instead of a plain block. */
  collapsible?: boolean;
  /** Render as a static raised panel (the permit detail page). */
  panel?: boolean;
  /** Initial expanded state (collapsible mode only). */
  open?: boolean;
  /** Visual position — drives CSS `order` and the sticky-stack offset. */
  orderIndex?: number;
  /** The permit's header badges that come from this section — its classification
   *  tags and its compliance flags — shown in the header so they read even while
   *  the section is collapsed. */
  tags?: Badge[];
  flags?: Badge[];
  /** The section is painted as a raised (layer-01) panel by its host page, so its
   *  content sits one layer deeper: wrapping it in cds-layer level 1 steps every
   *  layer-aware control inside (tiles → layer-02, fields, tags, borders) the way
   *  Carbon's layering model expects — e.g. gray contact cards on a white panel
   *  in a g10 zone. Off by default (plain sections on the page background);
   *  always on for `panel`. */
  layered?: boolean;
  /** Anchored-comments target key (see above). */
  commentKey?: string;
}
const {
  title, collapsible = false, panel = false, open = true, orderIndex = 0,
  tags = [], flags = [], layered = false, commentKey,
} = Astro.props;
const hasBadges = tags.length + flags.length > 0;
---

{collapsible ? (
  <section
    class="rsec"
    data-review-section
    data-comment-section={commentKey}
    data-comment-label={commentKey ? title : undefined}
    style={`--order-i:${orderIndex}; --stack-i:${orderIndex}`}
  >
    <h2 class="rsec__head">
      <button type="button" class="rsec__toggle" aria-expanded={open ? 'true' : 'false'} data-section-toggle>
        <svg class="rsec__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 11L3 6 3.7 5.3 8 9.6 12.3 5.3 13 6z"></path></svg>
        <span class="rsec__label">
          <span class="rsec__title t-heading-03">{title}</span>
          {hasBadges && (
            <span class="rsec__badges">
              {tags.map((tag) => <cds-tag type={tag.type} size="md" title={tag.label}>{tag.label}</cds-tag>)}
              {flags.map((tag) => <FlagTag tag={tag} />)}
            </span>
          )}
        </span>
      </button>
    </h2>
    <div class="rsec__body" data-section-body hidden={!open}>
      {layered ? <cds-layer level="1" class="rsec__layer"><slot /></cds-layer> : <slot />}
    </div>
  </section>
) : panel ? (
  <section
    class="rpanel"
    data-review-section
    data-comment-section={commentKey}
    data-comment-label={commentKey ? title : undefined}
  >
    <div class="rpanel__head" data-section-head>
      <h2 class="rpanel__title t-heading-03">{title}</h2>
      {hasBadges && (
        <div class="rpanel__badges">
          {tags.map((tag) => <cds-tag type={tag.type} size="md" title={tag.label}>{tag.label}</cds-tag>)}
          {flags.map((tag) => <FlagTag tag={tag} />)}
        </div>
      )}
      <div class="rpanel__aside" data-section-aside>
        <slot name="aside" />
      </div>
    </div>
    <cds-layer level="1" class="rpanel__layer"><slot /></cds-layer>
  </section>
) : (
  <PermitSection title={title} commentKey={commentKey}>
    {hasBadges && (
      <Fragment slot="aside">
        {tags.map((tag) => <cds-tag type={tag.type} size="md" title={tag.label}>{tag.label}</cds-tag>)}
        {flags.map((tag) => <FlagTag tag={tag} />)}
      </Fragment>
    )}
    <slot />
  </PermitSection>
)}

<style>
  /* ── Static raised panel (the permit detail page) ───────────────────────────
     Layout + surface only — type from the t-* scale, color from --cds-* tokens.
     The panel is layer-01 on the page's g10 field; its content is stepped one
     layer deeper by the cds-layer wrapper. */
  .rpanel {
    background: var(--cds-layer-01, #ffffff);
    padding: var(--cds-spacing-07, 2rem);
  }
  @media (max-width: 42rem) {
    .rpanel { padding: var(--cds-spacing-06, 1.5rem) var(--cds-spacing-05, 1rem); }
  }
  .rpanel__head {
    display: flex; flex-wrap: wrap; align-items: center;
    column-gap: var(--cds-spacing-05, 1rem); row-gap: var(--cds-spacing-03, 0.5rem);
    margin-bottom: var(--cds-spacing-06, 1.5rem);
  }
  .rpanel__title { margin: 0; }
  .rpanel__badges { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-spacing-02, 0.25rem); }
  /* Real actions (and the internal-only flag) sit at the far end of the head. */
  .rpanel__aside { display: flex; align-items: center; gap: var(--cds-spacing-03, 0.5rem); margin-inline-start: auto; }
  .rpanel__aside:empty { display: none; }
  .rpanel__layer { display: block; }

  /* ── Collapsible, sticky-stackable disclosure (the wizard) ────────────────────
     The header pins to the top of the nearest scroll ancestor. Each section's
     offset = its visual index × the header height, so headers stack rather than
     overlap. Earlier sections keep a higher z-index so an incoming header slides
     UNDER the already-pinned ones until it reaches its own stop.

     `display: contents` is what makes the headers ACCUMULATE: it dissolves this
     section's box so the header + body become direct children of .app-review (the
     full-height container). A sticky element can only stick within its containing
     block, so with the per-section box gone, each header's sticky range spans the
     WHOLE record — all five stay pinned and pile up as you scroll, instead of each
     leaving when its own section scrolls past. The head + body carry the section's
     `order` (kept together, header first) so reordering still works. */
  .rsec { display: contents; --rsec-h: 3rem; }

  .rsec__head {
    order: var(--order-i, 0);
    position: sticky;
    /* --rsec-sticky-top lets the host page push the whole stack below fixed/sticky
       page chrome (e.g. the wizard's step tracker). Defaults to 0 when unset. */
    top: calc(var(--rsec-sticky-top, 0px) + var(--stack-i, 0) * var(--rsec-h));
    z-index: calc(50 - var(--stack-i, 0));
    margin: 0;
    background: var(--cds-background, #ffffff);
    border-bottom: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }

  /* The whole header bar is the disclosure control (a stock button — see
     carbon-checked note above). Full-width, left-aligned, token-styled. */
  /* Top-aligned so a header whose badges wrap to a second row keeps the chevron on
     the TITLE's line. Padding (10px) + the title's 28px line = the 48px header, so
     a one-line header is unchanged; a wrapped one grows evenly. */
  .rsec__toggle {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    inline-size: 100%;
    min-block-size: var(--rsec-h);
    padding: 0.625rem 0;
    background: none;
    border: 0;
    text-align: start;
    cursor: pointer;
    color: var(--cds-text-primary, #161616);
  }
  .rsec__toggle:focus-visible {
    outline: 2px solid var(--cds-focus, #0f62fe);
    outline-offset: -2px;
  }

  .rsec__title { margin: 0; }

  /* Title + badges (classification tags, compliance flags): badges sit beside the
     title, and wrap as a row UNDER it (aligned with the title, not the chevron)
     when the header is narrow. */
  .rsec__label {
    display: flex; flex-wrap: wrap; align-items: center;
    column-gap: 0.75rem; row-gap: 0.5rem; min-inline-size: 0;
    min-block-size: 1.75rem; /* the title's line, so badges center against it */
  }
  .rsec__badges { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; }

  .rsec__chevron {
    flex: 0 0 auto;
    margin-block-start: 0.375rem; /* centers the 16px glyph on the 28px title line */
    color: var(--cds-icon-primary, #161616);
    transition: transform 0.15s ease;
  }
  .rsec__toggle[aria-expanded='false'] .rsec__chevron { transform: rotate(-90deg); }

  /* Body is now a sibling flex item (see display:contents above): carry the same
     order so it tracks its header, and use padding — not container gap — to separate
     one section's content from the next header (gap would space header from body). */
  .rsec__body { order: var(--order-i, 0); padding-block: 1.25rem 2.5rem; }
  /* Author element reset beats the UA [hidden] rule — restate it (see
     docs/…; the "hidden author-reset" gotcha) so a collapsed body truly collapses. */
  .rsec__body[hidden] { display: none; }
  .rsec__layer { display: block; }
</style>
