---
// A titled section within a permit tab: a heading with a hairline rule, an optional
// `aside` slot for real actions, then content in the slot. Good for editorial
// blocks flowing in whitespace; when a section reads better as a card, compose a
// cds-tile (with its own title) inside the slot or in place of this section.
//
// Story 15: the old per-section "Make changes" ghost button is gone — reviewers
// edit live in the review wizard, gated by the IR permission matrix (Story 9), so
// a dead per-section edit stub no longer fits the model.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="sec">
  <div class="sec__head">
    <h2 class="sec__title t-heading-03">{title}</h2>
    <div class="sec__aside">
      <slot name="aside" />
    </div>
  </div>
  <slot />
</section>

<style>
  /* Layout only — type/color from --cds-* tokens; content composes cds-* legos. */
  .sec__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  .sec__title {
    margin: 0;
  }
  .sec__aside {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 0 0 auto;
  }
</style>
