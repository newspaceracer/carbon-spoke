---
// My-permits KANBAN board — a status-lane view of the permits the reviewer holds
// a role on. Each column is one WORKFLOW state; each card is a permit she can
// move between states to triage her queue.
//
// The five lanes ARE the review workflow, left→right:
//   1. Submitted            — arrived, no reviewer has started review yet.
//   2. Under review         — a reviewer clicked "Start review" (sets the same
//                             `permit-review-started-<id>` flag the detail page
//                             uses, so the two screens agree).
//   3. Review completed     — a decision was reached (approved OR rejected; the
//                             card shows which).
//   4. Returned to researcher — sent back for changes (the app's "Returned to
//                             submitter" state); waiting on the applicant.
//   5. Delinquent           — an issued permit whose annual report is missing.
//
// Lane membership is DERIVED from each permit's data (status + paperwork fields),
// not stored on the row — so the board reads straight from the shared register
// data (permits.ts) with no schema change. The one runtime signal is the
// review-started flag: it (not raw data) is what promotes a Submitted card into
// Under review, because "under review" is something a reviewer starts, not a seed.
//
// Carbon-first note: Carbon ships no board / kanban / drag-and-drop primitive
// (checked the catalog — see the carbon-checked note on the board element). So
// everything VISIBLE is composed from stock cds-*: the state chips reuse the
// register's status glyph+label affordance (icon+text, never colour alone —
// WCAG 1.4.1), the per-card "Move to" control is a cds-overflow-menu, the role +
// outcome chips are cds-tag, and the reset is a cds-button. The ONLY bespoke
// layer is the thin drag-and-drop wiring; the overflow menu is the equal,
// keyboard-accessible path to the same move, so the board never depends on a drag
// a keyboard can't do.
import { withBase } from '../lib/base';
import type { PermitRow } from '../data/permits';

interface Props {
  /** The permits to place on the board (the reviewer's "mine" set). */
  permits: PermitRow[];
}
const { permits } = Astro.props;

// Lane order = the review lifecycle, left→right. `label` is the column title;
// `note` is a one-line clarifier under it; `action` is the verb the per-card move
// menu uses ("Start review", not "Move to Under review"). `colorToken` colours the
// lane glyph via a real Carbon tag-colour token (no hard-coded hex).
type LaneKind = 'submitted' | 'under-review' | 'completed' | 'returned' | 'delinquent';
const lanes: {
  kind: LaneKind;
  label: string;
  note: string;
  action: string;
  colorToken: string;
}[] = [
  { kind: 'submitted',    label: 'Submitted',        note: 'Awaiting review',        action: 'Move to Submitted',    colorToken: '--cds-tag-color-gray' },
  { kind: 'under-review', label: 'Under review',     note: 'Review started',         action: 'Start review',         colorToken: '--cds-tag-color-blue' },
  { kind: 'returned',     label: 'Returned to researcher', note: 'Awaiting changes', action: 'Return to researcher', colorToken: '--cds-tag-color-purple' },
  { kind: 'completed',    label: 'Review completed', note: 'Decided in the last 30 days', action: 'Mark review completed', colorToken: '--cds-tag-color-green' },
  { kind: 'delinquent',   label: 'Delinquent',       note: 'Annual report missing',  action: 'Flag delinquent',      colorToken: '--cds-tag-color-red' },
];

// Lane glyphs — icon + colour, matching the register's status affordance
// (carbon-ag-grid.ts). Icon paired with the lane's text label ⇒ a state never
// reads by colour alone.
const glyphs: Record<LaneKind, { viewBox: string; path: string }> = {
  submitted:      { viewBox: '0 0 32 32', path: 'M16,2A14,14,0,1,0,30,16,14,14,0,0,0,16,2ZM8,18a2,2,0,1,1,2-2A2,2,0,0,1,8,18Zm8,0a2,2,0,1,1,2-2A2,2,0,0,1,16,18Zm8,0a2,2,0,1,1,2-2A2,2,0,0,1,24,18Z' },
  'under-review': { viewBox: '0 0 32 32', path: 'M16,2A14,14,0,1,0,30,16,14.0158,14.0158,0,0,0,16,2Zm0,26A12,12,0,0,1,16,4V16l8.4812,8.4814A11.9625,11.9625,0,0,1,16,28Z' },
  completed:      { viewBox: '0 0 16 16', path: 'M8,1C4.1,1,1,4.1,1,8c0,3.9,3.1,7,7,7s7-3.1,7-7C15,4.1,11.9,1,8,1z M7,11L4.3,8.3l0.9-0.8L7,9.3l4-3.9l0.9,0.8L7,11z' },
  returned:       { viewBox: '0 0 32 32', path: 'M2 26h28v2H2zM25.4 9c.8-.8.8-2 0-2.8l-3.6-3.6c-.8-.8-2-.8-2.8 0l-15 15V24h6.4l15-15zM20.4 4L24 7.6l-3 3L17.4 7l3-3zM6 22v-3.6l10-10 3.6 3.6-10 10H6z' },
  delinquent:     { viewBox: '0 0 16 16', path: 'M8,1L0,15H16ZM7.25,6h1.5v4.5h-1.5ZM8,13.5A1,1,0,1,1,9,12.5,1,1,0,0,1,8,13.5Z' },
};

// Outcome glyphs for the Review-completed lane, so a card says which decision it
// was (check = approved, x = rejected) — icon + word, never colour alone.
const outcomeGlyphs = {
  Approved: { viewBox: '0 0 16 16', path: 'M8,1C4.1,1,1,4.1,1,8c0,3.9,3.1,7,7,7s7-3.1,7-7C15,4.1,11.9,1,8,1z M7,11L4.3,8.3l0.9-0.8L7,9.3l4-3.9l0.9,0.8L7,11z' },
  Rejected: { viewBox: '0 0 16 16', path: 'M8,1C4.1,1,1,4.1,1,8s3.1,7,7,7s7-3.1,7-7S11.9,1,8,1z M10.7,10.5l-0.8,0.8L8,9.4l-1.9,1.9l-0.8-0.8L7.2,8.6L5.3,6.7l0.8-0.8L8,7.8l1.9-1.9l0.8,0.8L8.8,8.6L10.7,10.5z' },
} as const;

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// ── Lane classification ──────────────────────────────────────────────────────
// Derive each permit's SEED lane from its data. Note "under-review" is NOT seeded
// here: whether a submitted permit is under review is decided at runtime by the
// review-started flag (a reviewer clicked "Start review"), never by the seed.
const isIssued = (p: PermitRow) => p.signedPermit === 'Yes'; // Active or Expired
function laneFor(p: PermitRow): LaneKind {
  // An issued permit whose annual report is missing is delinquent regardless of
  // whether it's active or already expired — it still owes the report.
  if (isIssued(p) && p.annualReportSubmitted === 'No') return 'delinquent';
  if (p.status === 'Returned to submitter') return 'returned';
  // Any reached decision — approved (out for signature / signed) or rejected /
  // withdrawn — is a completed review.
  if (p.status === 'Rejected' || p.status === 'Withdrawn') return 'completed';
  if (p.status === 'Out for signature') return 'completed';
  if (isIssued(p)) return 'completed'; // Active / Expired with the report in
  // Draft or (pre-decision) Under review → submitted; the flag promotes it later.
  return 'submitted';
}

// The decision outcome for a completed card.
const outcomeOf = (p: PermitRow): 'Approved' | 'Rejected' =>
  p.status === 'Rejected' || p.status === 'Withdrawn' ? 'Rejected' : 'Approved';

// Pull the most-recent history date matching a transition target (falls back to
// the submission date when the event isn't present).
function lastAt(p: PermitRow, to: string): string {
  for (let i = p.history.length - 1; i >= 0; i--) if (p.history[i].to === to) return p.history[i].at;
  return p.submitted;
}
const decisionDate = (p: PermitRow) => p.history[p.history.length - 1]?.at ?? p.submitted;

// The one date most relevant to each seeded lane, so a card carries a useful "when".
function cardDate(p: PermitRow, lane: LaneKind): string {
  switch (lane) {
    case 'delinquent':   return `Report due ${fmtDate(p.annualReportDue)}`;
    case 'returned':     return `Returned ${fmtDate(lastAt(p, 'Returned to submitter'))}`;
    case 'completed':    return `${outcomeOf(p)} ${fmtDate(decisionDate(p))}`;
    case 'under-review': return `In review since ${fmtDate(lastAt(p, 'Under review'))}`;
    default:             return `Submitted ${fmtDate(p.submitted)}`;
  }
}

// Group the permits into their seeded lanes.
const laneCards: Record<LaneKind, PermitRow[]> = {
  submitted: [], 'under-review': [], completed: [], returned: [], delinquent: [],
};
for (const p of permits) laneCards[laneFor(p)].push(p);

// ── "Review completed" is a RECENT tray, not an archive ──────────────────────
// The lane shows only reviews completed in the last 30 days, then they drop off
// the board; the full history lives in the register behind "See all". `now` is the
// most recent completion on this board (the house convention: anchor a window to
// the data's own latest date, never the wall clock — the seed's dates are fixed).
const addDays = (isoDate: string, days: number): string => {
  const [y, m, d] = isoDate.split('-').map(Number);
  const t = new Date(Date.UTC(y, m - 1, d) + days * 86400000);
  return `${t.getUTCFullYear()}-${String(t.getUTCMonth() + 1).padStart(2, '0')}-${String(t.getUTCDate()).padStart(2, '0')}`;
};
// The moment a review was completed — the approve (→ Out for signature) or close
// (→ Rejected / Withdrawn) decision. ISO dates compare correctly as strings.
function completedAt(p: PermitRow): string {
  for (const e of p.history) {
    if (e.to === 'Out for signature' || e.to === 'Rejected' || e.to === 'Withdrawn') return e.at;
  }
  return decisionDate(p);
}
const RECENT_DAYS = 30;
const now = laneCards.completed.reduce((mx, p) => (completedAt(p) > mx ? completedAt(p) : mx), '');
const windowStart = now ? addDays(now, -RECENT_DAYS) : '';
const completedRecent = windowStart
  ? laneCards.completed.filter((p) => completedAt(p) >= windowStart)
  : laneCards.completed;

// "See all" set = every permit this reviewer approved OR rejected, ever — the
// register's `mine-decided` scope. A superset of the completed lane: it also
// includes once-approved permits that later expired or went delinquent.
const decidedCount = permits.filter((p) =>
  p.history.some((e) => e.to === 'Out for signature' || e.to === 'Active' || e.to === 'Rejected'),
).length;
const seeAllHref = withBase('/permits') + '?scope=mine-decided';
---

<!-- carbon-checked: no cds-* component provides a kanban / board / drag-and-drop
     column layout (walked node_modules/@carbon/web-components/es/components and
     carbondesignsystem.com/components/overview). The board grid + drag wiring is
     the bespoke layer; every control inside it is stock cds-*. -->
<section class="kanban" aria-label="My permits by workflow state">
  <div class="kanban__bar">
    <p class="kanban__count t-body-01" id="kb-count" aria-live="polite"></p>
    <cds-button id="kb-reset" kind="ghost" size="md">
      Reset board
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" aria-hidden="true">
        <path d="M18,28A12,12,0,1,0,6,16v6.2L2.4,18.6,1,20l6,6,6-6-1.4-1.4L8,22.2V16H8A10,10,0,1,1,18,26Z" />
      </svg>
    </cds-button>
  </div>

  <div class="kanban__board" id="kb-board">
    {lanes.map((lane) => {
      // The completed lane renders only its recent tray; the rest live behind "See all".
      const cards = lane.kind === 'completed' ? completedRecent : laneCards[lane.kind];
      const g = glyphs[lane.kind];
      return (
        <div class="lane" data-kind={lane.kind}>
          <header class="lane__head">
            <div class="lane__headrow">
              <span class="lane__glyph" style={`color:var(${lane.colorToken})`}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox={g.viewBox} width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d={g.path} />
                </svg>
              </span>
              <h2 class="lane__title t-heading-compact-01">{lane.label}</h2>
              <span class="lane__count t-label-01" data-count>{cards.length}</span>
            </div>
            <p class="lane__note t-label-01">{lane.note}</p>
          </header>

          <ul class="lane__cards" data-kind={lane.kind} aria-label={`${lane.label} permits`}>
            {cards.map((p) => {
              const outcome = lane.kind === 'completed' ? outcomeOf(p) : null;
              const og = outcome ? outcomeGlyphs[outcome] : null;
              return (
                <li
                  class="kcard"
                  draggable="true"
                  data-permit-id={p.permitId}
                  data-kind={lane.kind}
                  data-seed-kind={lane.kind}
                >
                  <div class="kcard__top">
                    <span class="kcard__grip" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor">
                        <path d="M10 6H14V10H10z" /><path d="M18 6H22V10H18z" />
                        <path d="M10 14H14V18H10z" /><path d="M18 14H22V18H18z" />
                        <path d="M10 22H14V26H10z" /><path d="M18 22H22V26H18z" />
                      </svg>
                    </span>
                    <a class="kcard__id" href={withBase('/permit')}>{p.permitId}</a>
                    <cds-overflow-menu class="kcard__menu" size="sm" menu-label={`Move ${p.permitId} to another state`}>
                      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true">
                        <circle cx="16" cy="8" r="2" /><circle cx="16" cy="16" r="2" /><circle cx="16" cy="24" r="2" />
                      </svg>
                      <span slot="tooltip-content">Move to…</span>
                      <cds-overflow-menu-body>
                        {lanes.map((target) => (
                          <cds-overflow-menu-item
                            data-move-to={target.kind}
                            disabled={target.kind === lane.kind ? true : undefined}
                          >
                            {target.action}
                          </cds-overflow-menu-item>
                        ))}
                      </cds-overflow-menu-body>
                    </cds-overflow-menu>
                  </div>

                  <p class="kcard__title t-body-01">{p.title}</p>

                  <dl class="kcard__meta t-label-01">
                    <div><dt>PI</dt><dd>{p.principalInvestigator}</dd></div>
                    <div><dt>Park</dt><dd>{p.park}</dd></div>
                  </dl>

                  <footer class="kcard__foot">
                    <div class="kcard__tags">
                      <cds-tag type="teal" size="sm">{p.role}</cds-tag>
                      {outcome && og && (
                        <span class={`kcard__outcome kcard__outcome--${outcome.toLowerCase()}`}>
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox={og.viewBox} width="14" height="14" fill="currentColor" aria-hidden="true">
                            <path d={og.path} />
                          </svg>
                          {outcome}
                        </span>
                      )}
                    </div>
                    <span class="kcard__date t-label-01" data-date>{cardDate(p, lane.kind)}</span>
                  </footer>
                </li>
              );
            })}
          </ul>

          <p class="lane__empty t-label-01" data-empty hidden>Nothing here yet.</p>

          {lane.kind === 'completed' && (
            <a
              class="lane__seeall t-label-01"
              href={seeAllHref}
              aria-label={`See all ${decidedCount} permits you approved or rejected`}
            >
              See all {decidedCount}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M11 8L6 3 5.3 3.7 9.6 8 5.3 12.3 6 13z" />
              </svg>
            </a>
          )}
        </div>
      );
    })}
  </div>
</section>

<script>
  // ── Kanban move + persistence (prototype-local) ─────────────────────────────
  // Two ways to move a card, both landing in the same moveCard(): drag-and-drop
  // (the bespoke layer) and the per-card cds-overflow-menu (keyboard-accessible).
  //
  // Two persistence layers, by design:
  //   1. `overrides` (permitId → lane) — manual triage moves, this board's own
  //      store; "Reset board" clears it.
  //   2. `permit-review-started-<id>` — the SHARED flag the permit detail page
  //      sets when a reviewer clicks "Start review". It is what puts a card in the
  //      Under review lane, on this board or after starting review on the detail
  //      page. Moving a card into/out of Under review here sets/clears the same
  //      flag, so the board and the detail page never disagree.
  const STORE_KEY = 'carbon-spoke:my-permits-kanban-v2';
  const rsKey = (id: string) => `permit-review-started-${id}`;
  const board = document.getElementById('kb-board');
  const countEl = document.getElementById('kb-count');
  const resetBtn = document.getElementById('kb-reset');
  if (board && countEl) {
    const lanes = new Map(
      Array.from(board.querySelectorAll<HTMLElement>('.lane')).map((l) => [l.dataset.kind!, l]),
    );
    const listFor = (kind: string) =>
      lanes.get(kind)?.querySelector<HTMLElement>('.lane__cards') ?? null;

    const load = (): Record<string, string> => {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch {
        return {};
      }
    };
    let overrides = load();
    const save = () => localStorage.setItem(STORE_KEY, JSON.stringify(overrides));

    // A card's effective seed = its data seed, promoted to Under review when the
    // reviewer has started review (the shared flag is set). This is what Reset
    // and initial placement fall back to when there's no manual override.
    const effectiveSeed = (card: HTMLElement): string => {
      const seed = card.dataset.seedKind!;
      if (seed === 'submitted' && localStorage.getItem(rsKey(card.dataset.permitId!))) {
        return 'under-review';
      }
      return seed;
    };

    // Refresh a card's overflow-menu so its CURRENT lane is disabled (can't move
    // a card to where it already is).
    const syncMenu = (card: HTMLElement) => {
      card.querySelectorAll<HTMLElement>('[data-move-to]').forEach((item) => {
        const isHere = item.dataset.moveTo === card.dataset.kind;
        if (isHere) item.setAttribute('disabled', '');
        else item.removeAttribute('disabled');
      });
    };

    const refreshLane = (kind: string) => {
      const lane = lanes.get(kind);
      const list = listFor(kind);
      if (!lane || !list) return;
      const n = list.querySelectorAll('.kcard').length;
      lane.querySelector<HTMLElement>('[data-count]')!.textContent = String(n);
      lane.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
    };

    const total = board.querySelectorAll('.kcard').length;
    const refreshCount = () => {
      countEl.textContent = total === 1 ? '1 permit' : `${total} permits`;
    };

    // Move a card to a lane, keeping BOTH persistence layers consistent. `persist`
    // is false only for the initial/reset placement, which shouldn't record a
    // manual override for something the seed already implies.
    const moveCard = (card: HTMLElement, kind: string, persist = true) => {
      const from = card.dataset.kind!;
      if (from === kind) return;
      const list = listFor(kind);
      if (!list) return;
      list.appendChild(card);
      card.dataset.kind = kind;

      // Keep the shared review-started flag in step with the Under review lane —
      // moving IN starts review, moving OUT un-starts it.
      const id = card.dataset.permitId!;
      if (kind === 'under-review') {
        localStorage.setItem(rsKey(id), JSON.stringify({ by: 'You', at: new Date().toISOString() }));
      } else if (from === 'under-review') {
        localStorage.removeItem(rsKey(id));
      }

      if (persist) {
        // Store only real deviations from the effective (flag-aware) seed.
        if (kind === effectiveSeed(card)) delete overrides[id];
        else overrides[id] = kind;
        save();
      }
      syncMenu(card);
      refreshLane(from);
      refreshLane(kind);
    };

    // Wire a single card's menu + drag handlers.
    const wireCard = (card: HTMLElement) => {
      card.querySelectorAll<HTMLElement>('[data-move-to]').forEach((item) => {
        item.addEventListener('click', () => {
          if (!item.hasAttribute('disabled')) moveCard(card, item.dataset.moveTo!);
        });
      });
      card.addEventListener('dragstart', (e) => {
        card.classList.add('kcard--dragging');
        e.dataTransfer?.setData('text/plain', card.dataset.permitId!);
        if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
      });
      card.addEventListener('dragend', () => {
        card.classList.remove('kcard--dragging');
        board.querySelectorAll('.lane--over').forEach((l) => l.classList.remove('lane--over'));
      });
      syncMenu(card);
    };

    // Initial placement: manual override wins; otherwise the effective (flag-aware)
    // seed. This is how a permit whose review was started on the detail page shows
    // up here in Under review.
    board.querySelectorAll<HTMLElement>('.kcard').forEach((card) => {
      const target = overrides[card.dataset.permitId!] ?? effectiveSeed(card);
      if (target !== card.dataset.kind) {
        const list = listFor(target);
        if (list) {
          list.appendChild(card);
          card.dataset.kind = target;
        }
      }
      wireCard(card);
    });

    // Lane drop zones.
    lanes.forEach((lane, kind) => {
      lane.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        lane.classList.add('lane--over');
      });
      lane.addEventListener('dragleave', (e) => {
        if (!lane.contains(e.relatedTarget as Node)) lane.classList.remove('lane--over');
      });
      lane.addEventListener('drop', (e) => {
        e.preventDefault();
        lane.classList.remove('lane--over');
        const id = e.dataTransfer?.getData('text/plain');
        const card = id && board.querySelector<HTMLElement>(`.kcard[data-permit-id="${id}"]`);
        if (card) moveCard(card, kind);
      });
    });

    // Reset clears manual triage moves and returns each card to its effective seed
    // (which still honours a started review — resetting the board isn't the same
    // as un-starting a review).
    resetBtn?.addEventListener('click', () => {
      board.querySelectorAll<HTMLElement>('.kcard').forEach((card) => {
        moveCard(card, effectiveSeed(card), false);
      });
      overrides = {};
      localStorage.removeItem(STORE_KEY);
    });

    lanes.forEach((_, kind) => refreshLane(kind));
    refreshCount();
  }
</script>

<style>
  /* Section LAYOUT only — every control is a cds-* component styled by tokens. */
  .kanban {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .kanban__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .kanban__count {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }

  /* The board: five lanes in a row, scrolling horizontally when they don't fit
     rather than letting the page body scroll sideways. */
  .kanban__board {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(17rem, 1fr);
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .lane {
    display: flex;
    flex-direction: column;
    background: var(--cds-layer-01, #f4f4f4);
    border-top: 2px solid var(--cds-border-subtle-01, #c6c6c6);
    min-height: 12rem;
  }
  .lane__head {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 1rem;
  }
  .lane__headrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lane__glyph {
    display: inline-flex;
    flex: 0 0 auto;
  }
