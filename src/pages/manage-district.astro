---
import { withBase } from '../lib/base';
/* manifest:
     shell:  PermitNav (cds-header UI Shell).
     header: identity banner (g100) — "Manage district" + district name + crumb.
     spine:  main.page > .cds--css-grid (single full-width column)
     sections:
       - Scope bar  -> a district switcher scoped to the SIGNED-IN Prototype identity
                       (editableDistricts): HQ roles get every district, a district lead
                       gets the ones they lead, and it hides when there's only one. WHO
                       is acting is no longer picked here — it's the identity. An identity
                       that administers no districts sees a no-access notice instead of
                       the console body.
       - District information -> office address + phone/email (field-grid form)
       - Members    -> the district's people: a cds-table (name, role, auto-assignment,
                       point-of-contact) with per-row Edit/Remove + an "Add member"
                       cds-modal. Role drives permit behaviour; assistants get an
                       auto-assignment policy; any member can be flagged a contact.
     Parks are NOT editable here — a district's park roster is managed on its own
     screen; this console only reads the roster for member auto-assignment.
   Everything is prototype-local: "Save changes" writes the whole district record to
   localStorage (shared key with the /district detail screen, so edits show there).
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PermitNav from '../components/PermitNav.astro';
import PermitSection from '../components/PermitSection.astro';
import { district, districtDirectory } from '../data/district';
import { states } from '../data/user';

export const prototype = {
  title: 'Manage district',
  summary:
    'The scoped admin console for a district — edit its office, manage its members ' +
    '(roles + permit auto-assignment), and choose its points of contact. ' +
    'District leads manage their own; HQ admins manage any.',
  tag: 'Internal tool',
};

const d = district;

// The district switcher lists every district alphabetically (states are already A–Z).
const districtsSorted = [...districtDirectory].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title={`Manage ${d.name}`}>
  <PermitNav slot="nav" />

  <main class="page">
    <header class="banner cds--g100">
      <div class="banner__inner">
        <cds-breadcrumb no-trailing-slash class="banner__crumb">
          <cds-breadcrumb-item>
            <cds-breadcrumb-link href={withBase('/')}>Home</cds-breadcrumb-link>
          </cds-breadcrumb-item>
          <cds-breadcrumb-item>
            <cds-breadcrumb-link href={withBase('/districts')}>Districts</cds-breadcrumb-link>
          </cds-breadcrumb-item>
          <cds-breadcrumb-item>
            <cds-breadcrumb-link href={withBase('/district')}>{d.name}</cds-breadcrumb-link>
          </cds-breadcrumb-item>
          <cds-breadcrumb-item>
            <cds-breadcrumb-link aria-current="page">Manage</cds-breadcrumb-link>
          </cds-breadcrumb-item>
        </cds-breadcrumb>

        <p class="banner__eyebrow t-label-01">District administration</p>
        <h1 class="banner__name t-heading-05" id="banner-name">{d.name}</h1>
      </div>
    </header>

    <!-- Shown when the signed-in identity administers no districts (a non-admin
         reviewer, applicant, or logged-out): the console body is hidden and this
         explains why. HQ roles and district leads never see it. -->
    <cds-inline-notification
      id="no-access"
      hidden
      kind="info"
      low-contrast
      hide-close-button
      title="No districts to administer"
      subtitle="Your role doesn't administer any districts. HQ reviewers and district leads manage districts here."
    ></cds-inline-notification>

    <div id="console-body" class="cds--css-grid cds--css-grid--with-row-gap body">
      <div class="col cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
        <!-- ── Scope bar: which district is being administered ───────────────
             WHO is acting is no longer picked here — it's the signed-in Prototype
             identity. The client script scopes the switcher below to the districts
             that identity may edit (HQ roles → all; a district lead → the ones they
             lead) and shows it only when there's more than one to choose. -->
        <cds-tile class="scope" id="scope-tile">
          <div class="scope__row">
            <div id="switcher-wrap" class="scope__switcher" hidden>
              <cds-dropdown id="district-switcher" title-text="District" value={d.id}>
                {districtsSorted.map((row) => (
                  <cds-dropdown-item value={row.id}>{row.name}</cds-dropdown-item>
                ))}
              </cds-dropdown>
            </div>
          </div>
          <cds-inline-notification
            id="switcher-note"
            hidden
            kind="info"
            low-contrast
            hide-close-button
            title="Prototype scope"
            subtitle="This prototype populates only North Coast Redwoods District. Picking another would scope this same console to it."
          ></cds-inline-notification>
        </cds-tile>

        <!-- ── District information ─────────────────────────────────────────── -->
        <PermitSection title="District information">
          <p class="section-hint t-body-01">The district office address and contact details shown on its detail screen.</p>
          <div class="field-grid">
            <div class="field-grid__wide">
              <cds-text-input id="e-street" label="Street address"></cds-text-input>
            </div>
            <div class="field-grid__wide">
              <cds-text-input id="e-unit" label="Suite / unit (optional)"></cds-text-input>
            </div>
            <cds-text-input id="e-city" label="City"></cds-text-input>
            <cds-dropdown id="e-state" title-text="State">
              {states.map((s) => (
                <cds-dropdown-item value={s.value}>{s.label}</cds-dropdown-item>
              ))}
            </cds-dropdown>
            <cds-text-input id="e-zip" label="ZIP code"></cds-text-input>
            <div class="field-grid__wide"><div class="field-divider"></div></div>
            <cds-text-input id="e-phone" type="tel" label="District phone"></cds-text-input>
            <cds-text-input id="e-email" type="email" label="District email"></cds-text-input>
          </div>

          <!-- Save is scoped to the district-information form above; it's disabled
               until a field changes. Members and the default signer save themselves
               at their own confirmation, so they aren't governed by this button. -->
          <div class="form__actions">
            <cds-button id="cancel-btn" kind="ghost" size="lg" href={withBase('/district')}>Cancel</cds-button>
            <cds-button id="save-btn" type="button" size="lg" disabled>Save changes</cds-button>
          </div>
        </PermitSection>

        <!-- ── Members ──────────────────────────────────────────────────────── -->
        <PermitSection title="Members">
          <cds-button slot="aside" id="add-member" kind="tertiary" size="md">Add user</cds-button>
          <p class="section-hint t-body-01">
            The people assigned to this district. A member's <strong>role</strong> sets how they join a permit's
            analysis team: the <strong>lead</strong> reviewer leads single-district permits (supporting on
            multi-district); <strong>assistant</strong> reviewers are added as supporting analysts when a
            requested park matches their auto-assignment. Members marked a <strong>point of contact</strong> appear
            on the district's detail screen, and are offered as permit-letter contacts: the lead is each
            permit's default district contact, and a point of contact scoped to specific parks is added
            to the letter automatically when one of those parks is on the permit.
          </p>
          <div class="table-wrap">
            <cds-table>
              <cds-table-head>
                <cds-table-header-row>
                  <cds-table-header-cell>Member</cds-table-header-cell>
                  <cds-table-header-cell>Role</cds-table-header-cell>
                  <cds-table-header-cell>Permit auto-assignment</cds-table-header-cell>
                  <cds-table-header-cell>Point of contact</cds-table-header-cell>
                  <cds-table-header-cell>Actions</cds-table-header-cell>
                </cds-table-header-row>
              </cds-table-head>
              <cds-table-body id="members-tbody"></cds-table-body>
            </cds-table>
          </div>
        </PermitSection>

        <!-- ── Default signer (Story 7, single-district) ──────────────────────── -->
        <PermitSection title="Default signer">
          <cds-button slot="aside" id="set-signer" kind="tertiary" size="md">Set default signer</cds-button>
          <p class="section-hint t-body-01">
            The second signature on this district's <strong>single-district</strong> permits.
            The Responsible Agent signs first; this person co-signs to activate. Choose a
            district member or an external person — they're notified to sign via DocuSign and
            need no account.
          </p>
          <!-- carbon-checked: empty-state copy is prose, not a control — a <p> with a
               Carbon type role is the house pattern (see the users console empty states). -->
          <p id="signer-empty" class="empty t-body-01">No default signer set.</p>
          <div id="signer-card" class="identity" hidden>
            <p class="identity__name t-heading-compact-01" id="signer-name"></p>
            <p class="identity__meta t-body-01">
              <span id="signer-email"></span>
              <span id="signer-tag"></span>
            </p>
            <div class="signer-actions">
              <cds-button kind="ghost" size="sm" id="signer-remove">Remove</cds-button>
            </div>
          </div>
        </PermitSection>
      </div>
    </div>

    <!-- ── Add / edit member modal ────────────────────────────────────────── -->
    <cds-modal id="member-modal" size="sm">
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label id="member-modal-label">District user</cds-modal-label>
        <cds-modal-heading id="member-modal-heading">Add user</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <cds-inline-notification
          id="member-warning"
          hidden
          kind="warning"
          low-contrast
          hide-close-button
          title=""
          subtitle=""
        ></cds-inline-notification>

        <div class="modal-grid">
          <!-- Add mode only: add someone who already has an account, or invite a
               brand-new person into the system and onto this district at once. -->
          <div id="m-mode-wrap">
            <p class="modal-hint t-label-01" id="m-mode-label">Add an existing account, or invite someone new.</p>
            <cds-content-switcher id="m-mode" value="existing">
              <cds-content-switcher-item value="existing" selected>Existing user</cds-content-switcher-item>
              <cds-content-switcher-item value="new">Invite new user</cds-content-switcher-item>
            </cds-content-switcher>
          </div>

          <!-- Existing user: pick, never type. Identity is owned by the account. -->
          <div id="m-existing">
            <cds-combo-box id="m-user" title-text="User" label="Search users by name…" autoalign></cds-combo-box>
            <div id="m-identity" class="identity" hidden>
              <p class="identity__name t-heading-compact-01" id="m-id-name"></p>
              <p class="identity__meta t-body-01">
                <span id="m-id-email"></span>
                <span id="m-id-phone"></span>
              </p>
              <p class="identity__note t-label-01">These details come from the user's account — only the user or an admin can change them, not this page.</p>
            </div>
          </div>

          <!-- New user: create a pending account AND add them to this district. -->
          <div id="m-new" hidden>
            <div class="name-row">
              <cds-text-input id="m-first" label="First name" placeholder="e.g. Jordan"></cds-text-input>
              <cds-text-input id="m-last" label="Last name" placeholder="e.g. Rivera"></cds-text-input>
            </div>
            <cds-text-input id="m-email" type="email" label="Email" placeholder="name@parks.ca.gov"></cds-text-input>
            <cds-text-input id="m-phone" label="Phone (optional)" placeholder="(916) 555-0100"></cds-text-input>
            <p class="modal-hint t-label-01">They’ll get an invitation and stay pending until they accept.</p>
          </div>

          <!-- Options are built client-side, scoped to who's acting: a district
               lead can only appoint assistants; HQ can set lead or assistant. -->
          <cds-dropdown id="m-role" title-text="Role" autoalign></cds-dropdown>
          <!-- carbon-checked: scope note for the role field — plain helper prose, no cds-* fits. -->
          <p class="modal-hint t-label-01" id="role-lock-note" hidden>
            Only HQ can change the district lead — a lead is an HQ appointment.
          </p>

          <!-- carbon-checked: prose helper for the lead role — no cds-* component
               fits an explanatory line; a <p> with the Carbon type role is the
               house pattern (see PermitHeader/profile modals). -->
          <p class="modal-hint t-label-01" id="lead-note" hidden>
            Leads cover all parks and lead every single-district permit for this district
            (supporting analyst on multi-district permits). No per-park setting.
          </p>

          <div id="autoassign-block" hidden>
            <cds-radio-button-group
              id="m-autoassign"
              name="m-autoassign"
              orientation="vertical"
              label-text="Permit auto-assignment"
              value="none"
            >
              <cds-radio-button label-text="Do not auto-assign" value="none"></cds-radio-button>
              <cds-radio-button label-text="Auto-assign to specific parks" value="specific"></cds-radio-button>
              <cds-radio-button label-text="Auto-assign to all parks in the district" value="all"></cds-radio-button>
            </cds-radio-button-group>
            <div id="specific-parks" class="park-checks" hidden></div>
          </div>

          <cds-checkbox id="m-published" label-text="Show as a district point of contact"></cds-checkbox>
          <p class="modal-hint t-label-01">Points of contact appear on the district's detail screen and are offered as permit-letter contacts. If scoped to specific parks above, this person is added to a permit's letter automatically when one of those parks is on it.</p>
        </div>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="primary" id="m-save">Save user</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>

    <!-- ── Remove-member confirmation ─────────────────────────────────────── -->
    <cds-modal id="remove-modal" size="xs" danger>
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label>District user</cds-modal-label>
        <cds-modal-heading id="remove-heading">Remove user</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <!-- carbon-checked: confirmation prose has no cds-* component; a <p> with the
             Carbon type role is the house pattern for modal body copy. -->
        <p class="modal-hint t-body-01" id="remove-body">
          Remove this user from the district? They’ll no longer be auto-assigned to permits or listed as a contact.
        </p>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="danger" id="remove-confirm">Remove user</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>

    <!-- ── Request-deactivation modal (district lead → admin) ──────────────── -->
    <cds-modal id="deact-modal" size="sm">
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label>Account deactivation</cds-modal-label>
        <cds-modal-heading id="deact-heading">Request account deactivation</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <p class="modal-hint t-body-01" id="deact-body">
          An admin reviews and completes account deactivations. Send a request and they’ll be notified.
        </p>
        <cds-textarea id="deact-reason" label="Reason (optional)" placeholder="e.g. Left the agency on Jun 30; no longer needs access." rows="3"></cds-textarea>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="primary" id="deact-confirm">Send request</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>

    <!-- ── Default-signer modal (same dual-path pattern as Add member) ─────── -->
    <cds-modal id="signer-modal" size="sm">
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label>Default signer</cds-modal-label>
        <cds-modal-heading id="signer-modal-heading">Set default signer</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <cds-inline-notification
          id="signer-warning"
          hidden
          kind="warning"
          low-contrast
          hide-close-button
          title=""
          subtitle=""
        ></cds-inline-notification>

        <div class="modal-grid">
          <!-- Two ways to name the signer: an existing account, or an external
               person who signs via DocuSign and needs no account. -->
          <div id="signer-mode-wrap">
            <p class="modal-hint t-label-01">Choose an existing user, or add an external person.</p>
            <cds-content-switcher id="signer-mode" value="existing">
              <cds-content-switcher-item value="existing" selected>Existing user</cds-content-switcher-item>
              <cds-content-switcher-item value="external">External person</cds-content-switcher-item>
            </cds-content-switcher>
          </div>

          <div id="signer-existing">
            <!-- autoalign: Floating UI floats the open list out of the modal's
                 scroll container so the options aren't clipped at the bottom. -->
            <cds-combo-box id="signer-user" title-text="User" label="Search users by name…" autoalign></cds-combo-box>
          </div>

          <div id="signer-external" hidden>
            <cds-text-input id="signer-ext-name" label="Full name" placeholder="e.g. Dana Reyes"></cds-text-input>
            <cds-text-input id="signer-ext-email" type="email" label="Email" placeholder="name@example.org"></cds-text-input>
            <p class="modal-hint t-label-01">They’re notified to sign via DocuSign and need no account.</p>
          </div>
        </div>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="primary" id="signer-save">Save signer</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>

  </main>
</BaseLayout>

<script>
  import { district, roleMeta, assignableRoles, memberRoles, editableDistricts } from '../data/district';
  import { directory, activeUser } from '../data/user';
  // Member identity is resolved through resolveUser (seeded directory OR an
  // invited/added account) so a newly invited member isn't treated as unknown.
  import {
    inviteUser,
    resolveUser,
    userStatus,
    accountStatusOf,
    submitDeactivation,
    pendingDeactivationForUser,
  } from '../data/requests';
  // The signed-in Prototype identity drives district edit scope (HQ → all;
  // district lead → the districts they lead; anyone else → none).
  import { readIdentity } from '../lib/maintenance';
  import { showToast } from '../lib/toast';

  // ── Prototype-local district record (shared with the /district detail) ────
  // A member REFERENCES a user by id; name/email/phone are resolved from the
  // directory, never stored here — so identity can't drift or be free-typed.
  type Address = { street: string; unit: string; city: string; state: string; zip: string };
  type Office = { address: Address; phone: string; email: string };
  type Park = { name: string; designation: string };
  type AutoAssign = { mode: 'none' | 'specific' | 'all'; parks: string[] };
  type Member = { userId: string; role: string; autoAssign: AutoAssign; published: boolean };
  // The default second signer: an existing account (by id) OR an external person
  // (name + email, no account), or none.
  type DefaultSigner =
    | { kind: 'user'; userId: string }
    | { kind: 'external'; name: string; email: string }
    | null;
  type State = { office: Office; parks: Park[]; members: Member[]; defaultSigner: DefaultSigner };

  const KEY = `manage-district-${district.id}`;
  // Pre-modal builds stored the signer as a bare email under this key; migrated in.
  const legacySignerKey = `default-signer-${district.id}`;

  const seed = (): State => ({
    office: {
      address: { ...district.office.address },
      phone: district.office.phone,
      email: district.office.email,
    },
    parks: district.parks.map((p) => ({ ...p })),
    members: district.members.map((m) => ({
      userId: m.userId, role: m.role,
      autoAssign: { mode: m.autoAssign.mode, parks: [...m.autoAssign.parks] },
      published: m.published,
    })),
    defaultSigner: null,
  });

  const normalizeSigner = (s: any): DefaultSigner => {
    if (s && s.kind === 'user' && typeof s.userId === 'string') return { kind: 'user', userId: s.userId };
    if (s && s.kind === 'external' && typeof s.email === 'string') return { kind: 'external', name: s.name ?? '', email: s.email };
    return null;
  };

  // A member record is only trustworthy if it references a real user AND a known
  // role. Records saved by an earlier build (inline name/email, no userId, or a
  // since-removed role) fail this and are discarded — so stale localStorage can't
  // poison the UI (unknown-user rows, duplicate role options).
  const memberOk = (m: any): boolean =>
    !!m && typeof m.userId === 'string' && !!resolveUser(m.userId) && memberRoles.some((r) => r.value === m.role);

  const loadState = (): State => {
    const base = seed();
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && typeof saved === 'object') {
        const savedMembers = Array.isArray(saved.members) ? saved.members : null;
        // Use saved members only if EVERY one is valid (an empty list is a valid,
        // intentional "no members"); otherwise the save is stale → fall back.
        const membersUsable = savedMembers && savedMembers.every(memberOk);
        return {
          office: saved.office ?? base.office,
          parks: Array.isArray(saved.parks) ? saved.parks : base.parks,
          members: membersUsable ? savedMembers : base.members,
          defaultSigner: normalizeSigner(saved.defaultSigner),
        };
      }
    } catch { /* malformed — fall back to seed */ }
    return base;
  };

  let state: State = loadState();

  // Migrate a legacy bare-email signer into the structured field, once.
  if (!state.defaultSigner) {
    const legacy = (localStorage.getItem(legacySignerKey) || '').trim();
    if (legacy) state.defaultSigner = { kind: 'external', name: '', email: legacy };
  }

  // Single writer for the whole district record. Members and the default signer
  // call this at their own confirmation (instant-apply); the district-information
  // form calls it from "Save changes".
  const persist = () => localStorage.setItem(KEY, JSON.stringify(state));

  // ── Helpers ───────────────────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id);
  const esc = (s = '') =>
    s.replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));

  // Transient confirmations use the shared app-wide toast (src/lib/toast.ts).
  const toast = (title: string, subtitle = '') => showToast(title, subtitle);
  // Standard house "remove a row" affordance: a ghost trash icon-button (removal
  // is already confirmed via the danger #remove-modal below).
  const trash = `<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>`;
  const roleLabel = (v: string) => roleMeta(v).label;
  const roleTag = (v: string) => {
    const meta = roleMeta(v);
    if (meta.level === 'lead') return 'blue';
    if (meta.level === 'assistant') return 'teal';
    return 'cool-gray';
  };
  const shortPark = (name: string) => name.replace(/\s+(Redwoods\s+)?State\s+Park$/i, '').replace(/\s+State\s+(Natural\s+Reserve|Beach|Recreation\s+Area)$/i, '');
  const autoAssignText = (m: Member) => {
    const meta = roleMeta(m.role);
    if (meta.level === 'lead') return 'All parks · leads single-district permits';
    if (meta.level === 'assistant') {
      if (m.autoAssign.mode === 'all') return 'All parks in district';
      if (m.autoAssign.mode === 'specific')
        return m.autoAssign.parks.length ? m.autoAssign.parks.map(shortPark).join(', ') : 'Specific parks — none chosen';
      return 'Not auto-assigned';
    }
    return '—'; // non-reviewer staff
  };

  // The district's park roster — read-only here (edited on its own screen).
  // The member modal's "specific parks" picker draws from it.
  const currentParkNames = (): string[] => state.parks.map((p) => p.name);

  // ── Members table ──────────────────────────────────────────────────────────
  const renderMembers = () => {
    const tbody = $('members-tbody');
    if (!tbody) return;
    tbody.replaceChildren(
      ...state.members.map((m, i) => {
        const row = document.createElement('cds-table-row');

        const user = resolveUser(m.userId);
        const nameCell = document.createElement('cds-table-cell');
        // An invited member shows a pending indicator until they accept — state,
        // not a category, so an icon-indicator (icon + label), never a tag.
        const pending = userStatus(m.userId) === 'invited'
          ? '<span class="m-pending"><cds-icon-indicator size="16" kind="pending" label="Invited — pending acceptance"></cds-icon-indicator></span>'
          : '';
        nameCell.innerHTML = `<span class="m-name">${esc(user?.name ?? '(unknown user)')}</span><span class="m-sub">${esc(user?.email ?? '')}</span>${pending}`;

        const roleCell = document.createElement('cds-table-cell');
        roleCell.innerHTML = `<cds-tag type="${roleTag(m.role)}" size="sm">${esc(roleLabel(m.role))}</cds-tag>`;

        const aaCell = document.createElement('cds-table-cell');
        aaCell.textContent = autoAssignText(m);

        const pocCell = document.createElement('cds-table-cell');
        pocCell.innerHTML = m.published ? `<cds-tag type="green" size="sm">Contact</cds-tag>` : '<span class="m-sub">—</span>';

        const actionCell = document.createElement('cds-table-cell');
        const wrap = document.createElement('div');
        wrap.className = 'row-actions';
        const edit = document.createElement('cds-button');
        edit.setAttribute('kind', 'ghost'); edit.setAttribute('size', 'sm');
        edit.textContent = 'Edit';
        edit.addEventListener('click', () => openMemberModal(i));

        // The two lifecycle actions live in an overflow menu (Carbon's pattern for
        // multiple row actions), keeping Edit as the one inline affordance:
        //  - Remove from district  → district-scoped, done in place (confirmed).
        //  - Request account deactivation → account-global, so it goes to an admin.
        // Deactivation is guarded: already-inactive or already-requested accounts
        // show a disabled item explaining the current state.
        const deactState = accountStatusOf(m.userId) === 'inactive'
          ? 'inactive'
          : (pendingDeactivationForUser(m.userId) ? 'pending' : 'none');
        const deactLabel = deactState === 'inactive'
          ? 'Account already inactive'
          : deactState === 'pending'
            ? 'Deactivation requested'
            : 'Request account deactivation';
        const menu = document.createElement('cds-overflow-menu');
        menu.setAttribute('size', 'sm');
        menu.setAttribute('menu-label', `More actions for ${user?.name ?? 'member'}`);
        menu.innerHTML =
          `<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true">` +
          `<circle cx="16" cy="8" r="2"/><circle cx="16" cy="16" r="2"/><circle cx="16" cy="24" r="2"/></svg>` +
          `<span slot="tooltip-content">More actions</span>` +
          `<cds-overflow-menu-body>` +
          `<cds-overflow-menu-item data-act="remove">Remove from district</cds-overflow-menu-item>` +
          `<cds-overflow-menu-item data-act="deactivate"${deactState !== 'none' ? ' disabled' : ''}${deactState === 'inactive' ? ' danger' : ''}>${deactLabel}</cds-overflow-menu-item>` +
          `</cds-overflow-menu-body>`;
        menu.querySelector('[data-act="remove"]')?.addEventListener('click', () => openRemoveModal(i));
        if (deactState === 'none') {
          menu.querySelector('[data-act="deactivate"]')?.addEventListener('click', () => openDeactivateModal(i));
        }
        wrap.append(edit, menu);
        actionCell.appendChild(wrap);

        row.append(nameCell, roleCell, aaCell, pocCell, actionCell);
        return row;
      }),
    );
  };

  // ── Office fields ──────────────────────────────────────────────────────────
  const setVal = (id: string, v: string) => {
    const el = $(id) as any;
    if (!el) return;
    el.setAttribute('value', v);
    el.value = v;
  };
  const valOf = (id: string) => (($(id) as any)?.value ?? '').toString().trim();
  const populateOffice = () => {
    const a = state.office.address;
    setVal('e-street', a.street); setVal('e-unit', a.unit); setVal('e-city', a.city);
    setVal('e-state', a.state); setVal('e-zip', a.zip);
    setVal('e-phone', state.office.phone); setVal('e-email', state.office.email);
  };

  // ── Member modal ───────────────────────────────────────────────────────────
  const modal = $('member-modal') as any;
  const mWarn = $('member-warning') as any;
  let editingIndex = -1;
  let selectedUserId = '';

  const roleEl = () => $('m-role') as any;
  const aaGroup = () => $('m-autoassign') as any;
  const userBox = () => $('m-user') as any;
  const modeEl = () => $('m-mode') as any;

  // Add mode has two ways to name a member: pick an EXISTING account, or INVITE
  // a new person. Edit mode has neither — the person is fixed.
  const currentMode = (): 'existing' | 'new' => (modeEl()?.value === 'new' ? 'new' : 'existing');

  const newFieldIds = ['m-first', 'm-last', 'm-email', 'm-phone'];
  const clearNewFields = () => {
    newFieldIds.forEach((id) => {
      const el = $(id) as any;
      if (el) { el.value = ''; el.invalid = false; }
    });
  };

  const applyMode = () => {
    const mode = currentMode();
    const existing = $('m-existing');
    const neu = $('m-new');
    if (existing) existing.hidden = mode !== 'existing';
    if (neu) neu.hidden = mode !== 'new';
    if (mWarn) mWarn.hidden = true;
  };

  // The signed-in identity and the districts it may edit — computed once. HQ roles
  // act at 'hq' scope (can appoint leads); a district lead acts at 'lead' scope.
  const identity = readIdentity();
  const editable = editableDistricts(identity);
  const currentScope = (): 'lead' | 'hq' =>
    identity === 'admin' || identity === 'hq-technical' ? 'hq' : 'lead';

  // Role options are scoped to the ACTOR: a district lead can only appoint
  // assistants; HQ can set lead or assistant. When editing, the member's current
  // role is always shown — and locked if the actor isn't allowed to change it
  // (a lead is an HQ appointment, so a lead can't reassign the lead role).
  const buildRoleOptions = (currentRole: string) => {
    const dd = roleEl();
    if (!dd) return;
    const scope = currentScope();
    // Dedupe by role value so an option can never appear twice.
    const byValue = new Map<string, { value: string; label: string }>();
    assignableRoles(scope).forEach((r) => byValue.set(r.value, { value: r.value, label: r.label }));
    // Always keep the member's CURRENT role selectable — but only if it's a REAL
    // role (an unknown/stale role is not injected, which is what caused a phantom
    // duplicate assistant via the roleMeta fallback).
    const cur = memberRoles.find((r) => r.value === currentRole);
    if (cur) byValue.set(cur.value, { value: cur.value, label: cur.label });

    const roles = [...byValue.values()].sort((a, b) => a.label.localeCompare(b.label));
    dd.innerHTML = roles.map((r) => `<cds-dropdown-item value="${r.value}">${esc(r.label)}</cds-dropdown-item>`).join('');
    dd.value = byValue.has(currentRole) ? currentRole : (roles[0]?.value ?? 'district-assistant');

    const lockLead = scope !== 'hq' && currentRole === 'district-lead';
    if (lockLead) dd.setAttribute('disabled', '');
    else dd.removeAttribute('disabled');
    const note = $('role-lock-note');
    if (note) note.hidden = !lockLead;
  };

  // The read-only identity panel reflects the picked user's account.
  const showIdentity = (userId: string) => {
    const u = resolveUser(userId);
    const wrap = $('m-identity');
    const nameEl = $('m-id-name');
    const emailEl = $('m-id-email');
    const phoneEl = $('m-id-phone');
    if (nameEl) nameEl.textContent = u?.name ?? '';
    if (emailEl) emailEl.textContent = u?.email ?? '';
    if (phoneEl) phoneEl.textContent = u?.phone ?? '';
    if (wrap) wrap.hidden = !u;
  };

  // Populate the picker with users who ARE existing accounts and are NOT already
  // members of this district (in add mode). Members are picked, never typed.
  const buildUserOptions = () => {
    const box = userBox();
    if (!box) return;
    const taken = new Set(state.members.map((m) => m.userId));
    box.innerHTML = directory
      .filter((u) => !taken.has(u.id))
      .sort((a, b) => a.name.localeCompare(b.name))
      .map((u) => `<cds-combo-box-item value="${esc(u.id)}">${esc(u.name)} · ${esc(u.email)}</cds-combo-box-item>`)
      .join('');
    box.value = '';
  };

  const buildParkChecks = (selected: string[]) => {
    const box = $('specific-parks');
    if (!box) return;
    box.innerHTML = currentParkNames()
      .map((name) => `<cds-checkbox class="pk" data-park="${esc(name)}" label-text="${esc(name)}"${selected.includes(name) ? ' checked' : ''}></cds-checkbox>`)
      .join('');
  };

  const updateAutoAssignUI = () => {
    const specific = aaGroup()?.value === 'specific';
    const box = $('specific-parks');
    if (box) box.hidden = !specific;
  };

  const updateRoleUI = () => {
    const meta = roleMeta(roleEl()?.value ?? '');
    const leadNote = $('lead-note');
    const aaBlock = $('autoassign-block');
    if (leadNote) leadNote.hidden = meta.level !== 'lead';
    if (aaBlock) aaBlock.hidden = meta.level !== 'assistant';
    if (meta.level === 'assistant') updateAutoAssignUI();
  };

  const showWarn = (title: string, subtitle: string) => {
    if (!mWarn) return;
    mWarn.title = title;
    mWarn.subtitle = subtitle;
    mWarn.hidden = false;
  };

  const openMemberModal = (index: number) => {
    editingIndex = index;
    const blank: Member = { userId: '', role: 'district-assistant', autoAssign: { mode: 'none', parks: [] }, published: false };
    const m = index >= 0 ? state.members[index] : blank;

    // Make it unmistakable WHO is being edited — editing the wrong person's role
    // is exactly the dangerous mistake to prevent.
    const heading = $('member-modal-heading');
    const label = $('member-modal-label');
    if (index >= 0) {
      const who = resolveUser(m.userId)?.name ?? 'this user';
      if (label) label.textContent = 'Edit user';
      if (heading) heading.textContent = `Edit ${who}`;
    } else {
      if (label) label.textContent = 'District user';
      if (heading) heading.textContent = 'Add user';
    }
    if (mWarn) mWarn.hidden = true;

    selectedUserId = m.userId;
    const box = userBox();
    const modeWrap = $('m-mode-wrap');
    const existingBlock = $('m-existing');
    const newBlock = $('m-new');
    if (index >= 0) {
      // Editing: the person is fixed — no mode choice, show their identity.
      if (modeWrap) modeWrap.hidden = true;
      if (existingBlock) existingBlock.hidden = false;
      if (newBlock) newBlock.hidden = true;
      if (box) box.hidden = true;
      showIdentity(m.userId);
    } else {
      // Adding: choose an existing account or invite a new person.
      if (modeWrap) modeWrap.hidden = false;
      if (modeEl()) modeEl().value = 'existing';
      clearNewFields();
      applyMode();
      buildUserOptions();
      if (box) box.hidden = false;
      showIdentity(''); // nothing until they pick
    }

    buildRoleOptions(m.role);
    if (aaGroup()) aaGroup().value = m.autoAssign.mode || 'none';
    buildParkChecks(m.autoAssign.parks);
    const pub = $('m-published') as any;
    if (pub) pub.checked = m.published;

    updateRoleUI();
    modal.open = true;
  };

  // Validate the invite-new fields and, if good, invite the person into the
  // system scoped to THIS district (a member role IS a district-scoped account
  // role). Returns the new user id, or '' when a field is missing.
  const createInvitedMember = (role: string): string => {
    const first = valOf('m-first');
    const last = valOf('m-last');
    const email = valOf('m-email');
    const phone = valOf('m-phone');

    let ok = true;
    const fail = (id: string, msg: string) => {
      const el = $(id) as any;
      if (el) { el.invalid = true; el.invalidText = msg; }
      ok = false;
    };
    if (!first) fail('m-first', 'Enter a first name.');
    if (!last) fail('m-last', 'Enter a last name.');
    if (!email) fail('m-email', 'Enter an email address.');
    if (!ok) return '';

    return inviteUser({
      name: [first, last].filter(Boolean).join(' '),
      email,
      phone,
      role,
      district: district.id,
      expertise: [],
      invitedTo: district.id,
    });
  };

  const saveMember = () => {
    const role = roleEl()?.value ?? 'district-assistant';
    const meta = roleMeta(role);

    // Exactly one lead per district — the single-district lead-analyst rule.
    // Checked BEFORE any invite is created, so a rejected save leaves no orphan.
    if (meta.level === 'lead') {
      const other = state.members.find((x, i) => i !== editingIndex && roleMeta(x.role).level === 'lead');
      if (other) {
        const otherName = resolveUser(other.userId)?.name ?? 'Another member';
        showWarn('This district already has a lead', `${otherName} is the district lead. Change their role before assigning a new one.`);
        return;
      }
    }

    // Resolve WHO the member is: fixed on edit; picked or invited on add.
    let userId = '';
    if (editingIndex >= 0) {
      userId = selectedUserId;
    } else if (currentMode() === 'new') {
      userId = createInvitedMember(role);
      if (!userId) return; // a field is missing — inline errors already shown
    } else {
      userId = userBox()?.value || '';
    }

    if (!userId || !resolveUser(userId)) {
      showWarn('Select a user', 'Search and select an existing account, or switch to “Invite new user”.');
      return;
    }

    let autoAssign: AutoAssign = { mode: 'none', parks: [] };
    if (meta.level === 'assistant') {
      const mode = (aaGroup()?.value ?? 'none') as AutoAssign['mode'];
      const parks = mode === 'specific'
        ? Array.from(document.querySelectorAll('#specific-parks .pk'))
            .filter((c) => (c as any).checked)
            .map((c) => (c as HTMLElement).dataset.park ?? '')
            .filter(Boolean)
        : [];
      autoAssign = { mode, parks };
    } else if (meta.level === 'lead') {
      autoAssign = { mode: 'all', parks: [] };
    }

    const member: Member = {
      userId,
      role,
      autoAssign,
      published: !!($('m-published') as any)?.checked,
    };

    const wasEditing = editingIndex >= 0;
    if (wasEditing) state.members[editingIndex] = member;
    else state.members.push(member);

    renderMembers();
    persist(); // members save at confirmation — not governed by "Save changes"
    modal.open = false;
    const who = resolveUser(userId)?.name ?? 'The user';
    toast(wasEditing ? 'User updated' : 'User added', `${who} was saved to ${district.name}.`);
  };

  // ── Remove member (confirm first) ──────────────────────────────────────────
  const removeModal = $('remove-modal') as any;
  let pendingRemove = -1;

  const openRemoveModal = (index: number) => {
    pendingRemove = index;
    const m = state.members[index];
    const who = resolveUser(m?.userId)?.name ?? 'this member';
    const body = $('remove-body');
    if (body) body.textContent = `Remove ${who} from ${district.name}? They’ll no longer be auto-assigned to permits or listed as a contact.`;
    if (removeModal) removeModal.open = true;
  };

  $('remove-confirm')?.addEventListener('click', () => {
    if (pendingRemove >= 0) {
      const who = resolveUser(state.members[pendingRemove]?.userId)?.name ?? 'The user';
      state.members.splice(pendingRemove, 1);
      pendingRemove = -1;
      renderMembers();
      persist(); // instant-apply, like add/edit
      toast('User removed', `${who} was removed from ${district.name}.`);
    }
    if (removeModal) removeModal.open = false;
  });

  // ── Request account deactivation (district lead → admin) ───────────────────
  // Removing a member is district-scoped and done here; deactivating their
  // ACCOUNT is admin-held, so the lead only requests it. The request goes to the
  // /users admin inbox; approving it flips the account to inactive.
  const deactModal = $('deact-modal') as any;
  const deactReason = $('deact-reason') as any;
  let pendingDeact = -1;

  const flashMember = (title: string, subtitle: string) => toast(title, subtitle);

  const openDeactivateModal = (index: number) => {
    pendingDeact = index;
    const m = state.members[index];
    const who = resolveUser(m?.userId)?.name ?? 'this member';
    const body = $('deact-body');
    if (body) {
      body.textContent =
        `Ask an admin to deactivate ${who}’s account? It keeps its role and history but can ` +
        `no longer sign in. This is separate from removing them from the district.`;
    }
    if (deactReason) deactReason.value = '';
    if (deactModal) deactModal.open = true;
  };

  $('deact-confirm')?.addEventListener('click', () => {
    if (pendingDeact < 0) return;
    const m = state.members[pendingDeact];
    const who = resolveUser(m?.userId)?.name ?? 'The member';
    const me = activeUser(readIdentity());
    submitDeactivation({
      userId: m.userId,
      requestedBy: me?.id ?? 'unknown',
      districtId: district.id,
      reason: (deactReason?.value ?? '').trim(),
    });
    pendingDeact = -1;
    if (deactModal) deactModal.open = false;
    renderMembers(); // the row's overflow item now reads "Deactivation requested"
    flashMember(
      'Deactivation requested',
      `An admin was asked to deactivate ${who}’s account. Their district membership is unchanged until you remove it.`,
    );
  });

  // ── District-information form: dirty-tracked "Save changes" ─────────────────
  // Only the office fields are governed by "Save changes" (members + signer save
  // themselves). The button stays disabled until a field differs from what's saved.
  const collectOffice = (): Office => ({
    address: { street: valOf('e-street'), unit: valOf('e-unit'), city: valOf('e-city'), state: valOf('e-state'), zip: valOf('e-zip') },
    phone: valOf('e-phone'),
    email: valOf('e-email'),
  });
  const officeDirty = (): boolean => {
    const o = collectOffice();
    const s = state.office;
    return (
      o.phone !== s.phone || o.email !== s.email ||
      o.address.street !== s.address.street || o.address.unit !== s.address.unit ||
      o.address.city !== s.address.city || o.address.state !== s.address.state ||
      o.address.zip !== s.address.zip
    );
  };
  const updateSaveEnabled = () => {
    const btn = $('save-btn') as any;
    if (!btn) return;
    if (officeDirty()) btn.removeAttribute('disabled');
    else btn.setAttribute('disabled', '');
  };

  // ── Scope bar ──────────────────────────────────────────────────────────────
  const switcherWrap = $('switcher-wrap');
  const scopeTile = $('scope-tile');
  const switcher = $('district-switcher') as any;
  const switcherNote = $('switcher-note') as any;
  const consoleBody = $('console-body');
  const noAccess = $('no-access') as any;

  // Scope the console to the signed-in identity:
  //  - no editable districts → hide the console, show the no-access notice.
  //  - one → lock to it (no switcher; the note names the district).
  //  - many → prune the switcher to just those and reveal it.
  const applyScope = async () => {
    if (editable.length === 0) {
      if (consoleBody) consoleBody.style.display = 'none';
      if (noAccess) noAccess.hidden = false;
      return;
    }
    if (consoleBody) consoleBody.style.display = '';
    if (noAccess) noAccess.hidden = true;

    // Keep only the districts this identity may edit; default to the first.
    const allowed = new Set(editable.map((r) => r.id));
    if (switcher) {
      // Wait for the dropdown + its items to upgrade before reading/setting `.value`
      // (an unupgraded item's `.value` is undefined, which would prune everything).
      await customElements.whenDefined('cds-dropdown');
      await customElements.whenDefined('cds-dropdown-item');
      await switcher.updateComplete;
      // cds-* elements set :host display, so the `hidden` attribute won't collapse a
      // dropdown item — toggle inline display. Match on the ATTRIBUTE (always in the
      // SSR HTML) rather than the `.value` property, which lags element upgrade.
      Array.from(switcher.querySelectorAll('cds-dropdown-item')).forEach((o: any) => {
        o.style.display = allowed.has(o.getAttribute('value')) ? '' : 'none';
      });
      if (!allowed.has(switcher.value)) switcher.value = editable[0].id;
      syncBannerToSwitcher();
    }

    if (switcherWrap) switcherWrap.hidden = editable.length < 2;
    if (switcherNote) switcherNote.hidden = (switcher?.value ?? district.id) === district.id;
    // With the explanatory note gone, the scope tile only earns its space when
    // there's a district to switch between. Hide it otherwise (cds-tile sets
    // :host display, so toggle inline display, not the `hidden` attribute).
    if (scopeTile) scopeTile.style.display = editable.length < 2 ? 'none' : '';
  };

  const syncBannerToSwitcher = () => {
    const bannerName = $('banner-name');
    if (!bannerName || !switcher) return;
    const found = Array.from(switcher.querySelectorAll('cds-dropdown-item'))
      .find((o: any) => o.value === switcher.value) as HTMLElement | undefined;
    bannerName.textContent = found?.textContent?.trim() || district.name;
  };

  // ── Default signer (modal, same dual-path pattern as Add member) ────────────
  const signerModal = $('signer-modal') as any;
  const signerModeEl = () => $('signer-mode') as any;
  const signerUserBox = () => $('signer-user') as any;

  const signerCurrentMode = (): 'existing' | 'external' =>
    signerModeEl()?.value === 'external' ? 'external' : 'existing';

  const applySignerMode = () => {
    const mode = signerCurrentMode();
    const ex = $('signer-existing');
    const ext = $('signer-external');
    if (ex) ex.hidden = mode !== 'existing';
    if (ext) ext.hidden = mode !== 'external';
    const warn = $('signer-warning') as any;
    if (warn) warn.hidden = true;
  };

  // Any internal account can be picked as the signer (not scoped like members).
  const buildSignerUserOptions = (selected: string) => {
    const box = signerUserBox();
    if (!box) return;
    box.innerHTML = directory
      .map((u) => ({ id: u.id, r: resolveUser(u.id) }))
      .sort((a, b) => (a.r?.name ?? '').localeCompare(b.r?.name ?? ''))
      .map(({ id, r }) => `<cds-combo-box-item value="${esc(id)}">${esc(r?.name ?? id)} · ${esc(r?.email ?? '')}</cds-combo-box-item>`)
      .join('');
    box.value = selected || '';
  };

  const signerDisplay = (s: DefaultSigner): { name: string; email: string; tag: string } | null => {
    if (!s) return null;
    if (s.kind === 'user') {
      const u = resolveUser(s.userId);
      return u ? { name: u.name, email: u.email, tag: 'District / agency user' } : null;
    }
    return { name: s.name || s.email, email: s.name ? s.email : '', tag: 'External signer' };
  };

  const renderSigner = () => {
    const d = signerDisplay(state.defaultSigner);
    const empty = $('signer-empty');
    const card = $('signer-card');
    const btn = $('set-signer') as any;
    if (empty) empty.hidden = !!d;
    if (card) card.hidden = !d;
    if (btn) btn.textContent = d ? 'Change default signer' : 'Set default signer';
    if (d) {
      if ($('signer-name')) $('signer-name')!.textContent = d.name;
      if ($('signer-email')) $('signer-email')!.textContent = d.email;
      if ($('signer-tag')) $('signer-tag')!.textContent = d.tag;
    }
  };

  const openSignerModal = () => {
    const s = state.defaultSigner;
    if (signerModeEl()) signerModeEl().value = s?.kind === 'external' ? 'external' : 'existing';
    buildSignerUserOptions(s?.kind === 'user' ? s.userId : '');
    const extName = $('signer-ext-name') as any;
    const extEmail = $('signer-ext-email') as any;
    if (extName) { extName.value = s?.kind === 'external' ? s.name : ''; extName.invalid = false; }
    if (extEmail) { extEmail.value = s?.kind === 'external' ? s.email : ''; extEmail.invalid = false; }
    applySignerMode();
    if ($('signer-modal-heading')) $('signer-modal-heading')!.textContent = s ? 'Change default signer' : 'Set default signer';
    if (signerModal) signerModal.open = true;
  };

  $('set-signer')?.addEventListener('click', openSignerModal);
  signerModeEl()?.addEventListener('cds-content-switcher-selected', applySignerMode);
  signerUserBox()?.addEventListener('cds-combo-box-selected', () => {
    const warn = $('signer-warning') as any;
    if (warn) warn.hidden = true;
  });

  $('signer-save')?.addEventListener('click', () => {
    const warn = $('signer-warning') as any;
    const showSignerWarn = (title: string, subtitle: string) => {
      if (warn) { warn.title = title; warn.subtitle = subtitle; warn.hidden = false; }
    };
    if (signerCurrentMode() === 'existing') {
      const userId = signerUserBox()?.value || '';
      if (!userId || !resolveUser(userId)) {
        showSignerWarn('Select a user', 'Search and select an existing account, or switch to “External person”.');
        return;
      }
      state.defaultSigner = { kind: 'user', userId };
    } else {
      const extName = $('signer-ext-name') as any;
      const extEmail = $('signer-ext-email') as any;
      const name = (extName?.value || '').trim();
      const email = (extEmail?.value || '').trim();
      if (!email) {
        if (extEmail) { extEmail.invalid = true; extEmail.invalidText = 'Enter an email address.'; }
        return;
      }
      state.defaultSigner = { kind: 'external', name, email };
    }
    persist(); // instant-apply at confirmation
    renderSigner();
    if (signerModal) signerModal.open = false;
    toast('Default signer saved', 'Single-district permits in this district route their second signature here.');
  });

  $('signer-remove')?.addEventListener('click', () => {
    state.defaultSigner = null;
    persist();
    renderSigner();
    toast('Default signer removed', 'Single-district permits will have no preset second signer.');
  });

  // ── Wire everything ────────────────────────────────────────────────────────
  populateOffice();
  updateSaveEnabled(); // starts disabled — nothing changed yet
  renderMembers();
  renderSigner();
  applyScope();

  // District-information fields drive the dirty state for "Save changes".
  ['e-street', 'e-unit', 'e-city', 'e-zip', 'e-phone', 'e-email'].forEach((id) =>
    $(id)?.addEventListener('input', updateSaveEnabled),
  );
  $('e-state')?.addEventListener('cds-dropdown-selected', updateSaveEnabled);

  switcher?.addEventListener('cds-dropdown-selected', () => {
    syncBannerToSwitcher();
    if (switcherNote) switcherNote.hidden = switcher.value === district.id;
  });

  roleEl()?.addEventListener('cds-dropdown-selected', updateRoleUI);
  aaGroup()?.addEventListener('cds-radio-button-group-changed', updateAutoAssignUI);
  userBox()?.addEventListener('cds-combo-box-selected', () => {
    selectedUserId = userBox()?.value || '';
    showIdentity(selectedUserId);
    if (selectedUserId && mWarn) mWarn.hidden = true;
  });
  modeEl()?.addEventListener('cds-content-switcher-selected', applyMode);
  newFieldIds.forEach((id) =>
    $(id)?.addEventListener('input', () => {
      const el = $(id) as any;
      if (el) el.invalid = false;
    }),
  );

  $('add-member')?.addEventListener('click', () => openMemberModal(-1));
  $('m-save')?.addEventListener('click', saveMember);

  $('save-btn')?.addEventListener('click', () => {
    if (!officeDirty()) return; // button is disabled anyway; guard the direct call
    state.office = collectOffice();
    persist();
    updateSaveEnabled(); // now clean → disables again
    toast('District information saved', 'The district office details have been updated.');
  });
</script>

<style>
  .page { padding-block: 0 6rem; }

  /* Identity banner — same construction as the other screens. */
  .banner {
    background: var(--cds-background, #161616);
    margin-inline: calc(50% - 50vw);
    padding-block: var(--cds-spacing-07, 2rem);
  }
  .banner__inner {
    max-inline-size: 99rem;
    margin-inline: auto;
    padding-inline: var(--cds-grid-margin, 1.5rem);
  }
  .banner__crumb { display: block; margin-bottom: var(--cds-spacing-05, 1rem); }
  .banner__eyebrow { margin: 0 0 var(--cds-spacing-02, 0.25rem); color: var(--cds-text-secondary, #525252); }
  .banner__name { margin: 0; }

  .body { margin-top: var(--cds-spacing-07, 2rem); }
  .col {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    min-width: 0;
  }

  /* Scope bar — a cds-tile; layout only. */
  .scope__row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: flex-end;
  }
  .scope__row cds-dropdown { min-width: 18rem; }
  .scope__switcher { min-width: 18rem; }
  #switcher-note { margin-top: 1rem; }
  #switcher-note[hidden], #switcher-wrap[hidden], #no-access[hidden] { display: none; }

  /* Default-signer display. */
  .empty { margin: 0; padding: 0.5rem 0; color: var(--cds-text-secondary, #525252); }
  #signer-empty[hidden], #signer-card[hidden] { display: none; }
  .signer-actions { margin-top: 0.75rem; }
  #signer-mode-wrap { display: flex; flex-direction: column; gap: 0.5rem; }
  #signer-external { display: flex; flex-direction: column; gap: 1.25rem; }
  #signer-existing[hidden], #signer-external[hidden], #signer-warning[hidden] { display: none; }
  #signer-warning { margin-bottom: 0.5rem; }

  .section-hint {
    margin: 0 0 1.25rem;
    max-width: 52rem;
    color: var(--cds-text-secondary, #525252);
  }

  /* District-information form. */
  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    max-width: 44rem;
  }
  .field-grid__wide { grid-column: 1 / -1; }
  .field-divider { height: 1px; background: var(--cds-border-subtle-01, #e0e0e0); margin: 0.25rem 0; }
  @media (max-width: 42rem) { .field-grid { grid-template-columns: 1fr; } }

  /* Members table. */
  .table-wrap { overflow-x: auto; }
  :global(.m-name) { display: block; color: var(--cds-text-primary, #161616); }
  :global(.m-sub) { display: block; font-size: 0.75rem; color: var(--cds-text-secondary, #525252); }
  :global(.m-pending) { display: block; margin-top: 0.25rem; }
  :global(.row-actions) { display: flex; gap: 0.25rem; }

  /* Member modal internals. */
  .modal-grid { display: flex; flex-direction: column; gap: 1.25rem; }
  #m-identity[hidden] { display: none; }

  /* Add-mode: choose an existing account or invite a new person. */
  #m-mode-wrap { display: flex; flex-direction: column; gap: 0.5rem; }
  #m-mode-label { margin: 0; }
  #m-new { display: flex; flex-direction: column; gap: 1.25rem; }
  .name-row { display: flex; gap: 1rem; flex-wrap: wrap; }
  .name-row > * { flex: 1 1 10rem; min-width: 0; }
  #m-mode-wrap[hidden], #m-existing[hidden], #m-new[hidden] { display: none; }
  .identity {
    padding: 1rem;
    background: var(--cds-layer-01, #f4f4f4);
    border-left: 3px solid var(--cds-border-interactive, #0f62fe);
  }
  .identity__name { margin: 0; color: var(--cds-text-primary, #161616); }
  .identity__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.25rem 0 0;
    color: var(--cds-text-secondary, #525252);
  }
  .identity__note { margin: 0.5rem 0 0; color: var(--cds-text-secondary, #525252); }
  #member-warning { margin-bottom: 0.5rem; }
  #member-warning[hidden], #lead-note[hidden], #autoassign-block[hidden], #specific-parks[hidden] { display: none; }
  .modal-hint { margin: 0; color: var(--cds-text-secondary, #525252); }
  /* Single-column list — always one park per row so it stays easy to scan
     no matter how long the roster grows. */
  .park-checks {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.75rem;
    padding-left: 1.5rem;
  }

  .form__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1.5rem;
    /* Align to the field-grid's right edge, not the full column width, so the
       buttons sit under the fields they save. */
    max-width: 44rem;
  }
</style>
