---
import { withBase } from '../lib/base';
/* manifest:
     shell:  PermitNav (cds-header UI Shell) — Admin tools › "Manage internal users".
     header: identity banner (g100) — "Users" system-admin console + crumb.
     spine:  main.page > .cds--css-grid (single full-width column)
     sections:
       - Role change requests -> the pending inbox. A cds-table (user, current role,
                                 requested role, reason) with per-row Approve / Deny.
                                 Approving promotes the user's account role. Empty
                                 state when the queue is clear.
       - All users            -> the account directory: a cds-table (user, account
                                 role, affiliation) with per-row "Manage" opening a
                                 cds-modal to set the account role directly.
   This is the ACCOUNT axis — a user's global role lives here, not on any one
   district. (District MEMBERSHIP is edited per-district in /manage-district.)
   Prototype-local: requests + role changes persist to localStorage via
   src/data/requests.ts, shared with the profile page that submits requests.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PermitNav from '../components/PermitNav.astro';
import PermitSection from '../components/PermitSection.astro';
import { directory, publicDirectory, accountRoleOptions, expertiseOptions } from '../data/user';
import { districtDirectory } from '../data/district';

export const prototype = {
  title: 'Users',
  summary:
    'The system-admin console for user accounts — review and approve role-change ' +
    'requests, and manage every user’s global account role in one place.',
  tag: 'Internal tool',
};

// Dropdown options render alphabetically. (expertiseOptions is already A–Z with
// "Other" pinned last at the source, so it's rendered as-authored.)
const rolesSorted = [...accountRoleOptions].sort((a, b) => a.label.localeCompare(b.label));
const districtsSorted = [...districtDirectory].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Users">
  <PermitNav slot="nav" />

  <main class="page">
    <header class="banner cds--g100">
      <div class="banner__inner">
        <cds-breadcrumb no-trailing-slash class="banner__crumb">
          <cds-breadcrumb-item>
            <cds-breadcrumb-link href={withBase('/')}>Home</cds-breadcrumb-link>
          </cds-breadcrumb-item>
          <cds-breadcrumb-item>
            <cds-breadcrumb-link aria-current="page">Users</cds-breadcrumb-link>
          </cds-breadcrumb-item>
        </cds-breadcrumb>

        <p class="banner__eyebrow t-label-01">System administration</p>
        <h1 class="banner__name t-heading-05">Users</h1>
      </div>
    </header>

    <div class="cds--css-grid cds--css-grid--with-row-gap body">
      <div class="col cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
        <!-- Action confirmation. -->
        <cds-inline-notification
          id="admin-notice"
          hidden
          kind="success"
          low-contrast
          title=""
          subtitle=""
        ></cds-inline-notification>

        <!-- ── Role change requests (the inbox) ─────────────────────────────── -->
        <PermitSection title="Role change requests">
          <p class="section-hint t-body-01">
            Role changes reviewers requested from their profile. Approving
            <strong>promotes the user’s account role</strong> to the one requested; denying it
            closes the request.
          </p>

          <!-- carbon-checked: empty-state copy is prose, not a control — a <p> with a
               Carbon type role is the house pattern (see manage-district hints). -->
          <p id="requests-empty" class="empty t-body-01" hidden>No pending role change requests.</p>

          <div class="table-wrap" id="requests-wrap">
            <cds-table>
              <cds-table-head>
                <cds-table-header-row>
                  <cds-table-header-cell>User</cds-table-header-cell>
                  <cds-table-header-cell>Current role</cds-table-header-cell>
                  <cds-table-header-cell>Requested role</cds-table-header-cell>
                  <cds-table-header-cell>Reason</cds-table-header-cell>
                  <cds-table-header-cell>Actions</cds-table-header-cell>
                </cds-table-header-row>
              </cds-table-head>
              <cds-table-body id="requests-tbody"></cds-table-body>
            </cds-table>
          </div>
        </PermitSection>

        <!-- ── Pending invitations (invited, not yet accepted) ──────────────── -->
        <PermitSection title="Pending invitations">
          <cds-tag slot="aside" type="cool-gray" id="invites-count">0</cds-tag>
          <p class="section-hint t-body-01">
            People invited but not yet signed in. <strong>Resend</strong> or
            <strong>revoke</strong> an invitation, or <strong>mark it accepted</strong> once the
            person has joined.
          </p>

          <!-- carbon-checked: empty-state copy is prose, not a control — a <p> with a
               Carbon type role is the house pattern (see the requests inbox above). -->
          <p id="invites-empty" class="empty t-body-01" hidden>No pending invitations.</p>

          <div class="table-wrap" id="invites-wrap">
            <cds-table>
              <cds-table-head>
                <cds-table-header-row>
                  <cds-table-header-cell>User</cds-table-header-cell>
                  <cds-table-header-cell>Role</cds-table-header-cell>
                  <cds-table-header-cell>Affiliation</cds-table-header-cell>
                  <cds-table-header-cell>Invited</cds-table-header-cell>
                  <cds-table-header-cell>Actions</cds-table-header-cell>
                </cds-table-header-row>
              </cds-table-head>
              <cds-table-body id="invites-tbody"></cds-table-body>
            </cds-table>
          </div>
        </PermitSection>

        <!-- ── Internal users (agency staff accounts) ───────────────────────── -->
        <PermitSection title="Internal users">
          <cds-tag slot="aside" type="cool-gray" id="users-count">{directory.length}</cds-tag>
          <cds-button slot="aside" kind="tertiary" size="md" id="add-user-btn">Invite user</cds-button>
          <p class="section-hint t-body-01">
            Agency staff — their global role, expertise, and whether they’ve accepted. Use
            <strong>Edit</strong> to change a name, contact details, or role, or
            <strong>Invite user</strong> to add one. Per-district assignments are edited on the
            district’s management screen, not here.
          </p>
          <div class="table-wrap">
            <cds-table>
              <cds-table-head>
                <cds-table-header-row>
                  <cds-table-header-cell>User</cds-table-header-cell>
                  <cds-table-header-cell>Status</cds-table-header-cell>
                  <cds-table-header-cell>Account role</cds-table-header-cell>
                  <cds-table-header-cell>Expertise</cds-table-header-cell>
                  <cds-table-header-cell>Affiliation</cds-table-header-cell>
                  <cds-table-header-cell>Actions</cds-table-header-cell>
                </cds-table-header-row>
              </cds-table-head>
              <cds-table-body id="users-tbody"></cds-table-body>
            </cds-table>
          </div>
        </PermitSection>

        <!-- ── Public users (applicant / researcher accounts) ───────────────── -->
        <PermitSection title="Public users">
          <cds-tag slot="aside" type="cool-gray" id="public-count">{publicDirectory.length}</cds-tag>
          <p class="section-hint t-body-01">
            Members of the public who apply for permits — researchers and their institutions. They
            carry no agency role. Use <strong>Edit</strong> to correct a name or contact details;
            their email verifies the account at sign-in and can’t be changed.
          </p>
          <div class="table-wrap">
            <cds-table>
              <cds-table-head>
                <cds-table-header-row>
                  <cds-table-header-cell>User</cds-table-header-cell>
                  <cds-table-header-cell>Organization</cds-table-header-cell>
                  <cds-table-header-cell>Phone</cds-table-header-cell>
                  <cds-table-header-cell>Actions</cds-table-header-cell>
                </cds-table-header-row>
              </cds-table-head>
              <cds-table-body id="public-tbody"></cds-table-body>
            </cds-table>
          </div>
        </PermitSection>
      </div>
    </div>

    <!-- ── Edit-user modal: name + contact (email read-only), and role/expertise
         for internal accounts ───────────────────────────────────────────────── -->
    <cds-modal id="user-modal" size="sm">
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label>User account</cds-modal-label>
        <cds-modal-heading>Edit user</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <div class="modal-grid">
          <!-- Editable identity — name + phone. -->
          <cds-text-input id="u-name" label="Full name" placeholder="e.g. Jordan Rivera"></cds-text-input>
          <cds-text-input id="u-phone" label="Phone" placeholder="(916) 555-0100"></cds-text-input>

          <!-- Email is read-only: it verifies the account at sign-in, so it can't
               be changed here. A labeled value block, not a disabled input. -->
          <div class="readonly-field">
            <p class="rf-label t-label-01">Email</p>
            <p class="rf-value t-body-01" id="u-email"></p>
            <p class="rf-note t-label-01">Verified at sign-in — can’t be changed here.</p>
          </div>

          <!-- Organization — read-only context, shown for public users only. -->
          <div class="readonly-field" id="u-org-wrap" hidden>
            <p class="rf-label t-label-01">Organization</p>
            <p class="rf-value t-body-01" id="u-org"></p>
          </div>

          <!-- Role & access — internal accounts only (public users carry no role). -->
          <div id="u-role-section">
            <!-- autoalign: Floating UI positions the open menu so it escapes the
                 modal's scroll container instead of being clipped/faded at the
                 bottom (Carbon drops the modal's mask fade when a dropdown auto-aligns). -->
            <cds-dropdown id="u-role" title-text="Account role" autoalign>
              {rolesSorted.map((r) => (
                <cds-dropdown-item value={r.value}>{r.label}</cds-dropdown-item>
              ))}
            </cds-dropdown>
            <!-- carbon-checked: the dropdown has no per-option helper slot; this <p>
                 is the reusable home for the selected role's description. -->
            <p class="modal-desc t-label-01" id="u-role-desc"></p>

            <!-- District picker — shown only for a district-scoped role (lead /
                 assistant), which is always the lead/assistant OF a district. -->
            <div id="u-district-wrap" hidden>
              <cds-dropdown id="u-district" title-text="District" autoalign>
                {districtsSorted.map((d) => (
                  <cds-dropdown-item value={d.id}>{d.name}</cds-dropdown-item>
                ))}
              </cds-dropdown>
            </div>

            <!-- Areas of expertise — only for HQ technical reviewers (≥1 required). -->
            <div id="u-expertise-wrap" hidden>
              <cds-multi-select id="u-expertise" title-text="Areas of expertise" label="Select areas" autoalign>
                {expertiseOptions.map((e) => (
                  <cds-multi-select-item value={e.value}>{e.label}</cds-multi-select-item>
                ))}
              </cds-multi-select>
              <p class="modal-hint t-label-01" id="u-expertise-hint"></p>
            </div>
          </div>
        </div>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="primary" id="u-save">Save changes</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>

    <!-- ── Invite-user modal: create a PENDING account, set its role + expertise ── -->
    <cds-modal id="add-modal" size="sm">
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label>New account</cds-modal-label>
        <cds-modal-heading>Invite user</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <div class="modal-grid">
          <div class="name-row">
            <cds-text-input id="au-first" label="First name" placeholder="e.g. Jordan"></cds-text-input>
            <cds-text-input id="au-last" label="Last name" placeholder="e.g. Rivera"></cds-text-input>
          </div>
          <cds-text-input id="au-email" type="email" label="Email" placeholder="name@parks.ca.gov"></cds-text-input>
          <cds-text-input id="au-phone" label="Phone" placeholder="(916) 555-0100"></cds-text-input>

          <cds-dropdown id="au-role" title-text="Account role" label="Select a role" autoalign>
            {rolesSorted.map((r) => (
              <cds-dropdown-item value={r.value}>{r.label}</cds-dropdown-item>
            ))}
          </cds-dropdown>
          <p class="modal-desc t-label-01" id="au-role-desc"></p>

          <!-- District — required for a district-scoped role. -->
          <div id="au-district-wrap" hidden>
            <cds-dropdown id="au-district" title-text="District" autoalign>
              {districtsSorted.map((d) => (
                <cds-dropdown-item value={d.id}>{d.name}</cds-dropdown-item>
              ))}
            </cds-dropdown>
          </div>

          <!-- Areas of expertise — only for HQ technical reviewers (≥1 required). -->
          <div id="au-expertise-wrap" hidden>
            <cds-multi-select id="au-expertise" title-text="Areas of expertise" label="Select areas" autoalign>
              {expertiseOptions.map((e) => (
                <cds-multi-select-item value={e.value}>{e.label}</cds-multi-select-item>
              ))}
            </cds-multi-select>
            <p class="modal-hint t-label-01" id="au-expertise-hint"></p>
          </div>
        </div>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="primary" id="au-save">Send invitation</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>

    <!-- ── Shared confirmation for consequential actions (deny / revoke) ────── -->
    <cds-modal id="confirm-modal" size="xs" danger>
      <cds-modal-header>
        <cds-modal-close-button></cds-modal-close-button>
        <cds-modal-label id="confirm-label">Confirm</cds-modal-label>
        <cds-modal-heading id="confirm-heading">Are you sure?</cds-modal-heading>
      </cds-modal-header>
      <cds-modal-body>
        <!-- carbon-checked: confirmation prose has no cds-* component; a <p> with the
             Carbon type role is the house pattern for modal body copy. -->
        <p class="modal-hint t-body-01" id="confirm-body"></p>
      </cds-modal-body>
      <cds-modal-footer>
        <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
        <cds-modal-footer-button kind="danger" id="confirm-action">Confirm</cds-modal-footer-button>
      </cds-modal-footer>
    </cds-modal>
  </main>
</BaseLayout>

<script>
  import { accountRoleOptions, accountRoleMeta, expertiseLabel } from '../data/user';
  import {
    pendingRequests,
    decideRequest,
    accountRoleOf,
    accountRoleDisplay,
    setAccountRole,
    roleLabel,
    roleDisplay,
    affiliationOf,
    expertiseOf,
    setExpertise,
    setContact,
    listUsers,
    listPublicUsers,
    resolveUser,
    inviteUser,
    userStatus,
    pendingInvites,
    resendInvite,
    revokeInvite,
  } from '../data/requests';
  import { avatarHTML } from '../lib/avatar';

  const $ = (id: string) => document.getElementById(id);
  const esc = (s = '') =>
    s.replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));

  // ── Confirm consequential actions (deny a role request, revoke an invite) ──
  // One shared danger modal; each caller supplies the copy + the action to run
  // once confirmed. Deny/Revoke keep their own verbs (they're not a generic
  // "remove"), but both now confirm before firing.
  const confirmModal = $('confirm-modal') as any;
  let pendingAction: (() => void) | null = null;
  const askConfirm = (opts: { label: string; heading: string; body: string; confirmLabel: string; action: () => void }) => {
    const setText = (id: string, v: string) => { const el = $(id); if (el) el.textContent = v; };
    setText('confirm-label', opts.label);
    setText('confirm-heading', opts.heading);
    setText('confirm-body', opts.body);
    setText('confirm-action', opts.confirmLabel);
    pendingAction = opts.action;
    if (confirmModal) confirmModal.open = true;
  };
  $('confirm-action')?.addEventListener('click', () => {
    const run = pendingAction;
    pendingAction = null;
    if (confirmModal) confirmModal.open = false;
    run?.();
  });

  // A User cell: shared initials chip + name/email — one source (src/lib/avatar.ts).
  const userCellHTML = (name: string, email: string) =>
    `<div class="u-id">${avatarHTML(name, 'sm')}` +
    `<span class="u-idtext"><span class="u-name">${esc(name)}</span><span class="u-sub">${esc(email)}</span></span></div>`;

  // Account status is STATE, not a category — an icon-indicator (icon + label),
  // never a colored tag: pending until the invite is accepted, then active.
  const statusCellHTML = (userId: string) =>
    userStatus(userId) === 'invited'
      ? '<cds-icon-indicator size="16" kind="pending" label="Invited"></cds-icon-indicator>'
      : '<cds-icon-indicator size="16" kind="succeeded" label="Active"></cds-icon-indicator>';

  // A quiet relative age for the invited timestamp ("Just now", "3 hr ago").
  const timeAgo = (ms: number) => {
    if (!ms) return '—';
    const min = Math.round((Date.now() - ms) / 60000);
    if (min < 1) return 'Just now';
    if (min < 60) return `${min} min ago`;
    const hr = Math.round(min / 60);
    if (hr < 24) return `${hr} hr ago`;
    const day = Math.round(hr / 24);
    return `${day} day${day === 1 ? '' : 's'} ago`;
  };

  const notice = $('admin-notice') as any;
  const flash = (title: string, subtitle: string) => {
    if (!notice) return;
    notice.title = title;
    notice.subtitle = subtitle;
    notice.hidden = false;
    notice.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  };

  // ── Requests inbox ──────────────────────────────────────────────────────────
  const renderRequests = () => {
    const tbody = $('requests-tbody');
    const empty = $('requests-empty');
    const wrap = $('requests-wrap');
    if (!tbody) return;

    const rows = pendingRequests();
    if (empty) empty.hidden = rows.length > 0;
    if (wrap) wrap.hidden = rows.length === 0;

    tbody.replaceChildren(
      ...rows.map((req) => {
        const user = resolveUser(req.userId);
        const row = document.createElement('cds-table-row');

        const userCell = document.createElement('cds-table-cell');
        userCell.innerHTML = userCellHTML(user?.name ?? '(unknown user)', user?.email ?? '');

        const currentCell = document.createElement('cds-table-cell');
        currentCell.innerHTML = `<cds-tag type="cool-gray" size="sm">${esc(accountRoleDisplay(req.userId))}</cds-tag>`;

        const requestedCell = document.createElement('cds-table-cell');
        requestedCell.innerHTML = `<cds-tag type="blue" size="sm">${esc(roleDisplay(req.role, req.district))}</cds-tag>`;

        const reasonCell = document.createElement('cds-table-cell');
        reasonCell.innerHTML = `<span class="u-reason">${esc(req.reason || '—')}</span>`;

        const actionCell = document.createElement('cds-table-cell');
        const wrapEl = document.createElement('div');
        wrapEl.className = 'row-actions';
        const approve = document.createElement('cds-button');
        approve.setAttribute('kind', 'ghost'); approve.setAttribute('size', 'sm');
        approve.textContent = 'Approve';
        approve.addEventListener('click', () => {
          decideRequest(req.id, 'approved');
          renderRequests();
          renderUsers();
          flash('Request approved', `${user?.name ?? 'The user'} is now ${roleDisplay(req.role, req.district)}.`);
        });
        const deny = document.createElement('cds-button');
        deny.setAttribute('kind', 'danger-ghost'); deny.setAttribute('size', 'sm');
        deny.textContent = 'Deny';
        deny.addEventListener('click', () => {
          askConfirm({
            label: 'Role request',
            heading: 'Deny role request',
            body: `Deny ${user?.name ?? 'this user'}’s request for ${roleLabel(req.role)}? They keep their current access and can request again.`,
            confirmLabel: 'Deny request',
            action: () => {
              decideRequest(req.id, 'denied');
              renderRequests();
              flash('Request denied', `${user?.name ?? 'The user'}’s request for ${roleLabel(req.role)} was denied.`);
            },
          });
        });
        wrapEl.append(approve, deny);
        actionCell.appendChild(wrapEl);

        row.append(userCell, currentCell, requestedCell, reasonCell, actionCell);
        return row;
      }),
    );
  };

  // ── User directory ──────────────────────────────────────────────────────────
  // Expertise cell: one quiet chip per area, or an em dash when none.
  const expertiseCellHTML = (values: string[]) =>
    values.length
      ? `<div class="u-expertise">${values
          .map((v) => `<cds-tag type="cool-gray" size="sm">${esc(expertiseLabel(v))}</cds-tag>`)
          .join('')}</div>`
      : '<span class="u-sub">—</span>';

  const renderUsers = () => {
    const tbody = $('users-tbody');
    if (!tbody) return;
    const users = listUsers();
    const count = $('users-count');
    if (count) count.textContent = String(users.length);

    tbody.replaceChildren(
      ...users.map((u) => {
        const row = document.createElement('cds-table-row');

        const userCell = document.createElement('cds-table-cell');
        userCell.innerHTML = userCellHTML(u.name, u.email);

        const statusCell = document.createElement('cds-table-cell');
        statusCell.innerHTML = statusCellHTML(u.id);

        const roleCell = document.createElement('cds-table-cell');
        // Just the role label — the district already lives in the Affiliation
        // column, so repeating it here (accountRoleDisplay adds it) is redundant.
        roleCell.textContent = roleLabel(accountRoleOf(u.id).role);

        const expertiseCell = document.createElement('cds-table-cell');
        expertiseCell.innerHTML = expertiseCellHTML(expertiseOf(u.id));

        // District for a district-scoped role, else "HQ" — derived from the role.
        const affilCell = document.createElement('cds-table-cell');
        affilCell.textContent = affiliationOf(u.id);

        const actionCell = document.createElement('cds-table-cell');
        const manage = document.createElement('cds-button');
        manage.setAttribute('kind', 'ghost'); manage.setAttribute('size', 'sm');
        manage.textContent = 'Edit';
        manage.addEventListener('click', () => openUserModal(u.id, 'internal'));
        actionCell.appendChild(manage);

        row.append(userCell, statusCell, roleCell, expertiseCell, affilCell, actionCell);
        return row;
      }),
    );
  };

  // ── Public users (applicants / researchers) ─────────────────────────────────
  const renderPublicUsers = () => {
    const tbody = $('public-tbody');
    if (!tbody) return;
    const users = listPublicUsers();
    const count = $('public-count');
    if (count) count.textContent = String(users.length);

    tbody.replaceChildren(
      ...users.map((u) => {
        const row = document.createElement('cds-table-row');

        const userCell = document.createElement('cds-table-cell');
        userCell.innerHTML = userCellHTML(u.name, u.email);

        const orgCell = document.createElement('cds-table-cell');
        orgCell.textContent = u.organization;

        const phoneCell = document.createElement('cds-table-cell');
        phoneCell.textContent = u.phone || '—';

        const actionCell = document.createElement('cds-table-cell');
        const edit = document.createElement('cds-button');
        edit.setAttribute('kind', 'ghost'); edit.setAttribute('size', 'sm');
        edit.textContent = 'Edit';
        edit.addEventListener('click', () => openUserModal(u.id, 'public'));
        actionCell.appendChild(edit);

        row.append(userCell, orgCell, phoneCell, actionCell);
        return row;
      }),
    );
  };

  // ── Pending invitations ─────────────────────────────────────────────────────
  const renderInvites = () => {
    const tbody = $('invites-tbody');
    const empty = $('invites-empty');
    const wrap = $('invites-wrap');
    if (!tbody) return;

    const invites = pendingInvites();
    const count = $('invites-count');
    if (count) count.textContent = String(invites.length);
    if (empty) empty.hidden = invites.length > 0;
    if (wrap) wrap.hidden = invites.length === 0;

    tbody.replaceChildren(
      ...invites.map((inv) => {
        const row = document.createElement('cds-table-row');

        const userCell = document.createElement('cds-table-cell');
        userCell.innerHTML = userCellHTML(inv.name, inv.email);

        const roleCell = document.createElement('cds-table-cell');
        roleCell.textContent = roleLabel(accountRoleOf(inv.id).role);

        const affilCell = document.createElement('cds-table-cell');
        affilCell.textContent = affiliationOf(inv.id);

        const whenCell = document.createElement('cds-table-cell');
        whenCell.textContent = timeAgo(inv.invitedAt);

        const actionCell = document.createElement('cds-table-cell');
        const wrapEl = document.createElement('div');
        wrapEl.className = 'row-actions';

        const resend = document.createElement('cds-button');
        resend.setAttribute('kind', 'ghost'); resend.setAttribute('size', 'sm');
        resend.textContent = 'Resend';
        resend.addEventListener('click', () => {
          resendInvite(inv.id);
          renderInvites();
          flash('Invitation resent', `A new invitation was sent to ${inv.email}.`);
        });

        const revoke = document.createElement('cds-button');
        revoke.setAttribute('kind', 'danger-ghost'); revoke.setAttribute('size', 'sm');
        revoke.textContent = 'Revoke';
        revoke.addEventListener('click', () => {
          askConfirm({
            label: 'Pending invitation',
            heading: 'Revoke invitation',
            body: `Revoke ${inv.name}’s invitation? The sign-in link in their email will stop working.`,
            confirmLabel: 'Revoke invitation',
            action: () => {
              revokeInvite(inv.id);
              renderInvites();
              renderUsers();
              flash('Invitation revoked', `${inv.name}’s invitation was removed.`);
            },
          });
        });

        wrapEl.append(resend, revoke);
        actionCell.appendChild(wrapEl);

        row.append(userCell, roleCell, affilCell, whenCell, actionCell);
        return row;
      }),
    );
  };

  // ── Edit-user modal ───────────────────────────────────────────────────────────
  const modal = $('user-modal') as any;
  const nameEl = $('u-name') as any;
  const phoneEl = $('u-phone') as any;
  const roleSection = $('u-role-section');
  const orgWrap = $('u-org-wrap');
  const orgEl = $('u-org');
  const roleEl = $('u-role') as any;
  const roleDesc = $('u-role-desc');
  const districtWrap = $('u-district-wrap');
  const districtEl = $('u-district') as any;
  const expertiseWrap = $('u-expertise-wrap');
  const expertiseEl = $('u-expertise') as any;
  const expertiseHint = $('u-expertise-hint');
  let editingUserId = '';
  let editingKind: 'internal' | 'public' = 'internal';

  const HQ = 'hq-technical';
  const isScoped = (value: string) => !!accountRoleMeta(value)?.scoped;
  const expertiseHintText = (value: string) =>
    value === HQ
      ? 'Required — HQ technical reviewers need at least one area of expertise.'
      : 'Optional — the reviewer’s resource-domain expertise.';

  // A district role needs a district; a global one doesn't — show the picker and
  // the role's description to match the current selection. Expertise is required
  // for the HQ technical reviewer role, optional otherwise.
  const syncForRole = (value: string) => {
    if (roleDesc) roleDesc.textContent = accountRoleMeta(value)?.description ?? '';
    if (districtWrap) districtWrap.hidden = !isScoped(value);
    // Expertise applies only to HQ technical reviewers — hide it for every other role.
    if (expertiseWrap) expertiseWrap.hidden = value !== HQ;
    if (expertiseHint) {
      expertiseHint.textContent = value === HQ ? expertiseHintText(value) : '';
      expertiseHint.removeAttribute('data-error');
    }
  };

  const openUserModal = (userId: string, kind: 'internal' | 'public') => {
    editingUserId = userId;
    editingKind = kind;
    const u = resolveUser(userId);
    if (nameEl) { nameEl.value = u?.name ?? ''; nameEl.invalid = false; }
    if (phoneEl) phoneEl.value = u?.phone ?? '';
    if ($('u-email')) $('u-email')!.textContent = u?.email ?? '';

    // Role/expertise apply to internal accounts only; public users carry none.
    if (roleSection) roleSection.hidden = kind !== 'internal';
    if (orgWrap) orgWrap.hidden = kind !== 'public';
    if (kind === 'public') {
      const pub = listPublicUsers().find((p) => p.id === userId);
      if (orgEl) orgEl.textContent = pub?.organization ?? '';
    } else {
      const { role, district } = accountRoleOf(userId);
      if (roleEl) roleEl.value = role || accountRoleOptions[0].value;
      if (districtEl) districtEl.value = district || 'north-coast-redwoods';
      // Setting the multi-select's comma-joined value reconciles its checkboxes.
      if (expertiseEl) expertiseEl.value = expertiseOf(userId).join(',');
      syncForRole(roleEl?.value);
    }
    modal.open = true;
  };

  roleEl?.addEventListener('cds-dropdown-selected', () => syncForRole(roleEl.value));

  $('u-save')?.addEventListener('click', () => {
    if (!editingUserId) return;

    // Name is required — an account can't lose its display name. Phone is optional.
    const name = (nameEl?.value || '').trim();
    const phone = (phoneEl?.value || '').trim();
    if (!name) {
      if (nameEl) { nameEl.invalid = true; nameEl.invalidText = 'Enter a name.'; }
      return;
    }

    // Internal accounts also carry a role (+ HQ expertise); validate before saving.
    let value = '';
    let district: string | undefined;
    let expertise: string[] = [];
    if (editingKind === 'internal') {
      value = roleEl?.value || '';
      if (!value) return;
      district = isScoped(value) ? (districtEl?.value || 'north-coast-redwoods') : undefined;
      // Expertise is an HQ-only attribute — non-HQ roles carry none.
      expertise = value === HQ ? (expertiseEl?.value || '').split(',').filter(Boolean) : [];
      if (value === HQ && expertise.length === 0) {
        if (expertiseHint) {
          expertiseHint.textContent = 'HQ technical reviewers need at least one area of expertise.';
          expertiseHint.setAttribute('data-error', '');
        }
        return;
      }
    }

    // Contact edits apply to every account; role/expertise only to internal ones.
    setContact(editingUserId, { name, phone });
    if (editingKind === 'internal') {
      setAccountRole(editingUserId, value, district);
      setExpertise(editingUserId, expertise);
    }

    modal.open = false;
    if (editingKind === 'internal') {
      renderUsers();
      renderRequests(); // current-role / name column may reference this user
      flash('User updated', `${name} is now ${roleDisplay(value, district)}.`);
    } else {
      renderPublicUsers();
      flash('User updated', `${name}’s details were saved.`);
    }
  });

  // ── Add-user modal ──────────────────────────────────────────────────────────
  const addModal = $('add-modal') as any;
  const auFirst = $('au-first') as any;
  const auLast = $('au-last') as any;
  const auEmail = $('au-email') as any;
  const auPhone = $('au-phone') as any;
  const auRole = $('au-role') as any;
  const auRoleDesc = $('au-role-desc');
  const auDistrictWrap = $('au-district-wrap');
  const auDistrict = $('au-district') as any;
  const auExpertiseWrap = $('au-expertise-wrap');
  const auExpertise = $('au-expertise') as any;
  const auExpertiseHint = $('au-expertise-hint');

  const clearInvalid = (el: any) => { if (el) el.invalid = false; };

  const auSyncForRole = (value: string) => {
    if (auRoleDesc) auRoleDesc.textContent = accountRoleMeta(value)?.description ?? '';
    if (auDistrictWrap) auDistrictWrap.hidden = !isScoped(value);
    // Expertise applies only to HQ technical reviewers — hide it for every other role.
    if (auExpertiseWrap) auExpertiseWrap.hidden = value !== HQ;
    if (auExpertiseHint) {
      auExpertiseHint.textContent = value === HQ ? expertiseHintText(value) : '';
      auExpertiseHint.removeAttribute('data-error');
    }
  };

  const openAddModal = () => {
    if (auFirst) { auFirst.value = ''; clearInvalid(auFirst); }
    if (auLast) { auLast.value = ''; clearInvalid(auLast); }
    if (auEmail) { auEmail.value = ''; clearInvalid(auEmail); }
    if (auPhone) auPhone.value = '';
    if (auRole) { auRole.value = ''; clearInvalid(auRole); }
    if (auDistrict) auDistrict.value = 'north-coast-redwoods';
    if (auExpertise) auExpertise.value = '';
    auSyncForRole('');
    addModal.open = true;
  };

  $('add-user-btn')?.addEventListener('click', openAddModal);
  auRole?.addEventListener('cds-dropdown-selected', () => { clearInvalid(auRole); auSyncForRole(auRole.value); });
  auFirst?.addEventListener('input', () => clearInvalid(auFirst));
  auLast?.addEventListener('input', () => clearInvalid(auLast));
  auEmail?.addEventListener('input', () => clearInvalid(auEmail));

  $('au-save')?.addEventListener('click', () => {
    const first = (auFirst?.value || '').trim();
    const last = (auLast?.value || '').trim();
    const name = [first, last].filter(Boolean).join(' ');
    const email = (auEmail?.value || '').trim();
    const phone = (auPhone?.value || '').trim();
    const role = auRole?.value || '';
    const district = isScoped(role) ? (auDistrict?.value || 'north-coast-redwoods') : undefined;
    // Expertise is an HQ-only attribute — non-HQ roles carry none.
    const expertise = role === HQ ? (auExpertise?.value || '').split(',').filter(Boolean) : [];

    let ok = true;
    if (!first) { if (auFirst) { auFirst.invalid = true; auFirst.invalidText = 'Enter a first name.'; } ok = false; }
    if (!last) { if (auLast) { auLast.invalid = true; auLast.invalidText = 'Enter a last name.'; } ok = false; }
    if (!email) { if (auEmail) { auEmail.invalid = true; auEmail.invalidText = 'Enter an email address.'; } ok = false; }
    if (!role) { if (auRole) { auRole.invalid = true; auRole.invalidText = 'Select an account role.'; } ok = false; }
    if (role === HQ && expertise.length === 0) {
      if (auExpertiseHint) {
        auExpertiseHint.textContent = 'HQ technical reviewers need at least one area of expertise.';
        auExpertiseHint.setAttribute('data-error', '');
      }
      ok = false;
    }
    if (!ok) return;

    inviteUser({ name, email, phone, role, district, expertise });
    addModal.open = false;
    renderInvites();
    renderUsers();
    flash('Invitation sent', `${name} was invited as ${roleDisplay(role, district)}. They’ll show as active once they accept.`);
  });

  // ── Init ──────────────────────────────────────────────────────────────────────
  renderRequests();
  renderInvites();
  renderUsers();
  renderPublicUsers();
</script>

<style>
  .page { padding-block: 0 6rem; }

  /* Identity banner — same construction as the other admin screens. */
  .banner {
    background: var(--cds-background, #161616);
    margin-inline: calc(50% - 50vw);
    padding-block: var(--cds-spacing-07, 2rem);
  }
  .banner__inner {
    max-inline-size: 99rem;
    margin-inline: auto;
    padding-inline: var(--cds-grid-margin, 1.5rem);
  }
  .banner__crumb { display: block; margin-bottom: var(--cds-spacing-05, 1rem); }
  .banner__eyebrow { margin: 0 0 var(--cds-spacing-02, 0.25rem); color: var(--cds-text-secondary, #525252); }
  .banner__name { margin: 0; }

  .body { margin-top: var(--cds-spacing-07, 2rem); }
  .col {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    min-width: 0;
  }

  .section-hint {
    margin: 0 0 1.25rem;
    max-width: 52rem;
    color: var(--cds-text-secondary, #525252);
  }
  .empty {
    margin: 0;
    padding: 1.5rem 0;
    color: var(--cds-text-secondary, #525252);
  }
  .empty[hidden], #requests-wrap[hidden], #invites-wrap[hidden], #admin-notice[hidden] { display: none; }
  #admin-notice { margin-bottom: 1.25rem; max-width: 52rem; }

  /* Tables — client-rendered cells use global classes. */
  .table-wrap { overflow-x: auto; }
  :global(.u-id) { display: flex; align-items: center; gap: 0.625rem; }
  :global(.u-idtext) { min-width: 0; }
  /* The identity chip (.avatar) is styled globally in theme.css — one source. */
  :global(.u-name) { display: block; color: var(--cds-text-primary, #161616); }
  :global(.u-sub) { display: block; font-size: 0.75rem; color: var(--cds-text-secondary, #525252); }
  :global(.u-reason) {
    display: block;
    max-width: 26rem;
    color: var(--cds-text-secondary, #525252);
  }
  :global(.row-actions) { display: flex; gap: 0.25rem; }
  /* Expertise chips wrap within the cell rather than stretching the column. */
  :global(.u-expertise) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    max-width: 22rem;
  }

  /* Manage-user modal internals. */
  .modal-grid { display: flex; flex-direction: column; gap: 1.25rem; }
  /* First + last name share a row, stacking on narrow widths. */
  .name-row { display: flex; gap: 1rem; flex-wrap: wrap; }
  .name-row > * { flex: 1 1 10rem; min-width: 0; }
  .identity {
    padding: 1rem;
    background: var(--cds-layer-01, #f4f4f4);
    border-left: 3px solid var(--cds-border-interactive, #0f62fe);
  }
  .identity__name { margin: 0; color: var(--cds-text-primary, #161616); }
  .identity__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.25rem 0 0;
    color: var(--cds-text-secondary, #525252);
  }
  .identity__note { margin: 0.5rem 0 0; color: var(--cds-text-secondary, #525252); }
  .modal-desc { margin: 0; color: var(--cds-text-secondary, #525252); }
  /* Expertise helper text; turns error-red when the HQ rule is unmet. */
  .modal-hint { margin: 0.375rem 0 0; color: var(--cds-text-secondary, #525252); }
  .modal-hint[data-error] { color: var(--cds-text-error, #da1e28); }
</style>
