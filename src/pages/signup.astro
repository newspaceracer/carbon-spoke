---
// Self-service account creation for INTERNAL staff. The domain is the router:
// a verified @parks.ca.gov email creates a real (but roleless) account and drops
// the person into the pending-role flow; any other address is sent to the public
// applicant path instead — researchers don't need an account. Strict least
// privilege: signing up grants identity, never authority (a role is requested and
// admin-approved afterward). Composed from stock cds-* (tile, inputs, button,
// notification). Prototype-local: no real auth or email — see src/data/requests.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';

export const prototype = {
  title: 'Create account',
  summary:
    'Self-service sign-up for State Parks staff. A verified parks.ca.gov email ' +
    'creates a roleless account and starts the pending-role flow; other addresses ' +
    'are routed to the public application.',
  tag: 'System',
};
---

<BaseLayout title="Create account — CA State Parks">
  <!-- No app nav on the sign-up screen (empty nav slot suppresses AppHeader). -->
  <Fragment slot="nav"></Fragment>

  <main class="signup">
    <cds-tile class="signup__card">
      <p class="signup__eyebrow t-label-01">CA State Parks · Scientific Collecting Permits</p>
      <h1 class="signup__title t-heading-04">Create your account</h1>
      <p class="signup__lede t-body-01">
        For State Parks staff who review permits. Use your <strong>@parks.ca.gov</strong> email.
      </p>

      <!-- Wrong domain: not an error the user should fix here — a redirect to the
           right door. Shown with the public-application link. -->
      <cds-inline-notification
        id="domain-notice"
        hidden
        kind="info"
        low-contrast
        hide-close-button
        title="This looks like an applicant"
        subtitle="Staff accounts need a parks.ca.gov email. Researchers applying for a permit don’t need an account."
      ></cds-inline-notification>

      <form id="signup-form" class="signup__form">
        <div class="signup__names">
          <cds-text-input id="su-first" label="First name" placeholder="e.g. Taylor"></cds-text-input>
          <cds-text-input id="su-last" label="Last name" placeholder="e.g. Nguyen"></cds-text-input>
        </div>
        <cds-text-input id="su-email" type="email" label="Work email" placeholder="name@parks.ca.gov"></cds-text-input>
        <cds-text-input id="su-phone" label="Phone (optional)" placeholder="(916) 555-0100"></cds-text-input>

        <p class="signup__note t-label-01">
          We’ll email a verification link to confirm it’s you. In this prototype, creating the account continues straight through.
        </p>

        <cds-button id="su-submit" type="button" class="signup__submit">Create account</cds-button>
        <cds-button id="su-apply" type="button" kind="tertiary" hidden>Start a public application</cds-button>
      </form>

      <p class="signup__alt t-label-01">
        Already have an account? <cds-link href={withBase('/login')}>Sign in</cds-link>
      </p>
    </cds-tile>
  </main>
</BaseLayout>

<script>
  import { selfRegister } from '../data/requests';
  import { writeIdentity, writePendingUserId, ROUTES } from '../lib/maintenance';
  import { withBase } from '../lib/base';

  const $ = (id: string) => document.getElementById(id) as any;
  const first = $('su-first');
  const last = $('su-last');
  const email = $('su-email');
  const phone = $('su-phone');
  const notice = $('domain-notice');
  const applyBtn = $('su-apply');

  const clearInvalid = (el: any) => { if (el) el.invalid = false; };
  [first, last, email].forEach((el) => el?.addEventListener('input', () => clearInvalid(el)));
  // Re-typing the email hides the applicant redirect until we re-check on submit.
  email?.addEventListener('input', () => { if (notice) notice.hidden = true; if (applyBtn) applyBtn.hidden = true; });

  const isParksEmail = (v: string) => /@parks\.ca\.gov$/i.test(v.trim());

  applyBtn?.addEventListener('click', () => { location.href = withBase('/apply'); });

  $('su-submit')?.addEventListener('click', () => {
    const f = (first?.value || '').trim();
    const l = (last?.value || '').trim();
    const e = (email?.value || '').trim();
    const p = (phone?.value || '').trim();

    let ok = true;
    if (!f) { first.invalid = true; first.invalidText = 'Enter your first name.'; ok = false; }
    if (!l) { last.invalid = true; last.invalidText = 'Enter your last name.'; ok = false; }
    if (!e) { email.invalid = true; email.invalidText = 'Enter your work email.'; ok = false; }
    if (!ok) return;

    // Domain is the router: non-parks.ca.gov → send them to the public application.
    if (!isParksEmail(e)) {
      if (notice) notice.hidden = false;
      if (applyBtn) applyBtn.hidden = false;
      email.invalid = true;
      email.invalidText = 'Use your @parks.ca.gov email, or start a public application below.';
      notice.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      return;
    }

    // Verified staff email → create a roleless account and enter the pending flow.
    const id = selfRegister({ name: [f, l].join(' '), email: e, phone: p });
    writePendingUserId(id);
    writeIdentity('pending');
    location.href = withBase(ROUTES.pending);
  });
</script>

<style>
  .signup {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: calc(100vh - var(--cds-spacing-09, 3rem));
    padding: var(--cds-spacing-07, 2rem) var(--cds-spacing-05, 1rem);
  }
  .signup__card {
    inline-size: 100%;
    max-inline-size: 28rem;
    padding: var(--cds-spacing-07, 2rem);
  }
  .signup__eyebrow {
    margin: 0;
    text-transform: uppercase;
    color: var(--cds-text-secondary, #525252);
  }
  .signup__title { margin: var(--cds-spacing-02, 0.25rem) 0 var(--cds-spacing-03, 0.5rem); }
  .signup__lede { margin: 0 0 var(--cds-spacing-06, 1.5rem); color: var(--cds-text-secondary, #525252); }
  #domain-notice { margin-bottom: var(--cds-spacing-05, 1rem); }
  #domain-notice[hidden], #su-apply[hidden] { display: none; }
  .signup__form { display: flex; flex-direction: column; gap: var(--cds-spacing-05, 1rem); }
  .signup__names { display: flex; gap: var(--cds-spacing-05, 1rem); flex-wrap: wrap; }
  .signup__names > * { flex: 1 1 9rem; min-width: 0; }
  .signup__note { margin: 0; color: var(--cds-text-secondary, #525252); }
  .signup__submit { margin-top: var(--cds-spacing-02, 0.25rem); }
  .signup__alt { margin: var(--cds-spacing-06, 1.5rem) 0 0; color: var(--cds-text-secondary, #525252); }
</style>
