    word-break: break-word;
  }

  /* Body grid sits below the full-bleed banner. */
  .body { margin-top: var(--cds-spacing-07, 2rem); }

  /* Editorial rhythm within the main column — sections separated by whitespace.
     Capped to a readable form measure so each PermitSection's full-width header
     rule and its content share ONE width (a settings form reads better narrow
     than filling the whole col-11); the rail sits to its right. */
  .main {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    min-width: 0;
    max-width: 44rem;
  }

  .section-hint {
    margin: 0 0 1.25rem;
    max-width: 44rem;
    color: var(--cds-text-secondary, #525252);
  }

  /* Personal-information form — a responsive two-up field grid; the fields
     themselves are stock cds-text-input / cds-dropdown. Content fills the
     section (like permit.astro's col-11 main) so the fields, notification and
     action footer line up with the section header's full-width rule; only prose
     (.section-hint) is measured for readability. */
  #save-notice { margin-bottom: 1.25rem; }
  #save-notice[hidden] { display: none; }
  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .field-grid__wide { grid-column: 1 / -1; }
  /* Subheading that groups the address fields within the form. */
  .form__subhead {
    margin: 0.5rem 0 0;
  }
  @media (max-width: 42rem) {
    .field-grid { grid-template-columns: 1fr; }
  }
  /* Form footer: a top hairline spanning the full form width (matching the
     section header's rule) binds Save/Cancel to the form as its footer. */
  .form__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  .form__actions[hidden] { display: none; }
  /* cds-button sets :host display, overriding the UA [hidden] rule — an explicit
     author rule is needed to hide the Edit action in edit mode (same reason the
     notifications above carry their own [hidden] rules). */
  #profile-edit[hidden] { display: none; }

  /* Notification / appearance preferences — one event per row with a single
     toggle. Rows fill the section (like the form) so the toggle sits at the
     section's right edge; the row dividers bridge label and control. Layout
     only; the control is a stock cds-toggle. */
  .prefs__email { color: var(--cds-text-primary, #161616); }
  .prefs__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
  }
  .prefs__row + .prefs__row {
    border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  /* Text column fills the row; only its prose is measured for readability so the
     description doesn't run the full section width. */
  .prefs__info { min-width: 0; max-width: 44rem; }
  .prefs__label { margin: 0; }
  .prefs__desc {
    margin: 0.125rem 0 0;
    color: var(--cds-text-secondary, #525252);
  }
  /* cds-toggle renders [label-text span][switch][On/Off]; the label-text span is a
     variable-width visible label to the LEFT of the switch, so right-aligning the
     control lands each switch at a different x (ragged column). Carbon's hide-label
     would sr-only that span, but its attribute doesn't reflect to the property in
     2.59.0 — so the profile script applies the sr-only styling in the shadow DOM
     (see alignToggleSwitches). With the span out of flow every toggle is
     switch + On/Off only → equal width → right-aligned to one clean column. */
  .prefs__toggle {
    justify-self: end;
  }

  /* Role & access rail — a read-only cds-tile. Surface/padding are the tile's;
