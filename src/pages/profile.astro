  .access__subhead {
    margin: 0 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  .district-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .district {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .district__name { min-width: 0; }
  /* Researcher account panel — organization line under the subhead. */
  .researcher-org {
    margin: 0 0 1.5rem;
    color: var(--cds-text-primary, #161616);
  }
  .access__note {
    margin: 0 0 1rem;
    color: var(--cds-text-secondary, #525252);
  }
  /* Pending role-request banner, shown after submission. */
  #role-pending { margin: 0 0 1.25rem; }
  #role-pending[hidden] { display: none; }

  /* Role-request modal — layout only; the fields are stock cds-* components. */
  .modal-hint { margin: 0 0 1.25rem; }
  .modal-desc {
    margin: 0.75rem 0 0;
