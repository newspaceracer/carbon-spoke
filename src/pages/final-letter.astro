       descendants. */
    /* cds-inline-notification sets :host display, so a `hidden` property alone won't
       collapse the locked note — restate [hidden] here (Carbon host-display gotcha). */
    #contacts-locked-note[hidden] { display: none; }
    .contacts-input { display: flex; flex-direction: column; gap: var(--cds-spacing-06, 1.5rem); }
    .contacts-input :global(.contact-district) { display: flex; flex-direction: column; gap: var(--cds-spacing-04, 0.75rem); }
    /* Header bar: "<district> contacts" title with Add contact inline on the right. */
    .contacts-input :global(.contact-district__bar) { display: flex; align-items: center; justify-content: space-between; gap: var(--cds-spacing-04, 0.75rem); min-height: 2rem; }
    .contacts-input :global(.contact-district__name) { margin: 0; }
    .contacts-input :global(.contact-district__note) { margin: 0; color: var(--cds-text-secondary, #525252); font-style: italic; }
    /* Pending change requests — a small list under a district (lead: accept/decline;
       requester: withdraw). */
    .contacts-input :global(.contact-requests) { border-top: 1px solid var(--cds-border-subtle, #e0e0e0); padding-top: var(--cds-spacing-04, 0.75rem); display: flex; flex-direction: column; gap: var(--cds-spacing-03, 0.5rem); }
    .contacts-input :global(.contact-requests__title) { margin: 0; color: var(--cds-text-secondary, #525252); }
    .contacts-input :global(.contact-requests__list) { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--cds-spacing-03, 0.5rem); }
    .contacts-input :global(.creq) { display: flex; align-items: center; gap: var(--cds-spacing-04, 0.75rem); flex-wrap: wrap; }
    .contacts-input :global(.creq__text) { flex: 1 1 12rem; }
    .contacts-input :global(.creq__acts) { display: flex; gap: var(--cds-spacing-02, 0.25rem); margin-inline-start: auto; }
    /* A removed (excluded) special contact — dimmed, with a Re-add action. */
    .contacts-input :global(.crow--muted) { opacity: 0.6; }
    /* A contact row inside the contained list: avatar, name + badge, meta, action. */
    .contacts-input :global(.crow) { display: flex; align-items: center; gap: var(--cds-spacing-04, 0.75rem); width: 100%; }
