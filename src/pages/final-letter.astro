    .contacts-input :global(.crow__meta) { margin: 0.125rem 0 0; color: var(--cds-text-secondary, #525252); overflow-wrap: anywhere; }
    /* The park(s) a contact covers — the only classifier now (no role badges). */
    .contacts-input :global(.crow__scope) { margin: 0.125rem 0 0; color: var(--cds-text-secondary, #525252); font-style: italic; overflow-wrap: anywhere; }
    /* Scope fieldset (radio + park checkboxes) — used inline in the SA modal AND inside
