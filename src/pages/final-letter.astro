    :global(.scope-parks) { display: flex; flex-direction: column; gap: var(--cds-spacing-02, 0.25rem); padding-inline-start: var(--cds-spacing-05, 1rem); }
    :global(.scope-parks[hidden]) { display: none; }
    /* SA inline entry editor (reassign dropdown + scope fieldset) under a contact row. */
    .contacts-input :global(.crow-edit) { width: 100%; margin-top: var(--cds-spacing-03, 0.5rem); display: flex; flex-direction: column; gap: var(--cds-spacing-04, 0.75rem); }
    .contacts-input :global(.crow-add) { display: flex; flex-direction: column; gap: var(--cds-spacing-04, 0.75rem); border-top: 1px solid var(--cds-border-subtle, #e0e0e0); padding-top: var(--cds-spacing-04, 0.75rem); }
    .contacts-input :global(.crow-add__title) { margin: 0; color: var(--cds-text-secondary, #525252); }
    #contact-scope-host { margin-top: var(--cds-spacing-05, 1rem); }
    #contact-scope-host[hidden] { display: none; }
    .contact-person-static { margin: 0 0 var(--cds-spacing-04, 0.75rem); }
    .contact-person-static[hidden] { display: none; }
    .contacts-input :global(.crow__end) { flex: none; margin-inline-start: auto; display: flex; align-items: center; gap: var(--cds-spacing-02, 0.25rem); }

    /* Confirm-on-complete — the supporting analyst's contact sign-off. The list is
       injected into #confirm-contacts-body, so :global() its descendants. */
    .confirm-contacts__lead { margin: 0 0 var(--cds-spacing-05, 1rem); color: var(--cds-text-secondary, #525252); }
    .confirm-contacts { display: flex; flex-direction: column; gap: var(--cds-spacing-05, 1rem); }
    .confirm-contacts :global(.confirm-contacts__district) { display: flex; flex-direction: column; gap: 0.125rem; }
    .confirm-contacts :global(.confirm-contacts__name) { margin: 0; }
    .confirm-contacts :global(.confirm-contacts__parks) { margin: 0; color: var(--cds-text-secondary, #525252); }
    .confirm-contacts :global(.confirm-contacts__list) { margin: var(--cds-spacing-03, 0.5rem) 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
    .confirm-contacts :global(.confirm-contacts__meta) { color: var(--cds-text-secondary, #525252); }

    .subgroup { display: grid; gap: var(--cds-spacing-03, 0.5rem); margin-bottom: var(--cds-spacing-05, 1rem); }
    .subgroup__head { display: flex; align-items: center; gap: var(--cds-spacing-03, 0.5rem); }
    .subgroup__name { margin: 0; }
    /* Step ② authorized parks reuses step ①'s Study-areas mechanic: a filterable
       multi-select over a selected-parks roster (one flat list). Layout only — the
       controls are stock cds-*. */
    .selected { margin-top: var(--cds-spacing-03, 0.5rem); }
    .selected__label { margin: 0 0 var(--cds-spacing-03, 0.5rem); color: var(--cds-text-secondary, #525252); }
    .col-fields .ro-table { display: block; }

    /* Package step (③) — recap of what's issued, then the letter. */
    .pkg-recap { margin-top: var(--cds-spacing-06, 1.5rem); }
    .pkg-recap__title { margin: 0 0 var(--cds-spacing-05, 1rem); }
    .pkg-letter { margin-top: var(--cds-spacing-08, 2.5rem); }
    /* "What you're issuing" — grouped recap. The markup is injected via innerHTML
       (see renderRecap), so it never gets Astro's scoped data-attribute — these
       selectors MUST be :global() or they won't match. Surfaces come from
       cds-tile; only layout tracks and the muted/emphasis type colors live here. */
    :global(.issue) { display: grid; gap: var(--cds-spacing-06, 1.5rem); }

    /* Identity — permit kind + category, above a rule. */
    :global(.issue__ident) {
      padding-bottom: var(--cds-spacing-05, 1rem);
      border-bottom: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    }
    :global(.issue__type) { margin: 0; color: var(--cds-text-primary, #161616); }
    :global(.issue__cat) {
      margin: var(--cds-spacing-02, 0.25rem) 0 0; text-transform: uppercase;
      color: var(--cds-text-secondary, #525252);
    }

    /* Dates card — the anchor of the recap. The valid window leads at the largest
       size (the permit's most important fact); the report-due date sits beside it,
       clearly prominent, sharing the tile's bottom edge. */
    :global(.issue__dates) {
      display: grid; grid-template-columns: 2fr 1fr; align-items: end;
      gap: var(--cds-spacing-04, 0.75rem) var(--cds-spacing-07, 2rem);
    }
    :global(.issue__date-label) {
      margin: 0; text-transform: uppercase; color: var(--cds-text-secondary, #525252);
    }
    :global(.issue__date-val) {
      margin: var(--cds-spacing-02, 0.25rem) 0 0; color: var(--cds-text-primary, #161616);
      line-height: 1.15;
    }

    /* Authorization counts — scannable metric tiles (big number leads). */
    :global(.issue__metrics) {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: var(--cds-spacing-05, 1rem);
    }
    :global(.metric) { display: flex; flex-direction: column; }
    :global(.metric__value) { margin: 0; color: var(--cds-text-primary, #161616); line-height: 1.1; }
    :global(.metric__label) { margin: var(--cds-spacing-03, 0.5rem) 0 0; color: var(--cds-text-primary, #161616); }
    :global(.metric__sub) { margin: var(--cds-spacing-01, 0.125rem) 0 0; color: var(--cds-text-secondary, #525252); }

    @media (max-width: 42rem) {
      :global(.issue__dates) { grid-template-columns: 1fr; align-items: start; }
    }

    .wiz-actions { margin-top: var(--cds-spacing-08, 2.5rem); }
    .wiz-actions__inner { display: flex; align-items: center; gap: var(--cds-spacing-03, 0.5rem); padding-top: var(--cds-spacing-05, 1rem); border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0); }
    .wiz-actions__spacer { flex: 1 1 auto; }
    #wiz-back[hidden] { display: none; }

    /* Comments tab — composer (top) then the thread (newest first). */
    .comments-note { margin: 0 0 var(--cds-spacing-05, 1rem); color: var(--cds-text-secondary, #525252); }
    /* Composer: full-width field, the Add-comment button aligned bottom-right. */
    .dock-composer { display: grid; gap: var(--cds-spacing-04, 0.75rem); justify-items: end; margin-block-end: var(--cds-spacing-06, 1.5rem); }
    .mention-field { position: relative; inline-size: 100%; }
    .dock-composer cds-textarea { display: block; inline-size: 100%; }
    /* @-mention picker — a token-styled suggestion menu anchored under the composer.
       carbon-checked: Carbon ships no @-mention typeahead; this composes over the
       stock cds-textarea, styled entirely with --cds-* tokens. */
    .mention-menu { position: absolute; inset-inline: 0; top: calc(100% + 0.25rem); z-index: 100; margin: 0; padding: 0; list-style: none; max-block-size: 14rem; overflow-y: auto; background: var(--cds-layer-02, #fff); border: 1px solid var(--cds-border-subtle-01, #e0e0e0); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2); }
    .mention-menu[hidden] { display: none; }
    /* Menu items + posted mention tokens are BUILT IN JS (no Astro scope attribute),
       so their rules must be :global to match. */
    :global(.mention-menu__item) { display: flex; flex-direction: column; gap: 0.0625rem; cursor: pointer; padding: var(--cds-spacing-03, 0.5rem) var(--cds-spacing-05, 1rem); border-block-end: 1px solid var(--cds-border-subtle-01, #e0e0e0); }
    :global(.mention-menu__item:last-child) { border-block-end: none; }
    :global(.mention-menu__item.is-active), :global(.mention-menu__item:hover) { background: var(--cds-layer-hover-02, #e8e8e8); }
    :global(.mention-menu__name) { color: var(--cds-text-primary, #161616); font-size: 0.875rem; }
    :global(.mention-menu__detail) { color: var(--cds-text-secondary, #525252); font-size: 0.75rem; }
    :global(.mention) { color: var(--cds-link-primary, #0f62fe); font-weight: 600; }

    .dock-thread { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--cds-spacing-05, 1rem); align-content: start; }
    .comment { min-width: 0; }
    .comment__meta { margin: 0 0 var(--cds-spacing-02, 0.25rem); color: var(--cds-text-secondary, #525252); }
    .comment__author { font-weight: 600; color: var(--cds-text-primary, #161616); }
    .comment__text { margin: 0; }

    /* ── Live letter preview ── a white document surface, sticky beside the fields. */
    .preview__head { display: flex; align-items: center; justify-content: space-between; gap: var(--cds-spacing-03, 0.5rem); }
    .preview__label { margin: 0 0 var(--cds-spacing-03, 0.5rem); color: var(--cds-text-secondary, #525252); }
    .preview__head .preview__label { margin-bottom: 0; }
    .preview__hint { margin: 0 0 var(--cds-spacing-03, 0.5rem); color: var(--cds-text-secondary, #525252); }
    @media (min-width: 66.01rem) { .preview { position: sticky; top: 4rem; align-self: start; } }
    .sheet {
      background: var(--cds-background, #ffffff);
      border: 1px solid var(--cds-border-subtle-01, #e0e0e0);
      padding: var(--cds-spacing-07, 2rem);
      color: var(--cds-text-primary, #161616);
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
    /* On the package step the letter reads through in full — no inner scroll. */
    .pkg-letter .sheet { max-height: none; overflow-y: visible; }
    @media (max-width: 66rem) { .sheet { max-height: none; } }

    .sheet :global(.ltr__letterhead) { border-bottom: 2px solid var(--cds-border-strong-01, #8d8d8d); padding-bottom: var(--cds-spacing-04, 0.75rem); margin-bottom: var(--cds-spacing-06, 1.5rem); }
    .sheet :global(.ltr__letterhead p) { margin: 0; }
    .sheet :global(.ltr__dept) { margin: 0.125rem 0; }
    .sheet :global(.ltr__date) { margin: 0 0 var(--cds-spacing-05, 1rem); }
    .sheet :global(.ltr__to) { font-style: normal; line-height: 1.5; margin: 0 0 var(--cds-spacing-05, 1rem); }
    .sheet :global(.ltr__body) { line-height: 1.6; margin: 0 0 var(--cds-spacing-05, 1rem); }
    /* Editable body paragraphs (step ②): a quiet click-to-edit affordance, a focus
       field, and a left accent once a paragraph carries a reviewer override. Only
       the editable host gets it; the step-③ read-through paragraphs stay plain. */
    .letter-host--editable :global(.ltr__body--copy) { cursor: text; border-radius: 2px; padding: var(--cds-spacing-02, 0.25rem) var(--cds-spacing-03, 0.5rem); margin-left: calc(-1 * var(--cds-spacing-03, 0.5rem)); margin-right: calc(-1 * var(--cds-spacing-03, 0.5rem)); transition: background-color 70ms ease; }
    .letter-host--editable :global(.ltr__body--copy:hover) { background: var(--cds-field-02, #f4f4f4); }
    .letter-host--editable :global(.ltr__body--copy:focus) { outline: 2px solid var(--cds-focus, #0f62fe); outline-offset: -2px; background: var(--cds-field-02, #f4f4f4); }
    .letter-host--editable :global(.ltr__body--copy.is-edited) { box-shadow: inset 3px 0 0 var(--cds-border-interactive, #0f62fe); }
    .sheet :global(.ltr__signer) { line-height: 1.5; margin: 0 0 var(--cds-spacing-05, 1rem); }
    .sheet :global(.ltr__sig-line) { height: 2rem; width: 16rem; max-width: 100%; border-bottom: 1px solid var(--cds-border-strong-01, #8d8d8d); margin-bottom: var(--cds-spacing-03, 0.5rem); }
    .sheet :global(.ltr__pagebreak) { border: 0; border-top: 1px dashed var(--cds-border-subtle-01, #c6c6c6); margin: var(--cds-spacing-07, 2rem) 0; }
    .sheet :global(.ltr__h) { margin: 0 0 var(--cds-spacing-04, 0.75rem); }
    .sheet :global(.ltr__conditions) { margin: 0 0 var(--cds-spacing-05, 1rem); padding-left: var(--cds-spacing-06, 1.5rem); display: grid; gap: var(--cds-spacing-03, 0.5rem); }
    .sheet :global(.ltr__conditions p) { margin: 0; }
    .sheet :global(.ltr__cond-owner) { margin: var(--cds-spacing-04, 0.75rem) 0 var(--cds-spacing-02, 0.25rem); color: var(--cds-text-secondary, #525252); font-weight: 600; }
    .sheet :global(.ltr__contact) { margin-bottom: var(--cds-spacing-05, 1rem); }
    .sheet :global(.ltr__contact-head) { margin-bottom: var(--cds-spacing-02, 0.25rem); }
    .sheet :global(.ltr__district-name) { margin: 0; }
    .sheet :global(.ltr__coord) { margin: 0.125rem 0 0; color: var(--cds-text-secondary, #525252); }
    .sheet :global(.ltr__coord-tag) { font-style: italic; }
    .sheet :global(.ltr__parks) { margin: var(--cds-spacing-02, 0.25rem) 0 0; padding-left: var(--cds-spacing-06, 1.5rem); }
    /* Park-first contact list: each park unit heads its own set of contacts. */
    .sheet :global(.ltr__park) { margin: var(--cds-spacing-03, 0.5rem) 0 0; padding-left: var(--cds-spacing-05, 1rem); }
    .sheet :global(.ltr__park-name) { margin: 0; font-weight: 600; }
    .sheet :global(.ltr__specimens) { width: 100%; border-collapse: collapse; margin: var(--cds-spacing-03, 0.5rem) 0 var(--cds-spacing-05, 1rem); }
    .sheet :global(.ltr__specimens th), .sheet :global(.ltr__specimens td) { text-align: left; vertical-align: top; padding: var(--cds-spacing-02, 0.25rem) var(--cds-spacing-04, 0.75rem) var(--cds-spacing-02, 0.25rem) 0; border-bottom: 1px solid var(--cds-border-subtle-01, #e0e0e0); }
    .sheet :global(.ltr__specimens th) { font-weight: 600; border-bottom-color: var(--cds-border-strong-01, #8d8d8d); }
    .sheet :global(.ltr__specimens td:first-child) { font-style: italic; }

    /* Add/edit-specimen modal — the 2-col field grid, mirroring the application
       form's specimen dialog (Species/Condition span both columns). */
    .spec-fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--cds-spacing-05, 1rem); }
    .spec-fields__wide { grid-column: 1 / -1; }
  </style>
</BaseLayout>
