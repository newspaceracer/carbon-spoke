---
/* Permit review — layout studies (design exploration, NOT a shipping screen).

   These are alternative arrangements of the SAME review wizard the app already
   ships (final-letter.astro), so they reuse its chrome verbatim: PermitNav + the
   PermitHeader identity banner, the cds-progress-indicator step track, the
   page-head, the col-main / col-rail step grid, the raised .rail working panel,
   the wiz-actions footer, and the fixed comments FAB + slide-over drawer. Only the
   ARRANGEMENT differs between versions — a cds-tabs strip switches them.

   The reviewer's three jobs frame every version: COMPARE the application against
   the study proposal (a PDF), CONDITION (curate the special conditions), and TALK
   (the reviewer comment thread). Version D is the existing wizard, extended with a
   "Review application" and an "Add conditions" step in front of Finalize / Send.

   carbon-checked: every control is a stock cds-* component; the page CSS is copied
   from final-letter.astro's wizard chrome (page-head / wiz-track / step / rail /
   wiz-actions / comments FAB + drawer) — layout/positioning only, no reinvented
   primitive. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PermitNav from '../components/PermitNav.astro';
import PermitHeader from '../components/PermitHeader.astro';
import ReviewAppSummary from '../components/ReviewAppSummary.astro';
import ApplicationReview from '../components/ApplicationReview.astro';
import DocumentViewer from '../components/DocumentViewer.astro';
import ReviewConditions from '../components/ReviewConditions.astro';
import { permit } from '../data/permit';
import { userDirectory } from '../data/user';
import { withBase } from '../lib/base';
import { districtKey, seedInventory, plainText } from '../data/conditions';

export const prototype = {
  title: 'Review wizard — layout studies',
  summary:
    'Four arrangements of the existing review wizard (same chrome), organized around ' +
    "the reviewer's three jobs: compare against the study proposal, set special " +
    'conditions, and talk to other reviewers.',
  tag: 'Design study',
};

// ── PermitHeader props — mirror final-letter.astro so the studies carry the exact
// same identity banner as the real wizard. ──────────────────────────────────────
const responsibleAnalyst = permit.overview.analysisTeam.find((m) => m.highlight);
const involvementTags = [
  ...(permit.dataCollection.involvesCollection ? [{ label: 'Specimen collection', type: 'blue' }] : []),
  ...(permit.dataCollection.involvesLaboratory ? [{ label: 'Laboratory work', type: 'blue' }] : []),
];
const headerInfoTags = [...permit.infoTags, ...involvementTags];
const headerStats = [
  { label: 'Requested window', value: `${permit.activeWindow.start} – ${permit.activeWindow.end}` },
  { label: 'Submitted', value: 'Jul 9, 2026' },
  { label: 'Responsible analyst', value: responsibleAnalyst?.name ?? '—' },
];

// ── Shared mock content ─────────────────────────────────────────────────────────
// The study proposal, rendered by the PDF viewer as the document it is.
const proposal = [
  { id: 'objectives', title: 'Objectives & hypotheses', excerpt: 'Characterize coralline algal diversity across northern California rocky intertidal and test whether reproductive phenology tracks a latitudinal gradient.' },
  { id: 'methods', title: 'Study procedures & methods', excerpt: 'Timed subtidal and intertidal surveys at paired high- and low-impact sites; voucher fronds collected by hand and pressed for herbarium accession.' },
  { id: 'rationale', title: 'Collection rationale', excerpt: 'Destructive sampling is held to the minimum needed for morphological and reproductive determination. The 50-frond Corallina vancouveriensis allotment supports the reproductive case study.' },
  { id: 'data', title: 'Data & data products', excerpt: 'Occurrence records deposited to GBIF; vouchers accessioned at the Cal Poly Humboldt herbarium; DNA barcodes submitted to GenBank.' },
  { id: 'budget', title: 'Budget & literature', excerpt: 'Fully covered by an NSF systematics award; no state funds requested. 38 references cited.' },
];
const proposalDoc = {
  href: '/docs/coralline-diversity-proposal.pdf',
  filename: 'Coralline Diversity & Reproductive Systems Proposal.pdf',
  size: '313 KB',
  pages: 4,
  docTitle: permit.name,
};

// Every document uploaded to the permit — the document viewer's picker. The study
// proposal (first in the list) is the default shown.
const documents = permit.additionalDocs.files.map((f) => ({
  href: f.href,
  filename: f.name,
  size: f.size,
  pages: f.pages,
  type: f.type,
}));

// ── Special conditions — the REAL catalog, same source as the detail page ────────
// Pulled from src/data/conditions.ts (the single source of truth the permit's
// Special conditions tab reads), not a flat mock. Each owner block (HQ + every
// district on this permit) shows the conditions APPLIED to the permit — i.e. every
// DEFAULT catalog item for that owner (the "auto-attach on submission" set) — so
// the studies present the true HQ + district structure.
const scPermitDistricts = permit.studyAreas.districts.map((d) => ({
  key: districtKey(d.name),
  label: d.name,
  parks: d.parks.length,
}));
const scOwners = [
  { key: 'hq', label: 'Headquarters', parks: null as number | null },
  ...scPermitDistricts,
];
// Applied conditions per owner: the default items of that owner's catalog.
const conditionGroups = scOwners.map((o) => ({
  ...o,
  items: seedInventory(o.key)
    .filter((i) => i.isDefault)
    .map((i) => ({ id: i.id, body: i.body, source: 'default' as const })),
}));
const scTotal = conditionGroups.reduce((n, g) => n + g.items.length, 0);
// Per-owner catalog of NON-default items (what a reviewer can still pull in via the
// Add-condition modal), each with a plain-text preview for the picker. Emitted as
// JSON for the client so the picker repopulates when the scope changes.
const scInventory: Record<string, { id: string; preview: string; body: string }[]> =
  Object.fromEntries(
    scOwners.map((o) => [
      o.key,
      seedInventory(o.key)
        .filter((i) => !i.isDefault)
        .map((i) => ({ id: i.id, preview: plainText(i.body).slice(0, 120), body: i.body })),
    ]),
  );

// The application fields, section by section, for the section-anchored version —
// each paired with the proposal section a reviewer checks it against.
const sections = [
  { field: 'Project title', value: permit.name, compareId: 'objectives', comments: 2 },
  { field: 'Category', value: permit.category, compareId: 'methods', comments: 0 },
  { field: 'Requested window', value: `${permit.activeWindow.start} – ${permit.activeWindow.end}`, compareId: 'objectives', comments: 1 },
  { field: 'Study areas', value: '4 parks across North Coast Redwoods & Mendocino districts', compareId: 'methods', comments: 3 },
  { field: 'Authorized collection', value: '19 coralline taxa · Corallina vancouveriensis ×50 fronds', compareId: 'rationale', comments: 1 },
];

// Reviewer comment thread — the same conversation shown on the permit detail.
const comments = permit.overview.comments;
const initials = (name: string) => name.replace(/[^A-Za-z. ]/g, '').split(/[.\s]+/).filter(Boolean).map((p) => p[0]).slice(0, 2).join('').toUpperCase();

// Analysis team for the B2 docked panel — the roster, plus the directory users who
// aren't on it yet (the "Add member" modal's picker). Review status shows as an
// icon-indicator (status is meaning, not colour alone).
const team = permit.overview.analysisTeam;
const teamIds = new Set(team.map((m) => m.id));
const eligibleMembers = userDirectory.filter((u) => !teamIds.has(u.id));
const TEAM_STATE: Record<string, { kind: string; label: string }> = {
  'not-started': { kind: 'not-started', label: 'Not started' },
  'pending': { kind: 'in-progress', label: 'Pending' },
  'complete': { kind: 'succeeded', label: 'Complete' },
};

// The layout concepts (tab strip). `bestOf` looks the copy up by id so the panels
// don't depend on array position.
const versions = [
  { id: 'stepped', label: 'D · Stepped pipeline', best: 'A guided four-step pipeline — the existing wizard, with a Review-application and an Add-conditions step in front of Finalize and Send.' },
  { id: 'compare', label: 'A · Compare-first', best: 'The proposal and the record side by side is the whole job; conditions and comments are summoned from the toolbar when needed.' },
  { id: 'workspace', label: 'B · Three-column', best: 'Proposal, record, and a working rail all visible at once — nothing hidden, for reviewers who bounce between the three jobs.' },
  { id: 'stacked', label: 'B2 · Full-width panel', best: 'Like the three-column workspace, but the conditions and comments panel docks full-width beneath the two documents — the proposal and record get the full width up top, and the working panel gets room to breathe below.' },
  { id: 'docktabs', label: 'B3 · Docked documents', best: 'The record keeps the left column; everything else — the document viewer, conditions, comments, and the analysis team — becomes a tab in one working panel on the right, so the whole right side is a single tabbed surface the reviewer flips through in place.' },
  { id: 'sections', label: 'C · Section-anchored', best: 'Comparison and discussion attach to the specific finding — each application field carries its own proposal compare and comment count.' },
  { id: 'vtabs', label: 'E · Vertical tabs', best: 'The application record fills one half; the other half is a vertical tab set — Document viewer, Special conditions, and Comments — so the record stays in view while the reviewer flips the second panel between the three jobs.' },
];
const bestOf = (id: string) => versions.find((v) => v.id === id)?.best ?? '';

const trash =
  '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>';
const cancelHref = withBase('/final-letter');
---

<BaseLayout title="Review wizard — layout studies">
  <PermitNav slot="nav" />

  <main class="page">
    <PermitHeader
      id={permit.id}
      name={permit.name}
      organization={permit.researchTeam.organization.name}
      status={permit.status}
      infoTags={headerInfoTags}
      flagTags={permit.flagTags}
      stats={headerStats}
      requestedWindow={permit.activeWindow}
      analysisTeam={permit.overview.analysisTeam}
      directory={userDirectory}
      context="finalize"
    >
      <cds-breadcrumb slot="breadcrumb" no-trailing-slash>
        <cds-breadcrumb-item><cds-breadcrumb-link href={withBase('/permits')}>Permits</cds-breadcrumb-link></cds-breadcrumb-item>
        <cds-breadcrumb-item><cds-breadcrumb-link href={withBase('/permit')}>{permit.id}</cds-breadcrumb-link></cds-breadcrumb-item>
        <cds-breadcrumb-item><cds-breadcrumb-link aria-current="page">Layout studies</cds-breadcrumb-link></cds-breadcrumb-item>
      </cds-breadcrumb>
    </PermitHeader>

    <!-- Design-study intro + the version switcher. -->
    <section class="intro cds--css-grid">
      <div class="intro__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
        <p class="intro__eyebrow t-label-01">Design study · not a shipping screen</p>
        <h2 class="intro__title t-heading-04">Review wizard — layout options</h2>
        <p class="intro__lede t-body-02">
          Four arrangements of this same review wizard, framed by the reviewer's three jobs —
          <strong>compare</strong> the application against the study proposal, <strong>set the special conditions</strong>,
          and <strong>talk</strong> to the other reviewers. Same chrome; different arrangement. Pick one to preview.
        </p>
        <cds-tabs id="version-tabs" value="stepped">
          {versions.map((v) => <cds-tab id={`vt-${v.id}`} value={v.id}>{v.label}</cds-tab>)}
        </cds-tabs>
      </div>
    </section>

    <!-- ═══════════════ D · Stepped pipeline (the existing wizard, extended) ══ -->
    <div class="version" data-version="stepped">
      <nav class="wiz-track cds--css-grid" aria-label="Review steps">
        <div class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <cds-progress-indicator space-equally>
            <cds-progress-step state="current" label="Review application" secondary-label="Against the study proposal"></cds-progress-step>
            <cds-progress-step label="Add conditions" secondary-label="With the application in context"></cds-progress-step>
            <cds-progress-step label="Finalize letter" secondary-label="Confirm what prints"></cds-progress-step>
            <cds-progress-step label="Review & send" secondary-label="The full package"></cds-progress-step>
          </cds-progress-indicator>
        </div>
      </nav>

      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <p class="page-head__eyebrow t-label-01">Step 1 of 4</p>
          <h2 class="page-head__title t-heading-04">Review application</h2>
          <p class="page-head__sub t-body-02">Read the application against the study proposal, then continue to set the conditions.</p>
        </header>
      </div>

      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <ReviewAppSummary />
        </div>
        <aside class="col-rail cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8" aria-label="Document viewer">
          <div class="side-sticky">
            <p class="preview__label t-label-01">Document viewer — read against the record</p>
            <DocumentViewer documents={documents} docTitle={permit.name} />
          </div>
        </aside>
      </section>

      <footer class="wiz-actions cds--css-grid">
        <div class="wiz-actions__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-10">
          <cds-button kind="secondary" size="lg" disabled>Back</cds-button>
          <cds-button kind="ghost" size="lg" href={cancelHref}>Cancel</cds-button>
          <div class="wiz-actions__spacer"></div>
          <cds-button kind="primary" size="lg">Save and continue</cds-button>
        </div>
      </footer>

      <div class="handoff cds--css-grid">
        <p class="handoff__note cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16 t-label-01">
          Next: <strong>Add conditions</strong> (the record stays in context) → <strong>Finalize letter</strong> → <strong>Review &amp; send</strong> — the last two are the existing wizard at <cds-link href={cancelHref}>final-letter</cds-link>.
        </p>
      </div>
    </div>

    <!-- ═══════════════ A · Compare-first ═══════════════════════════════════ -->
    <div class="version" data-version="compare" hidden>
      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <p class="page-head__eyebrow t-label-01">Layout A</p>
          <h2 class="page-head__title t-heading-04">Compare-first</h2>
          <p class="page-head__sub t-body-02">{bestOf('compare')}</p>
        </header>
      </div>

      <div class="toolbar cds--css-grid">
        <div class="toolbar__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <cds-search size="md" placeholder="Jump to a section of the proposal…" label-text="Jump to a section"></cds-search>
          <div class="toolbar__actions">
            <cds-button kind="tertiary" size="md">Special conditions · {scTotal}</cds-button>
            <cds-button class="js-open-comments" kind="tertiary" size="md">Comments · {comments.length}</cds-button>
          </div>
        </div>
      </div>

      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <p class="preview__label t-label-01">Document viewer</p>
          <DocumentViewer documents={documents} docTitle={permit.name} />
        </div>
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <p class="preview__label t-label-01">Application record</p>
          <ReviewAppSummary />
        </div>
      </section>
    </div>

    <!-- ═══════════════ B · Three-column workspace ══════════════════════════ -->
    <div class="version" data-version="workspace" hidden>
      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <p class="page-head__eyebrow t-label-01">Layout B</p>
          <h2 class="page-head__title t-heading-04">Three-column workspace</h2>
          <p class="page-head__sub t-body-02">{bestOf('workspace')}</p>
        </header>
      </div>

      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-5">
          <p class="preview__label t-label-01">Document viewer</p>
          <DocumentViewer documents={documents} docTitle={permit.name} compact />
        </div>
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-6">
          <p class="preview__label t-label-01">Application record</p>
          <ReviewAppSummary compact />
        </div>
        <aside class="col-rail cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-5" aria-label="Working panel">
          <div class="rail" data-tab-scope>
            <cds-tabs value="conditions" data-panels>
              <cds-tab value="conditions">Conditions · {scTotal}</cds-tab>
              <cds-tab value="comments">Comments · {comments.length}</cds-tab>
            </cds-tabs>

            <div class="rail-panel" data-tabpanel="conditions">
              <ReviewConditions groups={conditionGroups} compact removable={false} />
            </div>

            <div class="rail-panel" data-tabpanel="comments" hidden>
              <ul class="rail-thread">
                {comments.map((c) => (
                  <li class="comment">
                    <span class="comment__avatar" aria-hidden="true">{initials(c.author)}</span>
                    <div class="comment__body">
                      <p class="comment__meta t-label-01"><span class="comment__author">{c.author}</span> · {c.time}</p>
                      <p class="comment__text t-body-01">{c.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
              <cds-textarea label="Add a comment" placeholder="Note something for the team…" rows="3"></cds-textarea>
              <div class="rail__send"><cds-button kind="primary" size="md">Add comment</cds-button></div>
            </div>
          </div>
        </aside>
      </section>
    </div>

    <!-- ═══════════════ B2 · Two-pane + full-width working panel ═════════════ -->
    <div class="version" data-version="stacked" hidden>
      <!-- Same step track as the stepped pipeline — sticky to the top of the page so
           the reviewer keeps their place in the flow while scrolling the record. -->
      <nav class="wiz-track cds--css-grid" aria-label="Review steps">
        <div class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <cds-progress-indicator space-equally>
            <cds-progress-step state="current" label="Review application" secondary-label="Against the study proposal"></cds-progress-step>
            <cds-progress-step label="Add conditions" secondary-label="With the application in context"></cds-progress-step>
            <cds-progress-step label="Finalize letter" secondary-label="Confirm what prints"></cds-progress-step>
            <cds-progress-step label="Review & send" secondary-label="The full package"></cds-progress-step>
          </cds-progress-indicator>
        </div>
      </nav>

      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <h2 class="page-head__title t-heading-04">Review application</h2>
        </header>
      </div>

      <!-- Top: the two documents, side by side, full width. Both stand the SAME
           height — the PDF frame at 80vh and the record filling its column to match,
           scrolling within — so they read as an even pair. -->
      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <h3 class="pane-title t-heading-04">Application record</h3>
          <!-- The REAL, editable step-① application review (same component the finalize
               wizard uses), not the read-only summary — so this study exercises the
               actual edit affordances. Behavior (field seeding, study-areas roster,
               specimen modal) is wired by page-local script below. The record grows the
               page as its sections expand (no inner scroll box).
               SHARED with B3: the record is a single instance (hardcoded ids) that the
               version switcher relocates into whichever of B2/B3 is active. This slot is
               its home; B3 has the matching empty slot. -->
          <div data-appreview-slot data-slot-for="stacked">
            <div class="appreview" data-appreview>
              <ApplicationReview collapsible />
            </div>
          </div>

          <!-- Working panel — conditions / comments / analysis team, stacked directly
               under the record in the SAME (left) column. -->
          <div class="dock" data-tab-scope>
            <cds-tabs value="conditions" data-panels>
              <cds-tab value="conditions">Conditions · {scTotal}</cds-tab>
              <cds-tab value="comments">Comments · {comments.length}</cds-tab>
              <cds-tab value="team">Analysis team · {team.length}</cds-tab>
            </cds-tabs>

            <!-- Special conditions — the REAL HQ + district structure from the
                 catalog (ReviewConditions), same source as the permit detail page.
                 "Add condition" opens the app's dual-path (catalog / manual) modal,
                 scoped to the chosen owner. -->
            <div class="rail-panel" data-tabpanel="conditions">
              <div class="dock-list">
                <div class="rail__tools"><cds-button class="js-open-add-cond" kind="tertiary" size="md">Add condition</cds-button></div>
                <ReviewConditions groups={conditionGroups} />
              </div>
            </div>

            <!-- Composer first (add before you scroll the thread), then the thread —
                 both capped to the same readable width. -->
            <div class="rail-panel" data-tabpanel="comments" hidden>
              <div class="dock-composer">
                <!-- Typing "@" opens a picker of existing users; choosing one inserts
                     the mention. On post, mentioned users get a (simulated) email. The
                     suggestion menu is a token-styled list — carbon-checked: Carbon
                     ships no @-mention typeahead; it composes over the stock textarea. -->
                <div class="mention-field">
                  <cds-textarea data-comment-input label="Add a comment" placeholder="Note something for the team… type @ to mention someone" rows="2"></cds-textarea>
                  <ul class="mention-menu" data-mention-menu role="listbox" aria-label="Mention a user" hidden></ul>
                </div>
                <cds-button class="js-post-comment" kind="primary" size="md">Add comment</cds-button>
              </div>
              <ul class="dock-thread" data-thread>
                {comments.map((c) => (
                  <li class="comment">
                    <span class="comment__avatar" aria-hidden="true">{initials(c.author)}</span>
                    <div class="comment__body">
                      <p class="comment__meta t-label-01"><span class="comment__author">{c.author}</span> · {c.time}</p>
                      <p class="comment__text t-body-01">{c.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Analysis team — the SAME roster pattern used elsewhere (a
                 cds-contained-list of members: name, role · unit, review status,
                 remove). "Add member" opens a base-page modal (button-first pattern):
                 pick a directory user, confirm, and the row lands here. The lead
                 can't be removed. Capped to a readable width in the wide dock. -->
            <div class="rail-panel" data-tabpanel="team" hidden>
              <div class="dock-list">
                <div class="rail__tools">
                  <cds-button class="js-email-team" kind="ghost" size="md">Email all</cds-button>
                  <cds-button class="js-open-add-member" kind="tertiary" size="md">Add member</cds-button>
                </div>
                <cds-contained-list data-team-list label="Assigned to this permit" kind="on-page">
                  {team.map((m) => (
                    <cds-contained-list-item data-user-id={m.id} data-email={userDirectory.find((u) => u.id === m.id)?.email ?? ''}>
                      <div class="cond">
                        <div class="cond__body">
                          <p class="cond__label t-body-01">{m.name}{m.highlight ? <span class="member__lead t-label-01"> · Lead</span> : null}</p>
                          <p class="member__role t-label-01">{m.role} · {m.detail}</p>
                        </div>
                        <div class="cond__meta">
                          <cds-icon-indicator size="16" kind={TEAM_STATE[m.reviewStatus].kind} label={TEAM_STATE[m.reviewStatus].label}></cds-icon-indicator>
                          {!m.highlight && (
                            <cds-icon-button kind="ghost" size="sm" align="left" data-remove-member set:html={`${trash}<span slot="tooltip-content">Remove ${m.name}</span>`}></cds-icon-button>
                          )}
                        </div>
                      </div>
                    </cds-contained-list-item>
                  ))}
                </cds-contained-list>
              </div>
            </div>
          </div>
        </div>
        <!-- Right column: the document viewer, pinned (sticky) so it stays in view
             while the left column (record + working panel) scrolls. -->
        <div class="col-main pdf-col cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <h3 class="pane-title t-heading-04">Document viewer</h3>
          <DocumentViewer documents={documents} docTitle={permit.name} />
        </div>
      </section>
    </div>

    <!-- ═══════════════ B3 · Record + docked documents/discussion ════════════ -->
    <!-- Same two-column split as B2, but the RIGHT column is a single tabbed working
         panel: the document viewer is now a TAB alongside conditions, comments, and
         the analysis team, so the whole right side is one surface the reviewer flips
         through in place. The record keeps the left column and grows the page; the
         right panel is sticky so it stays in view while the record scrolls. -->
    <div class="version" data-version="docktabs" hidden>
      <nav class="wiz-track cds--css-grid" aria-label="Review steps">
        <div class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <cds-progress-indicator space-equally>
            <cds-progress-step state="current" label="Review application" secondary-label="Against the study proposal"></cds-progress-step>
            <cds-progress-step label="Add conditions" secondary-label="With the application in context"></cds-progress-step>
            <cds-progress-step label="Finalize letter" secondary-label="Confirm what prints"></cds-progress-step>
            <cds-progress-step label="Review & send" secondary-label="The full package"></cds-progress-step>
          </cds-progress-indicator>
        </div>
      </nav>

      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <h2 class="page-head__title t-heading-04">Review application</h2>
        </header>
      </div>

      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <!-- Left column: the full application record, growing the page as its sections
             expand. B3 shows the SAME editable step-① ApplicationReview as B2 — a single
             instance (it hardcodes element ids, so it can't render twice) that the
             version switcher relocates here when B3 is active. This is its empty slot;
             B2 holds the record markup. The editable record already leads with Project
             information (its collapsible ORDER) and carries Expand/Collapse all. -->
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <h3 class="pane-title t-heading-04">Application record</h3>
          <div data-appreview-slot data-slot-for="docktabs"></div>
        </div>

        <!-- Right column: one tabbed working panel — Document viewer / Conditions /
             Comments / Analysis team — pinned (sticky) so it stays in view while the
             record scrolls. Same [data-tab-scope] dock hooks as B2, so every action
             (add / remove / @-mention / email all) is wired identically. -->
        <div class="col-main dock-col cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-8">
          <h3 class="pane-title t-heading-04">Working panel</h3>
          <div class="dock" data-tab-scope>
            <cds-tabs value="document" data-panels>
              <cds-tab value="document">Document viewer</cds-tab>
              <cds-tab value="conditions">Conditions · {scTotal}</cds-tab>
              <cds-tab value="comments">Comments · {comments.length}</cds-tab>
              <cds-tab value="team">Analysis team · {team.length}</cds-tab>
            </cds-tabs>

            <!-- Document viewer — the same embedded PDF + picker, now the first tab.
                 `slim` collapses the file bar to one line so the tabbed panel spends
                 its height on the document, not the header. -->
            <div class="rail-panel dock-doc" data-tabpanel="document">
              <DocumentViewer documents={documents} docTitle={permit.name} slim />
            </div>

            <!-- Special conditions — the REAL HQ + district structure (ReviewConditions)
                 + the dual-path add modal. -->
            <div class="rail-panel" data-tabpanel="conditions" hidden>
              <div class="dock-list">
                <div class="rail__tools"><cds-button class="js-open-add-cond" kind="tertiary" size="md">Add condition</cds-button></div>
                <ReviewConditions groups={conditionGroups} collapsible />
              </div>
            </div>

            <!-- Comments — composer first (with @-mention), then the thread. -->
            <div class="rail-panel" data-tabpanel="comments" hidden>
              <div class="dock-composer">
                <div class="mention-field">
                  <cds-textarea data-comment-input label="Add a comment" placeholder="Note something for the team… type @ to mention someone" rows="2"></cds-textarea>
                  <ul class="mention-menu" data-mention-menu role="listbox" aria-label="Mention a user" hidden></ul>
                </div>
                <cds-button class="js-post-comment" kind="primary" size="md">Add comment</cds-button>
              </div>
              <ul class="dock-thread" data-thread>
                {comments.map((c) => (
                  <li class="comment">
                    <span class="comment__avatar" aria-hidden="true">{initials(c.author)}</span>
                    <div class="comment__body">
                      <p class="comment__meta t-label-01"><span class="comment__author">{c.author}</span> · {c.time}</p>
                      <p class="comment__text t-body-01">{c.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Analysis team — same roster pattern; Email all + Add member. -->
            <div class="rail-panel" data-tabpanel="team" hidden>
              <div class="dock-list">
                <div class="rail__tools">
                  <cds-button class="js-email-team" kind="ghost" size="md">Email all</cds-button>
                  <cds-button class="js-open-add-member" kind="tertiary" size="md">Add member</cds-button>
                </div>
                <cds-contained-list data-team-list label="Assigned to this permit" kind="on-page">
                  {team.map((m) => (
                    <cds-contained-list-item data-user-id={m.id} data-email={userDirectory.find((u) => u.id === m.id)?.email ?? ''}>
                      <div class="cond">
                        <div class="cond__body">
                          <p class="cond__label t-body-01">{m.name}{m.highlight ? <span class="member__lead t-label-01"> · Lead</span> : null}</p>
                          <p class="member__role t-label-01">{m.role} · {m.detail}</p>
                        </div>
                        <div class="cond__meta">
                          <cds-icon-indicator size="16" kind={TEAM_STATE[m.reviewStatus].kind} label={TEAM_STATE[m.reviewStatus].label}></cds-icon-indicator>
                          {!m.highlight && (
                            <cds-icon-button kind="ghost" size="sm" align="left" data-remove-member set:html={`${trash}<span slot="tooltip-content">Remove ${m.name}</span>`}></cds-icon-button>
                          )}
                        </div>
                      </div>
                    </cds-contained-list-item>
                  ))}
                </cds-contained-list>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- ═══════════════ C · Section-anchored ═════════════════════════════════ -->
    <div class="version" data-version="sections" hidden>
      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <p class="page-head__eyebrow t-label-01">Layout C</p>
          <h2 class="page-head__title t-heading-04">Section-anchored</h2>
          <p class="page-head__sub t-body-02">{bestOf('sections')}</p>
        </header>
      </div>

      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-10">
          <div class="secs">
            {sections.map((s) => {
              const p = proposal.find((x) => x.id === s.compareId) ?? proposal[0];
              return (
                <article class="sec-card">
                  <div class="sec-card__head">
                    <div>
                      <p class="sec-card__field t-label-01">{s.field}</p>
                      <p class="sec-card__value t-body-02">{s.value}</p>
                    </div>
                    <cds-button class="js-open-comments" kind="ghost" size="sm">{s.comments} comment{s.comments === 1 ? '' : 's'}</cds-button>
                  </div>
                  <cds-accordion>
                    <cds-accordion-item title={`Compare with the proposal · ${p.title}`}>
                      <blockquote class="pdf-quote t-body-01">{p.excerpt}</blockquote>
                      <cds-link href={withBase(proposalDoc.href)} target="_blank" rel="noopener">Open “{p.title}” in the proposal PDF ↗</cds-link>
                    </cds-accordion-item>
                  </cds-accordion>
                </article>
              );
            })}
          </div>
        </div>
        <aside class="col-rail cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-6" aria-label="Special conditions">
          <div class="rail">
            <h3 class="rail__title t-heading-03">Special conditions</h3>
            <p class="rail__sub t-label-01">Standard conditions from headquarters and each district attach automatically. Add the conditional ones from the catalog, or remove any that don't apply.</p>
            <div class="rail__tools"><cds-button kind="tertiary" size="md">Add condition</cds-button></div>
            <ReviewConditions groups={conditionGroups} compact removable={false} />
          </div>
        </aside>
      </section>
    </div>

    <!-- ═══════════════ E · Form + vertical tabs ═════════════════════════════ -->
    <div class="version" data-version="vtabs" hidden>
      <div class="page-head cds--css-grid">
        <header class="page-head__inner cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <p class="page-head__eyebrow t-label-01">Layout E</p>
          <h2 class="page-head__title t-heading-04">Form + vertical tabs</h2>
          <p class="page-head__sub t-body-02">{bestOf('vtabs')}</p>
        </header>
      </div>

      <section class="step cds--css-grid cds--css-grid--with-row-gap">
        <!-- Left (narrower): the application record (the form) as a fixed,
             viewport-locked scroll pane so it stays level with the tab panel
             instead of towering over it. -->
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-6">
          <p class="preview__label t-label-01">Application record</p>
          <ReviewAppSummary scroll />
        </div>

        <!-- Right (wider): a vertical tab set switching the three jobs in place —
             the narrow rail + a roomy content panel for the PDF. -->
        <div class="col-main cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-10">
          <!-- Carbon's vertical-tabs wrapper: the tab rail slots into `tabs`, each
               panel into `panel`. My script toggles the panels' `hidden` on select. -->
          <cds-tabs-vertical class="vtabs" data-tab-scope>
            <cds-tabs slot="tabs" value="proposal" data-panels>
              <cds-tab value="proposal">Document viewer</cds-tab>
              <cds-tab value="conditions">Special conditions</cds-tab>
              <cds-tab value="comments">Comments</cds-tab>
            </cds-tabs>

            <div slot="panel" data-tabpanel="proposal">
              <DocumentViewer documents={documents} docTitle={permit.name} />
            </div>

            <div slot="panel" data-tabpanel="conditions" class="vtabs__pad" hidden>
              <div class="vtabs__tools"><cds-button kind="tertiary" size="md">Add condition</cds-button></div>
              <ReviewConditions groups={conditionGroups} removable={false} />
            </div>

            <div slot="panel" data-tabpanel="comments" class="vtabs__pad" hidden>
              <ul class="vtabs__thread">
                {comments.map((c) => (
                  <li class="comment">
                    <span class="comment__avatar" aria-hidden="true">{initials(c.author)}</span>
                    <div class="comment__body">
                      <p class="comment__meta t-label-01"><span class="comment__author">{c.author}</span> · {c.time}</p>
                      <p class="comment__text t-body-01">{c.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
              <cds-textarea label="Add a comment" placeholder="Note something for the team…" rows="3"></cds-textarea>
              <div class="vtabs__send"><cds-button kind="primary" size="md">Add comment</cds-button></div>
            </div>
          </cds-tabs-vertical>
        </div>
      </section>
    </div>
  </main>

  <!-- Persistent comments trigger — the SAME fixed FAB as the real wizard. -->
  <div class="comments-fab">
    <cds-button class="js-open-comments" kind="ghost" size="md">
      Comments
      <span class="comments-count">{comments.length}</span>
    </cds-button>
  </div>

  <!-- Comments thread — the SAME slide-over drawer as the real wizard. -->
  <aside id="comments-panel" class="drawer" aria-label="Comments" aria-hidden="true">
    <div class="drawer__head">
      <h2 class="drawer__title t-heading-03">Comments</h2>
      <cds-icon-button id="comments-close" kind="ghost" size="sm" align="left">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.4141 16 24 9.4141 22.5859 8 16 14.5859 9.4143 8 8 9.4141 14.5859 16 8 22.5859 9.4143 24 16 17.4141 22.5859 24 24 22.5859 17.4141 16z"/></svg>
        <span slot="tooltip-content">Close comments</span>
      </cds-icon-button>
    </div>
    <p class="comments-note t-label-01">Shared with the permit's review thread. Newest first.</p>
    <ul class="comments-thread">
      {comments.map((c) => (
        <li class="comment">
          <span class="comment__avatar" aria-hidden="true">{initials(c.author)}</span>
          <div class="comment__body">
            <p class="comment__meta t-label-01"><span class="comment__author">{c.author}</span> · {c.time}</p>
            <p class="comment__text t-body-01">{c.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="comments-composer">
      <cds-textarea label="Add a comment" placeholder="Note something for the team…" rows="3"></cds-textarea>
      <cds-button kind="primary" size="md">Add comment</cds-button>
    </div>
  </aside>

  <!-- Add-member modal — the SAME button-first pattern as the permit Overview's
       "Add to team" modal (a base-page sm modal: pick a directory user, "Add to team"
       commits). The picker lists only users not already on the team. Lives at page
       level so it overlays regardless of which version panel is showing. -->
  <cds-modal id="add-member-modal" size="sm">
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label>Analysis team</cds-modal-label>
      <cds-modal-heading>Add to team</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <cds-combo-box
        id="add-member-select"
        title-text="Reviewer"
        label="Search the user directory…"
        helper-text="Only users not already on the analysis team appear here."
      >
        {eligibleMembers.map((u) => (
          <cds-combo-box-item value={u.id} data-name={u.name} data-role={u.role} data-detail={u.detail} data-email={u.email}>{u.name} — {u.detail}</cds-combo-box-item>
        ))}
      </cds-combo-box>
    </cds-modal-body>
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="add-member-confirm">Add to team</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>

  <!-- Row template for a member added via the modal — same contained-list-item shape
       as the seeded rows; a new reviewer starts at "Not started". -->
  <template id="team-row-template">
    <cds-contained-list-item data-user-id="">
      <div class="cond">
        <div class="cond__body">
          <p class="cond__label t-body-01 member__name"></p>
          <p class="member__role t-label-01"></p>
        </div>
        <div class="cond__meta">
          <cds-icon-indicator size="16" kind="not-started" label="Not started"></cds-icon-indicator>
          <cds-icon-button kind="ghost" size="sm" align="left" data-remove-member>
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>
            <span slot="tooltip-content">Remove</span>
          </cds-icon-button>
        </div>
      </div>
    </cds-contained-list-item>
  </template>

  <!-- Add-condition modal — the SAME dual-path pattern as the real wizard's condition
       modal (final-letter / permit): a cds-content-switcher toggles "From catalog"
       (attach a saved condition) vs "Write manually" (type a new one), one path at a
       time. Scope picks which owner it attaches to. -->
  <cds-modal id="cond-modal" size="md">
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label>Special conditions</cds-modal-label>
      <cds-modal-heading>Add condition</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <cds-stack gap="6">
        <!-- Scope = the owner (HQ or a district on this permit) the condition attaches
             to — the same owners the detail page curates. -->
        <cds-dropdown id="cond-scope" title-text="Scope" value="hq" label="Choose a scope">
          {scOwners.map((o) => (
            <cds-dropdown-item value={o.key}>{o.label}</cds-dropdown-item>
          ))}
        </cds-dropdown>

        <!-- One path at a time, not both stacked (same switcher as the app). -->
        <div>
          <p class="cond-mode-label t-label-01">Pull a saved condition, or write a new one.</p>
          <cds-content-switcher id="cond-mode" value="catalog">
            <cds-content-switcher-item value="catalog" selected>From catalog</cds-content-switcher-item>
            <cds-content-switcher-item value="manual">Write manually</cds-content-switcher-item>
          </cds-content-switcher>
        </div>

        <!-- Catalog options are the chosen owner's non-default inventory; the script
             repopulates this list whenever the scope changes. -->
        <div id="cond-catalog">
          <cds-dropdown id="cond-pick" title-text="Saved conditions" label="Select a saved condition"></cds-dropdown>
        </div>

        <div id="cond-manual" hidden>
          <cds-textarea id="cond-body" label="Condition text" placeholder="The exact wording that will print on the permit…" rows="3"></cds-textarea>
        </div>
      </cds-stack>
    </cds-modal-body>
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="cond-modal-save">Add condition</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>

  <!-- Add / edit a specimen — used by the editable ApplicationReview in the B2
       version. SAME construction as the finalize wizard's specimen dialog
       (final-letter.astro): four fields that add a row or edit one in place. -->
  <cds-modal id="specimen-modal" size="md">
    <cds-modal-header>
      <cds-modal-close-button></cds-modal-close-button>
      <cds-modal-label>Authorized collection</cds-modal-label>
      <cds-modal-heading id="specimen-modal-heading">Add a specimen type</cds-modal-heading>
    </cds-modal-header>
    <cds-modal-body>
      <div class="spec-fields">
        <div class="spec-fields__wide">
          <cds-text-input id="ns-species" label="Species"></cds-text-input>
        </div>
        <cds-text-input id="ns-quantity" label="Quantity"></cds-text-input>
        <cds-text-input id="ns-portion" label="Portion"></cds-text-input>
        <div class="spec-fields__wide">
          <cds-text-input id="ns-condition" label="Condition"></cds-text-input>
        </div>
      </div>
    </cds-modal-body>
    <cds-modal-footer>
      <cds-modal-footer-button kind="secondary" data-modal-close>Cancel</cds-modal-footer-button>
      <cds-modal-footer-button kind="primary" id="ns-save">Add specimen</cds-modal-footer-button>
    </cds-modal-footer>
  </cds-modal>

  <!-- Row template for a condition added via the modal — the SAME item shape
       ReviewConditions renders (rich-text body + source meta, remove in slot="action").
       The script fills the body / source tag / added-by and appends into the chosen
       owner's list. -->
  <template id="cond-row-template">
    <cds-contained-list-item>
      <div class="rc-cond">
        <div class="rc-cond__body"></div>
        <div class="rc-cond__meta">
          <cds-tag size="sm" type="cool-gray"></cds-tag>
          <span class="rc-cond__by t-label-01"></span>
        </div>
      </div>
      <div slot="action" class="rc-cond__actions">
        <cds-icon-button kind="ghost" size="sm" align="left" data-edit-cond>
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M2 26h28v2H2zM25.4 9c.8-.8.8-2 0-2.8l-3.6-3.6c-.8-.8-2-.8-2.8 0l-15 15V26h8.4zM20.4 4L24 7.6l-3 3L17.4 7zM6 24v-3.6l10-10 3.6 3.6-10 10z"/></svg>
          <span slot="tooltip-content">Edit condition</span>
        </cds-icon-button>
        <cds-icon-button kind="ghost" size="sm" align="left" data-remove-cond>
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>
          <span slot="tooltip-content">Remove condition</span>
        </cds-icon-button>
      </div>
    </cds-contained-list-item>
  </template>

  <!-- Comment row template — cloned for a posted comment (author "You"), so the new
       row carries Astro's scoped-style attributes. Mentions render as .mention tokens
       built in JS (never innerHTML of user text). -->
  <template id="comment-row-template">
    <li class="comment">
      <span class="comment__avatar" aria-hidden="true">You</span>
      <div class="comment__body">
        <p class="comment__meta t-label-01"><span class="comment__author">You</span> · Just now</p>
        <p class="comment__text t-body-01"></p>
      </div>
    </li>
  </template>

  <!-- The user directory the @-mention picker draws from (id / name / detail / email). -->
  <script type="application/json" id="mention-directory" set:html={JSON.stringify(userDirectory.map((u) => ({ id: u.id, name: u.name, detail: u.detail, email: u.email })))}></script>

  <!-- Per-owner catalog (non-default items) the Add-condition picker offers, keyed by
       owner. The script repopulates #cond-pick from this when the scope changes. -->
  <script type="application/json" id="sc-inventory" set:html={JSON.stringify(scInventory)}></script>

  <!-- Seed for the editable ApplicationReview (B2 version): the same source data the
       finalize wizard seeds step ① from — project title, authorized specimens, and
       the authorized parks per district. The page-local wiring reads this, then
       persists edits to its own localStorage key (see script). -->
  <script type="application/json" id="appreview-seed" set:html={JSON.stringify({
    projectTitle: permit.name,
    specimens: permit.dataCollection.specimens.map((s) => ({ ...s })),
    districts: permit.studyAreas.districts.map((d) => ({ name: d.name, parks: [...d.parks] })),
  })}></script>

  <script>
    import { showToast } from '../lib/toast';

    // Version switcher — cds-tabs renders only the strip; toggling the matching
    // .version panel (plain <div>, so `hidden` collapses it) is the page's job.
    const vtabs = document.getElementById('version-tabs') as any;
    const versions = Array.from(document.querySelectorAll<HTMLElement>('.version'));
    const ids = versions.map((p) => p.dataset.version);

    // The editable application record is a SINGLE instance (ApplicationReview
    // hardcodes element ids, so it can't be rendered twice). B2 and B3 both show it,
    // and they're never visible at once, so one instance is shared: it lives in
    // whichever of the two is active, moved into that version's slot on switch.
    const appreviewNode = document.querySelector('[data-appreview]');
    const placeAppreview = (v: string) => {
      if (!appreviewNode) return;
      const slot = document.querySelector(`[data-appreview-slot][data-slot-for="${v}"]`);
      if (slot && !slot.contains(appreviewNode)) slot.appendChild(appreviewNode);
    };
    const show = (v: string) => {
      versions.forEach((p) => { p.hidden = p.dataset.version !== v; });
      placeAppreview(v);
    };
    vtabs?.addEventListener('cds-tabs-selected', () => { show(vtabs.value); history.replaceState(null, '', `#${vtabs.value}`); });

    const wanted = location.hash.replace('#', '');
    const initial = ids.includes(wanted) ? wanted : (vtabs?.value || 'stepped');
    customElements.whenDefined('cds-tabs').then(async () => {
      if (vtabs) { await (vtabs.updateComplete ?? Promise.resolve()); vtabs.value = initial; }
      show(initial);
    });
    show(initial);

    // Nested rail switcher (version B) — read the attribute pre-upgrade so the
    // panel isn't blank before cds-tabs upgrades, then re-sync on upgrade.
    document.querySelectorAll<HTMLElement>('[data-tab-scope]').forEach((scope) => {
      const tabs = scope.querySelector('cds-tabs[data-panels]') as any;
      if (!tabs) return;
      const panels = Array.from(scope.querySelectorAll<HTMLElement>('[data-tabpanel]'));
      const current = () => tabs.value || tabs.getAttribute('value');
      const sync = () => panels.forEach((p) => { p.hidden = p.dataset.tabpanel !== current(); });
      tabs.addEventListener('cds-tabs-selected', sync);
      customElements.whenDefined('cds-tabs').then(sync);
      sync();
    });

    // "View CV" (research-team PI tile) → open that document in the active version's
    // working panel: switch to its Document viewer tab and select the file in the
    // picker. Scoped to the trigger's own .version so B2/B3 drive their own dock.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('[data-view-cv]') as HTMLElement | null;
      if (!trigger) return;
      const href = trigger.dataset.viewCv;
      if (!href) return;
      const scope = (trigger.closest('.version') || document).querySelector('[data-tab-scope]');
      const tabsEl = scope?.querySelector('cds-tabs[data-panels]') as any;
      if (tabsEl) { tabsEl.value = 'document'; tabsEl.dispatchEvent(new CustomEvent('cds-tabs-selected')); }
      // Some versions embed the viewer without a dock (not tabbed) — fall back to any
      // picker within the version.
      const sel = (scope || trigger.closest('.version') || document)?.querySelector('.pdfv__select') as any;
      const item = sel?.querySelector(`cds-dropdown-item[value="${href}"]`) as HTMLElement | null;
      if (sel && item) {
        sel.value = href;
        sel.dispatchEvent(new CustomEvent('cds-dropdown-selected', { detail: { item } }));
      }
    });

    // Comments drawer open/close — same behavior as the real wizard.
    const panel = document.getElementById('comments-panel');
    const openComments = () => { panel?.classList.add('drawer--open'); panel?.setAttribute('aria-hidden', 'false'); };
    const closeComments = () => { panel?.classList.remove('drawer--open'); panel?.setAttribute('aria-hidden', 'true'); };
    document.querySelectorAll('.js-open-comments').forEach((b) => b.addEventListener('click', openComments));
    document.getElementById('comments-close')?.addEventListener('click', closeComments);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeComments(); });

    // ── Working dock (conditions / comments / analysis team) ───────────────────
    // Both B2 (full-width panel) and B3 (docked documents) render a "dock": the same
    // conditions / comments / analysis-team surface, differing only in arrangement.
    // All the dock behavior (add member, add condition, @-mention comments, email
    // all, remove) is wired PER SCOPE off shared [data-*] hooks, so every dock
    // instance works independently and the two studies never fight over one id.
    // Shared modals/templates are page-level singletons; opening one records which
    // dock scope invoked it, so "confirm" appends to the right list. Design study →
    // in-DOM only, no persistence.

    // Shared modal + template refs (page-level singletons).
    const addModal = document.getElementById('add-member-modal') as any;
    const addSelect = document.getElementById('add-member-select') as any;
    const teamRowTpl = document.getElementById('team-row-template') as HTMLTemplateElement | null;

    const condModal = document.getElementById('cond-modal') as any;
    const condMode = document.getElementById('cond-mode') as any;
    const condCatalog = document.getElementById('cond-catalog');
    const condManual = document.getElementById('cond-manual');
    const condScope = document.getElementById('cond-scope') as any;
    const condPick = document.getElementById('cond-pick') as any;
    const condBody = document.getElementById('cond-body') as any;
    const condRowTpl = document.getElementById('cond-row-template') as HTMLTemplateElement | null;
    const condModalHeading = condModal?.querySelector('cds-modal-heading') as HTMLElement | null;
    const condSaveBtn = document.getElementById('cond-modal-save') as HTMLElement | null;
    // The condition row currently being edited (null = the modal is in Add mode).
    let editingCond: HTMLElement | null = null;

    const commentTpl = document.getElementById('comment-row-template') as HTMLTemplateElement | null;
    interface Dir { id: string; name: string; detail: string; email: string; }
    let directory: Dir[] = [];
    try { directory = JSON.parse(document.getElementById('mention-directory')?.textContent || '[]'); } catch { directory = []; }

    // Which dock scope opened the currently-showing shared modal.
    let activeScope: HTMLElement | null = null;

    // Count labels live on the scope's own cds-tab (queried by value, no ids).
    const teamListOf = (s: HTMLElement) => s.querySelector('[data-team-list]');
    // Conditions now render as MULTIPLE owner lists (HQ + one per district), so the
    // count sums every item across all of a scope's lists.
    const condListsOf = (s: HTMLElement) => Array.from(s.querySelectorAll('[data-cond-list]'));
    const syncTeamCount = (s: HTMLElement) => {
      const list = teamListOf(s), tab = s.querySelector('cds-tab[value="team"]');
      if (list && tab) tab.textContent = `Analysis team · ${list.querySelectorAll('cds-contained-list-item').length}`;
    };
    const syncCondCount = (s: HTMLElement) => {
      const tab = s.querySelector('cds-tab[value="conditions"]');
      if (!tab) return;
      const n = condListsOf(s).reduce((sum, l) => sum + l.querySelectorAll('cds-contained-list-item').length, 0);
      tab.textContent = `Conditions · ${n}`;
    };

    // Per-owner catalog (non-default inventory) the Add-condition picker offers.
    interface Inv { id: string; preview: string; body: string; }
    let scInv: Record<string, Inv[]> = {};
    try { scInv = JSON.parse(document.getElementById('sc-inventory')?.textContent || '{}'); } catch { scInv = {}; }
    // Repopulate the catalog picker for the selected owner (value = inventory id).
    const repopulateCatalog = (owner: string) => {
      if (!condPick) return;
      const items = scInv[owner] || [];
      condPick.innerHTML = '';
      items.forEach((it) => {
        const opt = document.createElement('cds-dropdown-item');
        opt.setAttribute('value', it.id);
        opt.textContent = it.preview + (it.preview.length >= 120 ? '…' : '');
        condPick.appendChild(opt);
      });
      condPick.value = items[0]?.id || '';
    };
    condScope?.addEventListener('cds-dropdown-selected', (e: any) =>
      repopulateCatalog(e.detail?.item?.value || condScope.value || 'hq'));

    // Toggle the two paths on the add-condition switcher (cds-* ignore [hidden] on
    // hosts, but these are plain <div> wrappers, so the attribute collapses them).
    const applyCondMode = () => {
      const manual = (condMode?.value || 'catalog') === 'manual';
      if (condCatalog) condCatalog.hidden = manual;
      if (condManual) condManual.hidden = !manual;
    };
    condMode?.addEventListener('cds-content-switcher-selected', applyCondMode);

    // Add-member confirm — append to whichever dock opened the modal.
    document.getElementById('add-member-confirm')?.addEventListener('click', () => {
      const scope = activeScope;
      const teamList = scope ? teamListOf(scope) : null;
      const id: string = addSelect?.value || '';
      if (!id || !teamList || !teamRowTpl) { if (addModal) addModal.open = false; return; }
      const opt = addSelect.querySelector(`cds-combo-box-item[value="${CSS.escape(id)}"]`) as HTMLElement | null;
      const item = teamRowTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      item.dataset.userId = id;
      item.dataset.email = opt?.dataset.email || '';
      const nameEl = item.querySelector('.member__name');
      if (nameEl) nameEl.textContent = opt?.dataset.name || id;
      const roleEl = item.querySelector('.member__role');
      if (roleEl) roleEl.textContent = `${opt?.dataset.role || 'Supporting analyst'} · ${opt?.dataset.detail || '—'}`;
      teamList.appendChild(item);
      opt?.remove();          // a user already on the team drops out of the picker
      addSelect.value = '';
      addModal.open = false;
      if (scope) syncTeamCount(scope);
    });

    // Add-condition save — append into the chosen owner's list within the dock that
    // opened the modal. Catalog → pull the picked inventory item's rich-text body
    // (source "From catalog"); manual → wrap the typed text in a paragraph (source
    // "Custom"). Mirrors the detail page's source labelling.
    const escHtml = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as Record<string, string>)[c]);
    // Set the condition body / source tag / added-by on a row (shared by add + edit).
    const fillCondRow = (row: HTMLElement, bodyHtml: string, manual: boolean) => {
      const bodyEl = row.querySelector('.rc-cond__body');
      if (bodyEl) bodyEl.innerHTML = bodyHtml;   // our own sanitized seed HTML / escaped text
      const tag = row.querySelector('cds-tag');
      if (tag) tag.textContent = manual ? 'Custom' : 'From catalog';
      const by = row.querySelector('.rc-cond__by');
      if (by) by.textContent = manual ? 'Custom' : 'From catalog';
    };
    document.getElementById('cond-modal-save')?.addEventListener('click', () => {
      const scope = activeScope;
      const owner = condScope?.value || 'hq';
      const manual = (condMode?.value || 'catalog') === 'manual';
      let bodyHtml = '';
      if (manual) {
        const text = (condBody?.value || '').trim();
        if (!text) { if (condModal) condModal.open = false; return; }
        bodyHtml = `<p>${escHtml(text)}</p>`;
      } else {
        const pickId = condPick?.value || '';
        const picked = (scInv[owner] || []).find((i) => i.id === pickId);
        if (!picked) { if (condModal) condModal.open = false; return; }
        bodyHtml = picked.body;
      }
      if (editingCond) {
        // Edit in place — the row stays in its owner list; only its body/source change.
        fillCondRow(editingCond, bodyHtml, manual);
      } else {
        // Add — clone the row template into the chosen owner's list within this dock.
        const targetList = scope?.querySelector(`[data-cond-list][data-owner="${CSS.escape(owner)}"]`);
        if (!targetList || !condRowTpl) { if (condModal) condModal.open = false; return; }
        const item = condRowTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        fillCondRow(item, bodyHtml, manual);
        targetList.appendChild(item);
      }
      if (condBody) condBody.value = '';
      condModal.open = false;
      if (scope) syncCondCount(scope);
    });

    // @-mention wiring for one dock's composer (no-op if it has none, e.g. layouts
    // B/E whose comment boxes aren't the mention composer).
    const wireMentions = (scope: HTMLElement) => {
      const cdsInput = scope.querySelector('[data-comment-input]') as any;
      const menu = scope.querySelector('[data-mention-menu]') as HTMLElement | null;
      const thread = scope.querySelector('[data-thread]') as HTMLElement | null;
      if (!cdsInput || !menu || !thread || !commentTpl) return;
      customElements.whenDefined('cds-textarea').then(async () => {
        await (cdsInput.updateComplete ?? Promise.resolve());
        const ta = cdsInput.shadowRoot?.querySelector('textarea') as HTMLTextAreaElement | null;
        if (!ta) return;

        const picked = new Map<string, Dir>();   // name → user inserted via the picker
        let items: Dir[] = [];
        let active = -1;

        // The in-progress "@token" ending at the caret: from the last "@" that starts
        // a word, no newline, and not already closed by a trailing space.
        const queryAtCaret = () => {
          const caret = ta.selectionStart ?? ta.value.length;
          const upto = ta.value.slice(0, caret);
          const at = upto.lastIndexOf('@');
          if (at === -1) return null;
          if (at !== 0 && !/\s/.test(upto[at - 1])) return null;   // avoid emails (a@b)
          const q = upto.slice(at + 1);
          if (/\n/.test(q) || /\s$/.test(q) || q.length > 30) return null;
          return { at, caret, q };
        };

        const hideMenu = () => { menu.hidden = true; menu.innerHTML = ''; active = -1; };

        const renderMenu = (matches: Dir[]) => {
          items = matches;
          menu.innerHTML = '';
          matches.forEach((u, i) => {
            const li = document.createElement('li');
            li.className = 'mention-menu__item';
            li.setAttribute('role', 'option');
            li.dataset.idx = String(i);
            li.innerHTML = `<span class="mention-menu__name">${u.name}</span><span class="mention-menu__detail">${u.detail}</span>`;
            menu.appendChild(li);
          });
          active = matches.length ? 0 : -1;
          paintActive();
          menu.hidden = matches.length === 0;
        };

        const paintActive = () => {
          Array.from(menu.children).forEach((li, i) =>
            (li as HTMLElement).classList.toggle('is-active', i === active));
        };

        const refresh = () => {
          const ctx = queryAtCaret();
          if (!ctx) { hideMenu(); return; }
          const q = ctx.q.toLowerCase();
          const matches = directory.filter((u) => u.name.toLowerCase().includes(q)).slice(0, 6);
          renderMenu(matches);
        };

        // Insert the chosen user's mention, replacing the in-progress @token.
        const choose = (u: Dir) => {
          const ctx = queryAtCaret();
          if (!ctx) return;
          const before = ta.value.slice(0, ctx.at);
          const after = ta.value.slice(ctx.caret);
          const insert = `@${u.name} `;
          ta.value = before + insert + after;
          const pos = (before + insert).length;
          ta.setSelectionRange(pos, pos);
          cdsInput.value = ta.value;
          picked.set(u.name, u);
          hideMenu();
          ta.focus();
        };

        ta.addEventListener('input', refresh);
        ta.addEventListener('keyup', (e) => { if (['ArrowLeft','ArrowRight','Home','End'].includes((e as KeyboardEvent).key)) refresh(); });
        ta.addEventListener('keydown', (e) => {
          const k = (e as KeyboardEvent).key;
          if (menu.hidden) return;
          if (k === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, items.length - 1); paintActive(); }
          else if (k === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); paintActive(); }
          else if (k === 'Enter' && active >= 0) { e.preventDefault(); choose(items[active]); }
          else if (k === 'Escape') { e.preventDefault(); hideMenu(); }
        });
        // mousedown (not click) so the pick beats the textarea blur.
        menu.addEventListener('mousedown', (e) => {
          const li = (e.target as HTMLElement).closest('.mention-menu__item') as HTMLElement | null;
          if (!li) return;
          e.preventDefault();
          const u = items[Number(li.dataset.idx)];
          if (u) choose(u);
        });
        document.addEventListener('click', (e) => {
          if (!(e.target as HTMLElement).closest('.mention-field')) hideMenu();
        });

        // Render comment text with mentioned names as .mention tokens (build DOM, never
        // innerHTML the user's text).
        const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const renderText = (text: string, names: string[]): DocumentFragment => {
          const frag = document.createDocumentFragment();
          if (!names.length) { frag.appendChild(document.createTextNode(text)); return frag; }
          const re = new RegExp('@(' + names.slice().sort((a, b) => b.length - a.length).map(escapeRe).join('|') + ')', 'g');
          let last = 0, m: RegExpExecArray | null;
          while ((m = re.exec(text))) {
            if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
            const span = document.createElement('span');
            span.className = 'mention';
            span.textContent = '@' + m[1];
            frag.appendChild(span);
            last = m.index + m[0].length;
          }
          if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
          return frag;
        };

        const post = () => {
          const text = (ta.value || '').trim();
          if (!text) return;
          // Which picked mentions actually survive in the text?
          const mentioned = [...picked.values()].filter((u) => text.includes(`@${u.name}`));
          const row = commentTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const textEl = row.querySelector('.comment__text')!;
          textEl.textContent = '';
          textEl.appendChild(renderText(text, mentioned.map((u) => u.name)));
          thread.prepend(row);   // newest first
          // Simulated notification email to each mentioned user.
          if (mentioned.length) {
            showToast('Comment posted',
              `Emailed ${mentioned.map((u) => u.name).join(', ')} about your mention.`);
          } else {
            showToast('Comment posted');
          }
          ta.value = ''; cdsInput.value = ''; picked.clear(); hideMenu();
        };
        scope.querySelectorAll('.js-post-comment').forEach((b) => b.addEventListener('click', post));
      });
    };

    // Put the condition modal in Add mode (new row appended on save).
    const enterCondAddMode = () => {
      editingCond = null;
      if (condModalHeading) condModalHeading.textContent = 'Add condition';
      if (condSaveBtn) condSaveBtn.textContent = 'Add condition';
      if (condScope) condScope.disabled = false;
      if (condMode) condMode.value = 'catalog';
      if (condBody) condBody.value = '';
    };
    // Put the condition modal in Edit mode for a specific row (updated in place on
    // save). The owner is fixed while editing; the current wording seeds the textarea.
    const enterCondEditMode = (row: HTMLElement) => {
      editingCond = row;
      const owner = row.closest('[data-cond-list]')?.getAttribute('data-owner') || 'hq';
      if (condScope) { condScope.value = owner; condScope.disabled = true; }
      if (condMode) condMode.value = 'manual';
      applyCondMode();
      const text = (row.querySelector('.rc-cond__body') as HTMLElement | null)?.textContent?.trim() || '';
      if (condBody) condBody.value = text;
      if (condModalHeading) condModalHeading.textContent = 'Edit condition';
      if (condSaveBtn) condSaveBtn.textContent = 'Save changes';
    };

    // Wire every dock instance (B2, B3, …) off its own scope.
    document.querySelectorAll<HTMLElement>('[data-tab-scope]').forEach((scope) => {
      // Open the shared modals — record the invoking scope so confirm targets it.
      scope.querySelectorAll('.js-open-add-member').forEach((b) =>
        b.addEventListener('click', () => { activeScope = scope; if (addModal) addModal.open = true; }));
      scope.querySelectorAll('.js-open-add-cond').forEach((b) =>
        b.addEventListener('click', () => {
          activeScope = scope;
          if (condModal) {
            enterCondAddMode();
            applyCondMode();
            repopulateCatalog(condScope?.value || 'hq');
            condModal.open = true;
          }
        }));

      // Remove a member (delegated) — the lead has no remove control, so it never fires.
      teamListOf(scope)?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest?.('[data-remove-member]');
        if (!btn) return;
        btn.closest('cds-contained-list-item')?.remove();
        syncTeamCount(scope);
      });
      // Edit / remove a condition (delegated) — one listener per owner list (HQ +
      // districts). Edit opens the modal on that row; remove deletes it in place.
      condListsOf(scope).forEach((list) => list.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const editBtn = target.closest?.('[data-edit-cond]');
        if (editBtn) {
          const row = editBtn.closest('cds-contained-list-item') as HTMLElement | null;
          if (row && condModal) {
            activeScope = scope;
            enterCondEditMode(row);
            repopulateCatalog(condScope?.value || 'hq');
            condModal.open = true;
          }
          return;
        }
        const rmBtn = target.closest?.('[data-remove-cond]');
        if (!rmBtn) return;
        rmBtn.closest('cds-contained-list-item')?.remove();
        syncCondCount(scope);
      }));

      // Email all — one message to every current team member with an address on file.
      scope.querySelectorAll('.js-email-team').forEach((b) => b.addEventListener('click', () => {
        const list = teamListOf(scope);
        const emails = [...new Set(Array.from(list?.querySelectorAll<HTMLElement>('cds-contained-list-item[data-email]') ?? [])
          .map((r) => (r.dataset.email || '').trim()).filter(Boolean))];
        if (emails.length) window.location.href = `mailto:${emails.join(',')}`;
      }));

      // @-mention composer.
      wireMentions(scope);
    });

    // ──────────────────────────────────────────────────────────────────────────
    // Editable ApplicationReview (B2 · Full-width panel) — page-local wiring
    // ──────────────────────────────────────────────────────────────────────────
    // The B2 study renders the REAL step-① ApplicationReview component so the
    // layout can be exercised with live edit affordances. That component is markup
    // only; the finalize wizard's behavior (final-letter.astro) is entangled with
    // the letter + conditions. Rather than import that machinery, this is a
    // SELF-CONTAINED port of just the step-① editing — seed + persist the
    // letter-bound fields, the study-areas roster, and the specimen modal — scoped
    // to this page and persisted under its OWN key, decoupled from the wizard.
    // (Deliberately omits the wizard's drop-district confirmation / team
    // reassignment: this is a layout study, so parks add/remove freely.)
    (async () => {
      const appReviewRoot = document.querySelector('[data-appreview]');
      if (!appReviewRoot) return;

      await Promise.all([
        customElements.whenDefined('cds-multi-select'),
        customElements.whenDefined('cds-dropdown'),
        customElements.whenDefined('cds-text-input'),
      ]);

      const $ar = <T extends Element = HTMLElement>(id: string) => document.getElementById(id) as T | null;
      const escAr = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as Record<string, string>)[c]);
      const trashIcon =
        '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 12H14V24H12zM18 12H20V24H18z"/><path d="M4 6V8H6V28a2 2 0 002 2H24a2 2 0 002-2V8h2V6zM8 28V8H24V28zM12 2H20V4H12z"/></svg>';
      const editIcon =
        '<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M2 26H30V28H2zM25.4 9c.8-.8.8-2 0-2.8l-3.6-3.6c-.8-.8-2-.8-2.8 0l-15 15V24h6.4L25.4 9zM20.4 4L24 7.6l-3 3L17.4 7zM8 22v-3.6l10-10L21.6 12l-10 10z"/></svg>';

      // ── State: persisted edits win over the application seed ──────────────────
      const seedEl = document.getElementById('appreview-seed');
      const seed = seedEl ? JSON.parse(seedEl.textContent || '{}') : {};
      const STORE = 'review-layouts-appreview';
      let persisted: any = {};
      try { persisted = JSON.parse(localStorage.getItem(STORE) || '{}'); } catch { persisted = {}; }

      const districtNames: string[] = (seed.districts || []).map((d: any) => d.name);
      const catEl = $ar('fb-category') as any;
      const state = {
        fields: {
          projectTitle: seed.projectTitle ?? '',
          category: catEl?.value ?? '',
          ...(persisted.fields || {}),
        } as Record<string, string>,
        parks: (persisted.parks
          || Object.fromEntries((seed.districts || []).map((d: any) => [d.name, [...d.parks]]))) as Record<string, string[]>,
        specimens: (Array.isArray(persisted.specimens)
          ? persisted.specimens
          : (seed.specimens || []).map((s: any) => ({ ...s }))) as Array<Record<string, string>>,
      };
      // ── Auto-save indicator ───────────────────────────────────────────────────
      // Every edit persists immediately (below); this gives that silent save a
      // visible confirmation so the reviewer knows changes are kept without a Save
      // button. It flips to "Saving…" on change, then settles on "All changes saved".
      // Lives in the record's toolbar, so it travels with the record between B2/B3.
      const saveState = document.createElement('span');
      saveState.className = 'appreview-savestate t-label-01';
      saveState.setAttribute('role', 'status');
      saveState.setAttribute('aria-live', 'polite');
      saveState.dataset.state = 'idle';
      saveState.textContent = 'All changes saved';
      appReviewRoot.querySelector('.app-review__tools')?.prepend(saveState);
      let saveTimer: ReturnType<typeof setTimeout> | undefined;
      const flashSaved = () => {
        saveState.dataset.state = 'saving';
        saveState.textContent = 'Saving…';
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          saveState.dataset.state = 'saved';
          saveState.textContent = 'All changes saved';
        }, 500);
      };

      const persist = () => { localStorage.setItem(STORE, JSON.stringify(state)); flashSaved(); };

      // ── Editable letter-bound fields (project title + category) ───────────────
      const titleEl = $ar('fb-title') as any;
      if (titleEl) {
        titleEl.value = state.fields.projectTitle ?? '';
        titleEl.addEventListener('input', () => { state.fields.projectTitle = titleEl.value; persist(); });
      }
      if (catEl) {
        if (state.fields.category) catEl.value = state.fields.category;
        catEl.addEventListener('cds-dropdown-selected', (e: any) => {
          state.fields.category = e.detail?.item?.value || state.fields.category; persist();
        });
      }

      // ── Study-areas roster (multi-select → Park/District table) ───────────────
      const saSelect = $ar('sa-select') as any;
      const parkDistrict = new Map<string, string>();
      saSelect?.querySelectorAll('cds-multi-select-item').forEach((it: any) => {
        parkDistrict.set(it.getAttribute('value') || '', it.dataset.district || '');
      });
      const selectedNames = () => Object.values(state.parks).flat();
      const groupNames = (names: string[]) => {
        const grouped: Record<string, string[]> = Object.fromEntries(districtNames.map((n) => [n, []]));
        names.forEach((name) => {
          const d = parkDistrict.get(name);
          if (d && grouped[d]) grouped[d].push(name);
        });
        return grouped;
      };
      // Parks GROUPED BY DISTRICT: a district header row over its parks (state.parks
      // is already district-keyed). Matches ApplicationReview's 2-col Park | Remove
      // roster (the District column is redundant once grouped).
      const renderStudyAreas = () => {
        const names = selectedNames();
        if (saSelect) saSelect.value = names.join(',');
        const count = $ar('sa-count');
        if (count) count.textContent = names.length ? `(${names.length})` : '';
        const empty = $ar('sa-empty');
        if (empty) (empty as HTMLElement).hidden = names.length > 0;
        const body = $ar('sa-body');
        if (body) {
          body.innerHTML = districtNames
            .filter((n) => (state.parks[n] || []).length > 0)
            .map((n) => {
              const ps = (state.parks[n] || []).slice().sort((a, b) => a.localeCompare(b));
              const head = `<cds-table-row class="sa-grouprow"><cds-table-cell class="sa-groupcell">${escAr(n)} <span class="sa-groupcount">(${ps.length})</span></cds-table-cell><cds-table-cell class="sa-groupcell"></cds-table-cell></cds-table-row>`;
              const rows = ps.map((name) => `
                <cds-table-row>
                  <cds-table-cell class="sa-parkcell">${escAr(name)}</cds-table-cell>
                  <cds-table-cell>
                    <cds-icon-button kind="ghost" size="sm" align="left" data-remove-park="${encodeURIComponent(name)}">
                      ${trashIcon}<span slot="tooltip-content">Remove ${escAr(name)}</span>
                    </cds-icon-button>
                  </cds-table-cell>
                </cds-table-row>`).join('');
              return head + rows;
            }).join('');
        }
      };
      saSelect?.addEventListener('cds-multi-select-selected', () => {
        const v = (saSelect?.value ?? '') as string;
        state.parks = groupNames(v ? v.split(',').filter(Boolean) : []);
        persist(); renderStudyAreas();
      });
      $ar('sa-body')?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest?.('[data-remove-park]') as HTMLElement | null;
        if (!btn) return;
        const name = decodeURIComponent(btn.dataset.removePark || '');
        const district = parkDistrict.get(name);
        if (!district) return;
        state.parks[district] = (state.parks[district] || []).filter((p) => p !== name);
        persist(); renderStudyAreas();
      });

      // ── Specimens (display table + add/edit modal) ────────────────────────────
      const specBody = $ar('specimen-body');
      const specEmpty = $ar('specimen-empty');
      const specModal = $ar('specimen-modal') as any;
      const specHeading = $ar('specimen-modal-heading');
      const specSaveBtn = $ar('ns-save') as any;
      let editingSpecIndex: number | null = null;

      const renderSpecimens = () => {
        if (!specBody) return;
        specBody.innerHTML = state.specimens.map((s, i) => `
          <cds-table-row>
            <cds-table-cell>${escAr(s.species) || '—'}</cds-table-cell>
            <cds-table-cell>${escAr(s.quantity) || '—'}</cds-table-cell>
            <cds-table-cell>${escAr(s.portion) || '—'}</cds-table-cell>
            <cds-table-cell>${escAr(s.condition) || '—'}</cds-table-cell>
            <cds-table-cell>
              <cds-icon-button kind="ghost" size="sm" data-edit-specimen="${i}">${editIcon}<span slot="tooltip-content">Edit specimen</span></cds-icon-button>
              <cds-icon-button kind="ghost" size="sm" data-remove-specimen="${i}">${trashIcon}<span slot="tooltip-content">Remove specimen</span></cds-icon-button>
            </cds-table-cell>
          </cds-table-row>`).join('');
        if (specEmpty) (specEmpty as HTMLElement).hidden = state.specimens.length > 0;
      };
      const openSpecimenModal = (index: number | null) => {
        editingSpecIndex = index;
        const s = index !== null ? state.specimens[index] : null;
        if (specHeading) specHeading.textContent = index !== null ? 'Edit specimen' : 'Add a specimen type';
        if (specSaveBtn) specSaveBtn.textContent = index !== null ? 'Save specimen' : 'Add specimen';
        (($ar('ns-species') as any) || {}).value = s?.species ?? '';
        (($ar('ns-quantity') as any) || {}).value = s?.quantity ?? '';
        (($ar('ns-portion') as any) || {}).value = s?.portion ?? '';
        (($ar('ns-condition') as any) || {}).value = s?.condition ?? '';
        if (specModal) specModal.open = true;
      };
      $ar('add-specimen')?.addEventListener('click', () => openSpecimenModal(null));
      specBody?.addEventListener('click', (e) => {
        const ed = (e.target as HTMLElement).closest?.('[data-edit-specimen]') as HTMLElement | null;
        if (ed) { openSpecimenModal(Number(ed.dataset.editSpecimen)); return; }
        const rm = (e.target as HTMLElement).closest?.('[data-remove-specimen]') as HTMLElement | null;
        if (rm) { state.specimens.splice(Number(rm.dataset.removeSpecimen), 1); persist(); renderSpecimens(); }
      });
      specSaveBtn?.addEventListener('click', () => {
        const val = (id: string) => (($ar(id) as any)?.value ?? '').toString().trim();
        const species = val('ns-species');
        if (!species) { ($ar('ns-species') as any)?.focus(); return; }
        const entry = { species, quantity: val('ns-quantity'), portion: val('ns-portion'), condition: val('ns-condition') };
        if (editingSpecIndex !== null) state.specimens[editingSpecIndex] = entry;
        else state.specimens.push(entry);
        if (specModal) specModal.open = false;
        persist(); renderSpecimens();
      });

      // ── Collapsible sections (sticky-stackable disclosures) ───────────────────
      // Each section header is a data-section-toggle button over a data-section-body.
      // Expand/Collapse all flips them together. Sticky/stacking is pure CSS
      // (ReviewSection); this just drives the open/closed state.
      const sectionToggles = Array.from(appReviewRoot.querySelectorAll<HTMLElement>('[data-section-toggle]'));
      const setSectionOpen = (btn: HTMLElement, open: boolean) => {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        const body = btn.closest('[data-review-section]')?.querySelector<HTMLElement>('[data-section-body]');
        if (body) body.hidden = !open;
      };
      sectionToggles.forEach((btn) =>
        btn.addEventListener('click', () => setSectionOpen(btn, btn.getAttribute('aria-expanded') !== 'true')));
      appReviewRoot.querySelector('.js-appreview-expand')
        ?.addEventListener('click', () => sectionToggles.forEach((b) => setSectionOpen(b, true)));
      appReviewRoot.querySelector('.js-appreview-collapse')
        ?.addEventListener('click', () => sectionToggles.forEach((b) => setSectionOpen(b, false)));

      // Initial paint from the (possibly persisted) state.
      renderStudyAreas();
      renderSpecimens();
    })();
  </script>

  <style>
    /* ── Wizard chrome, copied from final-letter.astro so the studies are native ── */
    .page { padding-block: 0 var(--cds-spacing-10, 4rem); }

    .intro { margin-top: var(--cds-spacing-07, 2rem); }
    .intro__eyebrow { margin: 0 0 var(--cds-spacing-02, 0.25rem); color: var(--cds-text-secondary, #525252); text-transform: uppercase; }
    .intro__title { margin: 0 0 var(--cds-spacing-03, 0.5rem); }
    .intro__lede { margin: 0 0 var(--cds-spacing-06, 1.5rem); max-width: 52rem; color: var(--cds-text-secondary, #525252); }

    /* Toggled version panels — attribute selector out-specifies any element reset. */
    .version[hidden] { display: none; }

    .wiz-track { margin-top: var(--cds-spacing-07, 2rem); }

    .page-head { margin-top: var(--cds-spacing-07, 2rem); }
    .page-head__inner { max-width: 52rem; padding-bottom: var(--cds-spacing-05, 1rem); border-bottom: 1px solid var(--cds-border-subtle-01, #e0e0e0); }
    .page-head__eyebrow { margin: 0 0 var(--cds-spacing-02, 0.25rem); color: var(--cds-text-secondary, #525252); text-transform: uppercase; }
    .page-head__title { margin: 0; }
    .page-head__sub { margin: 0.25rem 0 0; color: var(--cds-text-secondary, #525252); }

    .step { margin-top: var(--cds-spacing-07, 2rem); }
    .col-main, .col-rail { min-width: 0; }

    /* Auto-save confirmation in the editable record's toolbar (B2/B3). Sits left of
       the Expand/Collapse buttons; a quiet green dot on "saved", plain while saving. */
    .appreview-savestate {
      margin-inline-end: auto;
      align-self: center;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      color: var(--cds-text-secondary, #525252);
    }
    .appreview-savestate::before {
      content: "";
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: 50%;
      background: var(--cds-support-success, #24a148);
      transition: background 0.15s;
    }
    .appreview-savestate[data-state="saving"]::before { background: var(--cds-border-strong-01, #8d8d8d); }

    /* Proposal viewer sits like the letter preview — sticky beside the record. */
    .preview__label { display: block; margin: 0 0 var(--cds-spacing-03, 0.5rem); color: var(--cds-text-secondary, #525252); }
    @media (min-width: 66.01rem) { .side-sticky { position: sticky; top: 4rem; align-self: start; } }

    /* Conditions / working rail — the raised working panel from the real wizard. */
    .rail { background: var(--cds-layer-01, #f4f4f4); border: 1px solid var(--cds-border-subtle-01, #e0e0e0); padding: var(--cds-spacing-06, 1.5rem); }
    @media (min-width: 66.01rem) { .rail { position: sticky; top: 4rem; max-height: calc(100vh - 5rem); overflow-y: auto; } }
    .rail__title { margin: 0 0 var(--cds-spacing-03, 0.5rem); }
    .rail__sub { margin: 0 0 var(--cds-spacing-05, 1rem); color: var(--cds-text-secondary, #525252); }
    .rail__tools { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--cds-spacing-03, 0.5rem); margin: 0 0 var(--cds-spacing-05, 1rem); }
    .rail__send { display: flex; justify-content: flex-end; margin-top: var(--cds-spacing-04, 0.75rem); }
    .rail-panel { padding-top: var(--cds-spacing-05, 1rem); }
    .rail-panel[hidden] { display: none; }
    /* Generic tab-panel collapse (author rule beats the element reset). */
    [data-tabpanel][hidden] { display: none; }

    /* B2: the step progress indicator pins as the reviewer scrolls, so the flow
       stays in view. It sticks at 6rem — clear of the fixed UI-Shell header (3rem)
       and PermitHeader's fixed compact bar (3rem) that pin above it; z-index sits
       just under the compact bar (95). A background + rule keep the page content
       from showing through the pinned bar. */
    [data-version="stacked"] .wiz-track {
      position: sticky;
      top: calc(var(--cds-spacing-09, 3rem) * 2); /* 6rem — UI-Shell header + compact bar */
      z-index: 90;
      padding-block: var(--cds-spacing-05, 1rem);
      background: var(--cds-background, #f4f4f4);
      border-bottom: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    }

    /* B2 pane headers — a proper title above each pane. */
    .pane-title { margin: 0 0 var(--cds-spacing-05, 1rem); color: var(--cds-text-primary, #161616); }

    /* B2: LEFT column = the record + the working panel (conditions / comments /
       analysis team) stacked in one column; RIGHT column = the document viewer, made
       sticky so it stays in view while the left column scrolls.
       The record GROWS THE PAGE (no inner scroll box); its sticky section headers pin
       below the page chrome (--rsec-sticky-top) and stack. --rsec-top is that clearance:
       the fixed UI-Shell header + PermitHeader bar (6rem) plus the sticky step tracker
       (~4rem) — the document viewer pins at the same line.
       `:global` is REQUIRED for .pdfv (rendered by the DocumentViewer child component,
       which carries a different Astro scope id — a plain scoped selector won't match). */
    [data-version="stacked"] .step { --rsec-top: calc(6rem + 4rem); }
    [data-version="stacked"] .appreview { --rsec-sticky-top: var(--rsec-top); }
    [data-version="stacked"] .pdf-col { position: sticky; top: var(--rsec-top); align-self: start; }
    [data-version="stacked"] .step :global(.pdfv) { block-size: max(74vh, 44rem); }
    [data-version="stacked"] .step :global(.pdfv__frame) { flex: 1 1 auto; block-size: auto; min-block-size: 0; }

    /* B3 · Docked documents — SAME split as B2 (record left, grows the page; working
       panel right, sticky), except the RIGHT column is the whole dock (document
       viewer + conditions + comments + team as tabs), not just the PDF. The dock
       sits at the top of its column, so no top margin. The document-viewer tab fits
       within a sticky pin: cap the PDF at a viewport-relative height with a rem floor
       and let the frame flex to fill it. */
    [data-version="docktabs"] .step { --rsec-top: calc(6rem + 4rem); }
    [data-version="docktabs"] .dock-col { position: sticky; top: var(--rsec-top); align-self: start; }
    [data-version="docktabs"] .dock { margin-top: 0; }
    [data-version="docktabs"] .dock-doc { padding: 0; }
    [data-version="docktabs"] .step :global(.pdfv) { block-size: max(68vh, 40rem); }
    [data-version="docktabs"] .step :global(.pdfv__frame) { flex: 1 1 auto; block-size: auto; min-block-size: 0; }

    /* Specimen add/edit modal fields — same shape as the finalize wizard's dialog. */
    .spec-fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--cds-spacing-05, 1rem); }
    .spec-fields__wide { grid-column: 1 / -1; }

    /* Working panel (version B2) — stacked under the record in the left column. */
    [data-version="stacked"] .dock { margin-top: var(--cds-spacing-07, 2rem); }
    .dock { background: var(--cds-layer-01, #f4f4f4); border: 1px solid var(--cds-border-subtle-01, #e0e0e0); padding: var(--cds-spacing-06, 1.5rem); }
    /* Conditions + team use the same cds-contained-list pattern as the other layouts;
       cap them to a readable width so rows don't stretch across the full-width dock. */
    .dock-list { max-inline-size: 60rem; }
    .member__role { margin: 0.125rem 0 0; color: var(--cds-text-secondary, #525252); }
    .member__lead { color: var(--cds-text-secondary, #525252); }
    /* Comments read top-to-bottom as a thread, not a multi-column card grid; cap the
       width so lines stay readable in the full-width dock. */
    .dock-thread { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--cds-spacing-05, 1rem); max-inline-size: 48rem; }
    /* Composer sits above the thread and matches its width (not the full dock). */
    .dock-composer { display: flex; gap: var(--cds-spacing-05, 1rem); align-items: flex-end; max-inline-size: 48rem; margin-block-end: var(--cds-spacing-06, 1.5rem); }
    .dock-composer cds-textarea { display: block; }
    .mention-field { position: relative; flex: 1 1 auto; min-width: 0; }
    @media (max-width: 42rem) { .dock-composer { flex-direction: column; align-items: stretch; } }

    /* @-mention picker — a token-styled suggestion menu anchored under the composer.
       carbon-checked: Carbon ships no @-mention typeahead; this composes over the
       stock cds-textarea, styled entirely with --cds-* tokens. */
    .mention-menu {
      position: absolute; inset-inline: 0; top: calc(100% + 0.25rem); z-index: 100;
      margin: 0; padding: 0; list-style: none; max-block-size: 14rem; overflow-y: auto;
      background: var(--cds-layer-02, #fff); border: 1px solid var(--cds-border-subtle-01, #e0e0e0);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }
    .mention-menu[hidden] { display: none; }
    /* Menu items and posted mention tokens are BUILT IN JS, so they carry no Astro
       scoped-style attribute — their rules must be :global to match (same reason the
       .avatar chip lives globally). */
    :global(.mention-menu__item) {
      display: flex; flex-direction: column; gap: 0.0625rem; cursor: pointer;
      padding: var(--cds-spacing-03, 0.5rem) var(--cds-spacing-05, 1rem);
      border-block-end: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    }
    :global(.mention-menu__item:last-child) { border-block-end: none; }
    :global(.mention-menu__item.is-active),
    :global(.mention-menu__item:hover) { background: var(--cds-layer-hover-02, #e8e8e8); }
    :global(.mention-menu__name) { color: var(--cds-text-primary, #161616); font-size: 0.875rem; }
    :global(.mention-menu__detail) { color: var(--cds-text-secondary, #525252); font-size: 0.75rem; }
    /* A posted mention token. */
    :global(.mention) { color: var(--cds-link-primary, #0f62fe); font-weight: 600; }

    /* Vertical-tabs half (version E) — cds-tabs-vertical lays out the rail + panel
       (it sets .cds--css-grid itself at ≥md, so DON'T set display on .vtabs or it
       overrides that grid). Carbon spans the tab rail across the first 4 of 16
       columns; shrink those columns so the rail is a slim strip and the panel
       (cols 5→end) takes the rest. */
    @media (min-width: 42.01rem) {
      .vtabs.cds--css-grid {
        grid-template-columns: repeat(4, minmax(0, 2.5rem)) repeat(12, minmax(0, 1fr));
        /* This is a NESTED grid, so drop the page-level side margin + width cap
           that .cds--css-grid applies (it left a gap to the left of the rail). */
        padding-inline: 0;
        max-inline-size: none;
      }
    }
    /* Inset the conditions/comments panels so their content isn't flush to the
       container edges (the proposal panel stays full-bleed so the PDF fills). */
    .vtabs__pad { padding: var(--cds-spacing-06, 1.5rem); }
    .vtabs__tools { display: flex; justify-content: flex-end; margin-bottom: var(--cds-spacing-04, 0.75rem); }
    .vtabs__thread { list-style: none; margin: 0 0 var(--cds-spacing-05, 1rem); padding: 0; display: grid; gap: var(--cds-spacing-05, 1rem); }
    .vtabs__send { display: flex; justify-content: flex-end; margin-top: var(--cds-spacing-04, 0.75rem); }

    /* Condition row inside a contained-list item. */
    .cond { display: flex; gap: 0.75rem; align-items: flex-start; justify-content: space-between; inline-size: 100%; }
    .cond__body { min-inline-size: 0; }
    .cond__scope { margin: 0 0 0.125rem; color: var(--cds-text-secondary, #525252); text-transform: uppercase; }
    .cond__label { margin: 0; }
    .cond__meta { display: flex; gap: 0.25rem; align-items: center; flex-shrink: 0; }

    /* Toolbar (version A). */
    .toolbar { margin-top: var(--cds-spacing-07, 2rem); }
    .toolbar__inner { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; }
    .toolbar cds-search { max-inline-size: 26rem; flex: 1 1 18rem; }
    .toolbar__actions { display: flex; gap: 0.5rem; }

    /* Section-anchored cards (version C). */
    .secs { display: flex; flex-direction: column; gap: var(--cds-spacing-05, 1rem); }
    .sec-card { border: 1px solid var(--cds-border-subtle-01, #e0e0e0); background: var(--cds-layer-01, #f4f4f4); padding: var(--cds-spacing-05, 1rem) var(--cds-spacing-06, 1.5rem); }
    .sec-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: var(--cds-spacing-04, 0.75rem); }
    .sec-card__field { margin: 0 0 0.125rem; color: var(--cds-text-secondary, #525252); text-transform: uppercase; }
    .sec-card__value { margin: 0; }
    .pdf-quote { margin: 0 0 0.75rem; padding-inline-start: 0.75rem; border-inline-start: 2px solid var(--cds-border-strong-01, #8d8d8d); color: var(--cds-text-secondary, #525252); }

    /* Actions footer — the real wizard's footer. */
    .wiz-actions { margin-top: var(--cds-spacing-08, 2.5rem); }
    .wiz-actions__inner { display: flex; align-items: center; gap: var(--cds-spacing-03, 0.5rem); padding-top: var(--cds-spacing-05, 1rem); border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0); }
    .wiz-actions__spacer { flex: 1 1 auto; }

    .handoff { margin-top: var(--cds-spacing-05, 1rem); }
    .handoff__note { margin: 0; color: var(--cds-text-secondary, #525252); }

    /* Fixed comments FAB — carbon-checked: positioning host for a stock cds-button
       (no Carbon floating-action container), copied from final-letter.astro. */
    .comments-fab {
      position: fixed; right: var(--cds-spacing-05, 1rem); bottom: var(--cds-spacing-05, 1rem);
      z-index: 8000; background: var(--cds-layer-01, #f4f4f4);
      border: 1px solid var(--cds-border-subtle-01, #e0e0e0); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
