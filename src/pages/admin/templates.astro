  /* Banner sits flush at top; body opens below it. Matches users.astro. */
  .page {
    padding-block: 0 6rem;
  }
  .body {
    margin-top: var(--cds-spacing-07, 2rem);
  }
  .console {
    max-width: 60rem;
  }
  #denied[hidden] { display: none; }
  #console[hidden] { display: none; }

  /* One long page: generous separation between stacked config sections. */
  .settings-block + .settings-block {
    margin-top: var(--cds-spacing-10, 4rem);
  }

  /* carbon-checked: fixed-position stacking host for stock cds-toast-notification
     elements (Carbon ships no toast positioning container; same as apply.astro). */
  .toast-host {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 9000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-hint {
    margin: 0 0 1.5rem;
    max-width: 46rem;
    color: var(--cds-text-secondary, #525252);
  }

  /* Regulated-forms table cells. */
  .doc-name { display: block; font-weight: 600; }
  .doc-desc { display: block; color: var(--cds-text-secondary, #525252); }
  .doc-file { word-break: break-all; }

  /* Read-view fact list (letterhead / defaults). */
  .facts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    max-width: 40rem;
  }
  .fact dt { color: var(--cds-text-secondary, #525252); margin-bottom: 0.25rem; }
  .fact dd { margin: 0; }
  #lh-read[hidden], #pd-read[hidden] { display: none; }

  /* Letterhead live preview — the masthead as it prints on the permit letter. */
  .lh-preview {
    margin: 0 0 2rem;
    max-width: 40rem;
  }
  .lh-preview__cap {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--cds-text-secondary, #525252);
  }
  .lh-preview__sheet {
    background: var(--cds-layer-01, #f4f4f4);
    border: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    padding: 1.5rem 1.75rem;
    border-bottom: 2px solid var(--cds-border-strong-01, #8d8d8d);
  }
  .lh-preview__sheet p { margin: 0; }
  .lh-preview__dept {
    margin: 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Edit form: stacked inputs with an action row. */
  .edit-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 32rem;
  }
  .edit-form[hidden] { display: none; }
  .pd-preview { margin: 0; color: var(--cds-text-secondary, #525252); }
  .edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }

  /* Notification cards. */
  .notif-list { display: flex; flex-direction: column; gap: 1.5rem; max-width: 46rem; }
  .notif {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    background: var(--cds-layer-01, #f4f4f4);
  }
  .notif__head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .notif__name { margin: 0; }
  .notif__k { color: var(--cds-text-secondary, #525252); margin-right: 0.5rem; }
  .notif__subject { margin: 0.75rem 0 0.5rem; }
  /* Keep line breaks from the copy, but clamp the card to a compact preview —
     the full body is editable in the modal. */
  .notif__body {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .uploader-hint { margin: 0.5rem 0 0; color: var(--cds-text-secondary, #525252); }
  .uploaded-list { margin-top: 0.75rem; }
  #rm-error { margin-top: 1rem; }
  #rm-error[hidden] { display: none; }
  .modal-hint { margin: 0 0 1.5rem; }
  .nm-body-wrap { margin-top: 1.25rem; }
  /* The editor isn't a native field, so its label is a plain span — match the
     spacing cds-* fields put between their label and control. */
