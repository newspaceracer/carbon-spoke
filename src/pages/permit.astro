</style>

<style>
  /* Page-level LAYOUT only — component look lives in cds-* legos + --cds-* tokens.
     body already offsets the fixed ui-shell header (theme.css padding-top). */
  /* Width + horizontal margins owned by the 2x Grid (.cds--css-grid on each
     panel + the full-bleed banner). This wrapper sets only vertical padding. */
  .page {
    padding-block: 1.5rem 6rem;
  }

  /* Sticky tab strip: pins at 6rem = the fixed UI-Shell header (3rem) + the
     compact header bar (3rem), so it lands flush beneath the compact bar once the
     full header has scrolled away. Its opaque full-bleed background (page bg)
     covers panel content scrolling underneath; the inner grid re-centers. z-index
     sits below the compact bar (95) and the UI-Shell header. */
  .tabbar {
    position: sticky;
    top: calc(var(--cds-spacing-09, 3rem) * 2);
    z-index: 90;
    background: var(--cds-background, #f4f4f4);
    padding-top: var(--cds-spacing-05, 1rem);
  }

  .panels { margin-top: 1.5rem; }
  /* Contents rails (Application, Special conditions) pin below the sticky tab strip
     (6rem header + compact bar, plus the ~4rem strip). */
  .sc-rail__sticky,
  .app-rail__sticky { position: sticky; top: 10rem; }
  /* A contents-rail jump lands the section below the sticky page chrome. */
  .app-anchor { scroll-margin-block-start: 10rem; }
  /* Panels are now .cds--css-grid (display:grid), whose author rule would
     override the [hidden] attribute's UA `display:none` — re-assert hiding so
     the tab script's p.hidden toggle still switches panels. Higher specificity
     than .cds--css-grid, so it wins. */
  .panel[hidden] { display: none; }

  /* Each tab stacks raised panels (ReviewSection `panel`) on the g10 field — the
     same read as the review wizard's record. The gutter between panels is the
     grid's own gap; .stack outranks .app-review's editorial gap. */
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--cds-spacing-05, 1rem);
  }
  /* Overview: main content column + Application-history rail, laid out on
     Carbon's 2x Grid (.cds--css-grid). Main spans 11 of 16 columns at lg, the
     rail 5; both go full-width and stack at md/sm. Only the main column's
     internal section rhythm below is bespoke — the columns are Carbon's. */
  .overview-main {
    display: flex;
    flex-direction: column;
    gap: var(--cds-spacing-05, 1rem);
    min-width: 0;
  }

  /* Sub-heading under the Schedule calendar. */
  .subhead {
    margin: 1.5rem 0 0.75rem;
  }

  /* Permit tags — a multi-select control above the applied dismissible tags.
     Layout only; the field and tags are Carbon legos. */
  .tagger {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 34rem;
  }
  .tagger__select {
    max-width: 24rem;
  }
  .tagger__applied {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .tagger__empty {
    margin: 0;
    color: var(--cds-text-secondary, #525252);
  }


  /* Overview rail tile: Analysis team / Application history as tabs inside a
     single cds-tile. The tab strip sits at the tile's top; each panel below is
     toggled by the page script. Author reset beats UA [hidden] on a div, so
     restate the collapse. */
  .rail-tabs { margin-bottom: 1.5rem; }
  .rail-panel[hidden] { display: none; }
  /* Analysis-team panel header: the internal-only flag, pushed to the right edge
     across the full width of the panel. */
  .rail-panel__head {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  /* Application history — phases (Presubmittal, In review, …), each a labeled
     group with its own vertical cds-progress-indicator. Layout/spacing only;
     the step rail, dots, and states are Carbon's. */
  .phases {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .phase__title { margin: 0 0 0.75rem; }

  /* Comment composer — avatar beside a stock cds-textarea, action flush-right.
     Layout only; the field + button are Carbon legos. Capped to a readable measure
     so comment lines don't stretch the full 11-column span. */
  .composer {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    max-width: 44rem;
  }
  .composer__field { flex: 1 1 auto; min-width: 0; }
  .composer__actions { display: flex; justify-content: flex-end; margin-top: 0.5rem; }

  /* @-mention typeahead — the menu anchors to the field; its items and the
     in-thread .mention tokens are DOM-built at runtime, so they need :global to
     escape Astro's scoping. Mirrors the review wizard (final-letter). */
  .mention-field { position: relative; }
  .mention-field cds-textarea { display: block; inline-size: 100%; }
  .mention-menu {
    position: absolute; inset-inline: 0; top: calc(100% + 0.25rem); z-index: 100;
    margin: 0; padding: 0; list-style: none; max-block-size: 14rem; overflow-y: auto;
    background: var(--cds-layer-02, #fff); border: 1px solid var(--cds-border-subtle-01, #e0e0e0);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  .mention-menu[hidden] { display: none; }
  :global(.mention-menu__item) {
    display: flex; flex-direction: column; gap: 0.0625rem; cursor: pointer;
    padding: var(--cds-spacing-03, 0.5rem) var(--cds-spacing-05, 1rem);
    border-block-end: 1px solid var(--cds-border-subtle-01, #e0e0e0);
  }
  :global(.mention-menu__item:last-child) { border-block-end: none; }
  :global(.mention-menu__item.is-active), :global(.mention-menu__item:hover) { background: var(--cds-layer-hover-02, #e8e8e8); }
  :global(.mention-menu__name) { color: var(--cds-text-primary, #161616); font-size: 0.875rem; }
  :global(.mention-menu__detail) { color: var(--cds-text-secondary, #525252); font-size: 0.75rem; }
  :global(.mention) { color: var(--cds-link-primary, #0f62fe); font-weight: 600; }

  /* Comment thread. */
  .thread { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; max-width: 44rem; }
  .comment { display: flex; gap: 0.75rem; }
  .comment__body { min-width: 0; }
  .comment__meta { margin: 0 0 0.25rem; color: var(--cds-text-secondary, #525252); }
  .comment__author { font-weight: 600; color: var(--cds-text-primary, #161616); }
  .comment__text { margin: 0; }

  /* Anchored comments (?comments=anchored) — layout only; controls are cds-*.
     A section's thread sits on the next layer up, directly under its head, so it
     reads as "about this section" without competing with the content. Inside a
     raised panel, --cds-layer resolves to the panel's next layer (gray on white). */
  .sec-thread {
    display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;
    margin-block-end: 1.5rem; padding: 1rem;
    background: var(--cds-layer, var(--cds-layer-01, #f4f4f4));
  }
  .sec-thread[hidden] { display: none; }
  .sec-thread .thread[hidden] { display: none; }
  .sec-thread__empty { margin: 0; color: var(--cds-text-secondary, #525252); }
  .sec-thread__empty[hidden] { display: none; }
  .sec-thread__list--resolved { opacity: 0.75; }
  .sec-thread__composer { inline-size: 100%; max-inline-size: 44rem; }
  .comment__replies {
    list-style: none; margin: 0.5rem 0 0; padding-inline-start: 0.75rem;
    border-inline-start: 2px solid var(--cds-border-subtle-01, #e0e0e0);
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .comment__actions { margin-block-start: 0.25rem; margin-inline-start: -1rem; }

  /* Header comments panel: wider than the 16rem default so threads stay legible. */
  .comments-panel[expanded] { inline-size: min(26rem, 100vw); }
  /* A jump from the panel lands the section below the sticky header + tab strip. */
  :global([data-comment-section]) { scroll-margin-block-start: 10rem; }
  .comments-panel__inner {
    block-size: 100%; overflow-y: auto; padding: 1rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .comments-panel__title, .comments-panel__summary { margin: 0; }
  .comments-panel__summary { color: var(--cds-text-secondary, #525252); }
  .comments-panel__groups { display: flex; flex-direction: column; gap: 1rem; }
  :global(.comments-panel__text) { color: var(--cds-text-secondary, #525252); }
  .comments-panel__general { border-block-start: 1px solid var(--cds-border-subtle-01, #e0e0e0); padding-block-start: 1rem; }


  /* Section intro line above a list/table. */
  .section-hint {
    margin: 0 0 1rem;
    max-width: 44rem;
    color: var(--cds-text-secondary, #525252);
  }
  /* Authorized parks — ONE table, one row per park unit: district, district
     contact, park unit, park contact. A contact cell stacks each person as a name
     over a mailto link + copy button. Rows are re-rendered client-side from the
     recorded contacts, so descendants are matched with :global() (injected nodes
     carry no scope attribute). */
  #study-area-list :global(.contact-cell__person) { display: block; }
  #study-area-list :global(.contact-cell__person + .contact-cell__person) { margin-top: 0.5rem; }
  #study-area-list :global(.contact-cell__name) { display: block; }
  #study-area-list :global(.contact-cell__email) {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    max-width: 100%;
  }
  #study-area-list :global(.contact-cell__none) { color: var(--cds-text-secondary, #525252); }
  /* The merged district cells sit at the TOP of their group rather than centred on
     it — with an uneven number of parks a centred cell drifts away from the
     district's first row and reads as belonging to whichever row it lands beside. */
  #study-area-list :global(.sa-cell--district),
  #study-area-list :global(.sa-cell--district + .contact-cell) { vertical-align: top; }
  /* A district's merged cells stop the row rule from crossing them, so each group
     reads as one block; a stronger rule opens each group after the first. */
  #study-area-list :global(.sa-group + .sa-group .sa-row:first-child > *) {
    border-top: 1px solid var(--cds-border-strong-01, #8d8d8d);
  }
  /* Row hover + merged cells. Carbon paints the hovered <tr>, which can't express
     a merged cell: the district's cells are children of the group's FIRST row, so
     every hover mapped wrong. Two rules restore the true relationship, which runs
     BOTH ways — a park row depends on its district cells, and a district cell
     covers every row it spans.

     (a) Hovering a PARK row also paints that group's merged cells. Row one needs
     `:hover` (Carbon paints the row, but the district <th> has its own opaque
     background on top, so the row paint never reaches it); later rows need `~`,
     which can't escape the group's own <tbody>. */
  #study-area-list :global(.sa-group > .sa-row:first-child:is(:hover, :has(~ .sa-row:hover)) > [rowspan]) {
    background-color: var(--cds-layer-hover, #e8e8e8);
  }
  /* (b) Hovering a MERGED cell paints the whole district group. Without this,
     Carbon's tr:hover fires on row one alone — because that's the row the merged
     cell is parented to — so pointing at the district contact highlighted the
     FIRST park unit, re-implying the exact pairing the rowspan exists to deny. */
  #study-area-list :global(.sa-group:has(> .sa-row > [rowspan]:hover) > .sa-row > *) {
    background-color: var(--cds-layer-hover, #e8e8e8);
  }
  /* No overflow rule here on purpose. The table has NO fixed height — it sizes to
     its content — and the wrapper's `.cds--data-table-content` (Carbon's own class)
     already carries `overflow-x: auto`, so it scrolls sideways only when a narrow
     viewport genuinely can't fit the four columns, and the page never scrolls
     horizontally instead. The copy-button tooltips are `autoalign`ed
     (see lib/contact-cell.ts) so they float OVER this wrapper rather than
     extending its scroll area — note `overflow-x: auto` alone makes the wrapper a
     scroll container on BOTH axes, since a non-visible value on one axis computes
     the other to `auto`. That's what made hovering a button scroll the section. */

  /* Special conditions — read-only (rendered by PermitConditions). */
  #sc-locked-notice[hidden] { display: none; }

  /* Field-investigation dates — constrain the contained list to a readable
     column width; the list itself is styled by Carbon tokens. */
  .field-dates {
    max-width: 28rem;
  }
</style>
