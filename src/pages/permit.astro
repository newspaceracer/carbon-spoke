---
/* manifest:
     shell:  cds-header (ui-shell)  — name + nav + Admin tools menu + cds-search
             + profile/logout global actions
     spine:  main.page > cds-stack(gap 6)
     READ-ONLY. Every section inside a tab is a raised panel (ReviewSection `panel`:
     layer-01 on the g10 field, title + the section's own classification tags and
     compliance flags in its head, content one layer deeper) — the same read as the
     review wizard's application record. The four record tabs compose the SHARED
     section components (src/components/application/*) read-only, so the detail
     and the wizard can't drift; editing lives in the wizard (Start / Open review).
     One read rule: short facts and yes/no answers are tiles, people are contact
     cards, collections are tables, narrative is prose. cds-tag only for genuine
     classifications.
     sections:
       - breadcrumb    -> cds-breadcrumb  (Permits / 26-635-017)
       - permit header -> PermitHeader.astro  (title, status indicator, actions,
                          classification badges, at-a-glance labeled fact row)
       - tabs          -> cds-tabs + cds-tab x6, panels toggled on cds-tabs-selected
           overview      -> Tags, Supporting review, Comments (thread) panels +
                            rail cds-tile (Analysis team / Application history)
           project info  -> ProjectInfoSection (narratives + requested-date tiles),
                            ResearchTeamSection (contact cds-tiles + participants
                            cds-table + coverage tile), Schedule (calendar + list)
           study areas   -> StudyAreasSection chrome around the merged-cell
                            parks-and-contacts table (the detail's own body)
           special cond. -> one panel around the shared PermitConditions
           data collect. -> DataCollectionSection (gate + facts as tiles, facility
                            contacts as cards, specimens cds-table)
           add. docs     -> AdditionalDocsSection (Compliance tiles; files
                            cds-table + Download all; inline DocumentViewer — View
                            / "View CV" / proposal links open the file in place)
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PermitNav from '../components/PermitNav.astro';
import PermitHeader from '../components/PermitHeader.astro';
import ReviewSection from '../components/ReviewSection.astro';
import ProjectInfoSection from '../components/application/ProjectInfoSection.astro';
import ResearchTeamSection from '../components/application/ResearchTeamSection.astro';
import StudyAreasSection from '../components/application/StudyAreasSection.astro';
import DataCollectionSection from '../components/application/DataCollectionSection.astro';
import AdditionalDocsSection from '../components/application/AdditionalDocsSection.astro';
import Avatar from '../components/Avatar.astro';
import AnalysisTeam from '../components/AnalysisTeam.astro';
import InternalOnlyFlag from '../components/InternalOnlyFlag.astro';
import PermitCalendar from '../components/PermitCalendar.astro';
import PermitConditions from '../components/PermitConditions.astro';
import RecordToc from '../components/record/RecordToc.astro';
import ResearcherOverview from '../components/ResearcherOverview.astro';
import ReportObligation from '../components/ReportObligation.astro';
import RecordLetter from '../components/record/RecordLetter.astro';
import RecordReport from '../components/record/RecordReport.astro';
import { permit, permitInfoTags, badgesForSection } from '../data/permit';
import { userDirectory, findUser } from '../data/user';
import { district as districtRecord } from '../data/district';
import { parkKey } from '../data/parks';
import { districtKey } from '../data/conditions';
import { contactCellHtml, dedupeContacts } from '../lib/contact-cell';
import '../styles/application-record.css';

export const prototype = {
  title: 'Permit detail',
  summary:
    'A reviewer opens a single scientific research & collection permit — status, ' +
    'requested dates, at-a-glance flags — and works through six tabbed sections.',
  tag: 'Internal tool',
};

const tabs = [
  { value: 'overview', label: 'Overview' },
  { value: 'application', label: 'Application' },
  { value: 'special-conditions', label: 'Special conditions' },
  // Gated: shown client-side only when they apply (see gateRecordTabs) — the
  // letter once it's out for signature, the report once one is on file.
  { value: 'letter', label: 'Final permit letter', gate: 'letter' },
  { value: 'report', label: 'Final report', gate: 'report' },
] as { value: string; label: string; gate?: string }[];

// Application tab contents rail — one entry per section on the scroll, with the
// section's compliance-flag count (same as the one-scroll record's rail).
const applicationTocItems = [
  { id: 'project-information', label: 'Project information', flags: badgesForSection('project').flags.length },
  { id: 'research-team', label: 'Research team', flags: badgesForSection('team').flags.length },
  { id: 'schedule', label: 'Schedule' },
  { id: 'study-areas', label: 'Authorized parks', flags: badgesForSection('study').flags.length },
  { id: 'data-collection', label: 'Data collection', flags: badgesForSection('data').flags.length },
  { id: 'additional-documents', label: 'Additional documentation', flags: badgesForSection('docs').flags.length },
];

// Responsible analyst = the lead/highlighted member of the analysis team (the
// "responsible agent" in the history). Derived from the same roster so they agree.
const responsibleAnalyst = permit.overview.analysisTeam.find((m) => m.highlight);

const stats = [
  { label: 'Requested window', value: `${permit.activeWindow.start} – ${permit.activeWindow.end}` },
  { label: 'Submitted', value: 'Jul 9, 2026' },
  { label: 'Responsible analyst', value: responsibleAnalyst?.name ?? '—' },
];

// A permit's type is its district span: multi-district when its parks span more
// than one district. Derived here (a stored field in Story 8); surfaced on the
// header banner so the dev permit-role control can constrain its options.
const permitType: 'single' | 'multi' =
  permit.studyAreas.districts.length > 1 ? 'multi' : 'single';

// Special-conditions contents rail: every owner that COULD hold conditions (HQ +
// the permit's districts). The client reorders for the reader, fills the counts,
// and drops owners with none — see the conditions-rail script.
const conditionOwnerItems = [
  { id: 'conditions-hq', label: 'Headquarters', count: null },
  ...permit.studyAreas.districts.map((d) => ({ id: `conditions-${districtKey(d.name)}`, label: d.name, count: null })),
];


// The signed-in reviewer (the highlighted analysis-team member) authors new comments.
const currentUser = permit.overview.analysisTeam.find((m) => m.highlight)?.name ?? 'You';

// Permit tags: applied from a curated set on the Overview tab. `appliedTags` seeds
// the row + the multi-select's selected state; edits persist per permit.
const appliedTags = permit.overview.tagOptions.filter((t) => permit.overview.tags.includes(t));
const tagStorageKey = `permit-tags-${permit.id}`;

const t = permit.researchTeam;

// Story 11 — researcher record scoping. A Researcher may reach this permit only if
// they are its submitter, principal investigator, or field lead (PICOF). These are
// the owner identifiers the client matches the active researcher identity against.
const ownerIdentifiers = [t.submitter, t.principalInvestigator, t.fieldLead]
  .flatMap((c) => [c?.name, c?.email])
  .filter(Boolean)
  .map((s) => (s as string).toLowerCase());

// ── Study-area district contacts ─────────────────────────────────────────────
// The contact shown for each authorized park MIRRORS what the review team
// recorded on step ② of the finalize wizard (final-letter.astro) — the district
// contact is assigned per park, so the same person may cover the whole district
// or just specific parks. Same model as the wizard: a flat per-district list of
// { person, scope } entries (scope null = covers all the district's parks,
// string[] = only those). Seeded here the same way the wizard seeds (district
// lead as an all-parks contact + any published park-specialists whose parks are
// on the permit), then HYDRATED client-side from the persisted
// `permit-final-${id}.contacts` so the detail page and the letter never disagree.
type ContactPerson = {
  id: string; name: string; email: string; phone: string;
  published: boolean; scopeParks?: string[] | null;
};
const districtRecords = [districtRecord];
const recordFor = (name: string) => districtRecords.find((r) => r.name === name) ?? null;

const buildDistrictContacts = (d: (typeof permit.studyAreas.districts)[number]) => {
  const rec = recordFor(d.name);
  const coordPerson: ContactPerson = {
    id: `coord-${d.name}`, name: d.coordinator.name,
    email: d.coordinator.email ?? '', phone: d.coordinator.phone ?? '', published: false,
  };
  let pool: ContactPerson[];
  let defaultPrimaryId: string;
  if (rec) {
    pool = rec.members.map((m) => {
      const u = findUser(m.userId);
      return {
        id: m.userId, name: u?.name ?? m.userId, email: u?.email ?? '', phone: u?.phone ?? '',
        published: m.published,
        scopeParks: m.autoAssign.mode === 'all' ? null
          : m.autoAssign.mode === 'specific' ? m.autoAssign.parks : undefined,
      };
    });
    const lead = rec.members.find((m) => m.role === 'district-lead');
    defaultPrimaryId = lead ? lead.userId : coordPerson.id;
  } else {
    // No populated member record — fall back to the affiliation-tagged directory
    // so every study-area district still resolves a real contact list.
    const affUsers = userDirectory.filter((u) => u.detail === d.name);
    pool = affUsers.map((u) => ({
      id: u.id, name: u.name, email: u.email, phone: '', published: true, scopeParks: undefined,
    }));
    defaultPrimaryId =
      (affUsers.find((u) => /superintendent/i.test(u.role)) ?? affUsers[0])?.id ?? coordPerson.id;
  }
  if (!pool.some((c) => c.email && c.email === coordPerson.email)) pool = [...pool, coordPerson];
  return { pool, defaultPrimaryId };
};

// Seed a district's contact entries the same way the wizard does: the lead as an
// all-parks contact + published park-specialists whose parks are on the permit.
type ContactEntry = { person: string; scope: string[] | null };
const seedContacts = (
  pool: ContactPerson[], defaultPrimaryId: string, parkList: string[],
): ContactEntry[] => {
  const out: ContactEntry[] = [];
  if (pool.some((c) => c.id === defaultPrimaryId)) out.push({ person: defaultPrimaryId, scope: null });
  pool.forEach((c) => {
    if (c.id === defaultPrimaryId || !c.published || c.scopeParks === undefined) return;
    if (c.scopeParks === null) { out.push({ person: c.id, scope: null }); return; }
    const covered = parkList.filter((p) => c.scopeParks!.some((sp) => parkKey(sp) === parkKey(p)));
    if (covered.length) out.push({ person: c.id, scope: covered });
  });
  return out;
};

// Per district: the resolved pool + the seed contact entries, split for the
// Authorized-parks TABLE — one row per park unit, carrying its district, the
// district-wide contact(s) (scope null), and only that park's OWN park-scoped
// contact (assigned during the finalize wizard). The district cells print once
// per district group; continuation rows repeat the name to screen readers only.
// The client re-hydrates the same rows from localStorage.
const dedupePeople = (arr: (ContactPerson | null)[]) => dedupeContacts(arr) as ContactPerson[];
const studyAreaDistricts = permit.studyAreas.districts.map((d) => {
  const { pool, defaultPrimaryId } = buildDistrictContacts(d);
  const seed = seedContacts(pool, defaultPrimaryId, d.parks);
  const personOf = (id: string) => pool.find((c) => c.id === id) ?? null;
  // District-wide contacts cover every park in the district (scope null).
  const districtContacts = dedupePeople(
    seed.filter((e) => e.scope === null).map((e) => personOf(e.person)),
  );
  // A park's own contact is any scoped entry naming that park (a unique park
  // contact — e.g. one added during the final-letter phase).
  const parkContactsFor = (park: string) =>
    dedupePeople(
      seed
        .filter((e) => e.scope !== null && e.scope.some((sp) => parkKey(sp) === parkKey(park)))
        .map((e) => personOf(e.person)),
    );
  return {
    name: d.name,
    districtContacts,
    parks: d.parks.map((park) => ({ name: park, contacts: parkContactsFor(park) })),
    pool,
    defaultPrimaryId,
    seed,
  };
});
// Table groups: one row per park unit, with the district name and its contact(s)
// in cells that ROWSPAN the whole district — so the district contact visibly
// covers every park in its group rather than looking attached to the first row.
const NO_DISTRICT_CONTACT =
  '<span class="contact-cell__none t-body-01">No contact assigned</span>';
const studyAreaGroups = studyAreaDistricts.map((d) => ({
  district: d.name,
  span: Math.max(d.parks.length, 1),
  districtCell: contactCellHtml(d.districtContacts, NO_DISTRICT_CONTACT),
  // No park-specific contact → the cell stays blank; the district contact spanning
  // the group already covers that park.
  parks: d.parks.map((p) => ({ name: p.name, parkCell: contactCellHtml(p.contacts) })),
}));

// Client hydration payload: per district, its resolved pool + seed entries so the
// script can re-resolve recorded contacts (person ids) to names/emails per park.
const studyAreaContactModel = studyAreaDistricts.map((d) => ({
  name: d.name,
  pool: d.pool.map((c) => ({ id: c.id, name: c.name, email: c.email })),
  seed: d.seed,
  parks: permit.studyAreas.districts.find((x) => x.name === d.name)!.parks,
}));
---

<BaseLayout title={`${permit.id} — ${permit.name}`}>
  <PermitNav slot="nav">
    <!-- Anchored-comments version (?comments=anchored): a stock UI Shell header
         action with an open-comment count that toggles a cds-header-panel listing
         every thread, grouped by the section it's about. Hidden (inline display —
         it sets :host display) unless the flag is on. Wrapped in a Fragment so the
         slot routing doesn't leave a slot="actions" attribute on the elements
         (cds-header has no such slot, so they'd never render). -->
    <Fragment slot="actions">
    <cds-header-global-action id="comments-global" aria-label="Comments" tooltip-text="Comments" panel-id="comments-panel" style="display:none">
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.74,30,16,29l4-7h6a2,2,0,0,0,2-2V8a2,2,0,0,0-2-2H6A2,2,0,0,0,4,8V20a2,2,0,0,0,2,2h9v2H6a4,4,0,0,1-4-4V8A4,4,0,0,1,6,4H26a4,4,0,0,1,4,4V20a4,4,0,0,1-4,4H21.16Z"/><path d="M8 10H24V12H8z"/><path d="M8 16H18V18H8z"/></svg>
      <cds-badge-indicator id="comments-global-count" count="0"></cds-badge-indicator>
    </cds-header-global-action>
    <cds-header-panel id="comments-panel" class="comments-panel" aria-label="Comments" style="display:none">
      <div class="comments-panel__inner">
        <h2 class="comments-panel__title t-heading-03">Comments</h2>
        <p class="comments-panel__summary t-body-01" id="comments-panel-summary"></p>
        <div id="comments-panel-groups" class="comments-panel__groups"></div>
        <!-- General comments: not about one section. The panel is their home. -->
        <div class="comments-panel__general">
          <div class="mention-field">
            <cds-textarea id="general-comment-input" label="General comment" placeholder="Not about one section? Comment here… type @ to mention someone" rows="2"></cds-textarea>
            <ul id="general-comment-menu" class="mention-menu" role="listbox" aria-label="Mention a user" hidden></ul>
          </div>
          <div class="composer__actions">
            <cds-button id="general-comment-submit" size="sm" type="button">Comment</cds-button>
          </div>
        </div>
      </div>
    </cds-header-panel>
    </Fragment>
  </PermitNav>

  <main class="page">
    <!-- No-flash: set the review-started class on <html> synchronously, before
         paint, so a permit already in review shows its detail immediately and
         never flashes the gate. localStorage isn't available at SSR, so this
         reconciles it client-side ahead of the deferred module scripts. -->
    <script is:inline define:vars={{ rsKey: `permit-review-started-${permit.id}`, stKey: `permit-status-${permit.id}`, seedStatus: permit.status.label }}>
      try {
        // The "Start review" gate belongs ONLY to "Waiting for review". Reveal the
        // body when the review-started flag is set OR the permit is already past
        // Waiting for review — so status and the gate can never disagree (a permit
        // that is Under review must never show the "Start the review" prompt).
        var status = localStorage.getItem(stKey) || seedStatus;
        if (localStorage.getItem(rsKey) || (status && status !== 'Waiting for review')) {
          document.documentElement.classList.add('review-started');
        }
      } catch (e) {}
    </script>
    <script type="application/json" id="permit-owners" set:html={JSON.stringify(ownerIdentifiers)}></script>

    <!-- Public view banner (Story 12) — revealed by the client for a public viewer
         of an Active/Expired permit; the record shows summary fields only, no PII. -->
    <cds-inline-notification
      id="public-view-banner"
      style="display:none"
      kind="info"
      low-contrast
      hide-close-button
      title="Public view"
      subtitle="This is the public summary of an issued research permit. Personal details and internal review information are not shown."
    ></cds-inline-notification>
    <cds-stack gap="6">
      <PermitHeader
        id={permit.id}
        name={permit.name}
        organization={permit.researchTeam.organization.name}
        status={permit.status}
        infoTags={permitInfoTags}
        flagTags={permit.flagTags}
        stats={stats}
        requestedWindow={permit.activeWindow}
        permitType={permitType}
        analysisTeam={permit.overview.analysisTeam}
        directory={userDirectory}
      >
        <cds-breadcrumb slot="breadcrumb" no-trailing-slash>
          <cds-breadcrumb-item>
            <cds-breadcrumb-link href="#">Permits</cds-breadcrumb-link>
          </cds-breadcrumb-item>
          <cds-breadcrumb-item>
            <cds-breadcrumb-link aria-current="page">{permit.id}</cds-breadcrumb-link>
          </cds-breadcrumb-item>
        </cds-breadcrumb>

      </PermitHeader>

      <!-- Changes requested (researcher owner, application returned) — revealed by the
           client: how many changes the review team asked for, and the way into the
           revise flow, where each change is shown on the page it's about. -->
      <div class="cds--css-grid" id="changes-requested-row" style="display:none">
        <div class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16">
          <cds-actionable-notification
            id="changes-requested-banner"
            style="display:none"
            kind="warning"
            low-contrast
            inline
            hide-close-button
            title="Changes requested"
            subtitle=""
          >
            <cds-actionable-notification-button slot="action" id="changes-requested-go">Review requested changes</cds-actionable-notification-button>
          </cds-actionable-notification>
        </div>
      </div>

      <!-- Amendment link — revealed by the client script only once an amendment has
           been started from this permit. Names the amendment and links to it, so the
           relationship is traceable from the original, not just from the amendment. -->
      <cds-actionable-notification
        id="amend-notice"
        class="amend-notice"
        kind="info"
        low-contrast
        hide-close-button
        hidden
      >
        <span slot="title">Amendment in progress</span>
        <span slot="subtitle" id="amend-notice-text"></span>
        <cds-actionable-notification-button id="amend-notice-btn" href="#">
          View amendment
        </cds-actionable-notification-button>
      </cds-actionable-notification>

      <!-- carbon-checked: .tabbar is NOT a tab component — the tabs are the stock
           cds-tabs/cds-tab below. It is only a full-bleed STICKY background layer
           that pins the tab strip below the compact header bar and gives it an
           opaque backdrop over scrolling panel content; no cds-* component provides
           a page-level sticky background band. -->
      <div class="tabbar">
        <div class="cds--css-grid">
          <cds-tabs class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16" id="permit-tabs" value="overview">
            {tabs.map((tab) => (
              <cds-tab id={`tab-${tab.value}`} value={tab.value} data-gate={tab.gate} style={tab.gate ? 'display:none' : undefined}>{tab.label}</cds-tab>
            ))}
          </cds-tabs>
        </div>
      </div>

      <section>
        <div class="panels">
          <!-- ── Overview ─────────────────────────────────────────────── -->
          <div class="panel" data-panel="overview" role="tabpanel" aria-labelledby="tab-overview">
            <div class="cds--css-grid cds--css-grid--with-row-gap">
              <div class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-11 overview-main">
              <!-- Researcher owner's Overview (stage lead, final report, needs your
                   action, the permit's facts). Hidden for staff — revealed by the
                   viewer-class script for an owner. -->
              <ResearcherOverview />
              <!-- Staff: the final report obligation (overdue → lift/restore the
                   renewal block). Hidden for non-staff and before it applies. -->
              <ReportObligation />
              <!-- Start-review prompt — the application is fully browsable, but until
                   review is formally started the reviewer is prompted here to begin
                   (which records when review actually started). Hidden once started
                   via the .review-started class the head script sets pre-paint.
                   Reuses the .permit-start-review handler wired in PermitHeader. -->
              <cds-actionable-notification
                id="start-review-prompt"
                class="start-review-prompt"
                kind="info"
                low-contrast
                hide-close-button
              >
                <span slot="title">Start your review</span>
                <span slot="subtitle">You can browse the whole application now. Starting records when your review began — the application stays exactly as the applicant filed it.</span>
                <cds-actionable-notification-button class="permit-start-review" slot="action">Start review</cds-actionable-notification-button>
              </cds-actionable-notification>

              <ReviewSection title="Tags" panel>
                <InternalOnlyFlag slot="aside" />
                <p class="section-hint t-body-01">Internal labels for triage and coordination, separate from the permit's classification badges. Pick from the set; applied tags appear below and can be removed.</p>
                <div class="tagger">
                  <cds-multi-select
                    id="permit-tag-select"
                    class="tagger__select"
                    filterable
                    title-text="Choose tags"
                    label="Search tags…"
                    value={appliedTags.join(',')}
                  >
                    {/* Selection is driven by the parent multi-select's `value`
                        (the component reconciles each item on first render), so
                        items carry no per-item `selected` — avoids Astro emitting
                        a stringy selected="false" that Lit would read as truthy. */}
                    {[...permit.overview.tagOptions].sort((a, b) => a.localeCompare(b)).map((tag) => (
                      <cds-multi-select-item value={tag}>{tag}</cds-multi-select-item>
                    ))}
                  </cds-multi-select>
                  <div class="tagger__applied" id="permit-tag-row" data-storage-key={tagStorageKey} aria-label="Applied tags">
                    {appliedTags.map((tag) => (
                      <cds-dismissible-tag type="cool-gray" size="md" text={tag} data-tag={tag}></cds-dismissible-tag>
                    ))}
                  </div>
                  <p class="tagger__empty t-body-01" id="permit-tag-empty" hidden>No tags applied.</p>
                </div>
              </ReviewSection>

              <!-- Supporting review (Story 10). An informational action shown only
                   to a Supporting Agent during Under review — it records their review
                   without gating the Responsible Agent's decision. Hidden for everyone
                   else (client-gated by the IR matrix: supporting-review). -->
              <div id="supporting-review-section" hidden>
                <ReviewSection title="Supporting review" panel>
                  <p class="section-hint t-body-01" id="sr-hint">Record your supporting review. This is informational — it doesn't hold up the Responsible Agent's decision.</p>
                  <div class="sr-row">
                    <cds-tag id="sr-status-tag" type="cool-gray" size="md">Not started</cds-tag>
                    <cds-button id="sr-action" kind="tertiary" size="md" type="button">Start supporting review</cds-button>
                  </div>
                </ReviewSection>
              </div>

              <ReviewSection title="Comments" panel>
                <InternalOnlyFlag slot="aside" />
                <!-- Composer: stock cds-textarea + cds-button, with the SAME @-mention
                     typeahead as the review wizard (shared src/lib/comment-mentions).
                     New comments are authored by the signed-in reviewer, persisted
                     client-side under the permit-comments-${id} key the wizard shares. -->
                <form
                  class="composer"
                  id="comment-composer"
                  data-author={currentUser}
                  data-storage-key={`permit-comments-${permit.id}`}
                >
                  <Avatar name={currentUser} size="sm" />
                  <div class="composer__field">
                    <div class="mention-field">
                      <cds-textarea
                        id="comment-input"
                        label="Add a comment"
                        placeholder="Note something for the team… type @ to mention someone (⌘/Ctrl+Enter to post)"
                        rows="2"
                      ></cds-textarea>
                      <ul id="comment-mention-menu" class="mention-menu" role="listbox" aria-label="Mention a user" hidden></ul>
                    </div>
                    <div class="composer__actions">
                      <cds-button id="comment-submit" size="md" type="button">Comment</cds-button>
                    </div>
                  </div>
                  <script type="application/json" id="comment-mention-directory" set:html={JSON.stringify(userDirectory.map((u) => ({ id: u.id, name: u.name, detail: u.detail ?? u.role })))}></script>
                </form>

                <ul class="thread" id="comment-thread">
                  {permit.overview.comments.map((c) => (
                    <li class="comment">
                      <Avatar name={c.author} size="sm" />
                      <div class="comment__body">
                        <p class="comment__meta t-label-01"><span class="comment__author">{c.author}</span> · {c.time}</p>
                        <p class="comment__text t-body-01">{c.text}</p>
                      </div>
                    </li>
                  ))}
                </ul>

                <!-- Template for JS-added comments: rendered inert here so its
                     markup carries Astro's scoped-style attributes (both this
                     page's .comment styles and the Avatar's), then cloned. -->
                <template id="comment-template">
                  <li class="comment">
                    <Avatar name="?" size="sm" />
                    <div class="comment__body">
                      <p class="comment__meta t-label-01"><span class="comment__author"></span> · <span class="comment__time"></span></p>
                      <p class="comment__text t-body-01"></p>
                    </div>
                  </li>
                </template>
              </ReviewSection>

              <!-- ── Anchored-comments templates (?comments=anchored) ──────────
                   Cloned into each commentable PermitSection by the page script.
                   Kept in this page's markup so they carry its scoped styles. -->
              <script type="application/json" id="seed-comments" set:html={JSON.stringify(permit.overview.comments)}></script>
              <template id="sec-comments-btn-template">
                <cds-button class="sec-comments-btn" kind="ghost" size="md" type="button">
                  <span class="sec-comments-btn__label">Comment</span>
                  <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path d="M17.74,30,16,29l4-7h6a2,2,0,0,0,2-2V8a2,2,0,0,0-2-2H6A2,2,0,0,0,4,8V20a2,2,0,0,0,2,2h9v2H6a4,4,0,0,1-4-4V8A4,4,0,0,1,6,4H26a4,4,0,0,1,4,4V20a4,4,0,0,1-4,4H21.16Z"/><path d="M8 10H24V12H8z"/><path d="M8 16H18V18H8z"/></svg>
                </cds-button>
              </template>
              <template id="sec-thread-template">
                <div class="sec-thread" role="region" hidden>
                  <ul class="thread sec-thread__list"></ul>
                  <p class="sec-thread__empty t-body-01">No comments on this section yet.</p>
                  <cds-button class="sec-thread__resolved-toggle" kind="ghost" size="sm" type="button"></cds-button>
                  <ul class="thread sec-thread__list sec-thread__list--resolved" hidden></ul>
                  <div class="sec-thread__composer">
                    <div class="mention-field">
                      <cds-textarea class="sec-thread__input" placeholder="Type @ to mention someone (⌘/Ctrl+Enter to post)" rows="2"></cds-textarea>
                      <ul class="mention-menu" role="listbox" aria-label="Mention a user" hidden></ul>
                    </div>
                    <div class="composer__actions">
                      <cds-button class="sec-thread__submit" size="md" type="button">Comment</cds-button>
                    </div>
                  </div>
                </div>
              </template>
              <template id="anchored-comment-template">
                <li class="comment">
                  <Avatar name="?" size="sm" />
                  <div class="comment__body">
                    <p class="comment__meta t-label-01"><span class="comment__author"></span> · <span class="comment__time"></span></p>
                    <p class="comment__text t-body-01"></p>
                    <ul class="comment__replies"></ul>
                    <div class="comment__actions">
                      <cds-button class="comment__resolve" kind="ghost" size="sm" type="button">Resolve</cds-button>
                    </div>
                  </div>
                </li>
              </template>
              </div>

              <aside class="cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-5">
                <cds-tile class="rail-tile">
                  <!-- Two rail views as tabs. Analysis team is the default; the tab
                       strip renders only the header — panel visibility is wired in the
                       page script (railTabs), like the main permit tabs. -->
                  <cds-tabs class="rail-tabs" id="rail-tabs" value="analysis-team">
                    <cds-tab id="rail-tab-analysis-team" value="analysis-team">Analysis team</cds-tab>
                    <cds-tab id="rail-tab-application-history" value="application-history">Application history</cds-tab>
                  </cds-tabs>

                  <!-- Analysis team (default) ─────────────────────────────── -->
                  <div class="rail-panel" data-rail-panel="analysis-team" role="tabpanel" aria-labelledby="rail-tab-analysis-team">
                    <div class="rail-panel__head">
                      <InternalOnlyFlag />
                    </div>
                    <AnalysisTeam permitId={permit.id} team={permit.overview.analysisTeam} directory={userDirectory} />
                  </div>

                  <!-- Application history ─────────────────────────────────── -->
                  <div class="rail-panel" data-rail-panel="application-history" role="tabpanel" aria-labelledby="rail-tab-application-history" hidden>
                    <div class="phases">
                      {permit.overview.history.map((phase) => (
                        <div class="phase">
                          <h3 class="phase__title t-heading-01">{phase.phase}</h3>
                          <cds-progress-indicator vertical>
                            {phase.steps.map((s) => (
                              <cds-progress-step
                                data-history-internal={/agents? review/i.test(s.label) ? '' : undefined}
                                complete={s.state === 'complete'}
                                current={s.state === 'current'}
                                label={s.label}
                                secondary-label-text={[s.decision, s.date].filter(Boolean).join(' · ')}
                              ></cds-progress-step>
                            ))}
                          </cds-progress-indicator>
                        </div>
                      ))}
                    </div>
                  </div>
                </cds-tile>
              </aside>
            </div>
          </div>


          <!-- ── Application ──────────────────────────────────────────── -->
          <!-- The whole application on ONE scroll (Project information · Research
               team · Schedule · Study areas · Data collection · Additional
               documents) with a pinned contents rail — the one-scroll record
               pattern (/prototypes/application-record). Each section sits in an
               .app-anchor the rail links to. -->
          <div class="panel cds--css-grid" data-panel="application" role="tabpanel" aria-labelledby="tab-application" hidden>
            <aside class="app-rail cds--css-grid-column cds--sm:col-span-0 cds--md:col-span-0 cds--lg:col-span-3">
              <div class="app-rail__sticky">
                <RecordToc items={applicationTocItems} />
              </div>
            </aside>
            <div class="stack app-review cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-12">
              <!-- The shared record sections, read-only (no Edit buttons). The field
                   occurrences list sits under the calendar in Schedule instead. -->
              <div class="app-anchor" id="project-information">
              <ProjectInfoSection readonly panel showOccurrences={false} commentKey="project-details" />
              </div>
              <div class="app-anchor" id="research-team">
              <ResearchTeamSection readonly panel commentKey="research-team" />
              </div>
              <div class="app-anchor" id="schedule">
              <ReviewSection title="Schedule" panel commentKey="schedule">
                <PermitCalendar
                  windowStartISO={permit.activeWindow.startISO}
                  windowEndISO={permit.activeWindow.endISO}
                  windowStartLabel={permit.activeWindow.start}
                  windowEndLabel={permit.activeWindow.end}
                  fieldSessions={permit.projectInfo.fieldSessions}
                  tentativeISO={permit.projectInfo.annualReport.tentativeISO}
                  tentativeLabel={permit.projectInfo.annualReport.tentativeLabel}
                  requiredISO={permit.projectInfo.annualReport.requiredISO}
                  requiredLabel={permit.projectInfo.annualReport.requiredLabel}
                  todayISO={permit.projectInfo.demoTodayISO}
                />
                <h3 class="subhead sub-head t-heading-02">Field investigation occurrences</h3>
                <cds-contained-list class="field-dates" label="Scheduled field dates" kind="on-page">
                  {permit.projectInfo.fieldOccurrences.map((d) => (
                    <cds-contained-list-item>{d}</cds-contained-list-item>
                  ))}
                </cds-contained-list>
              </ReviewSection>
              </div>
              <div class="app-anchor" id="study-areas">
              <!-- The shared Study areas section chrome (title + badges), with the
                   detail's own body: who covers each park, not the editable park set. -->
              <StudyAreasSection readonly panel title="Authorized parks" commentKey="authorized-parks">
                <p class="section-hint t-body-01">Parks where research and collection are authorized, grouped by district. The district contact covers every park in that district; a park unit may also have its own contact assigned during review.</p>
                <script type="application/json" id="study-area-contacts" set:html={JSON.stringify(studyAreaContactModel)}></script>
                <!-- carbon-checked: this table needs MERGED CELLS — one district
                     contact spanning all of that district's park rows. Both
                     cds-table and cds-structured-list fake table layout with
                     `display: table-*` on custom elements, and rowspan is an HTML
                     attribute that only exists on real <th>/<td> — so neither can
                     express it (CSS has no rowspan equivalent). This is a REAL
                     <table> wearing Carbon's own shipped .cds--data-table classes
                     (the class-based flavor in @carbon/styles, which targets
                     thead/tbody/tr/th/td), so the look is stock Carbon and the
                     rowspan is native. No bespoke table CSS. -->
                <div class="cds--data-table-content sa-table">
                  <table class="cds--data-table cds--data-table--md" id="study-area-list">
                    <thead>
                      <tr>
                        <th scope="col">District</th>
                        <th scope="col">District contact</th>
                        <th scope="col">Park unit</th>
                        <th scope="col">Park contact</th>
                      </tr>
                    </thead>
                    {/* Each district is its OWN <tbody> — a real row group. That
                        makes scope="rowgroup" on the district cell accurate (it
                        heads exactly this district's rows, not the whole table)
                        and keeps the hover rule's sibling scope from leaking into
                        the next district. */}
                    {studyAreaGroups.map((g) => (
                      <tbody class="sa-group" data-district={g.district}>
                        {g.parks.map((p, i) => (
                          <tr class="sa-row" data-district={g.district} data-park={p.name}>
                            {i === 0 && (
                              <Fragment>
                                <th scope="rowgroup" rowspan={g.span} class="sa-cell--district">{g.district}</th>
                                <td rowspan={g.span} class="contact-cell" set:html={g.districtCell} />
                              </Fragment>
                            )}
                            <td>{p.name}</td>
                            <td class="contact-cell" set:html={p.parkCell} />
                          </tr>
                        ))}
                      </tbody>
                    ))}
                  </table>
                </div>
              </StudyAreasSection>
              </div>
              <div class="app-anchor" id="data-collection">
              <DataCollectionSection readonly panel commentKey="data-collection" />
              </div>
              <div class="app-anchor" id="additional-documents">
              <AdditionalDocsSection readonly panel title="Additional documentation" commentKey="additional-documentation" />
              </div>
            </div>
          </div>

          <!-- ── Special conditions ───────────────────────────────────── -->
          <!-- Reworked into a review workflow: HQ + each district curate their own
               conditions, pulled from a reusable catalog (/special-conditions) or
               typed with the sc-rich-text editor. Default catalog items auto-attach
               on submission; approval freezes the whole tab read-only. The lists
               and district blocks are rendered client-side from localStorage; see
               the "Special conditions" script block below. -->
          <div class="panel cds--css-grid" data-panel="special-conditions" role="tabpanel" aria-labelledby="tab-special-conditions" hidden>
            <!-- Contents rail: one entry per owner group (HQ + each district), same
                 pattern as the application record's rail. Entries are seeded for every
                 possible owner, then reordered / counted / pruned client-side from what
                 PermitConditions actually rendered (reader order, non-empty only). -->
            <aside class="sc-rail cds--css-grid-column cds--sm:col-span-0 cds--md:col-span-0 cds--lg:col-span-3">
              <div class="sc-rail__sticky">
                <RecordToc items={conditionOwnerItems} countNoun="conditions" />
              </div>
            </aside>
            <div class="stack cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-12">
              <ReviewSection title="Special conditions" panel>
              <cds-inline-notification
                id="sc-locked-notice"
                hidden
                kind="info"
                low-contrast
                hide-close-button
                title="Conditions are final"
                subtitle="This permit is approved — its special conditions are now part of the permit and can no longer be changed."
              ></cds-inline-notification>

              <!-- Read-only conditions, grouped by owner (shared PermitConditions:
                   Headquarters first, then each district), built client-side from
                   the applied set, so it reflects what the review has curated. -->
              <PermitConditions idPrefix="conditions" />
              </ReviewSection>
            </div>
          </div>

          <!-- ── Final permit letter / Final report ───────────────────── -->
          <!-- The record's later documents (same components as the one-scroll
               record): the letter EXACTLY as sent for signature, with signature
               status; and the researcher's final report. Their tabs are gated —
               see gateRecordTabs. Content column lines up with the other tabs'. -->
          <div class="panel cds--css-grid" data-panel="letter" role="tabpanel" aria-labelledby="tab-letter" hidden>
            <div class="stack cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-start-4 cds--lg:col-span-12">
              <ReviewSection title="Final permit letter" panel>
                <RecordLetter />
              </ReviewSection>
            </div>
          </div>
          <div class="panel cds--css-grid" data-panel="report" role="tabpanel" aria-labelledby="tab-report" hidden>
            <div class="stack cds--css-grid-column cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-start-4 cds--lg:col-span-12">
              <ReviewSection title="Final report" panel>
                <RecordReport />
              </ReviewSection>
            </div>
          </div>



        </div>
      </section>
    </cds-stack>

  </main>
</BaseLayout>

<script>
  // Gate vs. body visibility is driven by the .review-started class the inline
  // head script sets pre-paint from the flag; starting itself navigates to the
  // wizard (PermitHeader.startReview), so there's no in-place reveal to run.

  // The "Start your review" prompt only makes sense for someone allowed to start.
  // PermitHeader hides the start button (.permit-start-review) for viewers who
  // can't, so mirror that onto the whole prompt — only ever hide (never force it
  // visible), so the .review-started stylesheet rule keeps winning once started.
  const startPrompt = document.getElementById('start-review-prompt') as HTMLElement | null;
  const startBtn = startPrompt?.querySelector<HTMLElement>('.permit-start-review') ?? null;
  if (startPrompt && startBtn) {
    const syncStartPrompt = () => { if (startBtn.hidden) startPrompt.style.display = 'none'; };
    requestAnimationFrame(syncStartPrompt);
    new MutationObserver(syncStartPrompt).observe(startBtn, { attributes: true, attributeFilter: ['hidden'] });
  }
</script>

<style>
  /* Start-review prompt — an inline call to action at the top of the Overview
     tab, shown until review begins. The application itself is always accessible;
     this only nudges the reviewer to formally start (which records the time). */
  .start-review-prompt {
    max-inline-size: 100%;
    margin-block-end: var(--cds-spacing-06, 1.5rem);
  }
</style>

<style is:global>
  /* Pre-paint prompt visibility, keyed on the class the inline head script sets
     from the flag — so a permit already in review never flashes the "Start your
     review" prompt. #start-review-prompt exists only on this page, so this global
     block can't affect any other screen. */
  html.review-started #start-review-prompt { display: none; }
  /* Header no-flash: on a started permit, don't let the "Start review" action
     flash before the script swaps it to "Open review". Safe as a global rule
     because .review-started is only ever set on this page — the other PermitHeader
     pages never match it. (The reverse case needs no rule: the "Open review" combo
     ships hidden by default, so it can't flash on a not-yet-started permit.) */
  html.review-started [data-phase="not-started"] { display: none; }
</style>

<script>
  import { withBase } from '../lib/base';
  import { reviewStore } from '../lib/review-thread';
  import { readIdentity } from '../lib/maintenance';
  import { activeUser } from '../data/user';
  import { sectionAccessor } from '../lib/permissions';
  import { showToast } from '../lib/toast';
  import { renderMentionText, wireMentionTypeahead, type MentionUser } from '../lib/comment-mentions';

  // IR permission context (Stories 9.1–9.5): resolve each section's access from
  // the active identity × permit-role × status × type. The banner carries the id,
  // type, and seeded status; the live status is the persisted lifecycle value.
  const permitBanner = document.getElementById('permit-banner');
  const thePermitId = permitBanner?.dataset.permitId || '';
  const liveStatus = () =>
    localStorage.getItem(`permit-status-${thePermitId}`) || permitBanner?.dataset.status || 'Under review';
  const acc = sectionAccessor(readIdentity(), thePermitId, permitBanner?.dataset.permitType, liveStatus());

  // ── Viewer class: internal reviewer · researcher owner · public (Stories 11–12) ─
  const hideSec = (sel: string) =>
    (document.querySelector(sel)?.closest('.sec, .rpanel') as HTMLElement | null)?.style.setProperty('display', 'none');
  let internalReviewHidden = false; // set for researcher/public viewers — no internal comments
  // Researcher owners see the special conditions once they're final — from the
  // moment the letter goes out for signature (they accept them by signing) and for
  // the life of the permit after. Draft conditions under review stay internal.
  const OWNER_CONDITIONS_STATUSES = ['Out for signature', 'Waiting for final report', 'Active', 'Expired'];
  const hideInternalReview = ({ keepConditions = false } = {}) => {
    internalReviewHidden = true;
    // Header: the analysis team's review progress is internal.
    (document.getElementById('analysis-metric') as HTMLElement | null)?.style.setProperty('display', 'none');
    // Application history: researchers see their own milestones, not the review
    // team's internal steps (who reviewed when).
    document.querySelectorAll<HTMLElement>('[data-history-internal]').forEach((el) => { el.style.display = 'none'; });
    document.documentElement.classList.add('review-started'); // hide the "Start your review" prompt for non-reviewers
    hideSec('#permit-tag-select');   // Tags
    hideSec('#comment-composer');    // Comments / internal notes
    // Analysis team is internal-only. It now lives as a tab in the overview rail
    // tile, so hide its tab + panel and fall the rail back to Application history.
    (document.getElementById('rail-tab-analysis-team') as HTMLElement | null)?.style.setProperty('display', 'none');
    (document.querySelector('[data-rail-panel="analysis-team"]') as HTMLElement | null)?.setAttribute('hidden', '');
    (document.querySelector('[data-rail-panel="application-history"]') as HTMLElement | null)?.removeAttribute('hidden');
    const railFallback = document.getElementById('rail-tabs') as any;
    if (railFallback) customElements.whenDefined('cds-tabs').then(() =>
      railFallback.updateComplete?.then?.(() => { railFallback.value = 'application-history'; }));
    (document.getElementById('supporting-review-section') as HTMLElement | null)?.style.setProperty('display', 'none');
    if (keepConditions) return;
    (document.getElementById('tab-special-conditions') as HTMLElement | null)?.style.setProperty('display', 'none');
    (document.querySelector('[data-panel="special-conditions"]') as HTMLElement | null)?.setAttribute('hidden', '');
  };
  let viewerIsPublic = false; // Story 12 public summary — no letter, no report
  {
    const who = readIdentity();
    const statusLabel = liveStatus();
    const isInternal = who === 'admin' || who === 'hq-technical' || who === 'district-lead' || who === 'district-assistant';
    const isPublicStatus = statusLabel === 'Active' || statusLabel === 'Expired';
    if (!isInternal) {
      let owners: string[] = [];
      try { owners = JSON.parse(document.getElementById('permit-owners')?.textContent || '[]'); } catch {}
      const me = activeUser(who);
      const ownsIt = who === 'researcher' && !!me && owners.includes(me.name.toLowerCase());

      if (ownsIt && statusLabel !== 'Withdrawn') {
        // Story 11 — the owner reads their submitted application; IR is hidden (§6).
        hideInternalReview({ keepConditions: OWNER_CONDITIONS_STATUSES.includes(statusLabel) });
        const ro = document.querySelector<HTMLElement>('[data-researcher-overview]');
        if (ro) {
          ro.style.display = '';
          ro.dataset.status = statusLabel;
          ro.dispatchEvent(new CustomEvent('researcher-overview-render', { detail: { status: statusLabel } }));
        }
        // Returned for changes → point the researcher at the revise flow.
        if (statusLabel === 'Changes requested' || statusLabel === 'Returned to submitter') {
          const ret = reviewStore(thePermitId).returned();
          const n = ret?.issueIds.length ?? 0;
          const cr = document.getElementById('changes-requested-banner') as any;
          if (cr) {
            cr.subtitle = `The review team asked for ${n === 1 ? '1 change' : `${n} changes`}${ret ? ` on ${ret.at}` : ''}. Each one is shown on the page of your application it's about.${ret?.message ? ` Their message: “${ret.message}”` : ''}`;
            cr.style.display = '';
            const row = document.getElementById('changes-requested-row');
            if (row) row.style.display = '';
          }
          document.getElementById('changes-requested-go')?.addEventListener('click', () => {
            location.href = withBase(`/apply?revise=${encodeURIComponent(thePermitId)}`);
          });
        }
      } else if (isPublicStatus) {
        // Story 12 — public view of an Active/Expired permit: summary only, no PII,
        // no Internal Review. Available to anon and any authenticated non-owner.
        viewerIsPublic = true;
        hideInternalReview();
        hideSec('.contact-grid');        // Research team (PI / field lead names — PII)
        const pub = document.getElementById('public-view-banner') as HTMLElement | null;
        if (pub) pub.style.display = '';
      } else {
        // Not the owner and not a public status → no access.
        location.replace(withBase(who === 'anon' ? '/search' : '/my-permits'));
      }
    }
  }

  // cds-tabs renders only the tab strip; panel visibility is the app's job.
  const tabsEl = document.getElementById('permit-tabs') as any;
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function showPanel(value: string) {
    panels.forEach((p) => { p.hidden = p.dataset.panel !== value; });
  }
  tabsEl?.addEventListener('cds-tabs-selected', () => showPanel(tabsEl.value));

  // Gated record tabs. Final permit letter: once the letter has gone out for
  // signature (staff + the researcher owner, who signs it). Final report: once the
  // researcher has filed one (permit-final-report-${id}; `?report=1` previews the
  // mock). Neither is part of the public summary. A gated tab that disappears
  // while open falls back to Overview.
  const LETTER_STATUSES = ['Out for signature', 'Waiting for final report', 'Active', 'Expired'];
  const gateRecordTabs = () => {
    const hasReport = new URLSearchParams(location.search).get('report') === '1'
      || !!localStorage.getItem(`permit-final-report-${thePermitId}`);
    const show: Record<string, boolean> = {
      letter: !viewerIsPublic && LETTER_STATUSES.includes(liveStatus()),
      report: !viewerIsPublic && hasReport,
    };
    document.querySelectorAll<HTMLElement>('#permit-tabs cds-tab[data-gate]').forEach((tab) => {
      const visible = show[tab.dataset.gate!] ?? true;
      tab.style.display = visible ? '' : 'none';
      if (!visible && tabsEl?.value === tab.getAttribute('value')) {
        tabsEl.value = 'overview';
        showPanel('overview');
      }
    });
  };
  gateRecordTabs();
  window.addEventListener('permit-status-changed', gateRecordTabs);

  // Header: once the permit is issued its window is the AUTHORIZED one, not the
  // request (staff may have narrowed it — the issued dates are what's in force).
  const syncWindowLabel = () => {
    const issued = LETTER_STATUSES.includes(liveStatus());
    document.querySelectorAll<HTMLElement>('#permit-banner .stat__label').forEach((dt) => {
      if (/^(Requested|Authorized) window$/.test(dt.textContent!.trim())) dt.textContent = issued ? 'Authorized window' : 'Requested window';
    });
  };
  syncWindowLabel();
  window.addEventListener('permit-status-changed', syncWindowLabel);

  // Overview rail tile: Analysis team / Application history as tabs. Same deal —
  // the strip only renders the header; we toggle the two rail panels ourselves.
  const railTabs = document.getElementById('rail-tabs') as any;
  const railPanels = Array.from(document.querySelectorAll<HTMLElement>('.rail-panel'));
  const showRailPanel = (value: string) => {
    railPanels.forEach((p) => { p.hidden = p.dataset.railPanel !== value; });
  };
  railTabs?.addEventListener('cds-tabs-selected', () => showRailPanel(railTabs.value));

  // Header (site) search: submitting a query takes the reviewer to the results page.
  const siteSearch = document.getElementById('site-search') as any;
  siteSearch?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Enter') return;
    const q = (siteSearch.value ?? '').trim();
    window.location.href = q
      ? withBase(`/search?q=${encodeURIComponent(q)}`)
      : withBase('/search');
  });

  // ── Comments: add + persist (prototype-local, newest-first, no editing) ──
  // A static Astro prototype has no backend, so "saved" means localStorage:
  // new comments survive reloads, keyed per permit.
  const composer = document.getElementById('comment-composer') as HTMLFormElement | null;
  const commentInput = document.getElementById('comment-input') as any;
  const commentSubmit = document.getElementById('comment-submit');
  const thread = document.getElementById('comment-thread');
  const commentTemplate = document.getElementById('comment-template') as HTMLTemplateElement | null;

  // Adding comments is ALWAYS allowed for anyone who can see this section — no
  // status or permit-role gate. (Internal notes stay internal: researchers and
  // public viewers don't get the section at all — hideInternalReview removes it.)
  const notesUpdatable = true;

  if (composer && commentInput && commentSubmit && thread && commentTemplate) {
    // The comment author is the person behind the active prototype identity, not a
    // hardcoded roster member — Story 1 (identity is the single global actor).
    const actor = activeUser(readIdentity());
    const author = actor?.name || composer.dataset.author || 'You';
    const storageKey = composer.dataset.storageKey || 'permit-comments';

    interface StoredComment { author: string; time: string; text: string; mentions?: string[] }

    // Mention directory + @-typeahead, shared with the review wizard so a mention
    // works identically here. `picked` records users inserted via the menu.
    let mentionDir: MentionUser[] = [];
    try { mentionDir = JSON.parse(document.getElementById('comment-mention-directory')?.textContent || '[]'); } catch { mentionDir = []; }
    const picked = wireMentionTypeahead(commentInput, document.getElementById('comment-mention-menu'), mentionDir);

    const initials = (name: string) =>
      name
        .replace(/^(Dr\.?|Prof\.?)\s+/i, '')
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((w) => w[0]?.toUpperCase() ?? '')
        .join('');

    const todayLabel = () =>
      new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

    // Match the composer's own avatar to the active identity's author.
    const composerAvatar = composer.querySelector('.avatar');
    if (composerAvatar) composerAvatar.textContent = initials(author);

    // Clone the scoped template so both this page's and the Avatar's styles apply.
    const buildComment = (c: StoredComment): HTMLElement => {
      const li = commentTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelector('.avatar')!.textContent = initials(c.author);
      li.querySelector('.comment__author')!.textContent = c.author;
      li.querySelector('.comment__time')!.textContent = c.time;
      const textEl = li.querySelector('.comment__text')!;
      textEl.textContent = '';
      textEl.appendChild(renderMentionText(c.text, c.mentions ?? []));
      return li;
    };

    const load = (): StoredComment[] => {
      try {
        const parsed = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };
    const save = (list: StoredComment[]) => localStorage.setItem(storageKey, JSON.stringify(list));

    // Seed comments are newest-first; user comments are newer still, so they go
    // above the first seed. Rendering the stored array (newest-first) in order
    // before that anchor preserves newest-first.
    const firstSeed = thread.firstElementChild;
    load().forEach((c) => thread.insertBefore(buildComment(c), firstSeed));

    const addComment = () => {
      const text = (commentInput.value ?? '').trim();
      if (!text) {
        commentInput.focus();
        return;
      }
      // Only the picked mentions that actually survive in the text are recorded.
      const mentioned = [...picked.values()].filter((u) => text.includes(`@${u.name}`));
      const comment: StoredComment = { author, time: todayLabel(), text, mentions: mentioned.map((u) => u.name) };
      const list = load();
      list.unshift(comment);
      save(list);
      thread.insertBefore(buildComment(comment), thread.firstElementChild);
      commentInput.value = '';
      picked.clear();
      commentInput.focus();
      showToast('Comment posted', mentioned.length ? `Notified ${mentioned.map((u) => u.name).join(', ')} of your mention.` : undefined);
    };

    // Wire the composer only when the active identity may add notes (Story 9.5).
    if (notesUpdatable) {
      commentSubmit.addEventListener('click', addComment);
      commentInput.addEventListener('keydown', (e: KeyboardEvent) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
          e.preventDefault();
          addComment();
        }
      });
    }
  }

  // ── Anchored comments (?comments=anchored) ─────────────────────────────────
  // Design study: no Comments section. Each commentable PermitSection (commentKey)
  // gets a comment control in its head and a thread below it; a header panel lists
  // every open thread grouped by section, plus general comments that aren't about
  // one section. Same permit-comments-${id} thread as the review wizard — a comment
  // just gains an optional `section` field. Resolved state is stored separately
  // (keyed like the wizard's replies) so other views are unaffected.
  const anchoredMode = new URLSearchParams(location.search).get('comments') === 'anchored';
  if (anchoredMode && !internalReviewHidden) {
    interface AComment { author: string; time: string; text: string; mentions?: string[]; section?: string; anchor?: { quote?: string } }
    interface AReply { author: string; time: string; text: string; mentions?: string[] }
    const pid = thePermitId || (composer?.dataset.storageKey || '').replace('permit-comments-', '');
    const commentsKey = `permit-comments-${pid}`;
    const repliesKey = `permit-comment-replies-${pid}`;
    const resolvedKey = `permit-comment-resolved-${pid}`;
    const keyOf = (c: AComment) => `${c.author}|${c.time}|${c.text.slice(0, 80)}`;
    const readJSON = <T,>(k: string, fallback: T): T => {
      try { const v = JSON.parse(localStorage.getItem(k) || 'null'); return v ?? fallback; } catch { return fallback; }
    };

    let seeds: AComment[] = [];
    try { seeds = JSON.parse(document.getElementById('seed-comments')?.textContent || '[]'); } catch { seeds = []; }
    let mentionDir: MentionUser[] = [];
    try { mentionDir = JSON.parse(document.getElementById('comment-mention-directory')?.textContent || '[]'); } catch { mentionDir = []; }
    const author = activeUser(readIdentity())?.name || composer?.dataset.author || 'You';
    const todayLabel = () => new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    const initials = (name: string) =>
      name.replace(/^(Dr\.?|Prof\.?)\s+/i, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase() ?? '').join('');

    // Stored comments are newest-first and newer than every seed.
    const allComments = (): AComment[] => {
      const stored = readJSON<AComment[]>(commentsKey, []);
      return [...(Array.isArray(stored) ? stored : []), ...seeds];
    };
    const resolvedSet = () => new Set(readJSON<string[]>(resolvedKey, []));
    const setResolved = (c: AComment, on: boolean) => {
      const set = resolvedSet();
      if (on) set.add(keyOf(c)); else set.delete(keyOf(c));
      localStorage.setItem(resolvedKey, JSON.stringify([...set]));
    };
    const post = (text: string, section: string | undefined, mentions: string[]) => {
      const list = readJSON<AComment[]>(commentsKey, []);
      list.unshift({ author, time: todayLabel(), text, mentions, ...(section ? { section } : {}) });
      localStorage.setItem(commentsKey, JSON.stringify(list));
    };

    // Swap the flat Comments section out; reveal the header action + panel.
    hideSec('#comment-composer');
    const globalBtn = document.getElementById('comments-global') as any;
    const panel = document.getElementById('comments-panel') as HTMLElement | null;
    globalBtn?.style.removeProperty('display');
    panel?.style.removeProperty('display');
    const closePanel = () => { panel?.removeAttribute('expanded'); if (globalBtn) globalBtn.active = false; };

    const btnTpl = document.getElementById('sec-comments-btn-template') as HTMLTemplateElement;
    const threadTpl = document.getElementById('sec-thread-template') as HTMLTemplateElement;
    const commentTpl = document.getElementById('anchored-comment-template') as HTMLTemplateElement;

    interface Target { key: string; label: string; tab: string; tabLabel: string; sec: HTMLElement; btn: any; region: HTMLElement; showResolved: boolean }
    const targets: Target[] = [];

    const buildItem = (c: AComment, isResolved: boolean, onChange: () => void): HTMLElement => {
      const li = commentTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelector('.avatar')!.textContent = initials(c.author);
      li.querySelector('.comment__author')!.textContent = c.author;
      li.querySelector('.comment__time')!.textContent = c.time;
      const textEl = li.querySelector('.comment__text')!;
      textEl.textContent = '';
      textEl.appendChild(renderMentionText(c.text, c.mentions ?? []));
      // Replies are written in the review wizard; shown here read-only.
      const replies = readJSON<Record<string, AReply[]>>(repliesKey, {})[keyOf(c)] || [];
      const repliesEl = li.querySelector('.comment__replies') as HTMLElement;
      if (!replies.length) repliesEl.remove();
      for (const r of replies) {
        const rli = document.createElement('li');
        const meta = document.createElement('p'); meta.className = 'comment__meta t-label-01';
        const who = document.createElement('span'); who.className = 'comment__author'; who.textContent = r.author;
        meta.append(who, document.createTextNode(` · ${r.time}`));
        const body = document.createElement('p'); body.className = 'comment__text t-body-01';
        body.appendChild(renderMentionText(r.text, r.mentions ?? []));
        rli.append(meta, body);
        repliesEl.append(rli);
      }
      const resolveBtn = li.querySelector('.comment__resolve') as HTMLElement;
      resolveBtn.textContent = isResolved ? 'Reopen' : 'Resolve';
      resolveBtn.addEventListener('click', () => {
        setResolved(c, !isResolved);
        onChange();
        showToast(isResolved ? 'Comment reopened' : 'Comment resolved');
      });
      return li;
    };

    const renderTarget = (t: Target) => {
      const resolved = resolvedSet();
      const mine = allComments().filter((c) => c.section === t.key);
      const open = mine.filter((c) => !resolved.has(keyOf(c)));
      const done = mine.filter((c) => resolved.has(keyOf(c)));
      const list = t.region.querySelector('.sec-thread__list:not(.sec-thread__list--resolved)') as HTMLElement;
      const doneList = t.region.querySelector('.sec-thread__list--resolved') as HTMLElement;
      const toggle = t.region.querySelector('.sec-thread__resolved-toggle') as HTMLElement;
      const rerender = () => renderAll();
      list.replaceChildren(...open.map((c) => buildItem(c, false, rerender)));
      doneList.replaceChildren(...done.map((c) => buildItem(c, true, rerender)));
      (t.region.querySelector('.sec-thread__empty') as HTMLElement).hidden = open.length > 0;
      list.hidden = !open.length;
      doneList.hidden = !(done.length && t.showResolved);
      toggle.style.display = done.length ? '' : 'none';
      toggle.textContent = t.showResolved ? `Hide resolved (${done.length})` : `Show resolved (${done.length})`;
      const label = t.btn.querySelector('.sec-comments-btn__label') as HTMLElement;
      label.textContent = !t.region.hidden ? 'Hide comments'
        : open.length ? `${open.length} comment${open.length === 1 ? '' : 's'}` : 'Comment';
    };

    const renderPanel = () => {
      const resolved = resolvedSet();
      const all = allComments();
      const openAll = all.filter((c) => !resolved.has(keyOf(c)));
      const groupsEl = document.getElementById('comments-panel-groups')!;
      const summary = document.getElementById('comments-panel-summary')!;
      const doneCount = all.length - openAll.length;
      summary.textContent = openAll.length
        ? `${openAll.length} open${doneCount ? ` · ${doneCount} resolved` : ''}`
        : doneCount ? `All ${doneCount} resolved` : 'No comments yet.';
      document.getElementById('comments-global-count')?.setAttribute('count', String(openAll.length));
      const known = new Set(targets.map((t) => t.key));
      const groups: { label: string; target?: Target; items: AComment[] }[] = [
        // General = no section, or a section this page doesn't show (e.g. a
        // passage comment from the review wizard). Listed first.
        { label: 'General', items: openAll.filter((c) => !c.section || !known.has(c.section)) },
        ...targets.map((t) => ({ label: `${t.label} · ${t.tabLabel}`, target: t, items: openAll.filter((c) => c.section === t.key) })),
      ];
      groupsEl.replaceChildren(...groups.filter((g) => g.items.length).map((g) => {
        const cl = document.createElement('cds-contained-list') as any;
        cl.setAttribute('label', g.label);
        cl.setAttribute('kind', 'on-page');
        for (const c of g.items) {
          const item = document.createElement('cds-contained-list-item') as any;
          if (g.target) item.setAttribute('clickable', '');
          const who = document.createElement('strong'); who.textContent = `${c.author} · ${c.time}`;
          const text = document.createElement('span'); text.className = 'comments-panel__text';
          text.textContent = c.anchor?.quote ? `On “${c.anchor.quote.slice(0, 60)}…” — ${c.text}` : c.text;
          item.append(who, document.createElement('br'), text);
          if (g.target) {
            const t = g.target;
            item.addEventListener('cds-contained-list-item-click', () => { closePanel(); jumpTo(t); });
          }
          cl.append(item);
        }
        return cl;
      }));
    };

    const renderAll = () => { targets.forEach(renderTarget); renderPanel(); };

    const setOpen = (t: Target, open: boolean) => {
      t.region.hidden = !open;
      renderTarget(t);
      if (open) setTimeout(() => (t.region.querySelector('.sec-thread__input') as any)?.focus?.(), 30);
    };

    const jumpTo = (t: Target) => {
      if (tabsEl && tabsEl.value !== t.tab) { tabsEl.value = t.tab; }
      showPanel(t.tab);
      setOpen(t, true);
      t.sec.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    };

    document.querySelectorAll<HTMLElement>('[data-comment-section]').forEach((sec) => {
      const key = sec.dataset.commentSection!;
      const label = sec.dataset.commentLabel || key;
      const panelEl = sec.closest<HTMLElement>('.panel');
      const tab = panelEl?.dataset.panel || 'overview';
      const tabLabel = document.getElementById(`tab-${tab}`)?.textContent?.trim() || '';
      const btn = btnTpl.content.firstElementChild!.cloneNode(true) as any;
      sec.querySelector('[data-section-aside]')?.prepend(btn);
      const region = threadTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      region.setAttribute('aria-label', `Comments on ${label}`);
      sec.querySelector('[data-section-head]')?.after(region);
      const input = region.querySelector('.sec-thread__input') as any;
      input.setAttribute('label', `Comment on ${label.charAt(0).toLowerCase()}${label.slice(1)}`);
      const picked = wireMentionTypeahead(input, region.querySelector('.mention-menu'), mentionDir);
      const t: Target = { key, label, tab, tabLabel, sec, btn, region, showResolved: false };
      targets.push(t);

      btn.addEventListener('click', () => setOpen(t, region.hasAttribute('hidden')));
      region.querySelector('.sec-thread__resolved-toggle')?.addEventListener('click', () => {
        t.showResolved = !t.showResolved; renderTarget(t);
      });
      const submit = () => {
        const text = (input.value ?? '').trim();
        if (!text) { input.focus(); return; }
        const mentioned = [...picked.values()].filter((u) => text.includes(`@${u.name}`));
        post(text, key, mentioned.map((u) => u.name));
        input.value = '';
        picked.clear();
        renderAll();
        input.focus();
        showToast('Comment posted', mentioned.length ? `Notified ${mentioned.map((u) => u.name).join(', ')} of your mention.` : undefined);
      };
      region.querySelector('.sec-thread__submit')?.addEventListener('click', submit);
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); submit(); }
      });
    });

    // General comments, posted from the header panel.
    const gInput = document.getElementById('general-comment-input') as any;
    const gPicked = wireMentionTypeahead(gInput, document.getElementById('general-comment-menu'), mentionDir);
    const postGeneral = () => {
      const text = (gInput?.value ?? '').trim();
      if (!text) { gInput?.focus(); return; }
      const mentioned = [...gPicked.values()].filter((u) => text.includes(`@${u.name}`));
      post(text, undefined, mentioned.map((u) => u.name));
      gInput.value = '';
      gPicked.clear();
      renderPanel();
      showToast('Comment posted', mentioned.length ? `Notified ${mentioned.map((u) => u.name).join(', ')} of your mention.` : undefined);
    };
    document.getElementById('general-comment-submit')?.addEventListener('click', postGeneral);
    gInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); postGeneral(); }
    });

    renderAll();
  }

  // ── Analysis team ──
  // The roster + its add / remove / email-all / copy behavior live in the shared
  // AnalysisTeam component (src/components/AnalysisTeam.astro), so this page and
  // the review wizard render it identically. It ships its own script — nothing to
  // wire here.

  // ── Permit tags: apply / remove from a curated set (prototype-local) ──
  // A cds-multi-select is the control; applied tags mirror below as dismissible
  // cds-tags. The applied set is the single source of truth: setting the
  // multi-select's `value` (comma-joined) reconciles its checkboxes + count, so
  // dismissing a tag and unchecking it stay in sync. Persists per permit.
  const tagSelect = document.getElementById('permit-tag-select') as any;
  const tagRow = document.getElementById('permit-tag-row');
  const tagEmpty = document.getElementById('permit-tag-empty');

  // Tags are ALWAYS editable for anyone who can see this section — no status or
  // permit-role gate; the picker stays visible and applied tags are dismissible.
  // (Tags stay internal: researchers and public viewers don't get the section at
  // all — hideInternalReview removes it.)
  const tagsEditable = true;

  if (tagSelect && tagRow && tagEmpty) {
    const storageKey = (tagRow as HTMLElement).dataset.storageKey || 'permit-tags';
    // Canonical order = the option order, so the applied row is stable.
    const optionOrder = Array.from(
      tagSelect.querySelectorAll('cds-multi-select-item'),
    ).map((i: any) => i.getAttribute('value') as string);
    const sortByOption = (tags: string[]) => optionOrder.filter((o) => tags.includes(o));

    const load = (): string[] | null => {
      try {
        const parsed = JSON.parse(localStorage.getItem(storageKey) || 'null');
        return Array.isArray(parsed) ? parsed.filter((t) => typeof t === 'string') : null;
      } catch {
        return null;
      }
    };
    const save = (tags: string[]) => localStorage.setItem(storageKey, JSON.stringify(tags));

    const buildTag = (label: string): HTMLElement => {
      // Editable → a dismissible tag; read-only → a plain, non-removable tag.
      const tag = document.createElement(tagsEditable ? 'cds-dismissible-tag' : 'cds-tag');
      tag.setAttribute('type', 'cool-gray');
      tag.setAttribute('size', 'md');
      tag.setAttribute('text', label);
      (tag as HTMLElement).dataset.tag = label;
      if (tagsEditable) {
        tag.addEventListener('cds-dismissible-tag-closed', () => {
          setTags(applied.filter((t) => t !== label));
          showToast('Tag removed', label);
        });
      }
      return tag;
    };

    // Seed from storage if present, else from the server-rendered row.
    let applied = load() ?? sortByOption(
      Array.from(tagRow.querySelectorAll<HTMLElement>('[data-tag]')).map((el) => el.dataset.tag!),
    );

    const setTags = (tags: string[]) => {
      applied = sortByOption([...new Set(tags)]);
      save(applied);
      tagRow.replaceChildren(...applied.map(buildTag));
      tagRow.hidden = applied.length === 0;
      (tagEmpty as HTMLElement).hidden = applied.length !== 0;
      // Reconcile the multi-select's checkboxes + field count to the applied set.
      const next = applied.join(',');
      if (tagSelect.value !== next) tagSelect.value = next;
    };

    // A user check/uncheck: the component has already updated its own `value`.
    // Diff against the prior applied set so each add/remove fires a success toast.
    if (tagsEditable) {
      tagSelect.addEventListener('cds-multi-select-selected', () => {
        const prev = applied;
        setTags((tagSelect.value || '').split(',').filter(Boolean));
        applied.filter((t) => !prev.includes(t)).forEach((t) => showToast('Tag added', t));
        prev.filter((t) => !applied.includes(t)).forEach((t) => showToast('Tag removed', t));
      });
    }

    setTags(applied); // apply stored state over the seed on load
  }

  // ── Supporting review (Story 10): SA-only, informational ────────────────────
  // Shown only when the resolver grants it (Supporting Agent, Under review). It
  // records the SA's review state (per identity, per permit) but never gates the RA.
  const srSection = document.getElementById('supporting-review-section') as HTMLElement | null;
  if (srSection && acc('supporting-review') === 'update') {
    srSection.hidden = false;
    const srTag = document.getElementById('sr-status-tag') as any;
    const srAction = document.getElementById('sr-action') as any;
    const srKey = `permit-supporting-review-${thePermitId}-${readIdentity()}`;
    type SRState = 'none' | 'in-progress' | 'complete';
    const readSR = (): SRState => {
      const v = localStorage.getItem(srKey);
      return v === 'in-progress' || v === 'complete' ? v : 'none';
    };
    const renderSR = () => {
      const s = readSR();
      const map = {
        none: { tag: 'Not started', type: 'cool-gray', action: 'Start supporting review', next: 'in-progress' },
        'in-progress': { tag: 'In progress', type: 'blue', action: 'Complete supporting review', next: 'complete' },
        complete: { tag: 'Complete', type: 'green', action: 'Reopen review', next: 'in-progress' },
      }[s];
      if (srTag) { srTag.textContent = map.tag; srTag.setAttribute('type', map.type); }
      if (srAction) srAction.textContent = map.action;
      return map.next as SRState;
    };
    let next = renderSR();
    srAction?.addEventListener('click', () => {
      localStorage.setItem(srKey, next);
      next = renderSR();
    });
  }

</script>

<!-- ── Special conditions: read-only view ──────────────────────────────────
     The applied conditions (HQ + each district), grouped in a standard accordion.
     Curation lives in the review workflow (final-letter); this only reads the
     shared permit-conditions-${id} localStorage set. -->
<script>
  import { permit } from '../data/permit';
  import { permitStatusKey } from '../data/conditions';
  import { readIdentity } from '../lib/maintenance';

  // The conditions themselves render in the shared PermitConditions component
  // (read-only; curation lives in the review workflow). This script only keeps the
  // "Conditions are final" notice in step with the permit's status.
  const $ = (id: string) => document.getElementById(id);
  const permitId = permit.id;

  // Approved / signed permits: note that the conditions are now final (part of the
  // permit). Kept in sync if the status changes while the page is open.
  // A researcher only reaches this tab as the permit's owner, once the conditions
  // are final — so they get their own wording: accept-by-signing, then comply.
  const FROZEN_STATUSES = ['Out for signature', 'Active'];
  const lockedNotice = $('sc-locked-notice') as any;
  const isOwner = readIdentity() === 'researcher';
  const OWNER_NOTICE: Record<string, [string, string]> = {
    'Out for signature': ['Read these before your permit starts', 'These conditions apply to everyone working under your permit from the day it is active.'],
    'Active': ['Follow every condition while you work', 'These conditions are part of your permit and apply to everyone working under it.'],
  };
  const syncLocked = (status?: string | null) => {
    const s = status ?? localStorage.getItem(permitStatusKey(permitId));
    if (!lockedNotice) return;
    lockedNotice.hidden = !FROZEN_STATUSES.includes(s ?? '');
    const owner = isOwner && s ? OWNER_NOTICE[s] : undefined;
    if (owner) [lockedNotice.title, lockedNotice.subtitle] = owner;
  };
  syncLocked();
  window.addEventListener('permit-status-changed', (e) => syncLocked((e as CustomEvent).detail?.status));

  // Contents rail: match the owner entries to the groups PermitConditions actually
  // rendered — reader order (own district first for district staff; HQ then the
  // permit's districts for everyone else), each with its count; owners with no
  // conditions drop out. The groups may render before or after this runs, so read
  // the stored result first, then listen.
  type RenderedOwner = { id: string; count: number };
  const scPanel = document.querySelector<HTMLElement>('[data-panel="special-conditions"]');
  const scToc = scPanel?.querySelector<HTMLElement>('[data-record-toc]');
  const scList = scToc?.querySelector('ul');
  const syncConditionsRail = (owners: RenderedOwner[]) => {
    if (!scToc || !scList) return;
    const items = [...scList.querySelectorAll<HTMLElement>('[data-toc-item]')];
    items.forEach((li) => { li.style.display = 'none'; });
    owners.forEach(({ id, count }) => {
      const li = items.find((el) => el.dataset.tocItem === id);
      if (!li) return;
      li.style.display = '';
      scList.appendChild(li); // re-append in reader order
      const n = li.querySelector<HTMLElement>('[data-toc-count]');
      if (n) n.innerHTML = `${count}<span class="cds--visually-hidden"> ${count === 1 ? 'condition' : 'conditions'}</span>`;
    });
    // No conditions at all → nothing to navigate; hide the whole rail.
    (scToc.closest('.sc-rail') as HTMLElement | null)?.style.setProperty('visibility', owners.length ? '' : 'hidden');
    scToc.dispatchEvent(new Event('record-toc-refresh'));
  };
  const scRoot = scPanel?.querySelector<HTMLElement>('[data-permit-conditions]');
  if (scRoot?.dataset.renderedOwners) syncConditionsRail(JSON.parse(scRoot.dataset.renderedOwners));
  scRoot?.addEventListener('permit-conditions-rendered', (e) => syncConditionsRail((e as CustomEvent).detail.owners));
  // The spies skip hidden panels; re-run every contents rail when a tab is shown.
  const permitTabs = document.getElementById('permit-tabs');
  permitTabs?.addEventListener('cds-tabs-selected', () =>
    requestAnimationFrame(() => document.querySelectorAll('[data-record-toc]')
      .forEach((toc) => toc.dispatchEvent(new Event('record-toc-refresh')))));
</script>

<!-- Amendment link — surfaces the amendment on the ORIGINAL permit once one has
     been started (flag written by PermitHeader's Request amendment action). -->
<script>
  import { permit } from '../data/permit';
  import { withBase } from '../lib/base';

  const amendNumber = localStorage.getItem(`permit-amendment-${permit.id}`);
  if (amendNumber) {
    const notice = document.getElementById('amend-notice') as any;
    const text = document.getElementById('amend-notice-text');
    const btn = document.getElementById('amend-notice-btn');
    if (text) text.textContent = `Amendment ${amendNumber} has been started for this permit.`;
    if (btn) btn.setAttribute('href', withBase(`/apply?amend=${permit.id}`));
    if (notice) notice.hidden = false;
  }
</script>

<!-- Study areas → Authorized parks: reflect the district contacts recorded on
     step ② of the finalize wizard (final-letter.astro). The wizard persists a flat
     per-district list of { person, scope } entries under permit-final-${id}.contacts
     (scope null = covers all the district's parks) and any edited park set under
     permit-parks-${id}; here we re-render the same table rows — one per park unit,
     district + district contact printed on the group's first row only — so the
     detail page and the letter never disagree. -->
<script>
  import { parkKey } from '../data/parks';
  import { contactCellHtml, dedupeContacts, type CellContact } from '../lib/contact-cell';
  import { installEmailCopy } from '../lib/email-copy';

  const permitId = (document.getElementById('permit-banner') as HTMLElement | null)?.dataset.permitId || '';
  const model = JSON.parse(document.getElementById('study-area-contacts')?.textContent || '[]') as {
    name: string; pool: CellContact[];
    seed: { person: string; scope: string[] | null }[]; parks: string[];
  }[];
  const table = document.getElementById('study-area-list');

  if (permitId && model.length && table) {
    let persisted: any = {};
    try { persisted = JSON.parse(localStorage.getItem(`permit-final-${permitId}`) || '{}'); } catch {}
    let editedParks: Record<string, string[]> = {};
    try { editedParks = JSON.parse(localStorage.getItem(`permit-parks-${permitId}`) || '{}'); } catch {}
    const recorded: Record<string, { person: string; scope: string[] | null }[]> = persisted.contacts || {};
    const esc = (s: string) =>
      String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // One <tbody> per district, mirroring the server render: a real row group, so
    // scope="rowgroup" is accurate and the hover rule can't reach the next district.
    const groups = model.map((d) => {
      const pool = new Map(d.pool.map((c) => [c.id, c]));
      const entries = recorded[d.name] || d.seed;
      const parkList = editedParks[d.name] || d.parks;
      const districtCell = contactCellHtml(
        dedupeContacts(entries.filter((e) => e.scope === null).map((e) => pool.get(e.person))),
        '<span class="contact-cell__none t-body-01">No contact assigned</span>',
      );
      const rows = parkList.map((park, i) => {
        // A park's own contact is a scoped entry naming that park; none → blank cell.
        const parkCell = contactCellHtml(
          dedupeContacts(
            entries
              .filter((e) => Array.isArray(e.scope) && e.scope!.some((sp) => parkKey(sp) === parkKey(park)))
              .map((e) => pool.get(e.person)),
          ),
        );
        // The district name + contact are emitted ONCE per district, on its first
        // row, spanning the group — same merged-cell shape as the server render.
        const span = Math.max(parkList.length, 1);
        const merged = i === 0
          ? `<th scope="rowgroup" rowspan="${span}" class="sa-cell--district">${esc(d.name)}</th>` +
            `<td rowspan="${span}" class="contact-cell">${districtCell}</td>`
          : '';
        return (
          `<tr class="sa-row" data-district="${esc(d.name)}" data-park="${esc(park)}">` +
            merged +
            `<td>${esc(park)}</td>` +
            `<td class="contact-cell">${parkCell}</td>` +
          '</tr>'
        );
      });
      return `<tbody class="sa-group" data-district="${esc(d.name)}">${rows.join('')}</tbody>`;
    });
    // Swap every row group at once, keeping <thead>. <table> is a valid insertion
    // context for <tbody>, so the parser won't hoist the rows out of the table.
    table.querySelectorAll('tbody').forEach((tb) => tb.remove());
    table.insertAdjacentHTML('beforeend', groups.join(''));
  }

  // The copy-email buttons in the contact cells (server-rendered or re-rendered
  // above) share the delegated handler — idempotent, so calling it here is safe
  // even though AnalysisTeam already installs it on this page.
  installEmailCopy();
</script>

<!-- Uploaded files: download every document. A static prototype has no server-side
     zip, so trigger a download per file (staggered so the browser doesn't drop
     simultaneous downloads) and confirm with a toast. -->
<script>
  import { showToast } from '../lib/toast';

  const dlAll = document.getElementById('download-all-docs');
  const dlData = document.getElementById('all-docs-data');
  if (dlAll && dlData) {
    const files = JSON.parse(dlData.textContent || '[]') as { href: string; name: string }[];
    dlAll.addEventListener('click', () => {
      files.forEach((f, i) => setTimeout(() => {
        const a = document.createElement('a');
        a.href = f.href;
        a.download = f.name;
        a.rel = 'noopener';
        document.body.appendChild(a);
        a.click();
        a.remove();
      }, i * 300));
      showToast('Downloading all documents', `${files.length} files`);
    });
  }
</script>

<!-- Uploaded files: read a document IN PLACE. A file's View action, a "View CV" on
     a research-team card, and an "Answered in study proposal" link all open that
     document in the inline DocumentViewer under the files table (Additional
     documentation tab) — switching the tab if needed and selecting the file in the
     viewer's picker (the viewer's own listener swaps the embed). The links' new-tab
     default is cancelled only when the viewer actually has that document. -->
<script>
  const viewerHost = document.querySelector<HTMLElement>('[data-record-docs]');
  const viewerTabs = document.getElementById('permit-tabs') as any;
  const viewerPanel = viewerHost?.closest<HTMLElement>('.panel');

  const openInViewer = (href: string): boolean => {
    const sel = viewerHost?.querySelector('.pdfv__select') as any;
    const item = sel?.querySelector(`cds-dropdown-item[value="${href}"]`) as HTMLElement | null;
    if (!viewerHost || !sel || !item) return false;
    // Switch to the tab that holds the viewer (the page's own tab logic toggles panels).
    const tab = viewerPanel?.dataset.panel;
    if (tab && viewerTabs && viewerTabs.value !== tab) {
      viewerTabs.value = tab;
      viewerTabs.dispatchEvent(new CustomEvent('cds-tabs-selected'));
    }
    viewerHost.hidden = false;
    sel.value = href;
    sel.dispatchEvent(new CustomEvent('cds-dropdown-selected', { detail: { item } }));
    viewerHost.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    return true;
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-view-cv], [data-view-doc]') as HTMLElement | null;
    if (!trigger) return;
    const href = trigger.dataset.viewCv ?? trigger.dataset.viewDoc;
    if (href && openInViewer(href)) e.preventDefault();
  });

  viewerHost?.querySelector('[data-docs-hide]')?.addEventListener('click', () => {
    viewerHost.hidden = true;
  });
</script>

<style>
  /* Amendment notice sits between the header and the tab strip; ships hidden. */
  .amend-notice[hidden] {
    display: none;
